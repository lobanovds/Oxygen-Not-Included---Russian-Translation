msgid "Duplicants assigned to <style=\"KKeyword\">{0}</style> have started their <b>{1}</b> block.\n\n{2}\n\nOpen the <style=\"KKeyword\">Schedule Screen</style> {Hotkey/ManageSchedule} to change blocks or assignments"
