#. STRINGS.CODEX.INVESTIGATIONS.DLC2_NEWBABY.BODY.CONTAINER1
msgctxt "STRINGS.CODEX.INVESTIGATIONS.DLC2_NEWBABY.BODY.CONTAINER1"
msgid "Director, this was sent to the general inbox.\n\n-----------------------------------------------------------------------------------------------------\n<indent=35%>~ * ~</indent>\n\n<indent=12%>Col. Josephine Carnot & Dr. Alan Stern</indent>\n<indent=35%>and</indent>\n<indent=12%>Dr. Kyung Min Wen & Dr. Soobin Chen</indent>\n\n<indent=20%><i>are overjoyed to announce\n<indent=15%>the arrival of their first grandchild</i></indent>\n\n<smallcaps><indent=20%><b><size=17>Giselle Jackie-Lin Stern</size></b></indent></smallcaps>\n\n<indent=15%><i>and congratulate the happy parents</i></indent>\n\n<indent=20%>Jonathan Stern & Wenlin Chen</indent>\n\n<indent=18%><i>on a safe and healthy incubation.</i></indent>\n\n<indent=35%>~ * ~</indent>\n\n</indent><indent=18%><i>Baby shower invitation to follow.</i></indent>\n-----------------------------------------------------------------------------------------------------\n\nWould you like me to file it with the others?"
msgstr "Директор, это было отправлено в общий почтовый ящик.\n\n-----------------------------------------------------------------------------------------------------\n<indent=35%>~ * ~</indent>\n\n<indent=12%>Полковник Жозефина Карно и Доктор Алан Стерн</indent>\n<indent=35%>и</indent>\n<indent=12%>Доктор Кен Мин Вен и Доктор Субин Чен</indent>\n\n<indent=20%><i>счастливы объявить\n<indent=15%>о рождении своей первой внучки</i></indent>\n\n<smallcaps><indent=20%><b><size=17>Жизель Джеки-Линь Стерн</size></b></indent></smallcaps>\n\n<indent=15%><i>и поздравляют счастливых родителей</i></indent>\n\n<indent=20%>Джонатан Стерн и Вэнлинь Чен</indent>\n\n<indent=18%><i>с благополучной и здоровой инкубацией.</i></indent>\n\n<indent=35%>~ * ~</indent>\n\n</indent><indent=18%><i>Приглашение на вечеринку в честь рождения ребенка последует.</i></indent>\n-----------------------------------------------------------------------------------------------------\n\nХотите, чтобы я подшила это к остальным?"

