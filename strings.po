msgctxt "STRINGS.CODEX.STORY_TRAITS.MORB_ROVER_MAKER.POPUPS.BEGIN.CODEX_NAME"
msgid "First Encounter"
msgstr "Первая Встреча"

#. STRINGS.CODEX.STORY_TRAITS.MORB_ROVER_MAKER.POPUPS.BEGIN.DESCRIPTION
msgctxt "STRINGS.CODEX.STORY_TRAITS.MORB_ROVER_MAKER.POPUPS.BEGIN.DESCRIPTION"
msgid "My Duplicants have discovered a laboratory full of dusty machinery. The vestiges of another colony's experiments, perhaps?\n\nIt is unclear whether the apparatus is intended for biological experimentation or advanced mechatronics...or both."
msgstr "Мои Дупликанты обнаружили лабораторию, полную пыльного оборудования. Возможно, это остатки экспериментов другой колонии?\n\nНеясно, предназначена ли эта аппаратура для биологических экспериментов, для продвинутой мехатроники... или для того и другого."

#. STRINGS.CODEX.STORY_TRAITS.MORB_ROVER_MAKER.POPUPS.BEGIN.NAME
msgctxt "STRINGS.CODEX.STORY_TRAITS.MORB_ROVER_MAKER.POPUPS.BEGIN.NAME"
msgid "Story Trait: Biobot Builder"
msgstr "Сюжетная история: Строитель Биороботов"

