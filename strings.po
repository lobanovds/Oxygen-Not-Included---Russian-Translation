msgctxt "STRINGS.CODEX.STORY_TRAITS.FOSSILHUNT.DNADATA_ENTRY_EXPANDED.SUBTITLE"
msgid "ENCRYPTION LEVEL: THREE"
msgstr "УРОВЕНЬ ШИФРОВАНИЯ: ТРИ"

#. STRINGS.CODEX.STORY_TRAITS.FOSSILHUNT.DNADATA_ENTRY_EXPANDED.TITLE
msgctxt "STRINGS.CODEX.STORY_TRAITS.FOSSILHUNT.DNADATA_ENTRY_EXPANDED.TITLE"
msgid "SUBJECT: RESETTLEMENT LAUNCH PARTY"
msgstr "ТЕМА: ПРАЗДНИК ПО ПОВОДУ ПЕРЕСЕЛЕНИЯ"

