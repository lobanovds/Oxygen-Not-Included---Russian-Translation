msgctxt "STRINGS.CREATURES.SPECIES.SEAL.DESC"
msgid "Spigot Seals are charismatic creatures who produce <link=\"ETHANOL\">Ethanol</link>.\n\nThey enjoy sipping <link=\"SUGARWATER\">Nectar</link> straight from the <link=\"SPACETREE\">Bonbon Tree</link>."
msgstr "Сифонники — харизматичные существа, производящие <link=\"ETHANOL\">Этанол</link>.\n\nОни любят потягивать <link=\"SUGARWATER\">Нектар</link> прямо с <link=\"SPACETREE\">Дерева Бонери</link>."

#. STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.SEAL.EGG_NAME"
msgid "<link=\"SEAL\">Spigot Pup Egg</link>"
msgstr "<link=\"SEAL\">Яйцо Сифонника</link>"

