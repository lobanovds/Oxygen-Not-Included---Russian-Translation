#. STRINGS.ITEMS.FOOD.BERRYPIE.DESC
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.DESC"
msgid "A pie made primarily of <link=\"WORMSUPERFRUIT\">Grubfruit</link> and <link=\"PRICKLEFRUIT\">Gristle Berries</link>.\n\nThe mixture of berries creates a fragrant, colorful filling that packs a sweet punch."
msgstr "Пирог, в основном приготовленный из <link=\"WORMSUPERFRUIT\">Корнефрута</link> и <link=\"PRICKLEFRUIT\">Щетинистой ягодки</link>.\n\nСмесь ягод создает ароматную, яркую начинку с насыщенным сладким вкусом."

#. STRINGS.ITEMS.FOOD.BERRYPIE.NAME
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.NAME"
msgid "<link=\"BERRYPIE\">Mixed Berry Pie</link>"
msgstr "<link=\"BERRYPIE\">Ягодный пирог</link>"

#. STRINGS.ITEMS.FOOD.BERRYPIE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BERRYPIE.RECIPEDESC"
msgid "A pie made primarily of <link=\"WORMSUPERFRUIT\">Grubfruit</link> and <link=\"PRICKLEFRUIT\">Gristle Berries</link>."
msgstr "Пирог, в основном приготовленный из <link=\"WORMSUPERFRUIT\">Корнефрута</link> и <link=\"PRICKLEFRUIT\">Щетинистой ягодки</link>."

#. STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"BURGER\">Frost Burger</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "Дегидрированный <link=\"BURGER\">Ледяной бургер</link>. Его нужно регидрировать, чтобы считать <link=\"FOOD\">Едой</link>.\n\nСухие пайки не имеют срока годности."

#. STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DEHYDRATED.NAME"
msgid "Dried Frost Burger"
msgstr "Высушенный ледяной бургер"

#. STRINGS.ITEMS.FOOD.BURGER.DESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.DESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"LETTUCE\">Lettuce</link> on a chilled <link=\"COLDWHEATBREAD\">Frost Bun</link>.\n\nIt's the only burger best served cold."
msgstr "<link=\"MEAT\">Мясо</link> и <link=\"LETTUCE\">Салат</link> на <link=\"COLDWHEATBREAD\">Ледяной булочке</link>.\n\nЕдинственный вид бургера, который лучше подавать охлажденным."

#. STRINGS.ITEMS.FOOD.BURGER.NAME
msgctxt "STRINGS.ITEMS.FOOD.BURGER.NAME"
msgid "<link=\"BURGER\">Frost Burger</link>"
msgstr "<link=\"BURGER\">Ледяной бургер</link>"

#. STRINGS.ITEMS.FOOD.BURGER.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.BURGER.RECIPEDESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"LETTUCE\">Lettuce</link> on a chilled <link=\"COLDWHEATBREAD\">Frost Bun</link>."
msgstr "<link=\"MEAT\">Мясо</link> и <link=\"LETTUCE\">Салат</link> на <link=\"COLDWHEATBREAD\">Ледяной булочке</link>."

#. STRINGS.ITEMS.FOOD.CARROT.DESC
msgctxt "STRINGS.ITEMS.FOOD.CARROT.DESC"
msgid "An edible tuber with an earthy, elegant flavor."
msgstr "Съедобный корнеплод с землистым, утонченным вкусом."

#. STRINGS.ITEMS.FOOD.CARROT.NAME
msgctxt "STRINGS.ITEMS.FOOD.CARROT.NAME"
msgid "<link=\"CARROT\">Plume Squash</link>"
msgstr "<link=\"CARROT\">Плюмовая тыква</link>"

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.DESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.DESC"
msgid "A simple bun baked from <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link> grain.\n\nEach bite leaves a mild cooling sensation in one's mouth, even when the bun itself is warm."
msgstr "Простая булочка, выпеченная из <link=\"COLDWHEATSEED\">Зерна морозной пшеницы</link>.\n\nКаждый укус оставляет приятную прохладу во рту, несмотря на то, что сама булочка теплая."

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.NAME
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.NAME"
msgid "<link=\"COLDWHEATBREAD\">Frost Bun</link>"
msgstr "<link=\"COLDWHEATBREAD\">Ледяная булочка</link>"

#. STRINGS.ITEMS.FOOD.COLDWHEATBREAD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATBREAD.RECIPEDESC"
msgid "A simple bun baked from <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link> grain."
msgstr "Простая булочка, выпеченная из <link=\"COLDWHEATSEED\">Зерна морозной пшеницы</link>."

#. STRINGS.ITEMS.FOOD.COLDWHEATSEED.DESC
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATSEED.DESC"
msgid "An edible grain that leaves a cool taste on the tongue."
msgstr "Съедобное зерно, которое оставляет приятное и прохладное послевкусие на языке."

#. STRINGS.ITEMS.FOOD.COLDWHEATSEED.NAME
msgctxt "STRINGS.ITEMS.FOOD.COLDWHEATSEED.NAME"
msgid "<link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>"
msgstr "<link=\"COLDWHEATSEED\">Зерно морозной пшеницы</link>"

#. STRINGS.ITEMS.FOOD.COMPOST
msgctxt "STRINGS.ITEMS.FOOD.COMPOST"
msgid "Compost"
msgstr "Компост"

#. STRINGS.ITEMS.FOOD.COOKEDEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDEGG.DESC"
msgid "Fluffed and folded Egg innards.\n\nIt turns out you do, in fact, have to break a few eggs to make it."
msgstr "Перемешанное и поджаренное содержимое яйца.\n\nОказывается, для приготовления требуется всего лишь разбить несколько яиц."

#. STRINGS.ITEMS.FOOD.COOKEDEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDEGG.NAME"
msgid "<link=\"COOKEDEGG\">Omelette</link>"
msgstr "<link=\"COOKEDEGG\">Омлет</link>"

#. STRINGS.ITEMS.FOOD.COOKEDEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDEGG.RECIPEDESC"
msgid "Fluffed and folded egg innards."
msgstr "Перемешанное и поджаренное содержимое яйца."

#. STRINGS.ITEMS.FOOD.COOKEDFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDFISH.DESC"
msgid "A cooked piece of freshly caught aquatic critter.\n\nUnsurprisingly, it tastes a bit fishy."
msgstr "Приготовленный кусок только что пойманного водного существа.\n\nНеудивительно, что вкус немного рыбный."

#. STRINGS.ITEMS.FOOD.COOKEDFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDFISH.NAME"
msgid "<link=\"COOKEDFISH\">Cooked Seafood</link>"
msgstr "<link=\"COOKEDFISH\">Жареные морепродукты</link>"

#. STRINGS.ITEMS.FOOD.COOKEDFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDFISH.RECIPEDESC"
msgid "A cooked piece of freshly caught aquatic critter."
msgstr "Приготовленный кусок только что пойманного водного существа."

#. STRINGS.ITEMS.FOOD.COOKEDMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDMEAT.DESC"
msgid "The cooked meat of a defeated critter.\n\nIt has a delightful smoky aftertaste."
msgstr "Приготовленное мясо побежденного существа.\n\nС восхитительным послевкусием дыма."

#. STRINGS.ITEMS.FOOD.COOKEDMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDMEAT.NAME"
msgid "<link=\"COOKEDMEAT\">Barbeque</link>"
msgstr "<link=\"COOKEDMEAT\">Барбекю</link>"

#. STRINGS.ITEMS.FOOD.COOKEDMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDMEAT.RECIPEDESC"
msgid "The cooked meat of a defeated critter."
msgstr "Приготовленное мясо побежденного существа."

#. STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.DESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.DESC"
msgid "Grilling a <link=\"HARDSKINBERRY\">Pikeapple</link> softens its spikes, making it slighly less awkward to eat.\n\nIt does not diminish the smell."
msgstr "Приготовление на гриле <link=\"HARDSKINBERRY\">Колючебуса</link> смягчает его шипы, делая его чуть менее неприятным.\n\nЗапах при этом никуда не девается."

#. STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.NAME
msgctxt "STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.NAME"
msgid "<link=\"COOKEDPIKEAPPLE\">Pikeapple Skewer</link>"
msgstr "<link=\"COOKEDPIKEAPPLE\">Шашлык из колючебуса</link>"

#. STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.COOKEDPIKEAPPLE.RECIPEDESC"
msgid "A grilled dish made with a fruiting <link=\"HARDSKINBERRY\">Pikeapple</link>."
msgstr "Блюдо на гриле, приготовленное из плодоносящего <link=\"HARDSKINBERRY\">Колючебуса</link>."

#. STRINGS.ITEMS.FOOD.CURRY.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.CURRY.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"CURRY\">Curried Beans</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "Дегидрированная <link=\"CURRY\">Фасоль с карри</link>. Ее нужно регидрировать, чтобы считать <link=\"FOOD\">Едой</link>.\n\nСухие пайки не имеют срока годности."

#. STRINGS.ITEMS.FOOD.CURRY.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.CURRY.DEHYDRATED.NAME"
msgid "Dried Curried Beans"
msgstr "Высушенная фасоль с карри"

#. STRINGS.ITEMS.FOOD.CURRY.DESC
msgctxt "STRINGS.ITEMS.FOOD.CURRY.DESC"
msgid "Chewy <link=\"BEANPLANTSEED\">Nosh Beans</link> simmered with chunks of <link=\"GINGERCONFIG\">Tonic Root</link>.\n\nIt's so spicy!"
msgstr "Упругие <link=\"BEANPLANTSEED\">Бобы ноша</link>, тушенуе с кусочками <link=\"GINGERCONFIG\">Тонизирующего корня</link>.\n\nОчень острые!"

#. STRINGS.ITEMS.FOOD.CURRY.NAME
msgctxt "STRINGS.ITEMS.FOOD.CURRY.NAME"
msgid "<link=\"CURRY\">Curried Beans</link>"
msgstr "<link=\"CURRY\">Фасоль с карри</link>"

#. STRINGS.ITEMS.FOOD.CURRY.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.CURRY.RECIPEDESC"
msgid "Chewy <link=\"BEANPLANTSEED\">Nosh Beans</link> simmered with chunks of <link=\"GINGERCONFIG\">Tonic Root</link>."
msgstr "Упругие <link=\"BEANPLANTSEED\">Бобы ноша</link>, тушенуе с кусочками <link=\"GINGERCONFIG\">Тонизирующего корня</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.DESC"
msgid "Deep-fried fish cradled in a crunchy fin."
msgstr "Рыба, зажаренная во фритюре, в хрустящей панировке."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.NAME"
msgid "<link=\"DEEPFRIEDFISH\">Fish Taco</link>"
msgstr "<link=\"DEEPFRIEDFISH\">Рыбное тако</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDFISH.RECIPEDESC"
msgid "<link=\"FISHMEAT\">Pacu Fillet</link> lightly battered and deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "<link=\"FISHMEAT\">Филе Паку</link> в легком кляре, обжаренное во фритюре с <link=\"TALLOW\">Жиром</link>."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.DESC"
msgid "A juicy slab of meat with a crunchy deep-fried upper layer."
msgstr "Сочный кусок мяса с хрустящим верхним слоем, обжаренным во фритюре."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.NAME"
msgid "<link=\"DEEPFRIEDMEAT\">Deep Fried Steak</link>"
msgstr "<link=\"DEEPFRIEDMEAT\">Стейк во фритюре</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDMEAT.RECIPEDESC"
msgid "A juicy slab of <link=\"MEAT\">Raw Meat</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "Сочный кусок <link=\"MEAT\">Мяса</link>, обжаренный во фритюре с <link=\"TALLOW\">Жиром</link>."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.DESC"
msgid "A snackable handful of crunchy beans."
msgstr "Горстка хрустящих бобов для перекуса."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.NAME"
msgid "<link=\"DEEPFRIEDNOSH\">Nosh Noms</link>"
msgstr "<link=\"DEEPFRIEDNOSH\">Ноша-нямы</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDNOSH.RECIPEDESC"
msgid "A crunchy stack of <link=\"BEANPLANT\">Nosh Beans</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "Хрустящая стопка <link=\"BEANPLANT\">Бобов ноша</link>, обжаренных во фритюре с <link=\"TALLOW\">Жиром</link>."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.DESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.DESC"
msgid "A crispy deep-fried critter claw."
msgstr "Хрустящая клешня, обжаренная во фритюре."

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.NAME
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.NAME"
msgid "<link=\"DEEPFRIEDSHELLFISH\">Shellfish Tempura</link>"
msgstr "<link=\"DEEPFRIEDSHELLFISH\">Темпура из моллюсков</link>"

#. STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DEEPFRIEDSHELLFISH.RECIPEDESC"
msgid "A tender chunk of battered <link=\"SHELLFISHMEAT\">Raw Shellfish</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "Нежный кусок <link=\"SHELLFISHMEAT\">Сырых моллюсков</link> в кляре, обжаренный во фритюре с <link=\"TALLOW\">Жиром</link>."

#. STRINGS.ITEMS.FOOD.DRECKOEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.DRECKOEGG.DESC"
msgid "An egg laid by a <link=\"DRECKO\">Drecko</link>.\n\nIf incubated, it will hatch into a new <link=\"DRECKO\">Drecklet</link>."
msgstr "Яйцо, отложенное <link=\"DRECKO\">Дрэко</link>.\n\nПосле инкубации, оно вылупится в <link=\"DRECKO\">Детеныша дрэко</link>."

#. STRINGS.ITEMS.FOOD.DRECKOEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.DRECKOEGG.NAME"
msgid "<link=\"DRECKO\">Drecklet Egg</link>"
msgstr "<link=\"DRECKO\">Яйцо дрэко</link>"

#. STRINGS.ITEMS.FOOD.DRECKOEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.DRECKOEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"DRECKO\">Drecko</link>."
msgstr "Яйцо, отложенное <link=\"DRECKO\">Дрэко</link>."

#. STRINGS.ITEMS.FOOD.FIELDRATION.DESC
msgctxt "STRINGS.ITEMS.FOOD.FIELDRATION.DESC"
msgid "A nourishing nutrient paste, sandwiched between thin wafer layers."
msgstr "Питательная паста, зажатая между слоями тонкой пластины."

#. STRINGS.ITEMS.FOOD.FIELDRATION.NAME
msgctxt "STRINGS.ITEMS.FOOD.FIELDRATION.NAME"
msgid "<link=\"FIELDRATION\">Nutrient Bar</link>"
msgstr "<link=\"FIELDRATION\">Питательный батончик</link>"

#. STRINGS.ITEMS.FOOD.FISHMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FISHMEAT.DESC"
msgid "An uncooked fillet from a very dead <link=\"PACU\">Pacu</link>. Yum!"
msgstr "Сырое филе очень мертвой рыбки <link=\"PACU\">Паку</link>. Ням!"

#. STRINGS.ITEMS.FOOD.FISHMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FISHMEAT.NAME"
msgid "<link=\"FISHMEAT\">Pacu Fillet</link>"
msgstr "<link=\"FISHMEAT\">Филе паку</link>"

#. STRINGS.ITEMS.FOOD.FOODSPLAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FOODSPLAT.DESC"
msgid "Food smeared on the wall from a recent Food Fight"
msgstr "Еда, размазанная по стене после недавней драки едой."

#. STRINGS.ITEMS.FOOD.FOODSPLAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FOODSPLAT.NAME"
msgid "Food Splatter"
msgstr "Остатки еды"

#. STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.DESC"
msgid "A seedless fruit with an unusual rubbery texture.\n\nIt cannot be replanted.\n\nHexalent fruit is much more calorie dense than Muckroot fruit."
msgstr "Плод без семечек с необычной резиновой текстурой.\n\nЕго нельзя культивировать.\n\nЕго плоды гораздо более калорийные, чем плоды гнилькорня."

#. STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FORESTFORAGEPLANT.NAME"
msgid "<link=\"FORESTFORAGEPLANT\">Hexalent Fruit</link>"
msgstr "<link=\"FORESTFORAGEPLANT\">Плод гексалента</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.DESC"
msgid "Pan-fried, solidified mudslop.\n\nThe inside is almost completely uncooked, despite the crunch on the outside."
msgstr "Сильно зажаренные, затвердевшие помои.\n\nВнутри практически сырые, несмотря на корочку снаружи."

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.NAME"
msgid "<link=\"FRIEDMUSHBAR\">Mush Fry</link>"
msgstr "<link=\"FRIEDMUSHBAR\">Жаренный мшистый батончик</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHBAR.RECIPEDESC"
msgid "Pan-fried, solidified mudslop."
msgstr "Сильно зажаренные, затвердевшие помои."

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.DESC"
msgid "A pan-fried dish made with a fruiting <link=\"MUSHROOM\">Dusk Cap</link>.\n\nIt has a thick, savory flavor with subtle earthy undertones."
msgstr "Жаркое, приготовленное из <link=\"MUSHROOM\">Сумеречных шляпок</link>.\n\nС густым, вкусный ароматом и небольшим земным оттенком."

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.NAME"
msgid "<link=\"FRIEDMUSHROOM\">Fried Mushroom</link>"
msgstr "<link=\"FRIEDMUSHROOM\">Жареный гриб</link>"

#. STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIEDMUSHROOM.RECIPEDESC"
msgid "A pan-fried dish made with a fruiting <link=\"MUSHROOM\">Dusk Cap</link>."
msgstr "Жаркое, приготовленное из <link=\"MUSHROOM\">Сумеречных шляпок</link>."

#. STRINGS.ITEMS.FOOD.FRIESCARROT.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.DESC"
msgid "Irresistibly crunchy.\n\nBest eaten hot."
msgstr "Неотразимо хрустящие.\n\nЛучше всего есть горячими."

#. STRINGS.ITEMS.FOOD.FRIESCARROT.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.NAME"
msgid "<link=\"FRIESCARROT\">Squash Fries</link>"
msgstr "<link=\"FRIESCARROT\">Фри из тыквы</link>"

#. STRINGS.ITEMS.FOOD.FRIESCARROT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRIESCARROT.RECIPEDESC"
msgid "Crunchy sticks of <link=\"CARROT\">Plume Squash</link> deep-fried in <link=\"TALLOW\">Tallow</link>."
msgstr "Хрустящие палочки из <link=\"CARROT\">Плюмовой тыква</link>, обжаренные в <link=\"TALLOW\">Жире</link>."

#. STRINGS.ITEMS.FOOD.FRUITCAKE.DESC
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.DESC"
msgid "A mashed up <link=\"PRICKLEFRUIT\">Bristle Berry</link> sludge with an exceptionally long shelf life.\n\nIts aggressive, overbearing sweetness can leave the tongue feeling temporarily numb."
msgstr "Размолотая <link=\"PRICKLEFRUIT\">Щетинистая ягодка</link> с экстремально долгим сроком хранения.\n\nСладкий и терпкий, от чего язык временно немеет."

#. STRINGS.ITEMS.FOOD.FRUITCAKE.NAME
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.NAME"
msgid "<link=\"FRUITCAKE\">Berry Sludge</link>"
msgstr "<link=\"FRUITCAKE\">Ягодный батончик</link>"

#. STRINGS.ITEMS.FOOD.FRUITCAKE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.FRUITCAKE.RECIPEDESC"
msgid "A mashed up <link=\"PRICKLEFRUIT\">Bristle Berry</link> sludge with an exceptionally long shelf life."
msgstr "Размолотая <link=\"PRICKLEFRUIT\">Щетинистая ягодка</link> с экстремально долгим сроком хранения."

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.DESC
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.DESC"
msgid "A disturbingly delicious mixture of irradiated dirt and water."
msgstr "Настолько странно вкусная смесь облученной земли и воды."

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.NAME
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.NAME"
msgid "<link=\"GAMMAMUSH\">Gamma Mush</link>"
msgstr "<link=\"GAMMAMUSH\">Мшистый гамма-батончик</link>"

#. STRINGS.ITEMS.FOOD.GAMMAMUSH.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.GAMMAMUSH.RECIPEDESC"
msgid "<link=\"FRIEDMUSHBAR\">Mush Fry</link> reheated in a <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"FRIEDMUSHBAR\">Жареный мшистый батончик</link>, прогретый в <link=\"GAMMARAYOVEN\">Гамма-печи</link>."

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.DESC"
msgid "The grilled bud of a <link=\"PRICKLEFRUIT\">Bristle Berry</link>.\n\nHeat unlocked an exquisite taste in the fruit, though the burnt spines leave something to be desired."
msgstr "Запеченный на гриле бутон <link=\"PRICKLEFRUIT\">Щетинистой ягодки</link>.\n\nТепло раскрывает изысканный вкус фрукта, хотя сгоревшие шипы портят общее впечатление."

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.NAME"
msgid "<link=\"GRILLEDPRICKLEFRUIT\">Gristle Berry</link>"
msgstr "<link=\"GRILLEDPRICKLEFRUIT\">Хрустящая ягодка</link>"

#. STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.GRILLEDPRICKLEFRUIT.RECIPEDESC"
msgid "The grilled bud of a <link=\"PRICKLEFRUIT\">Bristle Berry</link>."
msgstr "Запеченный на гриле бутон <link=\"PRICKLEFRUIT\">Щитовика цветущего</link>."

#. STRINGS.ITEMS.FOOD.HARDSKINBERRY.DESC
msgctxt "STRINGS.ITEMS.FOOD.HARDSKINBERRY.DESC"
msgid "An edible fruit encased in a thorny husk."
msgstr "Съедобный фрукт в колючей оболочке."

#. STRINGS.ITEMS.FOOD.HARDSKINBERRY.NAME
msgctxt "STRINGS.ITEMS.FOOD.HARDSKINBERRY.NAME"
msgid "<link=\"HARDSKINBERRY\">Pikeapple</link>"
msgstr "<link=\"HARDSKINBERRY\">Колючебус</link>"

#. STRINGS.ITEMS.FOOD.HATCHEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.DESC"
msgid "An egg laid by a <link=\"HATCH\">Hatch</link>.\n\nIf incubated, it will hatch into a <link=\"HATCH\">Hatchling</link>."
msgstr "Яйцо, отложенное <link=\"HATCH\">Норником</link>.\n\nПосле инкубации, оно вылупится в <link=\"HATCH\">Детеныша норника</link>."

#. STRINGS.ITEMS.FOOD.HATCHEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.NAME"
msgid "<link=\"HATCH\">Hatchling Egg</link>"
msgstr "<link=\"HATCH\">Яйцо норника</link>"

#. STRINGS.ITEMS.FOOD.HATCHEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.HATCHEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"HATCH\">Hatch</link>."
msgstr "Яйцо, отложенное <link=\"HATCH\">Норником</link>."

#. STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.DESC"
msgid "A cold seedless fruit that triggers mild brain freeze.\n\nIt cannot be replanted."
msgstr "Холодный бессемянный фрукт, вызывающий легкое обморожение мозга.\n\nЕго нельзя пересадить."

#. STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.ICECAVESFORAGEPLANT.NAME"
msgid "<link=\"ICECAVESFORAGEPLANT\">Sherberry</link>"
msgstr "<link=\"ICECAVESFORAGEPLANT\">Морозник</link>"

#. STRINGS.ITEMS.FOOD.LETTUCE.DESC
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.DESC"
msgid "Crunchy, slightly salty leaves from a <link=\"SEALETTUCE\">Waterweed</link> plant."
msgstr "Хрустящие, немного солоноватые листья, собранные с растения - <link=\"SEALETTUCE\">Элодея</link>."

#. STRINGS.ITEMS.FOOD.LETTUCE.NAME
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.NAME"
msgid "<link=\"LETTUCE\">Lettuce</link>"
msgstr "<link=\"LETTUCE\">Салат</link>"

#. STRINGS.ITEMS.FOOD.LETTUCE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.LETTUCE.RECIPEDESC"
msgid "Edible roughage from a <link=\"SEALETTUCE\">Waterweed</link>."
msgstr "Съедобные листья, собранные с <link=\"SEALETTUCE\">Элодеи</link>."

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.DESC"
msgid "An egg laid by a <link=\"LIGHTBUG\">Shine Bug</link>.\n\nIf incubated, it will hatch into a <link=\"LIGHTBUG\">Shine Nymph</link>."
msgstr "Яйцо, отложенное <link=\"LIGHTBUG\">Светлячком</link>.\n\nПосле инкубации, оно вылупится в <link=\"HATCHLING\">Детеныша светлячка</link>."

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.NAME"
msgid "<link=\"LIGHTBUG\">Shine Nymph Egg</link>"
msgstr "<link=\"LIGHTBUG\">Яйцо светлячка</link>"

#. STRINGS.ITEMS.FOOD.LIGHTBUGEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.LIGHTBUGEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"LIGHTBUG\">Shine Bug</link>."
msgstr "Яйцо, отложенное <link=\"LIGHTBUG\">Светлячком</link>."

#. STRINGS.ITEMS.FOOD.MEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.MEAT.DESC"
msgid "Uncooked meat from a very dead critter. Yum!"
msgstr "Сырое мясо очень мертвого существа. Объедение!"

#. STRINGS.ITEMS.FOOD.MEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.MEAT.NAME"
msgid "<link=\"MEAT\">Meat</link>"
msgstr "<link=\"MEAT\">Мясо</link>"

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.DESC
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.DESC"
msgid "<link=\"LETTUCE\">Lettuce</link> scrumptiously wilted in the <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"LETTUCE\">Салат</link>, восхитительно приправленный в <link=\"GAMMARAYOVEN\">Гамма-печи</link>."

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.NAME
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.NAME"
msgid "<link=\"MICROWAVEDLETTUCE\">Microwaved Lettuce</link>"
msgstr "<link=\"MICROWAVEDLETTUCE\">Гамма-салат</link>"

#. STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MICROWAVEDLETTUCE.RECIPEDESC"
msgid "<link=\"LETTUCE\">Lettuce</link> scrumptiously wilted in the <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>."
msgstr "<link=\"LETTUCE\">Салат</link>, восхитительно приправленный в <link=\"GAMMARAYOVEN\">Гамма-печи</link>."

#. STRINGS.ITEMS.FOOD.MUSHBAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.DESC"
msgid "An edible, putrefied mudslop.\n\nMush Bars are preferable to starvation, but only just barely."
msgstr "Съедобные, перегнившие помои.\n\nМшистые батончики лучше голода, но лишь чуть-чуть."

#. STRINGS.ITEMS.FOOD.MUSHBAR.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.NAME"
msgid "<link=\"MUSHBAR\">Mush Bar</link>"
msgstr "<link=\"MUSHBAR\">Мшистый батончик</link>"

#. STRINGS.ITEMS.FOOD.MUSHBAR.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHBAR.RECIPEDESC"
msgid "An edible, putrefied mudslop.\n\n<link=\"MUSHBAR\">Mush Bar</link>s are preferable to starvation, but only just barely."
msgstr "Съедобные, перегнившие помои.\n\n<link=\"MUSHBAR\">Мшистые батончики</link> лучше голода, но лишь чуть-чуть."

#. STRINGS.ITEMS.FOOD.MUSHROOM.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOM.DESC"
msgid "An edible, flavorless fungus that grew in the dark."
msgstr "Съедобные, ароматные грибы, которые растут в темноте."

#. STRINGS.ITEMS.FOOD.MUSHROOM.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOM.NAME"
msgid "<link=\"MUSHROOM\">Mushroom</link>"
msgstr "<link=\"MUSHROOM\">Гриб</link>"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"MUSHROOMWRAP\">Mushroom Wrap</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "Дегидрированное <link=\"MUSHROOMWRAP\">Грибное тако</link>. Его нужно регидрировать, чтобы считать <link=\"FOOD\">Едой</link>.\n\nСухие пайки не имеют срока годности."

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DEHYDRATED.NAME"
msgid "Dried Mushroom Wrap"
msgstr "Высушенное грибное тако"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.DESC"
msgid "Flavorful <link=\"MUSHROOM\">Mushrooms</link> wrapped in <link=\"LETTUCE\">Lettuce</link>.\n\nIt has an earthy flavor punctuated by a refreshing crunch."
msgstr "Ароматные <link=\"MUSHROOM\">Сумеречные шляпки</link> обернутые в <link=\"LETTUCE\">Салат</link>.\n\nОбладает землистым ароматом, который перемежается освежающим хрустом."

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.NAME
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.NAME"
msgid "<link=\"MUSHROOMWRAP\">Mushroom Wrap</link>"
msgstr "<link=\"MUSHROOMWRAP\">Грибное тако</link>"

#. STRINGS.ITEMS.FOOD.MUSHROOMWRAP.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.MUSHROOMWRAP.RECIPEDESC"
msgid "Flavorful <link=\"MUSHROOM\">Mushrooms</link> wrapped in <link=\"LETTUCE\">Lettuce</link>."
msgstr "Ароматные <link=\"MUSHROOM\">Сумеречные шляпки</link> обернутые в <link=\"LETTUCE\">Салат</link>."

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.DESC"
msgid "An egg laid by a <link=\"OILFLOATER\">Slickster</link>.\n\nIf incubated, it will hatch into a <link=\"OILFLOATER\">Slickster Larva</link>."
msgstr "Яйцо, отложенное <link=\"OILFLOATER\">Пленочником</link>.\n\nПосле инкубации, оно вылупится в <link=\"OILFLOATER\">Детеныша пленочника</link>."

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.NAME"
msgid "<link=\"OILFLOATER\">Larva Egg</link>"
msgstr "<link=\"OILFLOATER\">Яйцо пленочника</link>"

#. STRINGS.ITEMS.FOOD.OILFLOATEREGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.OILFLOATEREGG.RECIPEDESC"
msgid "An egg laid by a <link=\"OILFLOATER\">Slickster</link>."
msgstr "Яйцо, отложенное <link=\"OILFLOATER\">Пленочником</link>."

#. STRINGS.ITEMS.FOOD.PANCAKES.DESC
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.DESC"
msgid "Sweet discs made from <link=\"RAWEGG\">Raw Egg</link> and <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>.\n\nThey're so thick!"
msgstr "Сладкие диски из <link=\"RAWEGG\">Сырого яйца</link> и <link=\"COLDWHEATSEED\">Зерна морозной пшеницы</link>.\n\nОни такие толстые!"

#. STRINGS.ITEMS.FOOD.PANCAKES.NAME
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.NAME"
msgid "<link=\"PANCAKES\">Soufflé Pancakes</link>"
msgstr "<link=\"PANCAKES\">Блинчики</link>"

#. STRINGS.ITEMS.FOOD.PANCAKES.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PANCAKES.RECIPEDESC"
msgid "Sweet discs made from <link=\"RAWEGG\">Raw Egg</link> and <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "Сладкие диски из <link=\"RAWEGG\">Сырого яйца</link> и <link=\"COLDWHEATSEED\">Зерна морозной пшеницы</link>."

#. STRINGS.ITEMS.FOOD.PASTA.DESC
msgctxt "STRINGS.ITEMS.FOOD.PASTA.DESC"
msgid "pasta made from egg and wheat"
msgstr "Паста из яйца и пшеницы"

#. STRINGS.ITEMS.FOOD.PASTA.NAME
msgctxt "STRINGS.ITEMS.FOOD.PASTA.NAME"
msgid "<link=\"PASTA\">Pasta</link>"
msgstr "<link=\"PASTA\">Паста</link>"

#. STRINGS.ITEMS.FOOD.PASTA.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PASTA.RECIPEDESC"
msgid "pasta made from egg and wheat"
msgstr "Паста из яйца и пшеницы"

#. STRINGS.ITEMS.FOOD.PEMMICAN.DESC
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.DESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"TALLOW\">Tallow</link> pounded into a calorie-dense brick with an exceptionally long shelf life.\n\nSurvival never tasted so good."
msgstr "<link=\"MEAT\">Мясо</link> и <link=\"TALLOW\">Жир</link>, превращенные в калорийный блок с очень длительным сроком хранения.\n\nВыживание никогда не было таким вкусным."

#. STRINGS.ITEMS.FOOD.PEMMICAN.NAME
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.NAME"
msgid "<link=\"PEMMICAN\">Pemmican</link>"
msgstr "<link=\"PEMMICAN\">Пеммикан</link>"

#. STRINGS.ITEMS.FOOD.PEMMICAN.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PEMMICAN.RECIPEDESC"
msgid "<link=\"MEAT\">Meat</link> and <link=\"TALLOW\">Tallow</link> pounded into a nutrient-dense brick with an exceptionally long shelf life."
msgstr "<link=\"MEAT\">Мясо</link> и <link=\"TALLOW\">Жир</link>, превращенные в питательный блок с очень длительным сроком хранения."

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.DESC
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.DESC"
msgid "Meal Lice preserved in vinegar.\n\nIt's a rarely acquired taste."
msgstr "Мукоеды, маринованные в уксусе.\n\nОчень редкий и запоминающийся вкус."

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.NAME
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.NAME"
msgid "<link=\"PICKLEDMEAL\">Pickled Meal</link>"
msgstr "<link=\"PICKLEDMEAL\">Маринованное блюдо</link>"

#. STRINGS.ITEMS.FOOD.PICKLEDMEAL.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PICKLEDMEAL.RECIPEDESC"
msgid "<link=\"BASICPLANTFOOD\">Meal Lice</link> regrettably preserved in vinegar."
msgstr "<link=\"BASICPLANTFOOD\">Мукоеды</link>, замаринованные в уксусе."

#. STRINGS.ITEMS.FOOD.PLANTMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.PLANTMEAT.DESC"
msgid "Planty plant meat from a plant. How nice!"
msgstr "Растительное мясо из растения. Как мило!"

#. STRINGS.ITEMS.FOOD.PLANTMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.PLANTMEAT.NAME"
msgid "<link=\"PLANTMEAT\">Plant Meat</link>"
msgstr "<link=\"PLANTMEAT\">Лиственное мясо</link>"

#. STRINGS.ITEMS.FOOD.POPCORN.DESC
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.DESC"
msgid "<link=\"COLDWHEATSEED\">Sleet Wheat Grain</link> popped in a <link=\"GAMMARAYOVEN\">Gamma Ray Oven</link>.\n\nCompletely devoid of any fancy flavorings."
msgstr "<link=\"COLDWHEATSEED\">Зерно морозной пшеницы</link>, приготовленное в <link=\"GAMMARAYOVEN\">Гамма-печи</link>.\n\nСовершенно лишено каких-либо изысканных приправ."

#. STRINGS.ITEMS.FOOD.POPCORN.NAME
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.NAME"
msgid "<link=\"POPCORN\">Popcorn</link>"
msgstr "<link=\"POPCORN\">Попкорн</link>"

#. STRINGS.ITEMS.FOOD.POPCORN.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.POPCORN.RECIPEDESC"
msgid "Gamma-radiated <link=\"COLDWHEATSEED\">Sleet Wheat Grain</link>."
msgstr "Гамма-облученное <link=\"COLDWHEATSEED\">Зерно морозной пшеницы</link>."

#. STRINGS.ITEMS.FOOD.PRICKLEFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.PRICKLEFRUIT.DESC"
msgid "A sweet, mostly pleasant-tasting fruit covered in prickly barbs."
msgstr "Сладкий, в основном приятный на вкус плод, покрытый острыми колючками."

#. STRINGS.ITEMS.FOOD.PRICKLEFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.PRICKLEFRUIT.NAME"
msgid "<link=\"PRICKLEFRUIT\">Bristle Berry</link>"
msgstr "<link=\"PRICKLEFRUIT\">Щетинистая ягодка</link>"

#. STRINGS.ITEMS.FOOD.PUFTEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.DESC"
msgid "An egg laid by a <link=\"PUFT\">Puft</link>.\n\nIf incubated, it will hatch into a <link=\"PUFT\">Puftlet</link>."
msgstr "Яйцо, отложенное <link=\"PUFT\">Пуфом</link>.\n\nПосле инкубации, оно вылупится в <link=\"PUFT\">Детеныша пуфа</link>."

#. STRINGS.ITEMS.FOOD.PUFTEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.NAME"
msgid "<link=\"PUFT\">Puftlet Egg</link>"
msgstr "<link=\"PUFT\">Яйцо пуфа</link>"

#. STRINGS.ITEMS.FOOD.PUFTEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.PUFTEGG.RECIPEDESC"
msgid "An egg laid by a <link=\"PUFT\">Puft</link>."
msgstr "Яйцо, отложенное <link=\"PUFT\">Пуфом</link>."

#. STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"QUICHE\">Mushroom Quiche</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "Дегидрированный <link=\"QUICHE\">Грибной киш</link>. Его нужно регидрировать, чтобы считать <link=\"FOOD\">едой</link>.\n\nСухие пайки не имеют срока годности."

#. STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DEHYDRATED.NAME"
msgid "Dried Mushroom Quiche"
msgstr "Высушенный грибной киш"

#. STRINGS.ITEMS.FOOD.QUICHE.DESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.DESC"
msgid "<link=\"COOKEDEGG\">Omelette</link>, <link=\"FRIEDMUSHROOM\">Fried Mushroom</link> and <link=\"LETTUCE\">Lettuce</link> piled onto a yummy crust.\n\nSomehow, it's both soggy <i>and</i> crispy."
msgstr "<link=\"COOKEDEGG\">Омлет</link>, <link=\"FRIEDMUSHROOM\">Жареные грибы</link> и <link=\"LETTUCE\">Салат/link>, сложенные на вкусную основу.\n\nКаким-то образом он одновременно мокрый <i>и</i> хрустящий."

#. STRINGS.ITEMS.FOOD.QUICHE.NAME
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.NAME"
msgid "<link=\"QUICHE\">Mushroom Quiche</link>"
msgstr "<link=\"QUICHE\">Грибной киш</link>"

#. STRINGS.ITEMS.FOOD.QUICHE.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.QUICHE.RECIPEDESC"
msgid "<link=\"COOKEDEGG\">Omelette</link>, <link=\"FRIEDMUSHROOM\">Fried Mushroom</link> and <link=\"LETTUCE\">Lettuce</link> piled onto a yummy crust."
msgstr "<link=\"COOKEDEGG\">Омлет</link>, <link=\"FRIEDMUSHROOM\">Жареные грибы</link> и <link=\"LETTUCE\">Салат</link>, сложенные на вкусную основу."

#. STRINGS.ITEMS.FOOD.RAWEGG.DESC
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.DESC"
msgid "A raw Egg that has been cracked open for use in <link=\"FOOD\">Food</link> preparation.\n\nIt will never hatch."
msgstr "Сырое яйцо, которое было разбито для использования для приготовления <link=\"FOOD\">Еды</link>.\n\nОно никогда не вылупится."

#. STRINGS.ITEMS.FOOD.RAWEGG.NAME
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.NAME"
msgid "<link=\"RAWEGG\">Raw Egg</link>"
msgstr "<link=\"RAWEGG\">Сырое яйцо</link>"

#. STRINGS.ITEMS.FOOD.RAWEGG.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.RAWEGG.RECIPEDESC"
msgid "A raw egg that has been cracked open for use in <link=\"FOOD\">Food</link> preparation."
msgstr "Сырое яйцо, которое было разбито для использования для приготовления <link=\"FOOD\">Еды</link>."

#. STRINGS.ITEMS.FOOD.ROTPILE.DESC
msgctxt "STRINGS.ITEMS.FOOD.ROTPILE.DESC"
msgid "An inedible glop of former foodstuff.\n\n<link=\"COMPOST\">Rot Pile</link>s break down into <link=\"TOXICSAND\">Polluted Dirt</link> over time."
msgstr "Несъедобная куча бывших продуктов питания.\n\n<link=\"COMPOST\">Гнилые кучи</link> превращаются в <link=\"TOXICSAND\">Загрязненную землю</link> со временем."

#. STRINGS.ITEMS.FOOD.ROTPILE.NAME
msgctxt "STRINGS.ITEMS.FOOD.ROTPILE.NAME"
msgid "<link=\"COMPOST\">Rot Pile</link>"
msgstr "<link=\"COMPOST\">Гнилая куча</link>"

#. STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SALSA\">Stuffed Berry</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "Дегидрированный паек <link=\"SALSA\">Щетинистой ягодки</link>. Его нужно регидрировать, чтобы считать <link=\"FOOD\">Едой</link>.\n\nСухие пайки не имеют срока годности."

#. STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DEHYDRATED.NAME"
msgid "Dried Stuffed Berry"
msgstr "Высушенная щетинистая ягодка"

#. STRINGS.ITEMS.FOOD.SALSA.DESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.DESC"
msgid "A baked <link=\"PRICKLEFRUIT\">Bristle Berry</link> stuffed with delectable spices and vibrantly flavored."
msgstr "Запеченная <link=\"PRICKLEFRUIT\">Щетинистая ягодка</link>, фаршированная восхитительными пряностями и ярким ароматом."

#. STRINGS.ITEMS.FOOD.SALSA.NAME
msgctxt "STRINGS.ITEMS.FOOD.SALSA.NAME"
msgid "<link=\"SALSA\">Stuffed Berry</link>"
msgstr "<link=\"SALSA\">Фаршированная ягодка</link>"

#. STRINGS.ITEMS.FOOD.SALSA.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SALSA.RECIPEDESC"
msgid "A baked <link=\"PRICKLEFRUIT\">Bristle Berry</link> stuffed with delectable spices and vibrantly flavored."
msgstr "Запеченная <link=\"PRICKLEFRUIT\">Щетинистая ягодка</link>, фаршированная восхитительными пряностями и ярким ароматом."

#. STRINGS.ITEMS.FOOD.SHELLFISHMEAT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SHELLFISHMEAT.DESC"
msgid "An uncooked chunk of very dead <link=\"CRABFRESHWATER\">Sanishell</link>. Yum!"
msgstr "Сырой кусок мертвого <link=\"CRABFRESHWATER\">Мокребса</link>. Ням!"

#. STRINGS.ITEMS.FOOD.SHELLFISHMEAT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SHELLFISHMEAT.NAME"
msgid "<link=\"SHELLFISHMEAT\">Raw Shellfish</link>"
msgstr "<link=\"SHELLFISHMEAT\">Сырой моллюск</link>"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SPICEBREAD\">Pepper Bread</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "Дегидрированный паек <link=\"SPICEBREAD\">Перченого хлебушка</link>. Его нужно регидрировать, чтобы считать <link=\"FOOD\">Едой</link>.\n\nСухие пайки не имеют срока годности."

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DEHYDRATED.NAME"
msgid "Dried Pepper Bread"
msgstr "Высушенный перченый хлебушек"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.DESC"
msgid "A loaf of bread, lightly spiced with <link=\"SPICENUT\">Pincha Peppernut</link> for a mild bite.\n\nThere's a simple joy to be had in pulling it apart in one's fingers."
msgstr "Буханка хлеба, слегка приправленная <link=\"SPICENUT\">Перечным орехом</link> для легкого прикуса.\n\nСуществует простая радость, которую можно получить, держа ее в руке."

#. STRINGS.ITEMS.FOOD.SPICEBREAD.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.NAME"
msgid "<link=\"SPICEBREAD\">Pepper Bread</link>"
msgstr "<link=\"SPICEBREAD\">Перченый хлебушек</link>"

#. STRINGS.ITEMS.FOOD.SPICEBREAD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SPICEBREAD.RECIPEDESC"
msgid "A loaf of bread, lightly spiced with <link=\"SPICENUT\">Pincha Peppernut</link> for a mild bite."
msgstr "Буханка хлеба, слегка приправленная <link=\"SPICENUT\">Перечным орехом</link> для легкого прикуса."

#. STRINGS.ITEMS.FOOD.SPICENUT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICENUT.DESC"
msgid "The flavorful nut of a <link=\"SPICEVINE\">Pincha Pepperplant</link>.\n\nThe bitter outer rind hides a rich, peppery core that is useful in cooking."
msgstr "Ароматный орех <link=\"SPICEVINE\">Пинчи перечной</link>.\n\nВ горькой внешней кожуре скрывается богатое перечное ядро, которое используется в кулинарии."

#. STRINGS.ITEMS.FOOD.SPICENUT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICENUT.NAME"
msgid "<link=\"SPICENUT\">Pincha Peppernut</link>"
msgstr "<link=\"SPICENUT\">Перечный орех</link>"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SPICYTOFU\">Spicy Tofu</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "Дегидрированный паек <link=\"SPICYTOFU\">Острого тофу</link>. Его нужно регидрировать, чтобы считать <link=\"FOOD\">Едой</link>.\n\nСухие пайки не имеют срока годности."

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DEHYDRATED.NAME"
msgid "Dried Spicy Tofu"
msgstr "Высушенный острый тофу"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.DESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.DESC"
msgid "<link=\"TOFU\">Tofu</link> marinated in a flavorful <link=\"SPICENUT\">Pincha Peppernut</link> sauce.\n\nIt packs a delightful punch."
msgstr "<link=\"TOFU\">Тофу</link>, замаринованный в остром соусе из  <link=\"SPICENUT\">Пинчи перечной</link>.\n\nВосхитительный и острый."

#. STRINGS.ITEMS.FOOD.SPICYTOFU.NAME
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.NAME"
msgid "<link=\"SPICYTOFU\">Spicy Tofu</link>"
msgstr "<link=\"SPICYTOFU\">Острый тофу</link>"

#. STRINGS.ITEMS.FOOD.SPICYTOFU.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SPICYTOFU.RECIPEDESC"
msgid "<link=\"TOFU\">Tofu</link> marinated in a flavorful <link=\"SPICENUT\">Pincha Peppernut</link> sauce."
msgstr "<link=\"TOFU\">Тофу</link>, замаринованный в остром соусе из  <link=\"SPICENUT\">Пинчи перечной</link>."

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.DESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.DESC"
msgid "A dehydrated <link=\"SURFANDTURF\">Surf'n'Turf</link> ration. It must be rehydrated in order to be considered <link=\"FOOD\">Food</link>.\n\nDry rations have no expiry date."
msgstr "Дегидрированный паек <link=\"SURFANDTURF\">Мясного ассорти</link>. Его нужно регидрировать, чтобы считать <link=\"FOOD\">едой</link>.\n\nСухие пайки не имеют срока годности."

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.NAME
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DEHYDRATED.NAME"
msgid "Dried Surf'n'Turf"
msgstr "Высушенное мясное ассорти"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.DESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.DESC"
msgid "A bit of <link=\"MEAT\">Meat</link> from the land and <link=\"COOKEDFISH\">Cooked Seafood</link> from the sea.\n\nIt's hearty and satisfying."
msgstr "Немного <link=\"MEAT\">Мяса</link> из земных существ и <link=\"COOKEDFISH\">Приготовленные морепродукты</link> из моря.\n\nОчень сытно."

#. STRINGS.ITEMS.FOOD.SURFANDTURF.NAME
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.NAME"
msgid "<link=\"SURFANDTURF\">Surf'n'Turf</link>"
msgstr "<link=\"SURFANDTURF\">Мясное ассорти</link>"

#. STRINGS.ITEMS.FOOD.SURFANDTURF.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SURFANDTURF.RECIPEDESC"
msgid "A bit of <link=\"MEAT\">Meat</link> from the land and <link=\"COOKEDFISH\">Cooked Seafood</link> from the sea."
msgstr "Немного <link=\"MEAT\">Мяса</link> из земных существ и <link=\"COOKEDFISH\">Приготовленные морепродукты</link> из моря."

#. STRINGS.ITEMS.FOOD.SUSHI.DESC
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.DESC"
msgid "Raw <link=\"FISHMEAT\">Pacu Fillet</link> wrapped with fresh <link=\"LETTUCE\">Lettuce</link>.\n\nWhile the salt of the lettuce may initially overpower the flavor, a keen palate can discern the subtle sweetness of the fillet beneath."
msgstr "Сырое <link=\"FISHMEAT\">Филе паку</link>, обернутое свежими <link=\"LETTUCE\">Салат</link>.\n\nВ то время как соль из салата может подавить первоначальный аромат, через несколько мгновений, однако, вы сможете почувствовать тонкую сладость филе под ним."

#. STRINGS.ITEMS.FOOD.SUSHI.NAME
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.NAME"
msgid "<link=\"SUSHI\">Sushi</link>"
msgstr "<link=\"SUSHI\">Суши</link>"

#. STRINGS.ITEMS.FOOD.SUSHI.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SUSHI.RECIPEDESC"
msgid "Raw <link=\"FISHMEAT\">Pacu Fillet</link> wrapped with fresh <link=\"LETTUCE\">Lettuce</link>."
msgstr "Сырое <link=\"FISHMEAT\">Филе паку</link>, обернутое свежими <link=\"LETTUCE\">Салат</link>."

#. STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.DESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.DESC"
msgid "Dried gelatinous cubes from a <link=\"SWAMPFRUIT\">Bog Jelly</link>.\n\nEach cube has a wonderfully chewy texture and is lightly coated in a delicate powder."
msgstr "Сушеные желеобразные кубики из <link=\"SWAMPFRUIT\">Болотного желе</link>.\n\nКаждый кубик имеет прекрасную жевательную текстуру и легко покрыт нежным порошком."

#. STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.NAME
msgctxt "STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.NAME"
msgid "<link=\"SWAMPDELIGHTS\">Swampy Delights</link>"
msgstr "<link=\"SWAMPDELIGHTS\">Болотные деликатесы</link>"

#. STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPDELIGHTS.RECIPEDESC"
msgid "Dried gelatinous cubes from a <link=\"SWAMPFRUIT\">Bog Jelly</link>."
msgstr "Сушеные желеобразные кубики из <link=\"SWAMPFRUIT\">Болотного желе</link>."

#. STRINGS.ITEMS.FOOD.SWAMPFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPFORAGEPLANT.DESC"
msgid "A seedless plant with a squishy, juicy center and an awful smell.\n\nIt cannot be replanted."
msgstr "Бессемянное растение с мягким, сочным центром и ужасным запахом.\n\nЕго нельзя пересадить."

#. STRINGS.ITEMS.FOOD.SWAMPFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SWAMPFORAGEPLANT.NAME"
msgid "<link=\"SWAMPFORAGEPLANT\">Swamp Chard Heart</link>"
msgstr "<link=\"SWAMPFORAGEPLANT\">Сердцевина трясинника</link>"

#. STRINGS.ITEMS.FOOD.SWAMPFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.SWAMPFRUIT.DESC"
msgid "A fruit with an outer film that contains chewy gelatinous cubes."
msgstr "Фрукт с внешней пленкой, содержащей жевательные желеобразные кубики."

#. STRINGS.ITEMS.FOOD.SWAMPFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.SWAMPFRUIT.NAME"
msgid "<link=\"SWAMPFRUIT\">Bog Jelly</link>"
msgstr "<link=\"SWAMPFRUIT\">Болотное желе</link>"

#. STRINGS.ITEMS.FOOD.TOFU.DESC
msgctxt "STRINGS.ITEMS.FOOD.TOFU.DESC"
msgid "A bland curd made from <link=\"BEAN\">Nosh Beans</link>.\n\nIt has an unusual but pleasant consistency."
msgstr "Мягкий творог, сделанный из <link=\"BEAN\">Бобов ноша</link>.\n\nНеобычной, но приятной консистенции."

#. STRINGS.ITEMS.FOOD.TOFU.NAME
msgctxt "STRINGS.ITEMS.FOOD.TOFU.NAME"
msgid "<link=\"TOFU\">Tofu</link>"
msgstr "<link=\"TOFU\">Тофу</link>"

#. STRINGS.ITEMS.FOOD.TOFU.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.TOFU.RECIPEDESC"
msgid "A bland curd made from <link=\"BEAN\">Nosh Beans</link>."
msgstr "Мягкий творог, сделанный из <link=\"BEAN\">Бобов ноша</link>."

#. STRINGS.ITEMS.FOOD.WORMBASICFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFOOD.DESC"
msgid "Slow roasted <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>.\n\nIt has a smoky aroma and tastes of coziness."
msgstr "Вяленый <link=\"WORMBASICFRUIT\">Корнефрут</link>.\n\nИмеет дымный аромат и вкус уюта."

#. STRINGS.ITEMS.FOOD.WORMBASICFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFOOD.NAME"
msgid "<link=\"WORMBASICFOOD\">Roast Grubfruit Nut</link>"
msgstr "<link=\"WORMBASICFOOD\">Жареный rрнефрукт</link>"

#. STRINGS.ITEMS.FOOD.WORMBASICFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFOOD.RECIPEDESC"
msgid "Slow roasted <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>."
msgstr "Вяленый <link=\"WORMBASICFRUIT\">Корнефрут</link>."

#. STRINGS.ITEMS.FOOD.WORMBASICFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFRUIT.DESC"
msgid "A <link=\"WORMSUPERFRUIT\">Grubfruit</link> that failed to develop properly.\n\nIt is nonetheless edible, and vaguely tasty."
msgstr "Недозревший <link=\"WORMSUPERFRUIT\">Корнефрут</link>.\n\nВсе же съедобен и слегка вкусный."

#. STRINGS.ITEMS.FOOD.WORMBASICFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMBASICFRUIT.NAME"
msgid "<link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>"
msgstr "<link=\"WORMBASICFRUIT\">Корнефрут/link>"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.DESC"
msgid "A long lasting <link=\"WORMSUPERFRUIT\">Grubfruit</link> jam preserved in <link=\"SUCROSE\">Sucrose</link>.\n\nThe thick, goopy jam retains the shape of the jar when poured out, but the sweet taste can't be matched."
msgstr "Долго хранящееся варенье из <link=\"WORMSUPERFRUIT\">Корнефрута</link>, консервированное в <link=\"SUCROSE\">Сахарозе</link>.\n\nГустое, тягучее варенье сохраняет форму банки при выливании, но сладкий вкус просто непревзойденный."

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.NAME"
msgid "<link=\"WORMSUPERFOOD\">Grubfruit Preserve</link>"
msgstr "<link=\"WORMSUPERFOOD\">Варенье из корнефрута</link>"

#. STRINGS.ITEMS.FOOD.WORMSUPERFOOD.RECIPEDESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFOOD.RECIPEDESC"
msgid "A long lasting <link=\"WORMSUPERFRUIT\">Grubfruit</link> jam preserved in <link=\"SUCROSE\">Sucrose</link>."
msgstr "Долго хранящееся варенье из <link=\"WORMSUPERFRUIT\">Корнефрута</link>, консервированное в <link=\"SUCROSE\">Сахарозе</link>."

#. STRINGS.ITEMS.FOOD.WORMSUPERFRUIT.DESC
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFRUIT.DESC"
msgid "A plump, healthy fruit with a honey-like taste."
msgstr "Пухлый, сочный фрукт с медовым вкусом."

#. STRINGS.ITEMS.FOOD.WORMSUPERFRUIT.NAME
msgctxt "STRINGS.ITEMS.FOOD.WORMSUPERFRUIT.NAME"
msgid "<link=\"WORMSUPERFRUIT\">Grubfruit</link>"
msgstr "<link=\"WORMSUPERFRUIT\">Корнефрут</link>"

