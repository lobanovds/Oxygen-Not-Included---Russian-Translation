#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.SUN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.SUN.DESC"
msgid "A UV-free wallpaper."
msgstr "Обои, свободные от УФ-излучения."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.SUN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.SUN.NAME"
msgid "<link=\"EXTERIORWALL\">Sunshine Print</link>"
msgstr "<link=\"EXTERIORWALL\">Солнечный Принт</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TELESCOPE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TELESCOPE.DESC"
msgid "The perfect wallpaper for skygazers."
msgstr "Идеальные обои для любителей звезд."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TELESCOPE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TELESCOPE.NAME"
msgid "<link=\"EXTERIORWALL\">Telescope Print</link>"
msgstr "<link=\"EXTERIORWALL\">Телескопический Принт</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TICTACTOE_O.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TICTACTOE_O.DESC"
msgid "A crisp black 'O' on a clean white background. Ideal for monochromatic games rooms."
msgstr "Четкое черное 'О' на чистом белом фоне. Идеально для монохромных игровых комнат."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TICTACTOE_O.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TICTACTOE_O.NAME"
msgid "<link=\"EXTERIORWALL\">TicTacToe O</link>"
msgstr "<link=\"EXTERIORWALL\">Крестики-нолики O</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TICTACTOE_X.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TICTACTOE_X.DESC"
msgid "A crisp black 'X' on a clean white background. Ideal for monochromatic games rooms."
msgstr "Четкое черное 'Х' на чистом белом фоне. Идеально для монохромных игровых комнат."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TICTACTOE_X.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TICTACTOE_X.NAME"
msgid "<link=\"EXTERIORWALL\">TicTacToe X</link>"
msgstr "<link=\"EXTERIORWALL\">Крестики-нолики X</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TOILETPAPER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TOILETPAPER.DESC"
msgid "Softly undulating lines create an undeniable air of loo-xury."
msgstr "Мягкие волнистые линии создают непреложный воздух туалетной роскоши."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TOILETPAPER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TOILETPAPER.NAME"
msgid "<link=\"EXTERIORWALL\">De-loo-xe</link>"
msgstr "<link=\"EXTERIORWALL\">Де-туалетная-люкс</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TROPICAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TROPICAL.DESC"
msgid "The original scratch-and-sniff version was immediately recalled."
msgstr "Оригинальная версия с запахом была немедленно отозвана."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TROPICAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.TROPICAL.NAME"
msgid "<link=\"EXTERIORWALL\">Sporechid Print</link>"
msgstr "<link=\"EXTERIORWALL\">Спорехидный Принт</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.WATERMELON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.WATERMELON.DESC"
msgid "Far more practical than gluing real fruit on a wall."
msgstr "Гораздо практичнее, чем клеить настоящие фрукты на стену."

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.WATERMELON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.FACADES.WATERMELON.NAME"
msgid "<link=\"EXTERIORWALL\">Juicy Watermelon</link>"
msgstr "<link=\"EXTERIORWALL\">Сочный Арбуз</link>"

#. STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.EXTERIORWALL.NAME"
msgid "<link=\"EXTERIORWALL\">Drywall</link>"
msgstr "<link=\"EXTERIORWALL\">Гипсокартон</link>"

#. STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.EFFECT"
msgid "A tall, thin window."
msgstr "Высокое, тонкое окно."

#. STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FACILITYBACKWALLWINDOW.NAME"
msgid "Window"
msgstr "Окно"

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.DESC"
msgid "This station only has an effect on crops grown within the same room."
msgstr "Эта станция будет оказывать влияние только на посадки, выращиваемые в пределах той же комнаты."

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.EFFECT"
msgid "Produces <link=\"FARMSTATIONTOOLS\">Micronutrient Fertilizer</link> to increase <link=\"PLANTS\">Plant</link> growth rates.\n\nAssigned Duplicants must possess the <link=\"FARMING2\">Crop Tending</link> trait.\n\nThis building is a necessary component of the Greenhouse room."
msgstr "Производит <link=\"FARMSTATIONTOOLS\">Удобрение с микроэлементами</link>, для увеличения скорости роста <link=\"PLANTS\">Растения</link>.\n\nНазначенные Дупликанты должны обладать чертой <link=\"FARMING2\">Подкормка растений</link>.\n\nЭта постройка - необходимая часть комнаты \"Оранжереи\"."

#. STRINGS.BUILDINGS.PREFABS.FARMSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMSTATION.NAME"
msgid "<link=\"FARMSTATION\">Farm Station</link>"
msgstr "<link=\"FARMSTATION\">Станция подкормки</link>"

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.DESC"
msgid "Duplicants can deliver fertilizer and liquids to farm tiles, accelerating plant growth."
msgstr "Дупликанты могут доставлять удобрения и жидкости к блок-фермам, увеличивая скорость роста растений."

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.EFFECT"
msgid "Grows one <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>.\n\nCan be used as floor tile and rotated before construction."
msgstr "Выращивает одно <link=\"PLANTS\">Растение</link> из <link=\"PLANTS\">Семени</link>.\n\nМожет быть использована как блок пола и повернута перед постройкой."

#. STRINGS.BUILDINGS.PREFABS.FARMTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FARMTILE.NAME"
msgid "<link=\"FARMTILE\">Farm Tile</link>"
msgstr "<link=\"FARMTILE\">Блок-ферма</link>"

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.DESC"
msgid "Fertilizer synthesizers convert polluted dirt into fertilizer for domestic plants."
msgstr "Синтезатор удобрений преобразует загрязненную землю в удобрения, необходимые для культивированных растений."

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.EFFECT"
msgid "Uses <link=\"DIRTYWATER\">Polluted Water</link> and <link=\"PHOSPHORITE\">Phosphorite</link> to produce <link=\"FERTILIZER\">Fertilizer</link>."
msgstr "Использует <link=\"DIRTYWATER\">Загрязненную воду</link> и <link=\"PHOSPHORITE\">Фосфорит</link> для производства <link=\"FERTILIZER\">Удобрений</link>."

#. STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FERTILIZERMAKER.NAME"
msgid "<link=\"FERTILIZERMAKER\">Fertilizer Synthesizer</link>"
msgstr "<link=\"FERTILIZERMAKER\">Синтезатор удобрений</link>"

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.DESC"
msgid "Build these in addition to ladders for efficient upward and downward movement."
msgstr "Стройте пожарные столбы в дополнение к лестницам, для эффективного спуска и подъема."

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.EFFECT"
msgid "Allows rapid Duplicant descent.\n\nSignificantly slows upward climbing."
msgstr "Позволяет Дупликантам быстро спускаться.\n\nЗначительно замедляет подъем наверх."

#. STRINGS.BUILDINGS.PREFABS.FIREPOLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FIREPOLE.NAME"
msgid "<link=\"FIREPOLE\">Fire Pole</link>"
msgstr "<link=\"FIREPOLE\">Пожарный столб</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.DESC"
msgid "A fish release must be built above liquid to prevent released fish from suffocating."
msgstr "Эта постройка должна быть размещена над резервуаром с жидкостью, чтобы рыбки не задохнулись."

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.EFFECT"
msgid "Releases trapped <link=\"PACU\">Pacu</link> back into the world.\n\nCan be used multiple times."
msgstr "Отпустить пойманную <link=\"PACU\">рыбку</link> обратно в мир.\n\nМногоразовое использование."

#. STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHDELIVERYPOINT.NAME"
msgid "<link=\"FISHDELIVERYPOINT\">Fish Release</link>"
msgstr "<link=\"FISHDELIVERYPOINT\">Освободитель рыбок</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.DESC"
msgid "Build this feeder above a body of water to feed the fish within."
msgstr "Постройте эту кормушку над резервуаром с водой, чтобы кормить через нее рыбок."

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.EFFECT"
msgid "Automatically dispenses stored <link=\"CREATURES\">Critter</link> food into the area below.\n\nDispenses continuously as food is consumed."
msgstr "Автоматически распыляет хранимую еду для <link=\"CREATURES\">Существ</link> в области под собой.\n\nПодает непрерывно по мере потребления пищи."

#. STRINGS.BUILDINGS.PREFABS.FISHFEEDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHFEEDER.NAME"
msgid "<link=\"FISHFEEDER\">Fish Feeder</link>"
msgstr "<link=\"FISHFEEDER\">Кормушка для рыбок</link>"

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.DESC"
msgid "Trapped fish will automatically be bagged for transport."
msgstr "Пойманная рыбка будет автоматически упакована для транспортировки."

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.EFFECT"
msgid "Attracts and traps swimming <link=\"PACU\">Pacu</link>.\n\nSingle use."
msgstr "Привлекает и ловит плавающих <link=\"PACU\">рыбок</link>.\n\nОдноразовое использование."

#. STRINGS.BUILDINGS.PREFABS.FISHTRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FISHTRAP.NAME"
msgid "<link=\"FISHTRAP\">Fish Trap</link>"
msgstr "<link=\"FISHTRAP\">Ловушка для рыбок</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.DESC"
msgid "Any building's light emitting radius can be viewed in the light overlay."
msgstr "Радиус освещения каждой постройки можно увидеть на \"Карте освещения\"."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.EFFECT"
msgid "Provides <link=\"LIGHT\">Light</link> when <link=\"POWER\">Powered</link>.\n\nIncreases Duplicant workspeed within light radius."
msgstr "Излучает <link=\"LIGHT\">Свет</link>, когда подключена к <link=\"POWER\">электрической</link> сети.\n\nДупликанты управляют постройками более эффективно, находясь внутри освещенного пространства."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.DESC"
msgid "It's a bit prickly, but it casts a festive glow."
msgstr "Несколько колючее, но создает праздничное сияние."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.BRISTLEBLOSSOM.NAME"
msgid "<link=\"FLOORLAMP\">Holiday Lamp</link>"
msgstr "<link=\"FLOORLAMP\">Праздничная лампа</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.DESC"
msgid "Any building's light emitting radius can be viewed in the light overlay."
msgstr "Радиус излучения света любой постройки можно увидеть в наложении света."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.DEFAULT_FLOORLAMP.NAME"
msgid "<link=\"FLOORLAMP\">Lamp</link>"
msgstr "<link=\"FLOORLAMP\">Лампа</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.DESC"
msgid "This lamp blazes forth in unparalleled glory."
msgstr "Эта лампа сверкает в непревзойденной славе."

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.FACADES.LEG.NAME"
msgid "<link=\"FLOORLAMP\">Fragile Leg Lamp</link>"
msgstr "<link=\"FLOORLAMP\">Лампа с хрупкой ножкой</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORLAMP.NAME"
msgid "<link=\"FLOORLAMP\">Lamp</link>"
msgstr "<link=\"FLOORLAMP\">Лампа</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.DESC"
msgid "Weight plates can be used to turn on amenities only when Duplicants pass by."
msgstr "Прижимная плита используется для включения построек, когда на нее наступает Дупликант."

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when an object or Duplicant is placed atop of it.\n\nCannot be triggered by <link=\"ELEMENTSGAS\">Gas</link> or <link=\"ELEMENTSLIQUID\">Liquids</link>."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда Дупликант или объект находится на ней.\n\nНе может срабатывать от давления <link=\"ELEMENTSGAS\">Газа</link> или <link=\"ELEMENTSLIQUID\">Жидкости</link>."

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.LOGIC_PORT_DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.LOGIC_PORT_DESC"
msgid "<link=\"LOGIC\">Active</link>/<link=\"LOGIC\">Inactive</link>"
msgstr "Статус: <link=\"LOGIC\">Активный</link>/<link=\"LOGIC\">Неактивный</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOORSWITCH.NAME"
msgid "<link=\"FLOORSWITCH\">Weight Plate</link>"
msgstr "<link=\"FLOORSWITCH\">Прижимная плита</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.DESC"
msgid "Flower pots allow decorative plants to be moved to new locations."
msgstr "Цветочные горшки позволяют перемещать декоративные растения в новые места."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.EFFECT"
msgid "Houses a single <link=\"PLANTS\">Plant</link> when sown with a <link=\"PLANTS\">Seed</link>.\n\nIncreases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>."
msgstr "Домик для одного <link=\"PLANTS\">Растения</link>, когда в него посажено <link=\"PLANTS\">Семя</link>.\n\nУвеличивает показатель <link=\"DECOR\">Декора</link>, влияющий на <link=\"MORALE\">Мораль</link> Дупликантов."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.DESC"
msgid "The original container for plants on the move."
msgstr "Оригинальный контейнер для путешествующих растений."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.DEFAULT_FLOWERVASE.NAME"
msgid "<link=\"FLOWERVASE\">Flower Pot</link>"
msgstr "<link=\"FLOWERVASE\">Цветочный горшок</link>"

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.DESC"
msgid "A funky red flower pot for plants on the move."
msgstr "Яркий красный горшок для путешествующих растений."

#. STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.FLOWERVASE.FACADES.RETRO_BOLD.NAME"
msgid "<link=\"FLOWERVASE\">Bold Retro Flower Pot</link>"
