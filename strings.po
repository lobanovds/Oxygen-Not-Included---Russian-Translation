msgstr "Колонии необходимы <link=\"WASHBASIN\">умывальники</link>"

#. STRINGS.MISC.NOTIFICATIONS.HYGENE_NEEDED.TOOLTIP
msgctxt "STRINGS.MISC.NOTIFICATIONS.HYGENE_NEEDED.TOOLTIP"
msgid "<link=\"DISEASE\">Germs</link> are spreading in the colony because my Duplicants have nowhere to clean up\n\n<link=\"WASHBASIN\">Wash Basins</link> can be built from the <b>Medicine Tab</b> {Hotkey/Plan8}"
msgstr "<link=\"DISEASE\">Микробы</link> распространяются по колонии, потому что вашим Дупликантам негде их смыть\n\n<link=\"WASHBASIN\">Умывальник</link> может быть построен через меню <b>Лечение</b> {Hotkey/Plan8}"

#. STRINGS.MISC.NOTIFICATIONS.IMMIGRANTSLEFT.NAME
