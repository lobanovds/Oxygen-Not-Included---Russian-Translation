msgstr "Отменить этот приказ на доступ к исследованию"

#. STRINGS.UI.USERMENUACTIONS.OPENPOI.ALREADY_RUMMAGED
msgctxt "STRINGS.UI.USERMENUACTIONS.OPENPOI.ALREADY_RUMMAGED"
msgid "Already Rummaged"
msgstr "Уже обыскано"

#. STRINGS.UI.USERMENUACTIONS.OPENPOI.NAME
msgctxt "STRINGS.UI.USERMENUACTIONS.OPENPOI.NAME"
msgid "Rummage"
msgstr "Обыскать"

#. STRINGS.UI.USERMENUACTIONS.OPENPOI.NAME_OFF
