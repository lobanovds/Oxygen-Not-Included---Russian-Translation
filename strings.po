msgstr "<link=\"GASRESERVOIR\">Бледно-фиолетовый резервуар</link>"

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.RED_ROSE.DESC"
msgid "A colorful reservoir keeps gases neatly organized."
msgstr "Красочный резервуар аккуратно хранит газы."

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.RED_ROSE.NAME"
msgid "<link=\"GASRESERVOIR\">Puce Pink Gas Reservoir</link>"
msgstr "<link=\"GASRESERVOIR\">Розовый резервуар</link>"

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.YELLOW_TARTAR.DESC"
msgid "A colorful reservoir keeps gases neatly organized."
msgstr "Красочный резервуар аккуратно хранит газы."

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"GASRESERVOIR\">Ick Yellow Gas Reservoir</link>"
msgstr "<link=\"GASRESERVOIR\">Жёлтый резервуар</link>"

#. STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASRESERVOIR.NAME"
msgid "<link=\"GASRESERVOIR\">Gas Reservoir</link>"
msgstr "<link=\"GASRESERVOIR\">Резервуар для газа</link>"

#. STRINGS.BUILDINGS.PREFABS.GASVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVALVE.DESC"
msgid "Valves control the amount of gas that moves through pipes, preventing waste."
msgstr "Клапаны контролируют объем газа, который движется по трубам, предотвращая его перерасход."

#. STRINGS.BUILDINGS.PREFABS.GASVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVALVE.EFFECT"
msgid "Controls the <link=\"ELEMENTSGAS\">Gas</link> volume permitted through <link=\"GASPIPING\">Pipes</link>."
msgstr "Контролирует объем <link=\"ELEMENTSGAS\">Газа</link> в <link=\"GASPIPING\">Газовых трубах</link> для поддержания нужного давления."

#. STRINGS.BUILDINGS.PREFABS.GASVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVALVE.NAME"
msgid "<link=\"GASVALVE\">Gas Valve</link>"
msgstr "<link=\"GASVALVE\">Газовый клапан</link>"

#. STRINGS.BUILDINGS.PREFABS.GASVENT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENT.DESC"
msgid "Vents are an exit point for gases from ventilation systems."
msgstr "Газоотвод - это точка выхода газа из газопровода."

#. STRINGS.BUILDINGS.PREFABS.GASVENT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENT.EFFECT"
msgid "Releases <link=\"ELEMENTSGAS\">Gas</link> from <link=\"GASPIPING\">Gas Pipes</link>."
msgstr "Выпускает <link=\"ELEMENTSGAS\">Газ</link> из <link=\"GASPIPING\">Газовых труб</link>."

#. STRINGS.BUILDINGS.PREFABS.GASVENT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENT.NAME"
msgid "<link=\"GASVENT\">Gas Vent</link>"
msgstr "<link=\"GASVENT\">Газоотвод</link>"

#. STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.DESC"
msgid "High pressure vents can expel gas into more highly pressurized environments."
msgstr "Газоотводы высокого давления могут выпускать газ в среды с большим давлением газа."

#. STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.EFFECT"
msgid "Releases <link=\"ELEMENTSGAS\">Gas</link> from <link=\"GASPIPING\">Gas Pipes</link> into high pressure locations."
msgstr "Выпускает <link=\"ELEMENTSGAS\">Газ</link> из <link=\"GASPIPING\">Газовых труб</link> в среды с высоким давлением."

#. STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GASVENTHIGHPRESSURE.NAME"
msgid "<link=\"GASVENTHIGHPRESSURE\">High Pressure Gas Vent</link>"
msgstr "<link=\"GASVENTHIGHPRESSURE\">Газоотвод высокого давления</link>"

#. STRINGS.BUILDINGS.PREFABS.GENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERATOR.DESC"
msgid "Burning coal produces more energy than manual power, but emits heat and exhaust."
msgstr "Угольные генераторы производят больше электричества, чем ручные генераторы, но также выделяют тепло и углекислый газ."

#. STRINGS.BUILDINGS.PREFABS.GENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERATOR.EFFECT"
msgid "Converts <link=\"CARBON\">Coal</link> into electrical <link=\"POWER\">Power</link>.\n\nProduces <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>."
msgstr "Перерабатывает <link=\"CARBON\">Уголь</link> в <link=\"POWER\">Электричество</link>.\n\nПроизводит <link=\"CARBONDIOXIDE\">Углекислый газ</link>."

#. STRINGS.BUILDINGS.PREFABS.GENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERATOR.NAME"
msgid "<link=\"GENERATOR\">Coal Generator</link>"
msgstr "<link=\"GENERATOR\">Угольный генератор</link>"

#. STRINGS.BUILDINGS.PREFABS.GENERATOR.OVERPRODUCTION
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERATOR.OVERPRODUCTION"
msgid "{Generator} overproduction"
msgstr "{Generator} производит излишек электричества"

#. STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.DESC"
msgid "Omniprinters are incapable of printing organic matter."
msgstr "Омнипринтер не способен печатать органическую материю."

#. STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.EFFECT"
msgid "Converts <link=\"RAWMINERAL\">Raw Mineral</link> into unique materials and objects."
msgstr "Перерабатывает <link=\"RAWMINERAL\">Минерал</link> в уникальные ресурсы и объекты."

#. STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GENERICFABRICATOR.NAME"
msgid "<link=\"GENERICFABRICATOR\">Omniprinter</link>"
msgstr "<link=\"GENERICFABRICATOR\">Омнипринтер</link>"

#. STRINGS.BUILDINGS.PREFABS.GENESHUFFLER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GENESHUFFLER.DESC"
msgid "A massive synthetic brain, suspended in saline solution.\n\nThere is a chair attached to the device with room for one person."
msgstr "Массивный синтетический мозг, погруженный в физиологический раствор.\n\nК устройству прикреплен стул с местом для одной персоны."

#. STRINGS.BUILDINGS.PREFABS.GENESHUFFLER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GENESHUFFLER.NAME"
msgid "Neural Vacillator"
msgstr "Нейронный подстройщик"

#. STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.DESC"
msgid "Would a mutated rose still smell as sweet?"
msgstr "Будет ли мутирующая роза все еще пахнуть также сладко?"

#. STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.EFFECT"
msgid "Identifies new <link=\"PLANTS\">Seed</link> subspecies."
msgstr "Идентифицирует новые виды <link=\"PLANTS\">семян</link>."

#. STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GENETICANALYSISSTATION.NAME"
msgid "<link=\"GENETICANALYSISSTATION\">Botanical Analyzer</link>"
msgstr "<link=\"GENETICANALYSISSTATION\">Ботанический анализатор</link>"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.DESC"
msgid "What comes out depends very much on the initial temperature of what goes in."
msgstr "Выходное вещество зависит от начальной температуры входящего."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.EFFECT"
msgid "Uses <link=\"HEAT\">Heat</link> from the planet's core to dramatically increase the temperature of <link=\"ELEMENTSLIQUID\">Liquid</link> inputs.\n\nMaterials will be emitted at connected Geo Vents."
msgstr "Использует <link=\"HEAT\">Тепло</link> из ядра планеты для резкого увеличения температуры входящей <link=\"ELEMENTSLIQUID\">Жидкости</link>.\n\nРесурсы будут выбрасываться через подключенные геовенты."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALCONTROLLER.NAME"
msgid "<link=\"GEOTHERMALCONTROLLER\">Geothermal Heat Pump</link>"
msgstr "<link=\"GEOTHERMALCONTROLLER\">Геотермальный насос</link>"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.BLOCKED_DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.BLOCKED_DESC"
msgid "Blocked geo vents can be cleared by pumping in <link=\"ELEMENTSLIQUID\">liquids</link> that are hot enough to melt <link=\"LEAD\">Lead</link>."
msgstr "Заблокированные геовенты можно очистить с помощью <link=\"ELEMENTSLIQUID\">Жидкостей</link>, которые достаточно горячие, чтобы расплавить <link=\"LEAD\">Свинец</link>."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.DESC"
msgid "Geo vents must finish their current emission before accepting new materials."
msgstr "Геовенты  закончить текущую эмиссию перед принятием новых материалов."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.EFFECT"
msgid "Emits high-<link=\"HEAT\">temperature</link> materials received from the Geothermal Heat Pump."
msgstr "Выбрасывает <link=\"HEAT\">высокотемпературные</link> ресурсы, полученные от геотермального насоса."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT"
msgid "Material Content Monitor"
msgstr "Монитор содержания ресурсов"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when geo vent has materials to emit"
msgstr "Посылает <b><style=\"logic_on\">Зелёный сигнал</style></b>, когда у геовента есть ресурсы для выброса."

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случае посылает <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.NAME"
msgid "<link=\"GEOTHERMALVENT\">Geo Vent</link>"
msgstr "<link=\"GEOTHERMALVENT\">Геовент</link>"

#. STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.NAME_FMT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTHERMALVENT.NAME_FMT"
msgid "<link=\"GEOTHERMALVENT\">Geo Vent C-{ID}</link>"
msgstr "<link=\"GEOTHERMALVENT\">Геовент C-{ID}</link>"

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.DESC"
msgid "The targeted geyser receives stored amplification data when it is erupting."
msgstr "Целевой гейзер получает данные об усилении, когда он извергается."

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.EFFECT"
msgid "Increases the <link=\"HEAT\">Temperature</link> and output of an analyzed <link=\"GEYSERS\">Geyser</link>.\n\nMultiple Geotuners can be directed at a single <link=\"GEYSERS\">Geyser</link> anywhere on an asteroid."
msgstr "Увеличивает <link=\"HEAT\">Температуру</link> и выходное значение проанализированного <link=\"GEYSERS\">Гейзера</link>.\n\nНесколько Геотюнеров могут быть направлены на один <link=\"GEYSERS\">Гейзер</link> на астероиде."

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT"
msgid "Geyser Eruption Monitor"
msgstr "Монитор извержений гейзера"

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when geyser is erupting"
msgstr "Посылает <b><style=\"logic_on\">Зелёный сигнал</style></b>, когда гейзер извергается."

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случае посылает <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.GEOTUNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GEOTUNER.NAME"
msgid "<link=\"GEOTUNER\">Geotuner</link>"
msgstr "<link=\"GEOTUNER\">Геотюнер</link>"

#. STRINGS.BUILDINGS.PREFABS.GLASSFORGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSFORGE.DESC"
msgid "Glass can be used to construct window tile."
msgstr "Стекло используется для строительства блоков окон."

#. STRINGS.BUILDINGS.PREFABS.GLASSFORGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSFORGE.EFFECT"
msgid "Produces <link=\"MOLTENGLASS\">Molten Glass</link> from raw <link=\"SAND\">Sand</link>.\n\nOutputs <link=\"HEAT\">High Temperature</link> <link=\"ELEMENTSLIQUID\">Liquid</link>.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "Производит <link=\"MOLTENGLASS\">Расплавленное стекло</link> из <link=\"SAND\">Песка</link>.\n\nВыделяет значительно <link=\"HEAT\">Нагретую</link> <link=\"ELEMENTSLIQUID\">Жидкость</link>.\n\nДупликанты не будут производить предметы, пока рецепты не поставлены в очередь."

#. STRINGS.BUILDINGS.PREFABS.GLASSFORGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSFORGE.NAME"
msgid "<link=\"GLASSFORGE\">Glass Forge</link>"
msgstr "<link=\"GLASSFORGE\">Плавильня стекла</link>"

#. STRINGS.BUILDINGS.PREFABS.GLASSFORGE.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSFORGE.RECIPE_DESCRIPTION"
msgid "Extracts pure {0} from {1}."
msgstr "Производит {0} из {1}."

#. STRINGS.BUILDINGS.PREFABS.GLASSTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSTILE.DESC"
msgid "Window tiles provide a barrier against liquid and gas and are completely transparent."
msgstr "Блоки окон пропускают свет и декор, блокирую при этом потоки жидкости и газа."

#. STRINGS.BUILDINGS.PREFABS.GLASSTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSTILE.EFFECT"
msgid "Used to build the walls and floors of rooms.\n\nAllows <link=\"LIGHT\">Light</link> and <link=\"DECOR\">Decor</link> to pass through."
msgstr "Используется в качестве блоков пола и стен для строительства комнат.\n\nПропускают <link=\"LIGHT\">Свет</link> и <link=\"DECOR\">Декор</link>."

#. STRINGS.BUILDINGS.PREFABS.GLASSTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GLASSTILE.NAME"
msgid "<link=\"GLASSTILE\">Window Tile</link>"
msgstr "<link=\"GLASSTILE\">Блок окна</link>"

#. STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.DESC"
msgid "Luxury meals increase Duplicants' morale and prevents them from becoming stressed."
msgstr "Роскошные блюда повышают моральный дух Дупликантов и предотвращают стресс."

#. STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.EFFECT"
msgid "Cooks a wide variety of quality <link=\"FOOD\">Foods</link>.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "Позволяет готовить разнообразную <link=\"FOOD\">еду</link> высокого качества.\n\nДупликанты не будут готовить, если рецепты не поставлены в очередь."

#. STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GOURMETCOOKINGSTATION.NAME"
msgid "<link=\"GOURMETCOOKINGSTATION\">Gas Range</link>"
msgstr "<link=\"GOURMETCOOKINGSTATION\">Газовая плита</link>"

#. STRINGS.BUILDINGS.PREFABS.GRAVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVE.DESC"
msgid "Burying dead Duplicants reduces health hazards and stress on the colony."
msgstr "Погребение мертвых Дупликантов уменьшит вероятность возникновения болезней и уровень стресса в колонии."

#. STRINGS.BUILDINGS.PREFABS.GRAVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVE.EFFECT"
msgid "Provides a final resting place for deceased Duplicants.\n\nLiving Duplicants will automatically place an unburied corpse inside."
msgstr "Предоставляет место вечного отдыха для погибших Дупликантов.\n\nЖивые Дупликанты самостоятельно поместят не погребенных Дупликантов внутрь."

#. STRINGS.BUILDINGS.PREFABS.GRAVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVE.NAME"
msgid "<link=\"GRAVE\">Tasteful Memorial</link>"
msgstr "<link=\"GRAVE\">Мемориал памяти</link>"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.EFFECT"
msgid "A clothing storage unit.\n\nIt contains ultra-soft sleepwear."
msgstr "Шкаф для пижамы.\n\nСодержит ультрамягкую одежду для сна."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCONTAINER.NAME"
msgid "Pajama Cubby"
msgstr "Шкафчик для пижам"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.EFFECT"
msgid "An experimental DNA manipulator.\n\nAnalyzes <link=\"CREATURES\">Critters</link> to transform base morphs into random variants of their species."
msgstr "Экспериментальный манипулятор ДНК.\n\nАнализирует <link=\"CREATURES\">Существ</link>, чтобы преобразовать базовые формы в случайные варианты их видов."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASCREATUREMANIPULATOR.NAME"
msgid "<link=\"GRAVITASCREATUREMANIPULATOR\">Critter Flux-O-Matic</link>"
msgstr "<link=\"GRAVITASCREATUREMANIPULATOR\">Флукс-О-Матик для существ</link>"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.EFFECT"
msgid "An office door to an office that no longer exists."
msgstr "Офисная дверь в помещение офиса, которого больше нет."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASDOOR.NAME"
msgid "Gravitas Door"
msgstr "Дверь Гравитас"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.EFFECT"
msgid "An overhead light therapy lamp designed to soothe the minds."
msgstr "Светотерапевтическая лампа, созданная для расслабления разума."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASLABLIGHT.NAME"
msgid "LED Light"
msgstr "Светодиодная лампа"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.DESC"
msgid "Perception can be drastically changed by a bit of thoughtful presentation."
msgstr "Восприятие может быть радикально изменено с помощью небольшой продуманной презентации."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.DISPLAYED_ITEM_FMT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.DISPLAYED_ITEM_FMT"
msgid "Displayed {0}"
msgstr "Отображается {0}"

#. STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.EFFECT"
msgid "Displays a single object, doubling its <link=\"DECOR\">Decor</link> value.\n\nObjects with negative Decor will gain some positive Decor when displayed."
msgstr "Презентует один объект, удваивая значение его <link=\"DECOR\">Декора</link>.\n\n Объекты с негативным значением декора могут получить небольшое положительное значение декора."

#. STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.GRAVITASPEDESTAL.NAME"
msgid "<link=\"ITEMPEDESTAL\">Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">Пьедестал</link>"

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.DESC"
msgid "Allows Duplicants to survive space travel... Hopefully."
msgstr "Позволяет Дупликантам выжить в космическом путешествии находясь внутри этого защитного жилого модуля... Надеюсь."

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.EFFECT"
msgid "Functions as a Command Module.\n\nHolds up to ten Duplicant travellers.\n\nOne Command Module may be installed per rocket. \n\nEngine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr "Функционирует как командный модуль.\n\nВмещает до десяти Дупликантов-путешественников.\n\nНа шаттл можно установить только один командный модуль.\n\nДолжен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>."

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULEMEDIUM.NAME"
msgid "<link=\"HABITATMODULEMEDIUM\">Spacefarer Module</link>"
msgstr "<link=\"HABITATMODULEMEDIUM\">Многоместный жилой модуль</link>"

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.DESC"
msgid "One lucky Duplicant gets the best view from the whole rocket."
msgstr "Один везучий Дупликант получает лучший обзор."

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.EFFECT"
msgid "Functions as a Command Module and a Nosecone.\n\nHolds one Duplicant traveller.\n\nOne Command Module may be installed per rocket.\n\nMust be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n\nMust be built at the top of a rocket."
msgstr "Функционирует как Командный модуль и Носовой обтекатель.\n\nВмещает одного Дупликанта-путешественника.\n\nНа шаттл можно установить только один командный модуль.\n\nДолжен быть построен на вершине шаттла с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>."

#. STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HABITATMODULESMALL.NAME"
msgid "<link=\"HABITATMODULESMALL\">Solo Spacefarer Nosecone</link>"
msgstr "<link=\"HABITATMODULESMALL\">Одноместный жилой модуль</link>"

#. STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.DESC"
msgid "Hand sanitizers kill germs more effectively than wash basins."
msgstr "Дезинфекторы рук убивают микробы более эффективно, чем умывальники."

#. STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.EFFECT"
msgid "Removes most <link=\"DISEASE\">Germs</link> from Duplicants.\n\nGerm-covered Duplicants use Hand Sanitizers when passing by in the selected direction."
msgstr "Удалят большинство <link=\"DISEASE\">Микробов</link> с кожи Дупликантов.\n\nДупликанты, покрытые микробами, будут использовать дезинфекторы для рук, проходя мимо них в выбранном направлении."

#. STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HANDSANITIZER.NAME"
msgid "<link=\"HANDSANITIZER\">Hand Sanitizer</link>"
msgstr "<link=\"HANDSANITIZER\">Дезинфектор рук</link>"

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.DESC"
msgid "New Duplicants come out here, but thank goodness, they never go back in."
msgstr "Новые Дупликанты будут выходить отсюда и, слава богам, они никогда не вернутся обратно."

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.EFFECT"
msgid "An exceptionally advanced bioprinter of unknown origin.\n\nIt periodically produces new Duplicants or care packages containing resources."
msgstr "Исключительно продвинутый биопринтер неизвестного происхождения.\n\nПериодически производит новых Дупликантов, а также полезные для колонии ресурсы."

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERS.NAME"
msgid "<link=\"HEADQUARTERS\">Printing Pod</link>"
msgstr "<link=\"HEADQUARTERS\">Биопринтер</link>"

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERSCOMPLETE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERSCOMPLETE.NAME"
msgid "<link=\"HEADQUARTERS\">Printing Pod</link>"
msgstr "<link=\"HEADQUARTERS\">Биопринтер</link>"

#. STRINGS.BUILDINGS.PREFABS.HEADQUARTERSCOMPLETE.UNIQUE_POPTEXT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEADQUARTERSCOMPLETE.UNIQUE_POPTEXT"
msgid "A clone of the cloning machine? What a novel thought.\n\nAlas, it won't work."
msgstr "Клон клонирующей машины? Безумная задумка.\n\nНе сработает."

#. STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.DESC"
msgid "\"Room temperature\" is relative, really."
msgstr "\"Температура комнаты\" действительно относительна."

#. STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.EFFECT"
msgid "Heats or cools <link=\"ELEMENTSLIQUID\">Liquid</link> to match ambient <link=\"HEAT\">Air Temperature</link>."
msgstr "Нагревает или остужает <link=\"ELEMENTSLIQUID\">Жидкость</link>, чтобы соответствовать <link=\"HEAT\">Температуре воздуха</link> в окружающей среде."

#. STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEATCOMPRESSOR.NAME"
msgid "<link=\"HEATCOMPRESSOR\">Liquid Heatquilizer</link>"
msgstr "<link=\"HEATCOMPRESSOR\">Терморегулятор жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.DESC"
msgid "Particles packed up and ready to go."
msgstr "Частицы упакованы и готовы к работе."

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.EFFECT"
msgid "Stores Radbolts in a high-energy state, ready for transport.\n\nRequires a <b><style=\"logic_on\">Green Signal</style></b> to release radbolts from storage when the Radbolt threshold is reached.\n\nRadbolts in storage will rapidly decay while this building is disabled."
msgstr "Сохраняет Радчастицы в высокоэнергетическом состоянии, готовом к транспортировке.\n\nТребует <b><style=\"logic_on\">Зеленый сигнал</style></b>, чтобы высвободить радчастицы, если порог достигнут.\n\nРадчастицы в хранилище будут распадаться, пока постройка выключена."

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT"
msgid "Do not emit Radbolts"
msgstr "Не выделять радчастицы"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Emit Radbolts"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Выделять радчастицы"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Do not emit Radbolts"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Не выделять радчастицы"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE"
msgid "Radbolt Storage"
msgstr "Хранилище радчастиц"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when its Radbolt Storage is full"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, при полном заполнении хранилища радчастиц"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.LOGIC_PORT_STORAGE_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Иначе отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.HEPBATTERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBATTERY.NAME"
msgid "<link=\"HEPBATTERY\">Radbolt Chamber</link>"
msgstr "Камера для Радчастиц"

#. STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.DESC"
msgid "Allows Radbolts to pass through walls."
msgstr "Позволяет радчастицам проходить сквозь стены."

#. STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.EFFECT"
msgid "Receives <link=\"RADIATION\">Radbolts</link> from <link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generators</link> and directs them through walls. All other materials and elements will be blocked from passage."
msgstr "Получает <link=\"RADIATION\">Радцастицы</link> из <link=\"HIGHENERGYPARTICLESPAWNER\">Генераторов радчастиц</link> и направляет их сквозь стены."

#. STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPBRIDGETILE.NAME"
msgid "<link=\"HEPBRIDGETILE\">Radbolt Joint Plate</link>"
msgstr "<link=\"HEPBRIDGETILE\">Соединительная пластина радчастиц</link>"

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.DESC"
msgid "Radbolt-fueled rockets support few modules, but travel exceptionally far."
msgstr "Шаттлы, заправленные топливом из радчастиц поддерживают немного модулей, зато могут путешествовать очень далеко."

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.EFFECT"
msgid "Injects <link=\"RADIATION\">Radbolts</link> into a reaction chamber to propel rockets for long-range space exploration.\n\nRadbolt Engines are faster than <link=\"HYDROGENENGINE\">Hydrogen Engines</link> but with a more restrictive height allowance.\n\nEngine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n\nOnce the engine has been built, more rocket modules can be added."
msgstr "Вводит <link=\"RADIATION\">Радчастицы</link> в реакционную камеру для запуска шаттлов дальних исследований космоса. \n\nРад-двигатели быстрее, чем <link=\"HYDROGENGINE\">водородные двигатели</link>, но с большими ограничениями по высоте.\n\nДвигатель шаттла должен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>.\n\nПосле установки двигателя можно добавить дополнительные модули шаттла."

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE"
msgid "Radbolt Storage"
msgstr "Хранилище радчастиц"

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when its Radbolt Storage is full"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, при полном заполнении хранилища радчастиц"

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.LOGIC_PORT_STORAGE_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Иначе отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.HEPENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HEPENGINE.NAME"
msgid "<link=\"HEPENGINE\">Radbolt Engine</link>"
msgstr "<link=\"HEPENGINE\">Рад-двигатель</link>"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.DESC"
msgid "We were all out of mirrors."
msgstr "Мы все полны отражений."

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.EFFECT"
msgid "Receives and redirects Radbolts from <link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generators</link>."
msgstr "Получает и отражает радчастицы из <link=\"HIGHENERGYPARTICLESPAWNER\">Генераторов радчастиц</link>."

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT"
msgid "Ignore incoming Radbolts"
msgstr "Контролирует входящие радчастицы"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Allow incoming Radbolts"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Разрешить входящие радчастицы"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Ignore incoming Radbolts"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Игнорировать входящие радчастицы"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLEREDIRECTOR.NAME"
msgid "<link=\"HIGHENERGYPARTICLEREDIRECTOR\">Radbolt Reflector</link>"
msgstr "<link=\"HIGHENERGYPARTICLEREDIRECTOR\">Отражатель радчастиц</link>"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.DESC"
msgid "Radbolts are necessary for producing Materials Science research."
msgstr "Радчастицы необходимы для производства материалов исследований."

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.EFFECT"
msgid "Attracts nearby <link=\"RADIATION\">Radiation</link> to generate Radbolts.\n\nEmits generated Radbolts in the direction of your choosing when the set Radbolt threshold is reached.\n\nRadbolts collected will rapidly decay while this building is disabled."
msgstr "Собирает <link=\"RADIATION\">Радиацию</link> поблизости для выработки радчастиц.\n\nВыделяет сгенерированные радчастицы в выбранном направлении.\n\nСобраные радчастицы будут распадаться, пока генератор выключен."

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT"
msgid "Do not emit Radbolts"
msgstr "Не выделять радчастиц"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Emit Radbolts"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Выделять радчастицы"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Do not emit Radbolts"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Не выделять радчастицы"

#. STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHENERGYPARTICLESPAWNER.NAME"
msgid "<link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generator</link>"
msgstr "<link=\"HIGHENERGYPARTICLESPAWNER\">Генератор радчастиц</link>"

#. STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.DESC"
msgid "Higher wattage wire is used to avoid power overloads, particularly for strong generators."
msgstr "Плотный провод используется для избежания перегрузки сети, а также для сильных генераторов."

#. STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.EFFECT"
msgid "Carries more <link=\"POWER\">Wattage</link> than regular <link=\"WIRE\">Wire</link> without overloading.\n\nCannot be run through wall and floor tile."
msgstr "Пропускает больше <link=\"POWER\">Ватт</link> электричества, чем обычные <link=\"WIRE\">Провода</link>, без перегрузки системы.\n\nНе может быть проложен через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HIGHWATTAGEWIRE.NAME"
msgid "<link=\"HIGHWATTAGEWIRE\">Heavi-Watt Wire</link>"
msgstr "<link=\"HIGHWATTAGEWIRE\">Плотный провод</link>"

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.DESC"
msgid "Relaxes Duplicants with massaging jets of heated liquid."
msgstr "Расслабляет Дупликантов массажируя струями нагретой воды."

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.EFFECT"
msgid "Requires <link=\"LIQUIDPIPING\">Pipes</link> to and from tub and <link=\"POWER\">Power</link> to run the jets.\n\nWater must be a comfortable temperature and will cool rapidly.\n\nIncreases Duplicant <link=\"MORALE\">Morale</link> and leaves them feeling deliciously warm."
msgstr "Требует <link=\"LIQUIDPIPING\">Трубопроводов</link> к и из джакузи и источник <link=\"POWER\">Электричества</link> для работы струй.\n\nВода должна быть комфортной температуры, но остынет достаточно быстро.\n\nПовышает <link=\"MORALE\">Мораль</link> Дупликантов и дарит им приятное тепло."

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.NAME"
msgid "<link=\"HOTTUB\">Hot Tub</link>"
msgstr "<link=\"HOTTUB\">Джакузи</link>"

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.TEMPERATURE_REQUIREMENT
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.TEMPERATURE_REQUIREMENT"
msgid "Minimum {element} Temperature: {temperature}"
msgstr "Минимальная температура ({element}): {temperature}"

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.TEMPERATURE_REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.TEMPERATURE_REQUIREMENT_TOOLTIP"
msgid "The Hot Tub will only be usable if supplied with {temperature} {element}. If the {element} gets too cold, the Hot Tub will drain and require refilling with {element}."

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.WATER_REQUIREMENT
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.WATER_REQUIREMENT"
msgid "{element}: {amount}"
msgstr "{element}: {amount}"

#. STRINGS.BUILDINGS.PREFABS.HOTTUB.WATER_REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.HOTTUB.WATER_REQUIREMENT_TOOLTIP"
msgid "This building must be filled with {amount} {element} in order to function."
msgstr "Для работы эта постройка должна быть наполнена элементом: {element} в объеме {amount}."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.DESC"
msgid "Hydrogen engines can propel rockets further than steam or petroleum engines."
msgstr "Водородные двигатели позволяют шаттлам достигать более отдаленных мест космического пространства, чем паровые или нефтяные двигатели."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.EFFECT"
msgid "Burns <link=\"LIQUIDHYDROGEN\">Liquid Hydrogen</link> to propel rockets for long-range space exploration.\n\nHydrogen Engines have the same generous height restrictions as <link=\"KEROSENEENGINE\">Petroleum Engines</link> but are slightly faster.\n\nThe engine must be built first before more rocket modules can be added."
msgstr "Сжигает <link=\"LIQUIDHYDROGEN\">Жидкий водород</link> при запуске шаттла для исследования космоса на дальние расстояния.\n\nВодородные двигатели имеют те же ограничения по высоте, что и <link=\"KEROSENEENGINE\">Керосиновые двигатели</link>, но они немного быстрее.\n\n\n\nДвигатель шаттла должен быть построен первым, до добавления других модулей."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINE.NAME"
msgid "<link=\"HYDROGENENGINE\">Hydrogen Engine</link>"
msgstr "<link=\"HYDROGENENGINE\">Водородный двигатель</link>"

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.DESC"
msgid "Hydrogen engines can propel rockets further than steam or petroleum engines."
msgstr "Водородные двигатели позволяют шаттлам достигать более отдаленных мест космического пространства, чем паровые или керосиновые двигатели."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.EFFECT"
msgid "Burns <link=\"LIQUIDHYDROGEN\">Liquid Hydrogen</link> to propel rockets for long-range space exploration.\n\nHydrogen Engines have the same generous height restrictions as <link=\"KEROSENEENGINE\">Petroleum Engines</link> but are slightly faster.\n\nEngine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>.\n\nOnce the engine has been built, more rocket modules can be added."
msgstr "Сжигает <link=\"LIQUIDHYDROGEN\">Жидкий водород</link> при запуске шаттла для исследования космоса на дальние расстояния.\n\nВодородные двигатели имеют те же ограничения по высоте, что и <link=\"KEROSENEENGINE\">Керосиновые двигатели</link>, но они немного быстрее.\n\nДвигатель должен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>.\n\nПосле добавления двигателя, можно добавить и другие модули шаттла."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENENGINECLUSTER.NAME"
msgid "<link=\"HYDROGENENGINECLUSTER\">Hydrogen Engine</link>"
msgstr "<link=\"HYDROGENENGINECLUSTER\">Водородный двигатель</link>"

#. STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.DESC"
msgid "Hydrogen generators are extremely efficient, emitting next to no waste."
msgstr "Водородные генераторы являются особенно эффективными источниками электричества, а также не производят отходов."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.EFFECT"
msgid "Converts <link=\"HYDROGEN\">Hydrogen Gas</link> into electrical <link=\"POWER\">Power</link>."
msgstr "Перерабатывает <link=\"HYDROGEN\">Водород</link> в <link=\"POWER\">Электричество</link>."

#. STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROGENGENERATOR.NAME"
msgid "<link=\"HYDROGENGENERATOR\">Hydrogen Generator</link>"
msgstr "<link=\"HYDROGENGENERATOR\">Водородный генератор</link>"

#. STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.DESC"
msgid "Hydroponic farms reduce Duplicant traffic by automating irrigating crops."
msgstr "Гидропонные фермы уменьшают занятость Дупликантов благодаря автоматизации орошения с помощью труб."

#. STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.EFFECT"
msgid "Grows one <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>.\n\nCan be used as floor tile and rotated before construction.\n\nMust be irrigated through <link=\"LIQUIDPIPING\">Liquid Piping</link>."
msgstr "Выращивает одно <link=\"PLANTS\">Растение</link> из <link=\"PLANTS\">Семени</link>.\n\nМожет быть использована как блок пола и повернута перед постройкой.\n\nНеобходимо подключение орошения через <link=\"LIQUIDPIPING\">трубы</link>."

#. STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.HYDROPONICFARM.NAME"
msgid "<link=\"HYDROPONICFARM\">Hydroponic Farm</link>"
msgstr "<link=\"HYDROPONICFARM\">Гидропонная ферма</link>"

#. STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.DESC"
msgid "A Duplicant can work an Ice-E fan to temporarily cool small areas as needed."
msgstr "Дупликант может работать на вентиляторе льда, чтобы временно остудить небольшие зоны."

#. STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.EFFECT"
msgid "Uses <link=\"ICEORE\">Ice</link> to dissipate a small amount of the <link=\"HEAT\">Heat</link>."
msgstr "Использует <link=\"ICEORE\">Лед</link> для рассеивания небольшого объема <link=\"HEAT\">Тепла</link>."

#. STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICECOOLEDFAN.NAME"
msgid "<link=\"ICECOOLEDFAN\">Ice-E Fan</link>"
msgstr "<link=\"ICECOOLEDFAN\">Вентилятор льда</link>"

#. STRINGS.BUILDINGS.PREFABS.ICEKETTLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEKETTLE.DESC"
msgid "The water never gets hot enough to burn the tongue."
msgstr "Вода никогда не бывает горячей, чтобы обжечь язык."

#. STRINGS.BUILDINGS.PREFABS.ICEKETTLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEKETTLE.EFFECT"
msgid "Consumes <link=\"WOOD\">Wood</link> to melt <link=\"ICE\">Ice</link> into <link=\"WATER\">Water</link>, which can be bottled for transport."
msgstr "Потребляет <link=\"WOOD\">Древесину</link> для плавления <link=\"ICE\">Льда</link> в <link=\"WATER\">Воду</link>, которую можно разлить в бутылки для транспортировки."

#. STRINGS.BUILDINGS.PREFABS.ICEKETTLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEKETTLE.NAME"
msgid "<link=\"ICEKETTLE\">Ice Liquefier</link>"
msgstr "<link=\"ICEKETTLE\">Размягчитель льда</link>"

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.DESC"
msgid "Ice makers can be used as a small renewable source of ice and snow."
msgstr "Ледогенераторы используются в качестве небольших возобновляемых источников льда и снега."

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.EFFECT"
msgid "Converts <link=\"WATER\">Water</link> into <link=\"ICE\">Ice</link> or <link=\"SNOW\">Snow</link>."
msgstr "Конвертирует <link=\"WATER\">Воду</link> в <link=\"ICE\">Лед</link> или <link=\"SNOW\">Снег</link>."

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.NAME"
msgid "<link=\"ICEMACHINE\">Ice Maker</link>"
msgstr "<link=\"ICEMACHINE\">Ледогенератор</link>"

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.OPTION_TOOLTIPS.ICE
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.OPTION_TOOLTIPS.ICE"
msgid "Convert <link=\"WATER\">Water</link> into <link=\"ICE\">Ice</link>"
msgstr "Преобразовать <link=\"WATER\">Воду</link> в <link=\"ICE\">Лед</link>"

#. STRINGS.BUILDINGS.PREFABS.ICEMACHINE.OPTION_TOOLTIPS.SNOW
msgctxt "STRINGS.BUILDINGS.PREFABS.ICEMACHINE.OPTION_TOOLTIPS.SNOW"
msgid "Convert <link=\"WATER\">Water</link> into <link=\"SNOW\">Snow</link>"
msgstr "Преобразовать <link=\"WATER\">Воду</link> в <link=\"SNOW\">Снег</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.AVERAGEQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.AVERAGEQUALITYNAME"
msgid "Mediocre Ice Sculpture"
msgstr "Посредственная ледяная скульптура"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.DESC"
msgid "Prone to melting."
msgstr "Ледяные скульптуры растают со временем, если окружающая среда не будет достаточно холодной."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.EFFECT"
msgid "Majorly increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n\nMust be sculpted by a Duplicant."
msgstr "Значительно увеличивает показатель <link=\"DECOR\">Декора</link>, влияющий на <link=\"MORALE\">Мораль</link> Дупликантов.\n\nДолжен быть вырезан изо льда Дупликантом после постройки."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.EXCELLENTQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.EXCELLENTQUALITYNAME"
msgid "Genius Ice Sculpture"
msgstr "Гениальная ледяная скульптура"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_1.DESC"
msgid "These incisors are the stuff of dental legend."
msgstr "Эти резцы – настоящая зубная легенда."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_1.NAME"
msgid "<link=\"ICESCULPTUREAMAZING1\">Exquisite Chompers</link>"
msgstr "<link=\"ICESCULPTUREAMAZING1\">Изысканные Челюсти</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_2.DESC"
msgid "A charming depiction of the mighty Pokeshell in mid-rampage."
msgstr "Очаровательное изображение могучего Кребса в разгаре ярости."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_2.NAME"
msgid "<link=\"ICESCULPTUREAMAZING2\">Frosty Crustacean</link>"
msgstr "<link=\"ICESCULPTUREAMAZING2\">Ледяной Рак</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_3.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_3.DESC"
msgid "Some aquarists posit that Pacus are the original creators of the game now known as \"Tag.\""
msgstr "Некоторые аквариумисты считают, что Паку – первооткрыватели игры, ныне известной как «Салки»."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_3.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_AMAZING_3.NAME"
msgid "<link=\"ICESCULPTUREAMAZING3\">The Chase</link>"
msgstr "<link=\"ICESCULPTUREAMAZING3\">Погоня</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_CRAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_CRAP.DESC"
msgid "It's structurally unsound, but otherwise not entirely terrible."
msgstr "Конструкция ненадежна, но в целом не так уж и плоха."

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_CRAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.FACADES.ICESCULPTURE_CRAP.NAME"
msgid "<link=\"ICESCULPTURECRAP\">Cubi I</link>"
msgstr "<link=\"ICESCULPTURECRAP\">Кубик І</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.NAME"
msgid "<link=\"ICESCULPTURE\">Ice Block</link>"
msgstr "<link=\"ICESCULPTURE\">Ледяной блок</link>"

#. STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.POORQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ICESCULPTURE.POORQUALITYNAME"
msgid "\"Abstract\" Ice Sculpture"
msgstr "\"Абстрактная\" ледяная скульптура"

#. STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.DESC"
msgid "Pipe insulation prevents gas contents from significantly changing temperature in transit."
msgstr "Теплоизоляционные трубы предотвращают изменение температуры их содержимого во время транспортировки по ним."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.EFFECT"
msgid "Carries <link=\"ELEMENTSGAS\">Gas</link> with minimal change in <link=\"HEAT\">Temperature</link>.\n\nCan be run through wall and floor tile."
msgstr "Транспортирует <link=\"ELEMENTSGAS\">Газ</link> с минимальным изменением <link=\"HEAT\">Температуры</link>.\n\nМожет быть проложена через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDGASCONDUIT.NAME"
msgid "<link=\"INSULATEDGASCONDUIT\">Insulated Gas Pipe</link>"
msgstr "<link=\"INSULATEDGASCONDUIT\">Теплоизоляционная газовая труба</link>"

#. STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.DESC"
msgid "Pipe insulation prevents liquid contents from significantly changing temperature in transit."
msgstr "Теплоизоляционные трубы предотвращают изменение температуры их содержимого во время транспортировки по ним."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.EFFECT"
msgid "Carries <link=\"ELEMENTSLIQUID\">Liquid</link> with minimal change in <link=\"HEAT\">Temperature</link>.\n\nCan be run through wall and floor tile."
msgstr "Транспортирует <link=\"ELEMENTSLIQUID\">Жидкость</link> с минимальным изменением <link=\"HEAT\">Температуры</link>.\n\nМожет быть проложена через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDLIQUIDCONDUIT.NAME"
msgid "<link=\"INSULATEDLIQUIDCONDUIT\">Insulated Liquid Pipe</link>"
msgstr "<link=\"INSULATEDLIQUIDCONDUIT\">Теплоизоляционная водопроводная труба</link>"

#. STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.DESC"
msgid "This stuff won't go melting if things get heated."
msgstr "Эти провода не расплавятся, даже если обстановка накалится до предела."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.EFFECT"
msgid "Connects buildings to <link=\"POWER\">Power</link> sources in extreme <link=\"HEAT\">Heat</link>.\n\nCan be run through wall and floor tile."
msgstr "Соединяет постройки с источниками <link=\"POWER\">Электричества</link> в условиях крайне высокой <link=\"HEAT\">Температуры</link> окружающей среды.\n\nМожет быть проложен через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATEDWIRE.NAME"
msgid "<link=\"INSULATEDWIRE\">Insulated Wire</link>"
msgstr "<link=\"INSULATEDWIRE\">Теплоизоляционный провод</link>"

#. STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.DESC"
msgid "The low thermal conductivity of insulated tiles slows any heat passing through them."
msgstr "Низкая теплопроводность теплоизоляционных блоков замедляет передачу тепла."

#. STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.EFFECT"
msgid "Used to build the walls and floors of rooms.\n\nReduces <link=\"HEAT\">Heat</link> transfer between walls, retaining ambient heat in an area."
msgstr "Используется как блок пола и стен при строительстве комнат.\n\nУменьшает передачу <link=\"HEAT\">Тепла</link> между блоками, сохраняя температуру окружающей среды в зоне."

#. STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.INSULATIONTILE.NAME"
msgid "<link=\"INSULATIONTILE\">Insulated Tile</link>"
msgstr "<link=\"INSULATIONTILE\">Теплоизоляционный блок</link>"

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.DESC"
msgid "Perception can be drastically changed by a bit of thoughtful presentation."
msgstr "Восприятие может быть радикально изменено с помощью небольшой продуманной презентации."

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.DISPLAYED_ITEM_FMT
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.DISPLAYED_ITEM_FMT"
msgid "Displayed {0}"
msgstr "Отображается {0}"

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.EFFECT"
msgid "Displays a single object, doubling its <link=\"DECOR\">Decor</link> value.\n\nObjects with negative Decor will gain some positive Decor when displayed."
msgstr "Представляет один объект, удваивая его значение <link=\"DECOR\">Декора</link>.\n\n Уродливые предметы могут стать немного привлекательнее, если их положить на пьедестал."

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.DEFAULT_ITEMPEDESTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.DEFAULT_ITEMPEDESTAL.DESC"
msgid "Perception can be drastically changed by a bit of thoughtful presentation."
msgstr "Восприятие можно кардинально изменить с помощью продуманной презентации."

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.DEFAULT_ITEMPEDESTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.DEFAULT_ITEMPEDESTAL.NAME"
msgid "<link=\"ITEMPEDESTAL\">Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">Пьедестал</link>"

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.HAND.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.HAND.DESC"
msgid "This pedestal cradles precious objects in the palm of its hand."
msgstr "Этот пьедестал держит драгоценные предметы в своей ладони."

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.HAND.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.FACADES.HAND.NAME"
msgid "<link=\"ITEMPEDESTAL\">Hand of Dupe Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">Рука Дупликанта</link>"

#. STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ITEMPEDESTAL.NAME"
msgid "<link=\"ITEMPEDESTAL\">Pedestal</link>"
msgstr "<link=\"ITEMPEDESTAL\">Пьедестал</link>"

#. STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.DESC"
msgid "Jet suit docks can refill jet suits with air and fuel, or empty them of waste."
msgstr "Доки реактивных костюмов могут пополнить реактивные костюмы воздухом и топливом или опорожнить их от отходов."

#. STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.EFFECT"
msgid "Stores <link=\"JETSUIT\">Jet Suits</link> and refuels them with <link=\"OXYGEN\">Oxygen</link> and <link=\"PETROLEUM\">Petroleum</link>.\n\nEmpties suits of <link=\"DIRTYWATER\">Polluted Water</link>.\n\nBuild next to a <link=\"JETSUITMARKER\">Jet Suit Checkpoint</link> to make Duplicants change into suits when passing by."
msgstr "Хранит <link=\"JETSUIT\">Реактивные костюмы</link>, заправляет их <link=\"OXYGEN\">Кислородом</link> и <link=\"PETROLEUM\">Керосином</link>.\n\nОчищает костюмы от <link=\"DIRTYWATER\">Загрязненной воды</link>.\n\nПостройте рядом с <link=\"JETSUITMARKER\">Контрольным пунктом реактивных костюмов</link>, чтобы Дупликанты переодевались в них, проходя мимо."

#. STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITLOCKER.NAME"
msgid "<link=\"JETSUITLOCKER\">Jet Suit Dock</link>"
msgstr "<link=\"JETSUITLOCKER\">Док-станция реактивных костюмов</link>"

#. STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.DESC"
msgid "A checkpoint must have a correlating dock built on the opposite side its arrow faces."
msgstr "Контрольный пункт должен иметь док-станцию реактивных костюмов, построенную на противоположной стороне."

#. STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.EFFECT"
msgid "Marks a threshold where Duplicants must change into or out of <link=\"JETSUIT\">Jet Suits</link>.\n\nMust be built next to a <link=\"JETSUITLOCKER\">Jet Suit Dock</link>.\n\nCan be rotated before construction."
msgstr "Отмечает порог, при котором Дупликанты должны пойти поменять или зарядить свои <link=\"JETSUIT\">Реактивные костюмы</link>.\n\nДолжна быть построена рядом с <link=\"JETSUITLOCKER\">док-станцией реактивных костюмов</link>.\n\nМожет быть повернута перед постройкой."

#. STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.JETSUITMARKER.NAME"
msgid "<link=\"JETSUITMARKER\">Jet Suit Checkpoint</link>"
msgstr "<link=\"JETSUITMARKER\">Контрольный пункт реактивных костюмов</link>"

#. STRINGS.BUILDINGS.PREFABS.JUICER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.JUICER.DESC"
msgid "Fruity juice can really brighten a Duplicant's breaktime"
msgstr "Фруктовый сок поможет скрасить перерыв Дупликанта"

#. STRINGS.BUILDINGS.PREFABS.JUICER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.JUICER.EFFECT"
msgid "Provides refreshment for Duplicants on their breaks.\n\nDrinking juice increases Duplicant <link=\"MORALE\">Morale</link>."
msgstr "Освежающий вкус свежих фруктов для Дупликантов на перерывах.\n\nПитье сока увеличивает <link=\"MORALE\">Мораль</link> Дупликанта."

#. STRINGS.BUILDINGS.PREFABS.JUICER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.JUICER.NAME"
msgid "<link=\"JUICER\">Juicer</link>"
msgstr "<link=\"JUICER\">Соковыжималка</link>"

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.DESC"
msgid "Rockets can be used to send Duplicants into space and retrieve rare resources."
msgstr "Шаттлы используются для отправки Дупликантов в космические экспедиции и добычи редких ресурсов."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.EFFECT"
msgid "Burns <link=\"PETROLEUM\">Petroleum</link> to propel rockets for mid-range space exploration.\n\nPetroleum Engines have generous height restrictions, ideal for hauling many modules.\n\nThe engine must be built first before more rocket modules can be added."
msgstr "Сжигает <link=\"PETROLEUM\">Керосин</link> при запуске шаттла для исследования космоса на средние дистанции.n\nКеросиновые двигатели имеют значительные ограничения по высоте, что идеально подходит для перевозки большого количества модулей.\n\nДвигатель шаттла должен быть построен первым, до добавления других модулей."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINE.NAME"
msgid "<link=\"KEROSENEENGINE\">Petroleum Engine</link>"
msgstr "<link=\"KEROSENEENGINE\">Керосиновый двигатель</link>"

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.DESC"
msgid "More powerful rocket engines can propel heavier burdens."
msgstr "Более мощный двигатель, который может перемещать тяжелые грузы."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.EFFECT"
msgid "Burns <link=\"PETROLEUM\">Petroleum</link> to propel rockets for mid-range space exploration.\n\nPetroleum Engines have generous height restrictions, ideal for hauling many modules.\n\nEngine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n\nOnce the engine has been built, more rocket modules can be added."
msgstr "Сжигает <link=\"PETROLEUM\">Керосин</link> при запуске шаттла для исследования космоса на средние дистанции.\n\nКеросиновые двигатели имеют значительные ограничения по высоте, что идеально подходит для перевозки большого количества модулей.\n\nДвигатель должен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>.\n\nПосле добавления двигателя, можно добавить и другие модули шаттла."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTER.NAME"
msgid "<link=\"KEROSENEENGINECLUSTER\">Petroleum Engine</link>"
msgstr "<link=\"KEROSENEENGINECLUSTER\">Керосиновый двигатель</link>"

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.DESC"
msgid "Rockets can be used to send Duplicants into space and retrieve rare resources."
msgstr "Шаттлы используются Дупликантов для отправки в космические экспедиции и добычи редких ресурсов."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.EFFECT"
msgid "Burns <link=\"PETROLEUM\">Petroleum</link> to propel rockets for mid-range space exploration.\n\nSmall Petroleum Engines possess the same speed as a <link=\"KEROSENEENGINE\">Petroleum Engines</link> but have smaller height restrictions.\n\nEngine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n\nOnce the engine has been built, more rocket modules can be added."
msgstr "Сжигает <link=\"PETROLEUM\">Керосин</link> при запуске шаттла для исследования космоса на средние дистанции.\n\nМаленькие керосиновые двигатели обладают такой же скоростью, что и <link=\"KEROSENEENGINE\">Керосиновый двигатель</link>, но имеют ограничения по высоте.\n\nДвигатель должен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>.\n\nПосле добавления двигателя, можно добавить и другие модули шаттла."

#. STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.KEROSENEENGINECLUSTERSMALL.NAME"
msgid "<link=\"KEROSENEENGINECLUSTERSMALL\">Small Petroleum Engine</link>"
msgstr "<link=\"KEROSENEENGINECLUSTERSMALL\">Маленький керосиновый двигатель</link>"

#. STRINGS.BUILDINGS.PREFABS.KILN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.KILN.DESC"
msgid "Kilns can also be used to refine coal into pure carbon."
msgstr "Печь для обжига также используется для очистки угля до чистого углерода."

#. STRINGS.BUILDINGS.PREFABS.KILN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.KILN.EFFECT"
msgid "Fires <link=\"CLAY\">Clay</link> to produce <link=\"CERAMIC\">Ceramic</link>.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "Обжигает <link=\"CLAY\">Глину</link> в <link=\"CERAMIC\">Керамику</link>.\n\nДупликанты не будут производить предметы, если рецепты не поставлены в очередь."

#. STRINGS.BUILDINGS.PREFABS.KILN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.KILN.NAME"
msgid "<link=\"KILN\">Kiln</link>"
msgstr "<link=\"KILN\">Печь для обжига</link>"

#. STRINGS.BUILDINGS.PREFABS.LADDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDER.DESC"
msgid "(That means they climb it.)"
msgstr "(Правильное применение - забраться на нее.)"

#. STRINGS.BUILDINGS.PREFABS.LADDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDER.EFFECT"
msgid "Enables vertical mobility for Duplicants."
msgstr "Позволяет Дупликантам передвигаться по вертикали."

#. STRINGS.BUILDINGS.PREFABS.LADDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDER.NAME"
msgid "<link=\"LADDER\">Ladder</link>"
msgstr "<link=\"LADDER\">Лестница</link>"

#. STRINGS.BUILDINGS.PREFABS.LADDERBED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERBED.DESC"
msgid "Duplicant's sleep will be interrupted if another Duplicant uses the ladder."
msgstr "Дупликант проснется, если другой Дупликант использует лестницу"

#. STRINGS.BUILDINGS.PREFABS.LADDERBED.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERBED.EFFECT"
msgid "Provides a sleeping area for one Duplicant and also functions as a ladder.\n\nDuplicants will automatically sleep in their assigned beds at night."
msgstr "Предоставляет место для сна одного Дупликанта и функционирует как лестница.\n\nС наступлением ночи Дупликанты самостоятельно отправятся спать в назначенную им кровать."

#. STRINGS.BUILDINGS.PREFABS.LADDERBED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERBED.NAME"
msgid "<link=\"LADDERBED\">Ladder Bed</link>"
msgstr "<link=\"LADDERBED\">Кровать с лестницей</link>"

#. STRINGS.BUILDINGS.PREFABS.LADDERFAST.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERFAST.DESC"
msgid "Plastic ladders are mildly antiseptic and can help limit the spread of germs in a colony."
msgstr "Пластиковые лестницы - антисептические, и могут помочь ограничить распространение микробов в колонии."

#. STRINGS.BUILDINGS.PREFABS.LADDERFAST.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERFAST.EFFECT"
msgid "Increases Duplicant climbing speed."
msgstr "Увеличивает скорость лазания Дупликанта."

#. STRINGS.BUILDINGS.PREFABS.LADDERFAST.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LADDERFAST.NAME"
msgid "<link=\"LADDERFAST\">Plastic Ladder</link>"
msgstr "<link=\"LADDERFAST\">Пластиковая лестница</link>"

#. STRINGS.BUILDINGS.PREFABS.LANDING_POD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDING_POD.DESC"
msgid "Geronimo!"
msgstr "Джеронимо!"

#. STRINGS.BUILDINGS.PREFABS.LANDING_POD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDING_POD.EFFECT"
msgid "Contains a Duplicant deployed from orbit.\n\nPod will disintegrate on arrival."
msgstr "Содержит Дупликанта, отправленного с орбиты.\n\nПо прибытии капсула разрушается."

#. STRINGS.BUILDINGS.PREFABS.LANDING_POD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDING_POD.NAME"
msgid "Spacefarer Deploy Pod"
msgstr "Спасательная капсула"

#. STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.DESC"
msgid "Microtarget where your <link=\"RAILGUNPAYLOAD\">Interplanetary Payload</link> lands on a Planetoid surface."
msgstr "Микроцель, возле которой на поверхность приземляется <link=\"RAILGUNPAYLOAD\">Межпланетный груз</link>."

#. STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.EFFECT"
msgid "Guides <link=\"RAILGUNPAYLOAD\">Interplanetary Payloads</link> and <link=\"ORBITALCARGOMODULE\">Orbital Cargo Modules</link> to land nearby.\n\n<link=\"RAILGUNPAYLOAD\">Interplanetary Payloads</link> must be launched from a <link=\"RAILGUN\">Interplanetary Launcher</link>."
msgstr "Направляет <link=\"RAILGUNPAYLOAD\">Межпланетный груз</link> и <link=\"ORBITALCARGOMODULE\">Орбитальные грузовые модули</link> на посадку поблизости.\n\n<link=\"RAILGUNPAYLOAD\">Межпланетный груз</link> должен запускаться из <link=\"RAILGUN\">Межпланетной пусковой установки</link>."

#. STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LANDINGBEACON.NAME"
msgid "<link=\"LANDINGBEACON\">Targeting Beacon</link>"
msgstr "<link=\"LANDINGBEACON\">Маяк целеуказания</link>"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.DESC"
msgid "A platform from which rockets can be launched and on which they can land."
msgstr "Платформа, с которой можно запускать шаттлы и на которую они могут приземляться."

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.EFFECT"
msgid "Precursor to construction of all other Rocket modules.\n\nAllows Rockets to launch from or land on the host Planetoid.\n\nAutomatically links up to <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link><link=\"MODULARLAUNCHPADPORTSOLID\">s</link> built to either side of the platform."
msgstr "Предшественник для строительства всех остальных модулей Шаттла.\n\nПозволяет Шаттлам взлетать с или приземляться на планетоид.\n\nАвтоматически соединяется с <link=\"MODULARLAUNCHPADPORTSOLID\">Портами шаттла</link>, построенными по бокам платформы."

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET"
msgid "Landed Rocket"
msgstr "Шаттл приземлился"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET_ACTIVE"
msgid "Sends a Green Signal when its rocket is on the <link=\"LAUNCHPAD\">Rocket Platform</link>"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда шаттл находится на <link=\"LAUNCHPAD\">Платформе для шаттлов</link>"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LANDED_ROCKET_INACTIVE"
msgid "Otherwise, sends a Red Signal"
msgstr "Иначе отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH"
msgid "Launch Rocket"
msgstr "Запуск шаттла"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH_ACTIVE"
msgid "Green Signal: Launch rocket"
msgstr "Зеленый сигнал: Запуск шаттла"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_LAUNCH_INACTIVE"
msgid "Red Signal: Cancel launch"
msgstr "Красный сигнал: Отмена запуска"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY"
msgid "Rocket Checklist"
msgstr "Готовность шаттла к запуску"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY_ACTIVE"
msgid "Sends a Green Signal when its rocket is ready for flight"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда шаттл готов к полету"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.LOGIC_PORT_READY_INACTIVE"
msgid "Otherwise, sends a Red Signal"
msgstr "Иначе отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LAUNCHPAD.NAME"
msgid "<link=\"LAUNCHPAD\">Rocket Platform</link>"
msgstr "<link=\"LAUNCHPAD\">Платформа для шаттлов</link>"

#. STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.DESC"
msgid "Lead suit docks can refill lead suits with air and empty them of waste."
msgstr "Доки антирадиационных костюмов могут пополнить костюмы воздухом и опорожнить их от отходов."

#. STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.EFFECT"
msgid "Stores <link=\"LEADSUIT\">Lead Suits</link> and refuels them with <link=\"OXYGEN\">Oxygen</link>.\n\nEmpties suits of <link=\"DIRTYWATER\">Polluted Water</link>.\n\nBuild next to a <link=\"LEADSUITMARKER\">Lead Suit Checkpoint</link> to make Duplicants change into suits when passing by."
msgstr "Хранит <link=\"LEADSUIT\">Антирадиационные костюмы</link>, заправляет их <link=\"OXYGEN\">Кислородом</link>.\n\nОчищает костюмы от <link=\"DIRTYWATER\">Загрязненной воды</link>.\n\nПостройте рядом с <link=\"LEADSUITMARKER\">Контрольным пунктом антирадиационных костюмов</link>, чтобы Дупликанты переодевались в них, проходя мимо."

#. STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITLOCKER.NAME"
msgid "<link=\"LEADSUITLOCKER\">Lead Suit Dock</link>"
msgstr "<link=\"LEADSUITLOCKER\">Док антирадиационных костюмов</link>"

#. STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.DESC"
msgid "A checkpoint must have a correlating dock built on the opposite side its arrow faces."
msgstr "Контрольный пункт должен иметь док антирадиационных костюмов, построенный на противоположной стороне."

#. STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.EFFECT"
msgid "Marks a threshold where Duplicants must change into or out of <link=\"LEADSUIT\">Lead Suits</link>.\n\nMust be built next to a <link=\"LEADSUITLOCKER\">Lead Suit Dock</link>\n\nCan be rotated before construction."
msgstr "Отмечает порог, при котором Дупликанты должны пойти поменять или зарядить свои <link=\"LEADSUIT\">Антирадиационные костюмы</link>.\n\nДолжен быть построен рядом с <link=\"LEADSUITLOCKER\">доком антирадиационных костюмов</link>.\n\nМожет быть повернута перед постройкой."

#. STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LEADSUITMARKER.NAME"
msgid "<link=\"LEADSUITMARKER\">Lead Suit Checkpoint</link>"
msgstr "<link=\"LEADSUITMARKER\">Контрольный пункт антирадиационных костюмов</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.DESC"
msgid "Duplicants will fill cargo bays with any resources they find during space missions."
msgstr "Дупликанты будут заполнять грузовые отсеки любыми ресурсами, которые они найдут в ходе своих космических экспедиций."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.EFFECT"
msgid "Allows Duplicants to store any <link=\"ELEMENTSLIQUID\">Liquid</link> resources found during space missions.\n\nStored resources become available to the colony upon the rocket's return."
msgstr "Позволяет Дупликантам хранить любые <link=\"ELEMENTSLIQUID\">Жидкости</link>, которые они найдут в ходе космических экспедиций.\n\nСобранные ресурсы будут доступны колонии по возвращении шаттла."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAY.NAME"
msgid "<link=\"LIQUIDCARGOBAY\">Liquid Cargo Tank</link>"
msgstr "<link=\"LIQUIDCARGOBAY\">Грузовой бак для жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.DESC"
msgid "Holds more than a regular cargo tank."
msgstr "Вмещает больше, чем обычный грузовой бак."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.EFFECT"
msgid "Allows Duplicants to store most of the <link=\"ELEMENTSLIQUID\">Liquid</link> resources found during space missions.\n\nStored resources become available to the colony upon the rocket's return.\n\nMust be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr "Позволяет Дупликантам хранить большую часть <link=\"ELEMENTSSOLID\">Жидкостей</link>, найденных во время космических экспедиций.\n\nСобраные ресурсы станут доступными после возвращения шаттла. \n\nДолжен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYCLUSTER.NAME"
msgid "<link=\"LIQUIDCARGOBAY\">Large Liquid Cargo Tank</link>"
msgstr "<link=\"LIQUIDCARGOBAY\">Большой грузовой бак для жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.DESC"
msgid "Duplicants will fill cargo tanks with whatever resources they find during space missions."
msgstr "Дупликанты будут заполнять грузовые баки материалами, которые они найдут в ходе космических экспедиций."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.EFFECT"
msgid "Allows Duplicants to store some of the <link=\"ELEMENTSLIQUID\">Liquid</link> resources found during space missions.\n\nStored resources become available to the colony upon the rocket's return. \n\nMust be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr "Позволяет Дупликантам хранить небольшую часть <link=\"ELEMENTSLIQUID\">Жидкостей</link>, найденных во время космических экспедиций.\n\nНайденные ресурсы станут доступны, после возвращения шаттла.\n\nДолжен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCARGOBAYSMALL.NAME"
msgid "<link=\"LIQUIDCARGOBAYSMALL\">Liquid Cargo Tank</link>"
msgstr "<link=\"LIQUIDCARGOBAYSMALL\">Малый грузовой бак для жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.DESC"
msgid "A thermo aquatuner cools liquid and outputs the heat elsewhere."
msgstr "Охладитель жидкости остужает пропускаемую через него жидкость и выделяет тепло в окружающую среду."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.EFFECT"
msgid "Cools the <link=\"ELEMENTSLIQUID\">Liquid</link> piped through it, but outputs <link=\"HEAT\">Heat</link> in its immediate vicinity."
msgstr "Охлаждает пропускаемую через него по трубам <link=\"ELEMENTSLIQUID\">Жидкость</link>, но выделяет <link=\"HEAT\">Тепло</link> в непосредственной близости от себя."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDITIONER.NAME"
msgid "<link=\"LIQUIDCONDITIONER\">Thermo Aquatuner</link>"
msgstr "<link=\"LIQUIDCONDITIONER\">Охладитель жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.DESC"
msgid "Liquid pipes are used to connect the inputs and outputs of plumbed buildings."
msgstr "Водопроводные трубы используются для соединений входных и выходных отверстий построек, использующих водопровод."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.EFFECT"
msgid "Carries <link=\"ELEMENTSLIQUID\">Liquid</link> between <link=\"LIQUIDPIPING\">Outputs</link> and <link=\"LIQUIDPIPING\">Intakes</link>.\n\nCan be run through wall and floor tile."
msgstr "Транспортирует <link=\"ELEMENTSLIQUID\">Жидкость</link> между <link=\"LIQUIDPIPING\">Входными</link> и <link=\"LIQUIDPIPING\">Выходными</link> отверстиями водопровода.\n\nМожет быть проложена через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUIT.NAME"
msgid "<link=\"LIQUIDCONDUIT\">Liquid Pipe</link>"
msgstr "<link=\"LIQUIDCONDUIT\">Водопроводная труба</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.DESC"
msgid "Separate pipe systems help prevent building damage caused by mingled pipe contents."
msgstr "Отдельные системы водопровода, предотвращают получение постройками повреждений из-за некорректного содержимого."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.EFFECT"
msgid "Runs one <link=\"LIQUIDPIPING\">Liquid Pipe</link> section over another without joining them.\n\nCan be run through wall and floor tile."
msgstr "Позволяет провести одну <link=\"LIQUIDPIPING\">Водопроводную трубу</link> над другой, не соединяя их в одну систему.\n\nМожет быть проложена через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITBRIDGE.NAME"
msgid "<link=\"LIQUIDCONDUITBRIDGE\">Liquid Bridge</link>"
msgstr "<link=\"LIQUIDCONDUITBRIDGE\">Перемычка водопровода</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.DESC"
msgid "Germ sensors can help control automation behavior in the presence of germs."
msgstr "Сенсор микробов используется для автоматики поведения, в случае наличия в трубе микробов."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> based on the internal <link=\"DISEASE\">Germ</link> count of the pipe."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, в зависимости от количества <link=\"DISEASE\">Микробов</link> в трубе."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT"
msgid "Internal <link=\"DISEASE\">Germ</link> Count"
msgstr "Счетчик <link=\"DISEASE\">Микробов</link> внутри"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the number of Germs in the pipe is within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда число микробов в трубе попадает в заданный порог значений"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда число микробов в трубе находится вне заданного порога значений"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITDISEASESENSOR.NAME"
msgid "<link=\"LIQUIDCONDUITDISEASESENSOR\">Liquid Pipe Germ Sensor</link>"
msgstr "<link=\"LIQUIDCONDUITDISEASESENSOR\">Водопроводный сенсор микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.DESC"
msgid "Element sensors can be used to detect the presence of a specific liquid in a pipe."
msgstr "Сенсор элемента может быть использован для определения наличия в трубе жидкости конкретного типа."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when the selected <link=\"ELEMENTSLIQUID\">Liquid</link> is detected within a pipe."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, в случае наличия заданного типа <link=\"ELEMENTSLIQUID\">Жидкости</link> внутри трубы."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT"
msgid "Internal <link=\"ELEMENTSLIQUID\">Liquid</link> Presence"
msgstr "Наличие <link=\"ELEMENTSLIQUID\">Жидкости</link> внутри"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the configured Liquid is detected within the pipe"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, в случае, если жидкость, в трубе соответствует заданной в настройках."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, в случае, если жидкость, в трубе не соответствует заданной в настройках."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITELEMENTSENSOR.NAME"
msgid "<link=\"LIQUIDCONDUITELEMENTSENSOR\">Liquid Pipe Element Sensor</link>"
msgstr "<link=\"LIQUIDCONDUITELEMENTSENSOR\">Сенсор жидкости водопровода</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.DESC"
msgid "Overflow valves can be used to prioritize which buildings should receive precious resources first."
msgstr "Водные клапаны перенаполнения могут использоваться для приоритизации построек, которые должны получать жидкость в первую очередь."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.EFFECT"
msgid "Fills a secondary<link=\"ELEMENTSLIQUID\">Liquid</link> output only when its primary output is blocked."
msgstr "Имеет дополнительное выходное отверстие <link=\"ELEMENTSLIQUID\">Жидкости</link>, которое используется только в случае, если основное заблокировано."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITOVERFLOW.NAME"
msgid "<link=\"LIQUIDCONDUITOVERFLOW\">Liquid Overflow Valve</link>"
msgstr "<link=\"LIQUIDCONDUITOVERFLOW\">Жидкостный клапан переполнения</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.DESC"
msgid "Priority flows ensure important buildings are filled first when on a system with other buildings."
msgstr "Вспомогательный водный клапан обеспечивает заполнение важных построек первыми, когда к системе подключены несколько построек."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.EFFECT"
msgid "Diverts <link=\"ELEMENTSLIQUID\">Liquid</link> to a secondary input when its primary input overflows."
msgstr "Имеет дополнительное входное отверстие, которое будет подавать <link=\"ELEMENTSLIQUID\">Жидкости</link>, только в случае, если основное отверстие переполнено."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITPREFERENTIALFLOW.NAME"
msgid "<link=\"LIQUIDCONDUITPREFERENTIALFLOW\">Priority Liquid Flow</link>"
msgstr "<link=\"LIQUIDCONDUITPREFERENTIALFLOW\">Вспомогательный жидкостный клапан</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.DESC"
msgid "Radiant pipes pumping cold liquid can be run through hot areas to help cool them down."
msgstr "Излучающие трубы с холодной жидкостью могут проводиться через горячие зоны, для их охлаждения."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.EFFECT"
msgid "Carries <link=\"ELEMENTSLIQUID\">Liquid</link>, allowing extreme <link=\"HEAT\">Temperature</link> exchange with the surrounding environment.\n\nCan be run through wall and floor tile."
msgstr "Переносит <link=\"ELEMENTSLIQUID\">Жидкость</link>, обеспечивая значительный <link=\"HEAT\">Температурный</link> обмен.\n\nМожет быть проложена через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITRADIANT.NAME"
msgid "<link=\"LIQUIDCONDUITRADIANT\">Radiant Liquid Pipe</link>"
msgstr "<link=\"LIQUIDCONDUITRADIANT\">Излучающая водопроводная труба</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.DESC"
msgid "Thermo sensors disable buildings when their pipe contents reach a certain temperature."
msgstr "Термо-сенсор позволяет отключать постройки, если их содержимое достигает определенной температуры."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when pipe contents enter the chosen <link=\"HEAT\">Temperature</link> range."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, когда содержимое трубы входит в заданный диапазон <link=\"HEAT\">Температур</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT"
msgid "Internal <link=\"ELEMENTSLIQUID\">Liquid</link> <link=\"HEAT\">Temperature</link>"
msgstr "<link=\"HEAT\">Температура</link> <link=\"ELEMENTSLIQUID\">жидкости</link> внутри"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the contained Liquid is within the selected Temperature range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда температура жидкости внутри находится в пределах заданных значений."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда температура жидкости внутри выходит за пороги заданных значений."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCONDUITTEMPERATURESENSOR.NAME"
msgid "<link=\"LIQUIDCONDUITTEMPERATURESENSOR\">Liquid Pipe Thermo Sensor</link>"
msgstr "<link=\"LIQUIDCONDUITTEMPERATURESENSOR\">Водопроводный термо-сенсор</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.DESC"
msgid "A Duplicant can work a hydrofan to temporarily cool small areas as needed."
msgstr "Дупликант может использовать вентилятор, чтобы временно охладить небольшие области."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.EFFECT"
msgid "Dissipates a small amount of the <link=\"HEAT\">Heat</link>."
msgstr "Рассеивает небольшое количество <link=\"HEAT\">Тепла</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDCOOLEDFAN.NAME"
msgid "<link=\"LIQUIDCOOLEDFAN\">Hydrofan</link>"
msgstr "<link=\"LIQUIDCOOLEDFAN\">Вентилятор</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.DESC"
msgid "All liquids are sent into the building's output pipe, except the liquid chosen for filtering."
msgstr "Фильтры жидкостей отправляют выбранную жидкость в одну трубу, а оставшуюся смесь жидкостей в другую."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.EFFECT"
msgid "Sieves one <link=\"ELEMENTSLIQUID\">Liquid</link> out of a mix, sending it into a dedicated <link=\"LIQUIDPIPING\">Filtered Output Pipe</link>.\n\nCan only filter one liquid type at a time."
msgstr "Позволяет отделить выбранную <link=\"ELEMENTSLIQUID\">Жидкость</link> из смеси жидкостей, отправляя ее в отдельную <link=\"LIQUIDPIPING\">Водопроводную трубу</link>.\n\nОдновременно может фильтровать только один тип жидкости."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFILTER.NAME"
msgid "<link=\"LIQUIDFILTER\">Liquid Filter</link>"
msgstr "<link=\"LIQUIDFILTER\">Фильтр жидкостей</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.DESC"
msgid "Storing additional fuel increases the distance a rocket can travel before returning."
msgstr "Хранение дополнительного топлива увеличивает дистанцию, на которую может путешествовать шаттл до того, как он отправиться обратно домой."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.EFFECT"
msgid "Stores the <link=\"ELEMENTSLIQUID\">Liquid</link> fuel piped into it to supply rocket engines.\n\nThe stored fuel type is determined by the rocket engine it is built upon."
msgstr "Хранит <link=\"ELEMENTSLIQUID\">Жидкое</link> топливо, закаченное в него через трубы, для подачи двигателям шаттла.\n\nВид хранимого топлива определяет выбранный тип двигателя шаттла."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANK.NAME"
msgid "<link=\"LIQUIDFUELTANK\">Liquid Fuel Tank</link>"
msgstr "<link=\"LIQUIDFUELTANK\">Бак для жидкого топлива</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.DESC"
msgid "Storing additional fuel increases the distance a rocket can travel before returning."
msgstr "Хранение дополнительного топлива увеличивает дистанцию, на которую может путешествовать шаттл до того, как он отправиться домой."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.EFFECT"
msgid "Stores the <link=\"ELEMENTSLIQUID\">Liquid</link> fuel piped into it to supply rocket engines.\n\nThe stored fuel type is determined by the rocket engine it is built upon. \n\nMust be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr "Хранит <link=\"ELEMENTSLIQUID\">Жидкое</link> топливо, закаченное в него через трубы, для подачи двигателям шаттла.\n\nВид хранимого топлива определяет выбранный тип двигателя шаттла. \n\nДолжен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDFUELTANKCLUSTER.NAME"
msgid "<link=\"LIQUIDFUELTANKCLUSTER\">Large Liquid Fuel Tank</link>"
msgstr "Большой бак для жидкого топлива"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.DESC"
msgid "Tepidizers heat liquid which can kill waterborne germs."
msgstr "Водонагреватели нагревают жидкость, температура которой может убивать содержащиеся в ней микробы."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.EFFECT"
msgid "Warms large bodies of <link=\"ELEMENTSLIQUID\">Liquid</link>.\n\nMust be fully submerged."
msgstr "Нагревает большие объемы <link=\"ELEMENTSLIQUID\">Жидкости</link>.\n\nДолжен быть полностью погружен в воду."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDHEATER.NAME"
msgid "<link=\"LIQUIDHEATER\">Liquid Tepidizer</link>"
msgstr "<link=\"LIQUIDHEATER\">Водонагреватель</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.DESC"
msgid "Meter Valves let an exact amount of liquid pass through before shutting off."
msgstr "Дозирующие клапаны пропускают точное количество жидкости перед отключением."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.EFFECT"
msgid "Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn <link=\"ELEMENTSLIQUID\">Liquid</link> flow off when the specified amount has passed through it."
msgstr "Подключает к сети <link=\"LOGIC\">Автоматики</link>, для автоматического выключения потока <link=\"ELEMENTSLIQUID\">Жидкости</link>, когда указанное количество прошло через него."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.LOGIC_PORT_OUTPUT"
msgid "Limit Reached"
msgstr "Лимит достигнут"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.LOGIC_PORT_RESET
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.LOGIC_PORT_RESET"
msgid "Reset Meter"
msgstr "Сбросить счетчик"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.NAME"
msgid "<link=\"LIQUIDLIMITVALVE\">Liquid Meter Valve</link>"
msgstr "<link=\"LIQUIDLIMITVALVE\">Водный счетчик</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.OUTPUT_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if limit has been reached"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда лимит достигнут"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.OUTPUT_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случает отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.RESET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.RESET_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Reset the amount"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Сбросить количество"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.RESET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLIMITVALVE.RESET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Ничего"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.DESC"
msgid "Automated piping saves power and time by removing the need for Duplicant input."
msgstr "Автоматизация трубопровода экономит время и электричество, устраняя необходимость управления Дупликантом."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.EFFECT"
msgid "Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn <link=\"ELEMENTSLIQUID\">Liquid</link> flow on or off."
msgstr "Соединяет с сетью <link=\"LOGIC\">Автоматики</link> для автоматического включения и выключения потока <link=\"ELEMENTSLIQUID\">Жидкости</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT"
msgid "Open/Close"
msgstr "Открыть/Закрыть"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Allow Liquid flow"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Разрешить проход жидкости"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Prevent Liquid flow"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Запретить проход жидкости"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDLOGICVALVE.NAME"
msgid "<link=\"LIQUIDLOGICVALVE\">Liquid Shutoff</link>"
msgstr "<link=\"LIQUIDLOGICVALVE\">Водный контроллер</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.DESC"
msgid "Mini pumps are useful for moving small quantities of liquid with minimum power."
msgstr "Мини-насосы полезны для перемещения небольшого количества жидкости с минимальными затратами электричества."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.EFFECT"
msgid "Draws in a small amount of <link=\"ELEMENTSLIQUID\">Liquid</link> and runs it through <link=\"LIQUIDPIPING\">Pipes</link>.\n\nMust be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr "Втягивает небольшое количество <link=\"ELEMENTSLIQUID\">Жидкости</link> и перемещает его через <link=\"LIQUIDPIPING\">Трубы</link>.\n\nДолжен быть погружен в <link=\"ELEMENTSLIQUID\">Жидкость</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDMINIPUMP.NAME"
msgid "<link=\"LIQUIDMINIPUMP\">Mini Liquid Pump</link>"
msgstr "<link=\"LIQUIDMINIPUMP\">Водяной мини-насос</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.DESC"
msgid "Piping a pump's output to a building's intake will send liquid to that building."
msgstr "Соедините канал ввода насоса с каналом ввода постройки для отправки жидкости в эту постройку."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.EFFECT"
msgid "Draws in <link=\"ELEMENTSLIQUID\">Liquid</link> and runs it through <link=\"LIQUIDPIPING\">Pipes</link>.\n\nMust be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr "Всасывает <link=\"ELEMENTSLIQUID\">Жидкость</link> и пускает ее через подсоединенную <link=\"LIQUIDPIPING\">Водопроводную трубу</link>.\n\nДолжен быть погружен в <link=\"ELEMENTSLIQUID\">Жидкость</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMP.NAME"
msgid "<link=\"LIQUIDPUMP\">Liquid Pump</link>"
msgstr "<link=\"LIQUIDPUMP\">Водяной насос</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.DESC"
msgid "Pitcher pumps allow Duplicants to bottle and deliver liquids from place to place."
msgstr "Бутиляторы позволяют Дупликантам доставлять бутилированные жидкости от места к месту."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.EFFECT"
msgid "Manually pumps <link=\"ELEMENTSLIQUID\">Liquid</link> into bottles for transport.\n\nDuplicants can only carry liquids that are bottled."
msgstr "Бутиляторы закачивают <link=\"ELEMENTSLIQUID\">Жидкость</link> в бутылки для транспортировки.\n\nДупликанты могут переносить только бутилированные жидкости."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDPUMPINGSTATION.NAME"
msgid "<link=\"LIQUIDPUMPINGSTATION\">Pitcher Pump</link>"
msgstr "<link=\"LIQUIDPUMPINGSTATION\">Бутилятор</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.DESC"
msgid "Reservoirs cannot receive manually delivered resources."
msgstr "Резервуары не могут получать ресурсы от Дупликантов напрямую."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.EFFECT"
msgid "Stores any <link=\"ELEMENTSLIQUID\">Liquid</link> resources piped into it."
msgstr "Хранит любую <link=\"ELEMENTSLIQUID\">Жидкость</link>, закаченную в него через трубу."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDRESERVOIR.NAME"
msgid "<link=\"LIQUIDRESERVOIR\">Liquid Reservoir</link>"
msgstr "<link=\"LIQUIDRESERVOIR\">Водный резервуар</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.DESC"
msgid "Valves control the amount of liquid that moves through pipes, preventing waste."
msgstr "Клапаны контролируют объем жидкости, которая передвигается по трубам, предотвращая перерасход."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.EFFECT"
msgid "Controls the <link=\"ELEMENTSLIQUID\">Liquid</link> volume permitted through <link=\"LIQUIDPIPING\">Pipes</link>."
msgstr "Контролирует объем <link=\"ELEMENTSLIQUID\">Жидкости</link> в <link=\"LIQUIDPIPING\">Водопроводной трубе</link> для поддержания идеального давления."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVALVE.NAME"
msgid "<link=\"LIQUIDVALVE\">Liquid Valve</link>"
msgstr "<link=\"LIQUIDVALVE\">Водопроводный клапан</link>"

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.DESC"
msgid "Vents are an exit point for liquids from plumbing systems."
msgstr "Водостоки - точки выхода для жидкостей из водопровода."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.EFFECT"
msgid "Releases <link=\"ELEMENTSLIQUID\">Liquid</link> from <link=\"LIQUIDPIPING\">Liquid Pipes</link>."
msgstr "Выпускает <link=\"ELEMENTSLIQUID\">Воду</link> из <link=\"LIQUIDPIPING\">Водопроводных труб</link>."

#. STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LIQUIDVENT.NAME"
msgid "<link=\"LIQUIDVENT\">Liquid Vent</link>"
msgstr "<link=\"LIQUIDVENT\">Водосток</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.DESC"
msgid "Sends a notification when it receives a <b><style=\"logic_on\">Green Signal</style></b>."
msgstr "Отправляет уведомление, при получении <b><style=\"logic_on\">Зеленого сигнала</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.EFFECT"
msgid "Attach to sensors to send a notification when certain conditions are met.\n\nNotifications can be customized."
msgstr "Подсоедините к сенсорам, чтобы отправлять уведомление, по заданным условиям.\n\nУведомления можно настроить."

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_NAME"
msgid "INPUT"
msgstr "ВХОД"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Push notification"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Отправить уведомление"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Бездействует"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.LOGIC_PORT"
msgid "Notification"
msgstr "Уведомление"

#. STRINGS.BUILDINGS.PREFABS.LOGICALARM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICALARM.NAME"
msgid "<link=\"LOGICALARM\">Automated Notifier</link>"
msgstr "<link=\"LOGICALARM\">Автоуведомитель</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.DESC"
msgid "Starmap Location sensors can signal when a spacecraft is at a certain location"
msgstr "Сенсор звездной локации может сигнализировать, когда шаттл находится в выбранном месте."

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.EFFECT"
msgid "Send <b><style=\"logic_on\">Green Signals</style></b> at the chosen Starmap locations and <b><style=\"logic_off\">Red Signals</style></b> everywhere else."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> в выбранных местах звездной карты и <b><style=\"logic_off\">Красный сигнал</style></b> где-либо еще."

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT"
msgid "Starmap Location Sensor"
msgstr "Датчик расположения на звездной карте"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b>when a spacecraft is at the chosen Starmap locations"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда шаттл находится в выбранных точках на звездной карте"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случае отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCLUSTERLOCATIONSENSOR.NAME"
msgid "<link=\"LOGICCLUSTERLOCATIONSENSOR\">Starmap Location Sensor</link>"
msgstr "<link=\"LOGICCLUSTERLOCATIONSENSOR\">Сенсор места на звездной карте</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.DESC"
msgid "For numbers higher than ten connect multiple counters together."
msgstr "Для получения чисел больше чем 10, объедините вместе несколько счетчиков."

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.EFFECT"
msgid "Counts how many times a <b><style=\"logic_on\">Green Signal</style></b> has been received up to a chosen number.\n\nWhen the chosen number is reached it sends a <b><style=\"logic_on\">Green Signal</style></b> until it receives another <b><style=\"logic_on\">Green Signal</style></b>, when it resets automatically and begins counting again."
msgstr "Считает, сколько раз был получен <b><style=\"logic_on\">Зеленый сигнал</style></b> до заданного значения.\n\nПри достижении заданного значения отправит <b><style=\"logic_on\">Зеленый сигнал</style></b>, до тех пор пока не получит еще один <b><style=\"logic_on\">Зеленый сигнал</style></b>, чтобы сбросить счетчик и начать отсчет заново."

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Increase counter by one"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Увеличивает счетчик на 1"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Бездействует"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT"
msgid "Internal Counter Value"
msgstr "Внутреннее значение счетчика"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT_OUTPUT"
msgid "Number Reached"
msgstr "Значение достигнуто"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT_RESET
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.LOGIC_PORT_RESET"
msgid "Reset Counter"
msgstr "Сброс счетчика"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.NAME"
msgid "<link=\"LOGICCOUNTER\">Signal Counter</link>"
msgstr "<link=\"LOGICCOUNTER\">Счетчик сигналов</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.OUTPUT_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when the counter matches the selected value"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда заданное значение совпадает с текущим значением"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.OUTPUT_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случает отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.RESET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.RESET_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Reset counter"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Сброс счетчика"

#. STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.RESET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCOUNTER.RESET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Бездействует"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.COUNT_CRITTER_LABEL
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.COUNT_CRITTER_LABEL"
msgid "Count Critters"
msgstr "Счетчик существ"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.COUNT_EGG_LABEL
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.COUNT_EGG_LABEL"
msgid "Count Eggs"
msgstr "Счетчик яиц"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.DESC"
msgid "Detecting critter populations can help adjust their automated feeding and care regimens."
msgstr "Определяет размер популяции существ, позволяя автоматизировать их кормление и режим ухода."

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> based on the number of eggs and critters in a room."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b> в зависимости от количества яиц и существ в комнате."

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT"
msgid "Critter Count"
msgstr "Счетчик существ"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the number of Critters and Eggs in the Room is greater than the selected threshold."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда количество существ в комнате находится в заданном диапазоне"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда количество существ в комнате находится вне заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.NAME"
msgid "<link=\"LOGICCRITTERCOUNTSENSOR\">Critter Sensor</link>"
msgstr "<link=\"LOGICCRITTERCOUNTSENSOR\">Сенсор существ</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICCRITTERCOUNTSENSOR.SIDESCREEN_TITLE"
msgid "Critter Sensor"
msgstr "Сенсор существ"

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.DESC"
msgid "Detecting germ populations can help block off or clean up dangerous areas."
msgstr "Определяет наличие и количество микробов вокруг, помогает блокировать или очищать опасные зоны."

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> based on quantity of surrounding <link=\"DISEASE\">Germs</link>."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b> в зависимости от количества <link=\"DISEASE\">Микробов</link> в окружении."

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT"
msgid "<link=\"DISEASE\">Germ</link> Count"
msgstr "Счетчик <link=\"DISEASE\">Микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the number of Germs is within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда количество микробов входит в диапазон заданных значений"

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда количество микробов находится вне диапазона заданных значений"

#. STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDISEASESENSOR.NAME"
msgid "<link=\"LOGICDISEASESENSOR\">Germ Sensor</link>"
msgstr "<link=\"LOGICDISEASESENSOR\">Сенсор микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.DESC"
msgid "Motion sensors save power by only enabling buildings when Duplicants are nearby."
msgstr "Детектор движения позволят сохранить электричество, активируя постройки только когда рядом находятся Дупликанты."

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> based on whether a Duplicant is in the sensor's range."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, в зависимости от того, обнаружен ли Дупликант  в радиусе действия детектора."

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT"
msgid "Duplicant Motion Sensor"
msgstr "Детектор движения"

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> while a Duplicant is in the sensor's tile range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> при обнаружении Дупликанта в радиусе действия детектора"

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случае отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICDUPLICANTSENSOR.NAME"
msgid "<link=\"DUPLICANTSENSOR\">Duplicant Motion Sensor</link>"
msgstr "<link=\"DUPLICANTSENSOR\">Детектор движения</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.DESC"
msgid "These sensors can detect the presence of a specific gas and alter systems accordingly."
msgstr "Эти сенсоры могут определять наличие определенного вида газа и сигнализировать об этом системам соответствующим образом."

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when the selected <link=\"ELEMENTSGAS\">Gas</link> is detected on this sensor's tile.\n\nSends a <b><style=\"logic_off\">Red Signal</style></b> when the selected <link=\"ELEMENTSGAS\">Gas</link> is not present."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, в случае наличия определенного типа <link=\"ELEMENTSGAS\">Газа</link> в блоке, на котором расположен данный сенсор.\n\nОтправляет <b><style=\"logic_off\">Красный сигнал</style></b>, если выбранный <link=\"ELEMENTSGAS\">Газ</link> отсутствует."

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT"
msgid "Specific <link=\"ELEMENTSGAS\">Gas</link> Presence"
msgstr "Наличие определенного вида <link=\"ELEMENTSGAS\">Газа</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the selected Gas is detected"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда определено наличие заданного вида газа"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда заданный вид газа не обнаружен"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORGAS.NAME"
msgid "<link=\"LOGICELEMENTSENSORGAS\">Gas Element Sensor</link>"
msgstr "<link=\"LOGICELEMENTSENSORGAS\">Сенсор газа</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.DESC"
msgid "These sensors can detect the presence of a specific liquid and alter systems accordingly."
msgstr "Эти сенсоры могут определять наличие конкретного вида жидкости и сигнализировать об этом системам соответствующим образом."

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> when the selected <link=\"ELEMENTSLIQUID\">Liquid</link> is detected on this sensor's tile.\n\nSends a <b><style=\"logic_off\">Red Signal</style></b> when the selected <link=\"ELEMENTSLIQUID\">Liquid</link> is not present."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, в случае наличия определенного типа <link=\"ELEMENTSLIQUID\">Жидкости</link> в блоке, на котором расположен данный сенсор.\n\nОтправляет <b><style=\"logic_off\">Красный сигнал</style></b>, если выбранная <link=\"ELEMENTSLIQUID\">Жидкость</link> отсутствует."

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT"
msgid "Specific <link=\"ELEMENTSLIQUID\">Liquid</link> Presence"
msgstr "Наличие определенного вида <link=\"ELEMENTSLIQUID\">Жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if the selected Liquid is detected"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда определено наличие заданного вида жидкости"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда заданный вид жидкости не обнаружен"

#. STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICELEMENTSENSORLIQUID.NAME"
msgid "<link=\"LOGICELEMENTSENSORLIQUID\">Liquid Element Sensor</link>"
msgstr "<link=\"LOGICELEMENTSENSORLIQUID\">Сенсор жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.DESC"
msgid "This gate outputs a Green Signal when both its inputs are receiving Green Signals at the same time."
msgstr "Этот модуль отправляет зеленый сигнал, только когда оба входных сигнала одновременно получают зеленый сигнал."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.EFFECT"
msgid "Outputs a <b><style=\"logic_on\">Green Signal</style></b> when both Input A <b>AND</b> Input B are receiving <b><style=\"logic_on\">Green</style></b>.\n\nOutputs a <b><style=\"logic_off\">Red Signal</style></b> when even one Input is receiving <b><style=\"logic_off\">Red</style></b>."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда оба входных значения схемы получают <b><style=\"logic_on\">Зеленый сигнал</style></b>.\n\nОтправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда один или оба входных значения схемы получают <b><style=\"logic_off\">Красный сигнал</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.NAME"
msgid "<link=\"LOGICGATEAND\">AND Gate</link>"
msgstr "<link=\"LOGICGATEAND\">Модуль <И></link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if both Inputs are receiving <b><style=\"logic_on\">Green</style></b>"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда оба входных отверстия получают <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_INACTIVE"
msgid "Sends a <b><style=\"logic_off\">Red Signal</style></b> if any Input is receiving <b><style=\"logic_off\">Red</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда любое из входных отверстий получает <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEAND.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "Выходное отверстие"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.DESC"
msgid "This gate continues outputting a Green Signal for a short time after the gate stops receiving a Green Signal."
msgstr "Этот модуль будет отправлять зеленый сигнал короткий промежуток времени, после того как он перестанет получать зеленый сигнал."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.EFFECT"
msgid "Outputs a <b><style=\"logic_on\">Green Signal</style></b> if the Input is receiving a <b><style=\"logic_on\">Green Signal</style></b>.\n\nContinues sending a <b><style=\"logic_on\">Green Signal</style></b> for an amount of buffer time after the Input receives a <b><style=\"logic_off\">Red Signal</style></b>."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, если входное отверстие получает <b><style=\"logic_on\">Зеленый сигнал</style></b>.\n\nПродолжает отправлять <b><style=\"logic_on\">Зеленый сигнал</style></b>  небольшой промежуток времени, после того как входное значение схемы получит <b><style=\"logic_off\">Красный сигнал</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.NAME"
msgid "<link=\"LOGICGATEBUFFER\">BUFFER Gate</link>"
msgstr "<link=\"LOGICGATEBUFFER\">Модуль <БУФЕР></link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> while receiving <b><style=\"logic_on\">Green</style></b>. After receiving <b><style=\"logic_off\">Red</style></b>, will continue sending <b><style=\"logic_on\">Green</style></b> until the timer has expired"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда входное отверстие получает <b><style=\"logic_on\">Зеленый сигнал</style></b>.После получения <b><style=\"logic_off\">Красного сигнала</style></b>, продолжит отправлять <b><style=\"logic_on\">Зеленый сигнал</style></b>, пока время таймера не истечет"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>."
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда входное отверстие получает <b><style=\"logic_off\">Красный сигнал</style></b> или отсчет таймера закончен."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEBUFFER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "Выходное отверстие"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.DESC"
msgid "Signal Distributors can be used to choose which circuit should receive a given automation signal."
msgstr "Распределители сигналов используются для выбора, какая схема автоматики должна получить сигнал."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.EFFECT"
msgid "Route a single Input signal out one of four possible Outputs, based on the selection made by the Control Inputs.\n\nSend a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> to the two Control Inputs to determine which Output is selected."
msgstr "Соединить один входящий сигнал с одним из четырех возможных выходных порта, основываясь на выборе заданном контроллером.\n\nОтправляет <b><style=\"logic_on\">Зеленый</style></b> или <b><style=\"logic_off\">Красный</style></b> сигнал в 2 контроллера входа для определения одного выходного сигнала."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.NAME"
msgid "<link=\"LOGICGATEDEMULTIPLEXER\">Signal Distributor</link>"
msgstr "<link=\"LOGICGATEDEMULTIPLEXER\">Распределитель сигнала</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green</style></b> or <b><style=\"logic_off\">Red</style></b> signal to the selected output"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый</style></b> или <b><style=\"logic_off\">Красный</style></b> сигнал в выбранное выходной порт"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_INACTIVE"
msgid "Nothing"
msgstr "Ничего"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEDEMULTIPLEXER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "ВЫХОДНОЙ ПОРТ"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.DESC"
msgid "This gate only lets a Green Signal through if its Input has received a Green Signal that lasted longer than the selected filter time."
msgstr "Этот модуль пропускает зеленый сигнал, только если его входное отверстие получило зеленый сигнал, который длился дольше, чем установленное в фильтре время."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.EFFECT"
msgid "Only lets a <b><style=\"logic_on\">Green Signal</style></b> through if the Input has received a <b><style=\"logic_on\">Green Signal</style></b> for longer than the selected filter time.\n\nWill continue outputting a <b><style=\"logic_off\">Red Signal</style></b> if the <b><style=\"logic_on\">Green Signal</style></b> did not last long enough."
msgstr "Пропускает <b><style=\"logic_on\">Зеленый сигнал</style></b>, только если его входное отверстие получило <b><style=\"logic_on\">Зеленый сигнал</style></b>, который длился дольше, чем установленное в фильтре время.\n\nПродолжит отправлять <b><style=\"logic_off\">Красный сигнал</style></b>, если <b><style=\"logic_on\">Зеленый сигнал</style></b> длился недостаточно долго."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.NAME"
msgid "<link=\"LOGICGATEFILTER\">FILTER Gate</link>"
msgstr "<link=\"LOGICGATEFILTER\">Модуль <ФИЛЬТР></link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> after receiving <b><style=\"logic_on\">Green</style></b> for longer than the selected filter timer"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, после получения <b><style=\"logic_on\">Зеленого сигнала</style></b>, который длился дольше, чем установленное в фильтре время"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>."
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, если <b><style=\"logic_on\">Зеленый сигнал</style></b> длился недостаточно долго."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEFILTER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "Выходное отверстие"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.DESC"
msgid "Signal Selectors can be used to select which automation signal is relevant to pass through to a given circuit"
msgstr "Агрегатор сигналов используется для выбора, какой сигнал пропустить в заданную схему автоматики"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.EFFECT"
msgid "Select which one of four Input signals should be sent out the Output, using Control Inputs.\n\nSend a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> to the two Control Inputs to determine which Input is selected."
msgstr "Выбрать, какой из 4-х входных сигналов должен быть отправлен в выходной порт, используя контроллер входа.\n\nОтправляет <b><style=\"logic_on\">Зеленый</style></b> или <b><style=\"logic_off\">Красный</style></b> сигнал в два контроллера входа для определения выбранного сигнала."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.NAME"
msgid "<link=\"LOGICGATEMULTIPLEXER\">Signal Selector</link>"
msgstr "<link=\"LOGICGATEMULTIPLEXER\">Агрегатор сигналов</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_ACTIVE"
msgid "Receives a <b><style=\"logic_on\">Green</style></b> or <b><style=\"logic_off\">Red</style></b> signal from the selected input"
msgstr "Получает <b><style=\"logic_on\">Зеленый</style></b> или <b><style=\"logic_off\">Красный</style></b> сигнал, из выбранного входного порта"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_INACTIVE"
msgid "Nothing"
msgstr "Ничего"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEMULTIPLEXER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "ВЫХОДНОЙ ПОРТ"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.DESC"
msgid "This gate reverses automation signals, turning a Green Signal into a Red Signal and vice versa."
msgstr "Это реверсивный модуль - он обращает логику, отправляя <b><style=\"logic_on\">Зеленый сигнал</style></b> при получении <b><style=\"logic_off\">Красного сигнала</style></b> и наоборот."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.EFFECT"
msgid "Outputs a <b><style=\"logic_on\">Green Signal</style></b> if the Input is receiving a <b><style=\"logic_off\">Red Signal</style></b>.\n\nOutputs a <b><style=\"logic_off\">Red Signal</style></b> when its Input is receiving a <b><style=\"logic_on\">Green Signal</style></b>."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, если входное отверстие получило <b><style=\"logic_off\">Красный сигнал</style></b>.\n\nОтправляет <b><style=\"logic_off\">Красный сигнал</style></b>, если входное отверстие получило <b><style=\"logic_on\">Зеленый сигнал</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.NAME"
msgid "<link=\"LOGICGATENOT\">NOT Gate</link>"
msgstr "<link=\"LOGICGATENOT\">Модуль <НЕ></link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if receiving <b><style=\"logic_off\">Red</style></b>"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, при получении <b><style=\"logic_off\">Красного сигнала</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_INACTIVE"
msgid "Sends a <b><style=\"logic_off\">Red Signal</style></b> if receiving <b><style=\"logic_on\">Green</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, при получении <b><style=\"logic_on\">Зеленого сигнала</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATENOT.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "Выходное отверстие"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.DESC"
msgid "This gate outputs a Green Signal if receiving one or more Green Signals."
msgstr "Этот модуль будет отправлять зеленый сигнал, получает один или более зеленых сигналов."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.EFFECT"
msgid "Outputs a <b><style=\"logic_on\">Green Signal</style></b> if at least one of Input A <b>OR</b> Input B is receiving <b><style=\"logic_on\">Green</style></b>.\n\nOutputs a <b><style=\"logic_off\">Red Signal</style></b> when neither Input A or Input B are receiving <b><style=\"logic_on\">Green</style></b>."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, если одно <b>или</b> оба входных порта А и B получают <b><style=\"logic_on\">Зеленый сигнал</style></b>.\n\nОтправляет <b><style=\"logic_off\">Красный сигнал</style></b>, если оба входных порта получают <b><style=\"logic_off\">Красный сигнал</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.NAME"
msgid "<link=\"LOGICGATEOR\">OR Gate</link>"
msgstr "<link=\"LOGICGATEOR\">Модуль <ИЛИ></link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if any Input is receiving <b><style=\"logic_on\">Green</style></b>"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда входное отверстие А или B получает <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_INACTIVE"
msgid "Sends a <b><style=\"logic_off\">Red Signal</style></b> if both Inputs are receiving <b><style=\"logic_off\">Red</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда оба входные отверстия получают <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEOR.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "Выходное отверстие"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.DESC"
msgid "This gate outputs a Green Signal if exactly one of its Inputs is receiving a Green Signal."
msgstr "Этот модуль будет отправлять зеленый сигнал, только если один и не более входных сигналов получают зеленый сигнал."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.EFFECT"
msgid "Outputs a <b><style=\"logic_on\">Green Signal</style></b> if exactly one of its Inputs is receiving <b><style=\"logic_on\">Green</style></b>.\n\nOutputs a <b><style=\"logic_off\">Red Signal</style></b> if both or neither Inputs are receiving a <b><style=\"logic_on\">Green Signal</style></b>."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, если один и не более входных портов получают Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>.\n\nОтправляет <b><style=\"logic_off\">Красный сигнал</style></b>, если оба или ни один из входных портов получают <b><style=\"logic_on\">Зеленый сигнал</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.NAME"
msgid "<link=\"LOGICGATEXOR\">XOR Gate</link>"
msgstr "<link=\"LOGICGATEXOR\">Модуль <ИСКЛЮЧАЮЩЕЕ ИЛИ></link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if exactly one of its Inputs is receiving <b><style=\"logic_on\">Green</style></b>"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>, когда только одно из входных отверстий получает <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_INACTIVE"
msgid "Sends a <b><style=\"logic_off\">Red Signal</style></b> if both Input signals match (any color)"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда оба входных отверстия имеют одинаковый сигнал (любой цвет)"

#. STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICGATEXOR.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "Выходное отверстие"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.DESC"
msgid "The hammer makes neat sounds when it strikes buildings."
msgstr "Музыкальный молоток создает приятные звуки при ударении о постройки."

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.EFFECT"
msgid "In its default orientation, the hammer strikes the building to the left when it receives a <b><style=\"logic_on\">Green Signal</style></b>.\n\nEach building has a unique sound when struck by the hammer.\n\nThe hammer does no damage when it strikes."
msgstr "В базовой ориентации молоток ударяет постройку, находящуюся слева, при получении <b><style=\"logic_on\">Зеленого сигнала</style></b>.\n\nКаждая постройка имеет уникальный звук.\n\nМолоток не наносит урона постройкам."

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_NAME"
msgid "INPUT"
msgstr "ВХОД"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Hammer strikes once"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Ударить один раз"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Nothing"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Бездействует"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.LOGIC_PORT"
msgid "Resonating Buildings"
msgstr "Резонирует постройки"

#. STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHAMMER.NAME"
msgid "<link=\"LOGICHAMMER\">Hammer</link>"
msgstr "<link=\"LOGICHAMMER\">Музыкальный молоток</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.DESC"
msgid "Radbolt sensors can send a signal when a Radbolt passes over them."
msgstr "Сенсор радчастиц может посылать сигнал, когда перед ним проходят радчастицы."

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when Radbolts detected enters the chosen range."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый</style></b> или <b><style=\"logic_off\">Красный</style></b> сигнал, если обнаруженные радчастицы находятся в пределах заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT"
msgid "Detected Radbolts"
msgstr "Обнаружены радчастицы"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if detected Radbolts are within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, если обнаруженные радчастицы находятся в заданном диапазоне"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случае отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICHEPSENSOR.NAME"
msgid "<link=\"LOGICHEPSENSOR\">Radbolt Sensor</link>"
msgstr "<link=\"LOGICHEPSENSOR\">Сенсор радчастиц</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.DESC"
msgid "Receives automation signals from space."
msgstr "Получает сигналы автоматики из космоса."

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.EFFECT"
msgid "Receives a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> from an <link=\"LOGICINTERASTEROIDSENDER\">Automation Broadcaster</link> over vast distances in space.\n\nBoth the Automation Receiver and the Automation Broadcaster must be exposed to space to function."
msgstr "Получает <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b> от <link=\"LOGICINTERASTEROIDSENDER\">Передатчика автоматики</link> на огромных расстояниях в космосе.\n\nИ приемник, и передатчик должны находиться в открытом пространстве для работы."

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT"
msgid "Receiving Signal"
msgstr "Получение сигнала"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT_ACTIVE"
msgid "Receiving: <b><style=\"logic_on\">Green Signal</style></b>"
msgstr "Получает: <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.LOGIC_PORT_INACTIVE"
msgid "Receiving: <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Получает: <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDRECEIVER.NAME"
msgid "<link=\"LOGICINTERASTEROIDRECEIVER\">Automation Receiver</link>"
msgstr "<link=\"LOGICINTERASTEROIDRECEIVER\">Приемник автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.DEFAULTNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.DEFAULTNAME"
msgid "Unnamed Broadcaster"
msgstr "Безымянный Передатчик"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.DESC"
msgid "Sends automation signals into space."
msgstr "Отправляет сигналы автоматики в космос."

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> to an <link=\"LOGICINTERASTEROIDRECEIVER\">Automation Receiver</link> over vast distances in space.\n\nBoth the Automation Broadcaster and the Automation Receiver must be exposed to space to function."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b> <link=\"LOGICINTERASTEROIDRECEIVER\">Приемнику автоматики</link> на огромных расстояниях в космосе.\n\nИ приемник, и передатчик должны находиться в открытом пространстве для работы."

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT"
msgid "Broadcasting Signal"
msgstr "Передает сигнал"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT_ACTIVE"
msgid "Broadcasting: <b><style=\"logic_on\">Green Signal</style></b>"
msgstr "Передает: <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.LOGIC_PORT_INACTIVE"
msgid "Broadcasting: <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Передает: <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICINTERASTEROIDSENDER.NAME"
msgid "<link=\"LOGICINTERASTEROIDSENDER\">Automation Broadcaster</link>"
msgstr "<link=\"LOGICINTERASTEROIDSENDER\">Передатчик автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.DESC"
msgid "Light sensors can tell surface bunker doors above solar panels to open or close based on solar light levels."
msgstr "Датчики света могут управлять дверями бункера, расположенными над солнечными панелями, открывая или закрывая их в зависимости от интенсивности солнечного света."

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when ambient <link=\"LIGHT\">Brightness</link> enters the chosen range."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, когда окружающая <link=\"LIGHT\">Яркость</link> попадает в выбранный диапазон."

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT"
msgid "Ambient <link=\"LIGHT\">Brightness</link>"
msgstr "Окружающая <link=\"LIGHT\">Яркость</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if ambient <link=\"LIGHT\">Brightness</link> is within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, если окружающая <link=\"LIGHT\">Яркость</link> находится в выбранном диапазоне"

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случае отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICLIGHTSENSOR.NAME"
msgid "<link=\"LOGICLIGHTSENSOR\">Light Sensor</link>"
msgstr "<link=\"LOGICLIGHTSENSOR\">Датчик света</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.DESC"
msgid "A Memory stores a Green Signal received in the Set Port (S) until the Reset Port (R) receives a Green Signal."
msgstr "Память хранит зеленый сигнал, полученный через порт записи (S), до тех порт пока порт сброса (R) не получит зеленый сигнал."

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.EFFECT"
msgid "Contains an internal Memory, and will output whatever signal is stored in that Memory.\n\nSignals sent to the Inputs <i>only</i> affect the Memory, and do not pass through to the Output. \n\nSending a <b><style=\"logic_on\">Green Signal</style></b> to the Set Port (S) will set the memory to <b><style=\"logic_on\">Green</style></b>. \n\nSending a <b><style=\"logic_on\">Green Signal</style></b> to the Reset Port (R) will reset the memory back to <b><style=\"logic_off\">Red</style></b>."
msgstr "Содержит блок внутренней памяти и будет отправлять сохраненный в ней сигнал.\n\nСигналы, отправляемые из входных отверстий влияют <i>только</i> на память и не проходят через выходные отверстия. \nОтправка <b><style=\"logic_on\">Зеленого сигнала</style></b> через порт записи (S) установит память в <b><style=\"logic_on\">Зеленый сигнал</style></b>.\nОтправка <b><style=\"logic_on\">Зеленого сигнала</style></b> через порт сброса (R), сбросит память обратно в <b><style=\"logic_off\">Красный сигнал</style></b>."

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.NAME"
msgid "<link=\"LOGICMEMORY\">Memory Toggle</link>"
msgstr "<link=\"LOGICMEMORY\">Модуль <ПАМЯТЬ></link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT"
msgid "MEMORY OUTPUT"
msgstr "Выходное отверстие"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT_ACTIVE"
msgid "Outputs a <b><style=\"logic_on\">Green Signal</style></b> if the internal Memory is set to <b><style=\"logic_on\">Green</style></b>"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда порт записи установлен в <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.READ_PORT_INACTIVE"
msgid "Outputs a <b><style=\"logic_off\">Red Signal</style></b> if the internal Memory is set to <b><style=\"logic_off\">Red</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда порт записи установлен в <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT"
msgid "RESET PORT (R)"
msgstr "Порт сброса (R)"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Reset the internal Memory to <b><style=\"logic_off\">Red</style></b>"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>: Сбрасывает внутреннюю память в <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.RESET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: No effect"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>: Без эффекта"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT"
msgid "SET PORT (S)"
msgstr "Порта записи (S)"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Set the internal Memory to <b><style=\"logic_on\">Green</style></b>"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Устанавливает внутреннюю память в <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.SET_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: No effect"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Без эффекта"

#. STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.STATUS_ITEM_VALUE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICMEMORY.STATUS_ITEM_VALUE"
msgid "Current Value: {0}"
msgstr "Текущее значение: {0}"

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.DESC"
msgid "Automated systems save power and time by removing the need for Duplicant input."
msgstr "Системы автоматики позволяют экономить электричество и время, устраняя необходимость участия Дупликанта."

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.EFFECT"
msgid "Connects to an <link=\"LOGIC\">Automation</link> grid to automatically turn <link=\"POWER\">Power</link> on or off.\n\nDoes not affect circuitry preceding the switch."
msgstr "Соединяет с сетью <link=\"LOGIC\">Автоматики</link> для автоматического включения или выключения <link=\"POWER\">Электричества</link>.\n\nНе влияет на часть сети, расположенную до переключателя."

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT"
msgid "Kill Power"
msgstr "Отключение питания"

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Allow <style=\"KKeyword\">Power</style> through connected circuits"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Позволяет электричеству проходить через провод"

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Prevent <style=\"KKeyword\">Power</style> from flowing through connected circuits"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Запрещает электричеству проходить через провод"

#. STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPOWERRELAY.NAME"
msgid "<link=\"LOGICPOWERRELAY\">Power Shutoff</link>"
msgstr "<link=\"LOGICPOWERRELAY\">Электро контроллер</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.DESC"
msgid "Atmo sensors can be used to prevent excess oxygen production and overpressurization."
msgstr "Атмосферные сенсоры могут быть использованы для предотвращения производства излишнего кислорода и, как следствие, избыточного давления."

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when <link=\"ELEMENTSGAS\">Gas</link> pressure enters the chosen range."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, в зависимости от того, удовлетворяет ли атмосферное давление <link=\"ELEMENTSGAS\">Газа</link> установленному порогу."

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT"
msgid "<link=\"ELEMENTSGAS\">Gas</link> Pressure"
msgstr "Давление <link=\"ELEMENTSGAS\">Газа</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if Gas pressure is within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда давление газа, находится в пределах заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда давление газа, находится вне заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORGAS.NAME"
msgid "<link=\"LOGICPRESSURESENSORGAS\">Atmo Sensor</link>"
msgstr "<link=\"LOGICPRESSURESENSORGAS\">Атмосферный сенсор</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.DESC"
msgid "A hydro sensor can tell a pump to refill its basin as soon as it contains too little liquid."
msgstr "Водные сенсоры могут передавать сигнал насосу, чтобы пополнить резервуар, когда в нем осталось слишком мало жидкости."

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when <link=\"ELEMENTSLIQUID\">Liquid</link> pressure enters the chosen range.\n\nMust be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, в зависимости от того, удовлетворяет ли давление <link=\"ELEMENTSLIQUID\">Жидкости</link> установленному порогу значений.\n\nДолжен быть погружен в <link=\"ELEMENTSLIQUID\">Жидкость</link>."

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT"
msgid "<link=\"ELEMENTSLIQUID\">Liquid</link> Pressure"
msgstr "Давление <link=\"ELEMENTSLIQUID\">Жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if Liquid pressure is within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда давление находится в пределах заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда давление находится вне заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICPRESSURESENSORLIQUID.NAME"
msgid "<link=\"LOGICPRESSURESENSORLIQUID\">Hydro Sensor</link>"
msgstr "<link=\"LOGICPRESSURESENSORLIQUID\">Водный сенсор</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.DESC"
msgid "Radiation sensors can disable buildings when they detect dangerous levels of radiation."
msgstr "Сенсор радиации может выключить постройки при обнаружении опасного уровня радиации."

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when ambient <link=\"RADIATION\">Radiation</link> enters the chosen range."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый</style></b> или <b><style=\"logic_off\">Красный</style></b> сигнал, если окружающая <link=\"RADIATION\">Радиация</link> находятся в пределах заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT"
msgid "Ambient <link=\"RADIATION\">Radiation</link>"
msgstr "Окружающая <link=\"RADIATION\">Радиация</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if ambient <link=\"RADIATION\">Radiation</link> is within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, если окружающая <link=\"RADIATION\">Радиация</link> находятся в заданном диапазоне"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случае отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRADIATIONSENSOR.NAME"
msgid "<link=\"LOGICRADIATIONSENSOR\">Radiation Sensor</link>"
msgstr "<link=\"LOGICRADIATIONSENSOR\">Радиационный сенсор</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.DESC"
msgid "Logic ribbons use significantly less space to carry multiple automation signals."
msgstr "Логические ленты занимают намного меньше пространства и способны переносить до 4х сигналов."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.EFFECT"
msgid "A 4-Bit <link=\"LOGICWIRE\">Automation Wire</link> which can carry up to four automation signals.\n\nUse a <link=\"LOGICRIBBONWRITER\">Ribbon Writer</link> to output to multiple Bits, and a <link=\"LOGICRIBBONREADER\">Ribbon Reader</link> to input from multiple Bits."
msgstr "4-х битный <link=\"LOGICWIRE\">Провод автоматики</link>, который может передавать до 4-х сигналов.\n\nИспользуйте <link=\"LOGICRIBBONWRITER\">Ленточный ввод</link>, чтобы вывести сигнал в несколько бит и <link=\"LOGICRIBBONREADER\">Ленточный вывод</link>, чтобы ввести сигнал из нескольких бит."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBON.NAME"
msgid "<link=\"LOGICRIBBON\">Automation Ribbon</link>"
msgstr "<link=\"LOGICRIBBON\">Лента автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.DESC"
msgid "Wire bridges allow multiple automation grids to exist in a small area without connecting."
msgstr "ленточный Провод-мост автоматики позволяет нескольким ленточным цепям автоматики проходить через одно и тоже пространство, не соединяясь."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.EFFECT"
msgid "Runs one <link=\"LOGICRIBBON\">Automation Ribbon</link> section over another without joining them.\n\nCan be run through wall and floor tile."
msgstr "Проводит <link=\"LOGICRIBBON\">Ленточный провод-мост</link> автоматики над другим без их соединения.\n\nМожет быть проложен через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT"
msgid "Transmit Signal"
msgstr "Передатчик сигнала"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Pass through the <b><style=\"logic_on\">Green Signal</style></b>"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: проходит через <b><style=\"logic_on\">Зеленый сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Pass through the <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: проходит через <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONBRIDGE.NAME"
msgid "<link=\"LOGICRIBBONBRIDGE\">Automation Ribbon Bridge</link>"
msgstr "<link=\"LOGICRIBBONBRIDGE\">Ленточный провод-мост</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.DESC"
msgid "Inputs the signal from a single Bit in an <link=\"LOGICRIBBON\">Automation Ribbon</link> into an <link=\"LOGICWIRE\">Automation Wire</link>."
msgstr "Переводит сигнал из одного бита <link=\"LOGICRIBBON\">Ленты автоматики</link> в <link=\"LOGICWIRE\">провод автоматики</link>."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.EFFECT"
msgid "Reads a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> from the specified Bit of an <link=\"LOGICRIBBON\">Automation Ribbon</link> onto an <link=\"LOGICWIRE\">Automation Wire</link>."
msgstr "Читает  <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b> из выбранного бита <link=\"LOGICRIBBON\">Ленты автоматики</link> и передает его в <link=\"LOGICWIRE\">провод автоматики</link>."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_NAME"
msgid "RIBBON INPUT"
msgstr "ВХОД"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Reads a <b><style=\"logic_on\">Green Signal</style></b> from selected Bit"
msgstr "<b><style=\"logic_on\">Зеленый Сигнал</style></b>: Получает <b><style=\"logic_on\">Зеленый сигнал</style></b> из выбранного бита"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Reads a <b><style=\"logic_off\">Red Signal</style></b> from selected Bit"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Получает <b><style=\"logic_off\">Красный сигнал</style></b> из выбранного бита"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.LOGIC_PORT"
msgid "4-Bit Input"
msgstr "4-х битный вход"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.LOGIC_PORT_OUTPUT"
msgid "Bit Reading"
msgstr "Чтение бита"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.NAME"
msgid "<link=\"LOGICRIBBONREADER\">Ribbon Reader</link>"
msgstr "<link=\"LOGICRIBBONREADER\">Ленточный вывод</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_NAME"
msgid "OUTPUT"
msgstr "ВЫХОД"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Sends a <b><style=\"logic_on\">Green Signal</style></b> to attached <link=\"LOGICWIRE\">Automation Wire</link>"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> в подключенный <link=\"LOGICWIRE\">Провод автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONREADER.OUTPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Sends a <b><style=\"logic_off\">Red Signal</style></b> to attached <link=\"LOGICWIRE\">Automation Wire</link>"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Отправляет <b><style=\"logic_off\">Красный сигнал</style></b> в подключенный <link=\"LOGICWIRE\">Провод автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.DESC"
msgid "Translates the signal from an <link=\"LOGICWIRE\">Automation Wire</link> to a single Bit in an <link=\"LOGICRIBBON\">Automation Ribbon</link>"
msgstr "Переводит сигнал из <link=\"LOGICWIRE\">Провода автоматики</link> в единичный бит <link=\"LOGICRIBBON\">Ленты автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.EFFECT"
msgid "Writes a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> to the specified Bit of an <link=\"LOGICRIBBON\">Automation Ribbon</link>\n\n<link=\"LOGICRIBBON\">Automation Ribbon</link> must be used as the output wire to avoid overloading."
msgstr "Записывает <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b> в выбранный бит <link=\"LOGICRIBBON\">Ленты автоматики</link>\n\n<link=\"LOGICRIBBON\">Лента автоматики</link> должна быть использована как выходное отверстие провода чтобы избежать перегрузки."

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_NAME"
msgid "INPUT"
msgstr "ВХОД"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Receives <b><style=\"logic_on\">Green Signal</style></b> to be written to selected Bit"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Получает <b><style=\"logic_on\">Зеленый сигнал</style></b> для записи в выбранный бит"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Receives <b><style=\"logic_off\">Red Signal</style></b> to to be written selected Bit"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Получает <b><style=\"logic_off\">Красный сигнал</style></b> для записи в выбранный бит"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.LOGIC_PORT"
msgid "1-Bit Input"
msgstr "1-битный вход"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.LOGIC_PORT_OUTPUT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.LOGIC_PORT_OUTPUT"
msgid "Bit Writing"
msgstr "Запись бита"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.NAME"
msgid "<link=\"LOGICRIBBONWRITER\">Ribbon Writer</link>"
msgstr "<link=\"LOGICRIBBONWRITER\">Ленточный ввод</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_NAME"
msgid "RIBBON OUTPUT"
msgstr "ЛЕНТОЧНЫЙ ВЫХОД"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Writes a <b><style=\"logic_on\">Green Signal</style></b> to selected Bit of an <link=\"LOGICRIBBON\">Automation Ribbon</link>"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: записывает <b><style=\"logic_on\">Зеленый сигнал</style></b> в выбранный бит <link=\"LOGICRIBBON\">Ленты автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICRIBBONWRITER.OUTPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Writes a <b><style=\"logic_off\">Red Signal</style></b> to selected Bit of an <link=\"LOGICRIBBON\">Automation Ribbon</link>"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: записывает <b><style=\"logic_off\">Красный сигнал</style></b> в выбранный бит <link=\"LOGICRIBBON\">Ленты автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.DESC"
msgid "Signal switches don't turn grids on and off like power switches, but add an extra signal."
msgstr "Переключатель сигнала не выключает цепи, в отличии от рубильника, но добавляет дополнительный сигнал-условие для активации."

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> on an <link=\"LOGIC\">Automation</link> grid."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или<b><style=\"logic_off\">Красный сигнал</style></b> для цепи <link=\"LOGIC\">Автоматики</link>."

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT"
msgid "Signal Toggle"
msgstr "Переключатель сигнала"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if toggled ON"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда включен"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.LOGIC_PORT_INACTIVE"
msgid "Sends a <b><style=\"logic_off\">Red Signal</style></b> if toggled OFF"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда выключен"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.NAME"
msgid "<link=\"LOGICSWITCH\">Signal Switch</link>"
msgstr "<link=\"LOGICSWITCH\">Переключатель сигнала</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICSWITCH.SIDESCREEN_TITLE"
msgid "Signal Switch"
msgstr "Переключатель сигнала"

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.DESC"
msgid "Thermo sensors can disable buildings when they approach dangerous temperatures."
msgstr "Логический сенсор температуры может автоматически отключать постройки, когда температура окружающей среды выходит за порог установленного диапазона."

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when ambient <link=\"HEAT\">Temperature</link> enters the chosen range."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, когда окружающая <link=\"HEAT\">Температура</link> удовлетворяет установленному порогу значений."

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT"
msgid "Ambient <link=\"HEAT\">Temperature</link>"
msgstr "Окружающая <link=\"HEAT\">Температура</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if ambient <link=\"HEAT\">Temperature</link> is within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда окружающая температура находится в заданном диапазоне"

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>, когда окружающая температура находится вне заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTEMPERATURESENSOR.NAME"
msgid "<link=\"LOGICTEMPERATURESENSOR\">Thermo Sensor</link>"
msgstr "<link=\"LOGICTEMPERATURESENSOR\">Термо-сенсор</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.DESC"
msgid "Cycle sensors ensure systems always turn on at the same time, day or night, every cycle."
msgstr "Сенсоры цикла позволяют гарантировать, что системы будут оставаться включенными в одно и тоже время дня или ночи, каждый цикл."

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.EFFECT"
msgid "Sets an automatic <b><style=\"logic_on\">Green Signal</style></b> and <b><style=\"logic_off\">Red Signal</style></b> schedule within one day-night cycle."
msgstr "Устанавливает таймер для автоматизации переключения сети на <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, используя заданное расписание."

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT"
msgid "Cycle Time"
msgstr "Время цикла"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if current time is within the selected <b><style=\"logic_on\">Green</style></b> range"
msgstr "Отправляет сигнал <b><style=\"logic_on\">Зеленый сигнал</style></b>, когда текущее время находится в заданном диапазоне"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет сигнал <b><style=\"logic_off\">Красный сигнал</style></b>, когда текущее время находится вне заданного диапазона"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMEOFDAYSENSOR.NAME"
msgid "<link=\"LOGICTIMEOFDAYSENSOR\">Cycle Sensor</link>"
msgstr "<link=\"LOGICTIMEOFDAYSENSOR\">Сенсор цикла</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.DESC"
msgid "Timer sensors create automation schedules for very short or very long periods of time."
msgstr "Сенсоры времени позволяют создавать авто-расписания с очень коротким или очень длинным периодом времени."

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.EFFECT"
msgid "Creates a timer to send <b><style=\"logic_on\">Green Signals</style></b> and <b><style=\"logic_off\">Red Signals</style></b> for specific amounts of time."
msgstr "Создает таймер для отправки <b><style=\"logic_on\">Зеленых сигналов</style></b> и <b><style=\"logic_off\">Красных сигналов</style></b> в течение заданного промежутка времени."

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT"
msgid "Timer Schedule"
msgstr "Таймер расписания"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> for the selected amount of Green time"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> в течение заданного промежутка времени"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.LOGIC_PORT_INACTIVE"
msgid "Then, sends a <b><style=\"logic_off\">Red Signal</style></b> for the selected amount of Red time"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b> в течение заданного промежутка времени"

#. STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICTIMERSENSOR.NAME"
msgid "<link=\"LOGICTIMERSENSOR\">Timer Sensor</link>"
msgstr "<link=\"LOGICTIMERSENSOR\">Сенсор времени</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.DESC"
msgid "Wattage sensors can send a signal when a building has switched on or off."
msgstr "Сенсоры тока могут отправлять сигнал, когда постройка включена или выключена."

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.EFFECT"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> or a <b><style=\"logic_off\">Red Signal</style></b> when <link=\"POWER\">Wattage</link> consumed enters the chosen range."
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b> или <b><style=\"logic_off\">Красный сигнал</style></b>, когда потребляемое <link=\"POWER\">Электричество</link> входит в заданный диапазон."

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT"
msgid "Consumed <link=\"POWER\">Wattage</link>"
msgstr "Потреблено <link=\"POWER\">Электричества</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT_ACTIVE"
msgid "Sends a <b><style=\"logic_on\">Green Signal</style></b> if current <link=\"POWER\">Wattage</link> is within the selected range"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, если текущее значение <link=\"POWER\">Электричества</link> в заданном диапазоне"

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.LOGIC_PORT_INACTIVE"
msgid "Otherwise, sends a <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "В противном случае отправляет <b><style=\"logic_off\">Красный сигнал</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWATTAGESENSOR.NAME"
msgid "<link=\"LOGICWATTSENSOR\">Wattage Sensor</link>"
msgstr "<link=\"LOGICWATTSENSOR\">Сенсор электричества</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIRE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIRE.DESC"
msgid "Automation wire is used to connect building ports to automation gates."
msgstr "Провод автоматики используется для соединения портов построек с входными значениями в цепи автоматики."

#. STRINGS.BUILDINGS.PREFABS.LOGICWIRE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIRE.EFFECT"
msgid "Connects buildings to <link=\"LOGIC\">Sensors</link>.\n\nCan be run through wall and floor tile."
msgstr "Соединяет постройки, предусматривающие подключение <link=\"LOGIC\">Модулей автоматики</link>.\n\nМожет быть проложен через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.LOGICWIRE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIRE.NAME"
msgid "<link=\"LOGICWIRE\">Automation Wire</link>"
msgstr "<link=\"LOGICWIRE\">Провод автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.DESC"
msgid "Wire bridges allow multiple automation grids to exist in a small area without connecting."
msgstr "Провод-мост автоматики позволяет нескольким цепям автоматики проходить через одно и тоже пространство, не соединяясь."

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.EFFECT"
msgid "Runs one <link=\"LOGICWIRE\">Automation Wire</link> section over another without joining them.\n\nCan be run through wall and floor tile."
msgstr "Проводит <link=\"LOGICWIRE\">провод-мост</link> автоматики над другим без их соединения.\n\nМожет быть проложен через блоки пола и стен."

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT"
msgid "Transmit Signal"
msgstr "Передатчик сигнала"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Pass through the <b><style=\"logic_on\">Green Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_on\">Зеленый сигнал</style></b>, при получении <b><style=\"logic_on\">Зеленого сигнала</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Pass through the <b><style=\"logic_off\">Red Signal</style></b>"
msgstr "Отправляет <b><style=\"logic_off\">Красный сигнал</style></b>: при получении <b><style=\"logic_off\">Красного сигнала</style></b>"

#. STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LOGICWIREBRIDGE.NAME"
msgid "<link=\"LOGICWIREBRIDGE\">Automation Wire Bridge</link>"
msgstr "<link=\"LOGICWIREBRIDGE\">Провод-мост автоматики</link>"

#. STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.DESC"
msgid "There's nothing quite like receiving homemade gifts in the mail."
msgstr "Нет ничего лучше, чем получать подарки из дома по почте."

#. STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.EFFECT"
msgid "Displays a single edible object."
msgstr "Отображает один съедобный предмет."

#. STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMAILBOX.NAME"
msgid "Mailbox"
msgstr "Почтовый ящик"

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.DESC"
msgid "Its occupant has been alone for so long, he's forgotten what friendship feels like."
msgstr "Его обитатель был один так долго, что забыл, что такое дружба."

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.EFFECT"
msgid "A large transport unit from the facility's sub-sub-basement.\n\nIt has been modified into a crude yet functional temporary shelter."
msgstr "Большой транспортный блок из под-подвального помещения.\n\nОн был модифицирован в грубое, но функциональное временное укрытие."

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE.NAME"
msgid "<link=\"LONELYMINIONHOUSE\">Gravitas Shipping Container</link>"
msgstr "<link=\"LONELYMINIONHOUSE\">Контейнер Гравитас</link>"

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.DESC"
msgid "Someone lived inside it for a while."
msgstr "Кто-то жил внутри этого контейнера какое-то время."

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.EFFECT"
msgid "A super-spacious container for the <link=\"ELEMENTSSOLID\">Solid Materials</link> of your choosing."
msgstr "Супер-просторный контейнер для <link=\"ELEMENTSSOLID\">Твердотелых материалов</link> на ваш выбор."

#. STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LONELYMINIONHOUSE_COMPLETE.NAME"
msgid "<link=\"LONELYMINIONHOUSECOMPLETE\">Gravitas Shipping Container</link>"
msgstr "<link=\"LONELYMINIONHOUSECOMPLETE\">Контейнер Гравитас</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.DESC"
msgid "Duplicants prefer comfy beds to cots and wake up more rested after sleeping in them."
msgstr "Дупликанты предпочитают удобные кровати койкам и восстанавливают больше выносливости спят в них."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.EFFECT"
msgid "Provides a sleeping area for one Duplicant and restores additional stamina.\n\nDuplicants will automatically sleep in their assigned beds at night."
msgstr "Предоставляет место для сна одного Дупликанта и восстанавливает больше выносливости.\n\nС наступлением ночи Дупликанты самостоятельно отправятся спать в назначенную им кровать."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOAT.DESC"
msgid "Ahoy! Set sail for zzzzz's."
msgstr "Ахо! В путь к снам."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOAT.NAME"
msgid "<link=\"LUXURYBED\">Dreamboat Bed</link>"
msgstr "<link=\"LUXURYBED\">Кровать-мечта</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOUNCY_BED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOUNCY_BED.DESC"
msgid "An inflatable party prop makes a surprisingly good bed."
msgstr "Надувной атрибут вечеринки оказывался отличной кроватью."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOUNCY_BED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.BOUNCY_BED.NAME"
msgid "<link=\"LUXURYBED\">Bouncy Castle Bed</link>"
msgstr "<link=\"LUXURYBED\">Кровать-батут</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.DEFAULT_LUXURYBED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.DEFAULT_LUXURYBED.DESC"
msgid "Much comfier than a cot."
msgstr "Гораздо удобнее, чем раскладушка."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.DEFAULT_LUXURYBED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.DEFAULT_LUXURYBED.NAME"
msgid "<link=\"LUXURYBED\">Comfy Bed</link>"
msgstr "<link=\"LUXURYBED\">Удобная кровать</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GRANDPRIX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GRANDPRIX.DESC"
msgid "Where every Duplicant wakes up a winner."
msgstr "Где каждый Дупликант просыпается победителем."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GRANDPRIX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GRANDPRIX.NAME"
msgid "<link=\"LUXURYBED\">Grand Prix Bed</link>"
msgstr "<link=\"LUXURYBED\">Кровать Гран-при</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GREEN_MUSH.DESC"
msgid "The mattress is so soft, it's almost impossible to climb out of."
msgstr "Матрас настолько мягкий, что выбраться из него почти невозможно."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"LUXURYBED\">Comfy Mush Bed</link>"
msgstr "<link=\"LUXURYBED\">Мягкая кровать</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.HAND.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.HAND.DESC"
msgid "It's so nice to be held."
msgstr "Так приятно быть в обьятиях."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.HAND.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.HAND.NAME"
msgid "<link=\"LUXURYBED\">Cradled Bed</link>"
msgstr "<link=\"LUXURYBED\">Уютное грездышко</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PUFT_BED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PUFT_BED.DESC"
msgid "A comfy, if somewhat 'fragrant', place to sleep."
msgstr "Удобное, хотя и немного 'ароматное', место для сна."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PUFT_BED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PUFT_BED.NAME"
msgid "<link=\"LUXURYBED\">Puft Bed</link>"
msgstr "<link=\"LUXURYBED\">Кровать Пуфа</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PURPLE_BRAINFAT.DESC"
msgid "A soft landing spot for swooners."
msgstr "Мягкое место для отдыха."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"LUXURYBED\">Comfy Fainting Bed</link>"
msgstr "<link=\"LUXURYBED\">Кровать для забвения</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.RED_ROSE.DESC"
msgid "A pink-hued bed for rosy dreams."
msgstr "Розовая кровать для сладких снов."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.RED_ROSE.NAME"
msgid "<link=\"LUXURYBED\">Comfy Puce Bed</link>"
msgstr "<link=\"LUXURYBED\">Пушистая кровать-уют</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.ROCKET_BED.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.ROCKET_BED.DESC"
msgid "Launches sleepy Duplicants into a deep-space slumber."
msgstr "Запускает сонных Дупликантов в глубокий космос."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.ROCKET_BED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.ROCKET_BED.NAME"
msgid "<link=\"LUXURYBED\">S.S. Napmaster Bed</link>"
msgstr "<link=\"LUXURYBED\">Ковчег Снов</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.RUBIKS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.RUBIKS.DESC"
msgid "A little pattern recognition at bedtime soothes the mind."
msgstr "Небольшая игра с узорами перед сном успокаивает ум."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.RUBIKS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.RUBIKS.NAME"
msgid "<link=\"LUXURYBED\">Puzzle Cube Bed</link>"
msgstr "<link=\"LUXURYBED\">Кровать-головоломка</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.YELLOW_TARTAR.DESC"
msgid "When life is icky, bed rest is the only answer."
msgstr "Когда жизнь неприятна, отдых в кровати — единственное решение."

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"LUXURYBED\">Comfy Ick Bed</link>"
msgstr "<link=\"LUXURYBED\">Убежище от непогоды</link>"

#. STRINGS.BUILDINGS.PREFABS.LUXURYBED.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.LUXURYBED.NAME"
msgid "<link=\"LUXURYBED\">Comfy Bed</link>"
msgstr "<link=\"LUXURYBED\">Удобная кровать</link>"

#. STRINGS.BUILDINGS.PREFABS.MACHINESHOP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MACHINESHOP.DESC"
msgid "Duplicants will only improve the efficiency of buildings in the same room as this station."
msgstr "Дупликанты будут улучшать эффективность построек, находящихся только в одной комнате с данной станцией."

#. STRINGS.BUILDINGS.PREFABS.MACHINESHOP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MACHINESHOP.EFFECT"
msgid "Allows the assigned <link=\"MACHINETECHNICIAN\">Engineer</link> to improve building production efficiency.\n\nThis building is a necessary component of the Machine Shop room."
msgstr "Позволяет назначенному <link=\"MACHINETECHNICIAN\">Инженеру</link> улучшать эффективность работы построек.\n\nЭта постройка - необходимый компонент комнаты \"Машинное отделение\"."

#. STRINGS.BUILDINGS.PREFABS.MACHINESHOP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MACHINESHOP.NAME"
msgid "<link=\"MACHINESHOP\">Mechanics Station</link>"
msgstr "<link=\"MACHINESHOP\">Машинная станция</link>"

#. STRINGS.BUILDINGS.PREFABS.MANUALGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALGENERATOR.DESC"
msgid "Watching Duplicants run on it is adorable... the electrical power is just an added bonus."
msgstr "Наблюдать, как Дупликанты бегают на нем восхитительно... электричество лишь дополнительный бонус."

#. STRINGS.BUILDINGS.PREFABS.MANUALGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALGENERATOR.EFFECT"
msgid "Converts manual labor into electrical <link=\"POWER\">Power</link>."
msgstr "Преобразует ручной труд в <link=\"POWER\">Электричество</link>."

#. STRINGS.BUILDINGS.PREFABS.MANUALGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALGENERATOR.NAME"
msgid "<link=\"MANUALGENERATOR\">Manual Generator</link>"
msgstr "<link=\"MANUALGENERATOR\">Ручной генератор</link>"

#. STRINGS.BUILDINGS.PREFABS.MANUALHIGHENERGYPARTICLESPAWNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALHIGHENERGYPARTICLESPAWNER.DESC"
msgid "Radbolts are necessary for producing Materials Science research."
msgstr "Радчастицы необходимы для производства исследования материй."

#. STRINGS.BUILDINGS.PREFABS.MANUALHIGHENERGYPARTICLESPAWNER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALHIGHENERGYPARTICLESPAWNER.EFFECT"
msgid "Refines radioactive ores to generate Radbolts.\n\nEmits generated Radbolts in the direction of your choosing."
msgstr "Перерабатывает радиоактивные руды, чтобы генерировать радчастицы.\n\nВыделяет сгенерированные радчастицы в выбранном направлении."

#. STRINGS.BUILDINGS.PREFABS.MANUALHIGHENERGYPARTICLESPAWNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALHIGHENERGYPARTICLESPAWNER.NAME"
msgid "<link=\"MANUALHIGHENERGYPARTICLESPAWNER\">Manual Radbolt Generator</link>"
msgstr "<link=\"MANUALHIGHENERGYPARTICLESPAWNER\">Ручной генератор радчастиц</link>"

#. STRINGS.BUILDINGS.PREFABS.MANUALHIGHENERGYPARTICLESPAWNER.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALHIGHENERGYPARTICLESPAWNER.RECIPE_DESCRIPTION"
msgid "Creates <link=\"RADIATION\">Radbolts</link> by processing {0}. Also creates {1} as a byproduct."
msgstr "Создает <link=\"RADIATION\">Радчастицы</link> путем обработки {0}. Также создает {1} как побочный продукт."

#. STRINGS.BUILDINGS.PREFABS.MANUALPRESSUREDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALPRESSUREDOOR.DESC"
msgid "Airlocks can quarter off dangerous areas and prevent gases from seeping into the colony."
msgstr "Ручной шлюз может отделить колонию от опасных зон и предотвратить просачивание газов в колонию."

#. STRINGS.BUILDINGS.PREFABS.MANUALPRESSUREDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALPRESSUREDOOR.EFFECT"
msgid "Blocks <link=\"ELEMENTSLIQUID\">Liquid</link> and <link=\"ELEMENTSGAS\">Gas</link> flow, maintaining pressure between areas.\n\nWild <link=\"CREATURES\">Critters</link> cannot pass through doors."
msgstr "Блокирует потоки <link=\"ELEMENTSLIQUID\">Жидкости</link> и <link=\"ELEMENTSGAS\">Газа</link>, поддерживая давление между зонами.\n\nДикие <link=\"CREATURES\">существа</link> не могут проходить через двери."

#. STRINGS.BUILDINGS.PREFABS.MANUALPRESSUREDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MANUALPRESSUREDOOR.NAME"
msgid "<link=\"MANUALPRESSUREDOOR\">Manual Airlock</link>"
msgstr "<link=\"MANUALPRESSUREDOOR\">Ручной шлюз</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.AVERAGEQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.AVERAGEQUALITYNAME"
msgid "Mediocre Marble Sculpture"
msgstr "Посредственная мраморная скульптура"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.DESC"
msgid "Duplicants who have learned art skills can produce more decorative sculptures."
msgstr "Дупликанты с высоким навыком творчества будут создавать более качественные скульптуры, с большим уровнем декора."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.EFFECT"
msgid "Majorly increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n\nMust be sculpted by a Duplicant."
msgstr "Значительно увеличивает <link=\"DECOR\">Декор</link>, который добавляет плюс к <link=\"MORALE\">Морали</link> Дупликанта.\n\nДолжен быть вырезан из камня Дупликантом после постройки."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.EXCELLENTQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.EXCELLENTQUALITYNAME"
msgid "Genius Marble Sculpture"
msgstr "Гениальная скульптура из мрамора"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_1.DESC"
msgid "She's not afraid to take up space."
msgstr "Она не боится занимать пространство."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_1.NAME"
msgid "<link=\"SCULPTUREMARBLEAMAZING1\">The Large-ish Mermaid</link>"
msgstr "<link=\"SCULPTUREMARBLEAMAZING1\">Большеватая Русалка</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_2.DESC"
msgid "The artist took great pleasure in conveying their displeasure."
msgstr "Художник получил удовольствие, выражая свое недовольство."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_2.NAME"
msgid "<link=\"SCULPTUREMARBLEAMAZING2\">Grouchy Beast</link>"
msgstr "<link=\"SCULPTUREMARBLEAMAZING2\">Ворчливый Зверь</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_3.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_3.DESC"
msgid "Will not play fetch."
msgstr "Не будет играть в апорт."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_3.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_3.NAME"
msgid "<link=\"SCULPTUREMARBLEAMAZING3\">The Guardian</link>"
msgstr "<link=\"SCULPTUREMARBLEAMAZING3\">Страж</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_4.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_4.DESC"
msgid "A masterful celebration of one of the universe's most mysterious - and flatulent - organisms."
msgstr "Дань мастера одному из самых загадочных – и пукающих – существ во Вселенной."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_4.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_4.NAME"
msgid "<link=\"SCULPTUREMARBLEAMAZING4\">Truly A-Moo-Zing</link>"
msgstr "<link=\"SCULPTUREMARBLEAMAZING4\">Настоящая А-Му-Зинг</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_5.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_5.DESC"
msgid "A masterful celebration of the deep bond between a horticulturalist and her prize Bristle Blossom."
msgstr "Дань мастера глубокому союзу между садовником и его призовым Щитовиком цветущим."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_5.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_AMAZING_5.NAME"
msgid "<link=\"SCULPTUREMARBLEAMAZING5\">Green Goddess</link>"
msgstr "<link=\"SCULPTUREMARBLEAMAZING5\">Зеленая Богиня</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_CRAP_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_CRAP_1.DESC"
msgid "The artist was a very fungi."
msgstr "Художник был настоящим грибом."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_CRAP_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_CRAP_1.NAME"
msgid "<link=\"SCULPTUREMARBLECRAP1\">Lumpy Fungus</link>"
msgstr "<link=\"SCULPTUREMARBLECRAP1\">Комковатый Гриб</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_GOOD_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_GOOD_1.DESC"
msgid "It has real \"mane\" character energy."
msgstr "У него настоящая \"манящая\" харизма."

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_GOOD_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.FACADES.SCULPTURE_MARBLE_GOOD_1.NAME"
msgid "<link=\"SCULPTUREMARBLEGOOD1\">Unicorn Bust</link>"
msgstr "<link=\"SCULPTUREMARBLEGOOD1\">Бюст Единорога</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.NAME"
msgid "<link=\"MARBLESCULPTURE\">Marble Block</link>"
msgstr "<link=\"MARBLESCULPTURE\">Блок мрамора</link>"

#. STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.POORQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MARBLESCULPTURE.POORQUALITYNAME"
msgid "\"Abstract\" Marble Sculpture"
msgstr "\"Абстрактная\" скульптура из мрамора"

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.ACTIVATE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.ACTIVATE_TOOLTIP"
msgid "Duplicants must take a massage break when their <style=\"KKeyword\">Stress</style> reaches {0}%"
msgstr "Дупликанты должны уйти на перерыв, когда их уровень <style=\"KKeyword\">стресса</style> достигнет {0}%"

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.DEACTIVATE_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.DEACTIVATE_TOOLTIP"
msgid "Breaktime ends when <style=\"KKeyword\">Stress</style> is reduced to {0}%"
msgstr "Перерыв окончится, когда уровень <style=\"KKeyword\">стресса</style> опустится до {0}%"

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.DESC"
msgid "Massage tables quickly reduce extreme stress, at the cost of power production."
msgstr "Массажные столы быстро уменьшают стресс, используя электричество."

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.EFFECT"
msgid "Rapidly reduces <link=\"STRESS\">Stress</link> for the Duplicant user.\n\nDuplicants will automatically seek a massage table when <link=\"STRESS\">Stress</link> exceeds breaktime range."
msgstr "Быстро уменьшает <link=\"STRESS\">Стресс</link> одного Дупликанта при использовании.\n\nДупликанты будут самостоятельно посещать массажные столы, если их <link=\"STRESS\">Стресс</link> поднимется до указанного в \"Политике перерыва\" значения."

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.DEFAULT_MASSAGETABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.DEFAULT_MASSAGETABLE.DESC"
msgid "Massage tables quickly reduce extreme stress, at the cost of power production."
msgstr "Массажные столы быстро снимают сильный стресс, но требуют значительных затрат энергии."

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.DEFAULT_MASSAGETABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.DEFAULT_MASSAGETABLE.NAME"
msgid "<link=\"MASSAGETABLE\">Massage Table</link>"
msgstr "<link=\"MASSAGETABLE\">Массажный стол</link>"

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.MASSEUR_BALLOON.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.MASSEUR_BALLOON.DESC"
msgid "Inflates well-being, deflates stress."
msgstr "Увеличивает благополучие, снижает стресс."

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.MASSEUR_BALLOON.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.MASSEUR_BALLOON.NAME"
msgid "<link=\"MASSAGETABLE\">Inflatable Massage Table</link>"
msgstr "<link=\"MASSAGETABLE\">Надувной массажный стол</link>"

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.SHIATSU.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.SHIATSU.DESC"
msgid "Deep pressure for deep-seated stress."
msgstr "Глубокое давление для глубинного стресса."

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.SHIATSU.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.FACADES.SHIATSU.NAME"
msgid "<link=\"MASSAGETABLE\">Shiatsu Table</link>"
msgstr "<link=\"MASSAGETABLE\">Стол Шиацу</link>"

#. STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSAGETABLE.NAME"
msgid "<link=\"MASSAGETABLE\">Massage Table</link>"
msgstr "<link=\"MASSAGETABLE\">Массажный стол</link>"

#. STRINGS.BUILDINGS.PREFABS.MASSIVEHEATSINK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSIVEHEATSINK.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.MASSIVEHEATSINK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSIVEHEATSINK.EFFECT"
msgid "A self-sustaining machine powered by what appears to be refined <link=\"UNOBTANIUM\">Neutronium</link>.\n\nAbsorbs and neutralizes <link=\"HEAT\">Heat</link> energy when provided with piped <link=\"HYDROGEN\">Hydrogen Gas</link>."
msgstr "Автономная машина, запитанная, похоже, от очищенного <link=\"UNOBTANIUM\">Нейтрониума</link>.\n\nПри подключении к трубе, снабжающей постройку <link=\"HYDROGEN\">Водородом</link>, абсорбирует и нейтрализует <link=\"HEAT\">Тепло</link>."

#. STRINGS.BUILDINGS.PREFABS.MASSIVEHEATSINK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MASSIVEHEATSINK.NAME"
msgid "<link=\"MASSIVEHEATSINK\">Anti Entropy Thermo-Nullifier</link>"
msgstr "<link=\"MASSIVEHEATSINK\">Анти-энтропийный терморегулятор</link>"

#. STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.DESC"
msgid "Mechanical waves make for radical relaxation time."
msgstr "Искусственные волны способствуют радикальному расслаблению."

#. STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.EFFECT"
msgid "Increases Duplicant <link=\"MORALE\">Morale</link>.\n\nSome <link=\"WATER\">Water</link> gets splashed on the floor during use."
msgstr "Увеличивает <link=\"MORALE\">Мораль</link> Дупликанта.\n\n Некоторое количество <link=\"WATER\">Воды</link> время от времени разливается на пол, во время использования."

#. STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.LEAK_REQUIREMENT
msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.LEAK_REQUIREMENT"
msgid "Spillage: {amount}"
msgstr "Утечка: {amount}"

#. STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.LEAK_REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.LEAK_REQUIREMENT_TOOLTIP"
msgid "This building will spill {amount} of its contents on to the floor during use, which must be replenished."
msgstr "Эта постройка будет разливать часть своего содержимого ({amount}) на пол во время использования, поэтому она потребует пополнения."

#. STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.NAME"
msgid "<link=\"MECHANICALSURFBOARD\">Mechanical Surfboard</link>"
msgstr "<link=\"MECHANICALSURFBOARD\">Доска для серфинга</link>"

#. STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.WATER_REQUIREMENT
msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.WATER_REQUIREMENT"
msgid "{element}: {amount}"
msgstr "{element}: {amount}"

#. STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.WATER_REQUIREMENT_TOOLTIP
msgctxt "STRINGS.BUILDINGS.PREFABS.MECHANICALSURFBOARD.WATER_REQUIREMENT_TOOLTIP"
msgid "This building must be filled with {amount} {element} in order to function."
msgstr "Для функционирования эта постройка должна быть наполнена жидкостью: {element}, в объеме: {amount}."

#. STRINGS.BUILDINGS.PREFABS.MEDICALCOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MEDICALCOT.DESC"
msgid "Duplicants use triage cots to recover from physical injuries and receive aid from peers."
msgstr "Дупликанты используют медицинскую кровать для восстановления от болезни и могут получать медицинскую помощь от других Дупликантов."

#. STRINGS.BUILDINGS.PREFABS.MEDICALCOT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MEDICALCOT.EFFECT"
msgid "Accelerates <link=\"HEALTH\">Health</link> restoration and the healing of physical injuries.\n\nRevives incapacitated Duplicants."
msgstr "Ускоряет восстановление <link=\"HEALTH\">Здоровья</link> и лечение физических ранений.\n\nПозволяет спасти выведенных из строя Дупликантов."

#. STRINGS.BUILDINGS.PREFABS.MEDICALCOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MEDICALCOT.NAME"
msgid "<link=\"MEDICALCOT\">Triage Cot</link>"
msgstr "<link=\"MEDICALCOT\">Мед. кровать</link>"

#. STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.EFFECT"
msgid "An organic multi-cortex repository and processing system fuelled by <link=\"OXYGEN\">Oxygen</link>.\n\nAnalyzes <link=\"DREAMJOURNAL\">Dream Journals</link> produced by Duplicants wearing <link=\"SLEEPCLINICPAJAMAS\">Pajamas</link>.\n\nProvides a sustainable boost to Duplicant skills and abilities throughout the colony."
msgstr "Органическая система хранения и обработки мультикортексов, работающая на <link=\"OXYGEN\">Кислороде</link>.\n\nАнализирует <link=\"DREAMJOURNAL\">Дневники снов</link>, созданные Дупликантами в <link=\"SLEEPCLINICPAJAMAS\">Пижамах</link>.\n\nОбеспечивает устойчивое повышение навыков и способностей Дупликантов по всей колонии."

#. STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MEGABRAINTANK.NAME"
msgid "<link=\"MEGABRAINTANK\">Somnium Synthesizer</link>"
msgstr "<link=\"MEGABRAINTANK\">Синтезатор Сомний</link>"

#. STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.DESC"
msgid "Mercury ceiling lights take a while to reach full brightness, but once they do...zowie!"
msgstr "Ртутные потолочные лампы требуют времени для достижения полной яркости, но когда они это делают... вуаля!"

#. STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.EFFECT"
msgid "Uses <link=\"MERCURY\">Mercury</link> and <link=\"POWER\">Power</link> to produce <link=\"LIGHT\">Light</link>.\n\nLight reduces Duplicant stress and is required to grow certain plants."
msgstr "Использует <link=\"MERCURY\">Ртуть</link> и <link=\"POWER\">Электричество</link> для производства <link=\"LIGHT\">Света</link>.\n\nСвет снижает стресс Дупликантов и необходим для роста определенных растений."

#. STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MERCURYCEILINGLIGHT.NAME"
msgid "<link=\"MERCURYCEILINGLIGHT\">Mercury Ceiling Light</link>"
msgstr "<link=\"MERCURYCEILINGLIGHT\">Ртутная потолочная лампа</link>"

#. STRINGS.BUILDINGS.PREFABS.MESHTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MESHTILE.DESC"
msgid "Mesh tile can be used to make Duplicant pathways in areas where liquid flows."
msgstr "Каркасные блоки не блокируют потоки газа и жидкостей, предоставляя Дупликантам путь для передвижения."

#. STRINGS.BUILDINGS.PREFABS.MESHTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MESHTILE.EFFECT"
msgid "Used to build the walls and floors of rooms.\n\nDoes not obstruct <link=\"ELEMENTSLIQUID\">Liquid</link> or <link=\"ELEMENTSGAS\">Gas</link> flow."
msgstr "Используется как блок пола и стен при строительстве комнат.\n\nНе блокирует потоки <link=\"ELEMENTSLIQUID\">Жидкости</link> или <link=\"ELEMENTSGAS\">Газа</link>."

#. STRINGS.BUILDINGS.PREFABS.MESHTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MESHTILE.NAME"
msgid "<link=\"MESHTILE\">Mesh Tile</link>"
msgstr "<link=\"MESHTILE\">Каркасный блок</link>"

#. STRINGS.BUILDINGS.PREFABS.METALREFINERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.DESC"
msgid "Refined metals are necessary to build advanced electronics and technologies."
msgstr "Очищенные металлы необходимы для постройки передовой электроники и технологий."

#. STRINGS.BUILDINGS.PREFABS.METALREFINERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.EFFECT"
msgid "Produces <link=\"REFINEDMETAL\">Refined Metals</link> from raw <link=\"RAWMETAL\">Metal Ore</link>.\n\nSignificantly <link=\"HEAT\">Heats</link> and outputs the <link=\"ELEMENTSLIQUID\">Liquid</link> piped into it.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "Производит <link=\"REFINEDMETAL\">Очищенный металл</link> из сырой <link=\"RAWMETAL\">Металлической руды</link>.\n\nВыделяет значительное количество <link=\"HEAT\">Нагретой</link> <link=\"ELEMENTSLIQUID\">Жидкости</link>.\n\nДупликанты не будут производить предметы, пока рецепты не поставлены в очередь."

#. STRINGS.BUILDINGS.PREFABS.METALREFINERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.NAME"
msgid "<link=\"METALREFINERY\">Metal Refinery</link>"
msgstr "<link=\"METALREFINERY\">Очиститель руды</link>"

#. STRINGS.BUILDINGS.PREFABS.METALREFINERY.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.METALREFINERY.RECIPE_DESCRIPTION"
msgid "Extracts pure {0} from {1}."
msgstr "Извлекает очищенный материал {0} из {1}."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.AVERAGEQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.AVERAGEQUALITYNAME"
msgid "Mediocre Metal Sculpture"
msgstr "Посредственная скульптура из металла"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.DESC"
msgid "Duplicants who have learned art skills can produce more decorative sculptures."
msgstr "Дупликанты с высоким навыком творчества будут создавать более качественные скульптуры, с большим уровнем декора."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.EFFECT"
msgid "Majorly increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n\nMust be sculpted by a Duplicant."
msgstr "Значительно увеличивает показатель <link=\"DECOR\">Декора</link>, влияющий на <link=\"MORALE\">Мораль</link> Дупликантов.\n\nДолжна быть вырезана из камня Дупликантом после постройки."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.EXCELLENTQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.EXCELLENTQUALITYNAME"
msgid "Genius Metal Sculpture"
msgstr "Гениальная скульптура из металла"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_1.DESC"
msgid "It's quite lovely, until someone stubs their toe on it in the dark."
msgstr "Очень красивая, пока кто-то не ударится об нее ногой в темноте."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_1.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING1\">Insatiable Appetite</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING1\">Неутолимый аппетит</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_2.DESC"
msgid "Not quite expressionist, but undeniably expressive."
msgstr "Не полная экспрессия, но определенно выразительно."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_2.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING2\">Agape</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING2\">Агапе</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_3.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_3.DESC"
msgid "It emits no light, but it sure does brighten up a room."
msgstr "Не излучает света, но определенно освежает комнату."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_3.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_3.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING3\">Friendly Flier</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING3\">Дружелюбный летун</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_4.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_4.DESC"
msgid "A masterful likeness of the mischievous critter that Duplicants love to love."
msgstr "Мастерская реплика озорного существа, которое Дупликанты просто обожают."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_4.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_4.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING4\">Whatta Pip</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING4\">Вот это Пип</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_5.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_5.DESC"
msgid "What if the entire head is one big bump?"
msgstr "А что если всся голова - одна большая шишка?"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_5.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_AMAZING_5.NAME"
msgid "<link=\"SCULPTUREMETALAMAZING5\">Phrenologist's Dream</link>"
msgstr "<link=\"SCULPTUREMETALAMAZING5\">Мечта френолога</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_CRAP_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_CRAP_1.DESC"
msgid "Actually, it's a very good likeness."
msgstr "На самом деле, похожесть потрясающая."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_CRAP_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_CRAP_1.NAME"
msgid "<link=\"SCULPTUREMETALCRAP1\">Unnatural Beauty</link>"
msgstr "<link=\"SCULPTUREMETALCRAP1\">Ненатуральная красота</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_GOOD_1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_GOOD_1.DESC"
msgid "The Morb's eye is mounted on a swivel that activates at random intervals."
msgstr "Глаз Морба установлен на поворотном механизме, который активируется случайным образом."

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_GOOD_1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.FACADES.SCULPTURE_METAL_GOOD_1.NAME"
msgid "<link=\"SCULPTUREMETALGOOD1\">Beautiful Biohazard</link>"
msgstr "<link=\"SCULPTUREMETALGOOD1\">Био-опасный красавчик</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.NAME"
msgid "<link=\"METALSCULPTURE\">Metal Block</link>"
msgstr "<link=\"METALSCULPTURE\">Заготовка металлической скульптуры</link>"

#. STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.POORQUALITYNAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALSCULPTURE.POORQUALITYNAME"
msgid "\"Abstract\" Metal Sculpture"
msgstr "\"Абстрактная\" скульптура из металла"

#. STRINGS.BUILDINGS.PREFABS.METALTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METALTILE.DESC"
msgid "Heat travels much more quickly through metal tile than other types of flooring."
msgstr "Тепло перемещается намного быстрее через металлические блоки, чем через блоки других типов."

#. STRINGS.BUILDINGS.PREFABS.METALTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.METALTILE.EFFECT"
msgid "Used to build the walls and floors of rooms.\n\nSignificantly increases Duplicant runspeed."
msgstr "Используется как блок пола и стен при строительстве комнат.\n\nЗначительно увеличивает скорость Дупликанта."

#. STRINGS.BUILDINGS.PREFABS.METALTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METALTILE.NAME"
msgid "<link=\"METALTILE\">Metal Tile</link>"
msgstr "<link=\"METALTILE\">Металлический блок</link>"

#. STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.DESC"
msgid "Natural gas generators leak polluted water and are best built above a waste reservoir."
msgstr "Генератор на природном газе выделяет загрязненную воду, лучше всего его строить над резервуаром для отходов."

#. STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.EFFECT"
msgid "Converts <link=\"METHANE\">Natural Gas</link> into electrical <link=\"POWER\">Power</link>.\n\nProduces <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"DIRTYWATER\">Polluted Water</link>."
msgstr "Перерабатывает <link=\"METHANE\">Природный газ</link> в <link=\"POWER\">Электричество</link>.\n\nПроизводит <link=\"CARBONDIOXIDE\">Углекислый газ</link> и <link=\"DIRTYWATER\">Загрязненную воду</link>."

#. STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.METHANEGENERATOR.NAME"
msgid "<link=\"METHANEGENERATOR\">Natural Gas Generator</link>"
msgstr "<link=\"METHANEGENERATOR\">Генератор на природном газе</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.DESC"
msgid "Musher recipes will keep Duplicants fed, but may impact health and morale over time."
msgstr "Еда из миксера микробов будет поддерживать жизнь в Дупликантах, но может вызвать стресс и болезни с течением времени."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.EFFECT"
msgid "Produces low quality <link=\"FOOD\">Food</link> using common ingredients.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "Производит низкокачественную <link=\"FOOD\">Еду</link> для Дупликантов, используя наиболее распространенные ингредиенты.\n\nДупликанты не будут готовить, пока рецепты не поставлены в очередь."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.BLUE_BABYTEARS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.BLUE_BABYTEARS.DESC"
msgid "Prioritizes nutritional value over flavor."
msgstr "Ставит питательную ценность выше вкуса."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.BLUE_BABYTEARS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.BLUE_BABYTEARS.NAME"
msgid "<link=\"MICROBEMUSHER\">Weepy Blue Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Слезливо-синий миксер микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.DEFAULT_MICROBEMUSHER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.DEFAULT_MICROBEMUSHER.DESC"
msgid "Musher recipes will keep Duplicants fed, but may impact health and morale over time."
msgstr "Рецепты миксера микробов обеспечивают Дупликантов пищей, но могут со временем негативно сказаться на их здоровье и моральном состоянии."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.DEFAULT_MICROBEMUSHER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.DEFAULT_MICROBEMUSHER.NAME"
msgid "<link=\"MICROBEMUSHER\">Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Миксер микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.GREEN_MUSH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.GREEN_MUSH.DESC"
msgid "Edible colloids for dinner <i>again</i>?"
msgstr "Съедобные коллоиды на ужин <i>снова</i>?"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.GREEN_MUSH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.GREEN_MUSH.NAME"
msgid "<link=\"MICROBEMUSHER\">Mush Green Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Зеленый миксер микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.PURPLE_BRAINFAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.PURPLE_BRAINFAT.DESC"
msgid "A colorful distraction from the actual quality of the food."
msgstr "Яркое отвлечение от реального качества еды."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.PURPLE_BRAINFAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.PURPLE_BRAINFAT.NAME"
msgid "<link=\"MICROBEMUSHER\">Faint Purple Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Фиолетовый миксер микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.RED_ROSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.RED_ROSE.DESC"
msgid "Hunger strikes are not an option, but color-coordination is."
msgstr "Голодные забастовки не вариант, но координация цветов — да."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.RED_ROSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.RED_ROSE.NAME"
msgid "<link=\"MICROBEMUSHER\">Puce Pink Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Розовый миксер микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.YELLOW_TARTAR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.YELLOW_TARTAR.DESC"
msgid "Makes meals that are memorable for all the wrong reasons."
msgstr "Приготовление еды, которая запоминается по неправильным причинам."

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.YELLOW_TARTAR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.FACADES.YELLOW_TARTAR.NAME"
msgid "<link=\"MICROBEMUSHER\">Ick Yellow Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Желтый миксер микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MICROBEMUSHER.NAME"
msgid "<link=\"MICROBEMUSHER\">Microbe Musher</link>"
msgstr "<link=\"MICROBEMUSHER\">Миксер микробов</link>"

#. STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.DESC"
msgid "Duplicants can slather up with brackwax to increase their travel speed in transit tubes."
msgstr "Дупликанты могут смазываться браковаксом для увеличения скорости передвижения в транзитных трубах."

#. STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.EFFECT"
msgid "Refines <link=\"MILK\">Brackene</link> into <link=\"BRINE\">Brine</link> and <link=\"MILKFAT\">Brackwax</link>, and emits <link=\"CARBONDIOXIDE\">Carbon Dioxide</link>."
msgstr "Перерабатывает <link=\"MILK\">Бракен</link> в <link=\"BRINE\">Солевой раствор</link> и <link=\"MILKFAT\">Браковакс</link>, выделяя <link=\"CARBONDIOXIDE\">Углекислый газ</link>."

#. STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFATSEPARATOR.NAME"
msgid "<link=\"MILKFATSEPARATOR\">Brackwax Gleaner</link>"
msgstr "<link=\"MILKFATSEPARATOR\">Сборщик браковакса</link>"

#. STRINGS.BUILDINGS.PREFABS.MILKFEEDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFEEDER.DESC"
msgid "It's easier to tolerate overcrowding when you're all hopped up on brackene."
msgstr "Легче терпеть переполненность, когда ты под влиянием бракена."

#. STRINGS.BUILDINGS.PREFABS.MILKFEEDER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFEEDER.EFFECT"
msgid "Dispenses <link=\"MILK\">Brackene</link> to a wide variety of <link=\"CREATURES\">Critters</link>.\n\nAccessing the fountain significantly improves <link=\"CREATURES\">Critters</link>' moods."
msgstr "Выдает <link=\"MILK\">Бракен</link> различным <link=\"CREATURES\">Существам</link>.\n\nДоступ к фонтану значительно улучшает настроение <link=\"CREATURES\">Существ</link>."

#. STRINGS.BUILDINGS.PREFABS.MILKFEEDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKFEEDER.NAME"
msgid "<link=\"MILKFEEDER\">Critter Fountain</link>"
msgstr "<link=\"MILKFEEDER\">Фонтан для существ</link>"

#. STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.DESC"
msgid "The harvested liquid is basically the equivalent of soda for critters."
msgstr "Полученная жидкость по сути является аналогом газировки для существ."

#. STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.EFFECT"
msgid "Allows Duplicants with the <link=\"RANCHING2\">Critter Ranching II</link> skill to milk <link=\"MOO\">Gassy Moos</link> for <link=\"MILK\">Brackene</link>.\n\n<link=\"MILK\">Brackene</link> can be used to refill the <link=\"MILKFEEDER\">Critter Fountain</link>."
msgstr "Позволяет Дупликантам с навыком <link=\"RANCHING2\">Узод за сушествами II</link> доить <link=\"MOO\">Газомусов</link> для получения <link=\"MILK\">Бракена</link>.\n\n<link=\"MILK\">Бракен</link> можно использовать для пополнения <link=\"MILKFEEDER\">Фонтана для существ</link>."

#. STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKINGSTATION.NAME"
msgid "<link=\"MILKINGSTATION\">Milking Station</link>"
msgstr "<link=\"MILKINGSTATION\">Доильная станция</link>"

#. STRINGS.BUILDINGS.PREFABS.MILKPRESS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKPRESS.DESC"
msgid "For Duplicants who are too squeamish to milk critters."
msgstr "Для Дупликантов, которые слишком брезгливы, чтобы доить существ."

#. STRINGS.BUILDINGS.PREFABS.MILKPRESS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKPRESS.EFFECT"
msgid "Crushes <link=\"COLDWHEAT\">Sleet Wheat Grain</link> or <link=\"SPICENUT\">Pincha Peppernut</link> to extract <link=\"MILK\">Brackene</link>.\n\n<link=\"MILK\">Brackene</link> can be used to refill the <link=\"MILKFEEDER\">Critter Fountain</link>."
msgstr "Размельчает <link=\"COLDWHEAT\">Морозную пшеницу</link> или <link=\"SPICENUT\">Перечный орех</link> для получения <link=\"MILK\">Бракена</link>.\n\n<link=\"MILK\">Бракен</link> можно использовать для пополнения <link=\"MILKFEEDER\">Фонтана для существ</link>."

#. STRINGS.BUILDINGS.PREFABS.MILKPRESS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKPRESS.NAME"
msgid "<link=\"MILKPRESS\">Plant Pulverizer</link>"
msgstr "<link=\"MILKPRESS\">Мельница для растений</link>"

#. STRINGS.BUILDINGS.PREFABS.MILKPRESS.NUT_MILK_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKPRESS.NUT_MILK_RECIPE_DESCRIPTION"
msgid "Converts {0} to {1}"
msgstr "Преобразует {0} в {1}"

#. STRINGS.BUILDINGS.PREFABS.MILKPRESS.WHEAT_MILK_RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.MILKPRESS.WHEAT_MILK_RECIPE_DESCRIPTION"
msgid "Converts {0} to {1}"
msgstr "Преобразует {0} в {1}"

#. STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.DESC"
msgid "Oxygen diffusers are inefficient, but output enough oxygen to keep a colony breathing."
msgstr "Раскислители водорослей неэффективны, но они могут выделить достаточно кислорода для поддержания атмосферы, пригодной для дыхания в вашей колонии."

#. STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.EFFECT"
msgid "Converts large amounts of <link=\"ALGAE\">Algae</link> into <link=\"OXYGEN\">Oxygen</link>.\n\nBecomes idle when the area reaches maximum pressure capacity."
msgstr "Перерабатывает большие объемы <link=\"ALGAE\">Водорослей</link> в <link=\"OXYGEN\">Кислород</link>.\n\nСтановится неактивным, когда давление воздуха в комнате становится максимальным."

#. STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MINERALDEOXIDIZER.NAME"
msgid "<link=\"MINERALDEOXIDIZER\">Oxygen Diffuser</link>"
msgstr "<link=\"MINERALDEOXIDIZER\">Раскислитель водорослей</link>"

#. STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.DESC"
msgid "Blastshot shells are an effective defense against incoming meteor showers."
msgstr "Гранаты надежно защищают от метеорных атак. "

#. STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.EFFECT"
msgid "Produces <link=\"MISSILELAUNCHER\">Blastshot</link> from <link=\"REFINEDMETAL\">Refined Metals</link> combined with <link=\"PETROLEUM\">Petroleum</link>.\n\nDuplicants will not fabricate items unless recipes are queued."
msgstr "Производит <link=\"MISSILELAUNCHER\">Гранаты</link> из <link=\"REFINEDMETAL\">Очищенныз металлов</link> и <link=\"PETROLEUM\">Керосина</link>.\n\nДупликанты не будут производить предметы, пока рецепты не будут выставлены в очередь."

#. STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.NAME"
msgid "<link=\"MISSILEFABRICATOR\">Blastshot Maker</link>"
msgstr "<link=\"MISSILEFABRICATOR\">Производитель гранат</link>"

#. STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.RECIPE_DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILEFABRICATOR.RECIPE_DESCRIPTION"
msgid "Produces {0} from {1} and {2}."
msgstr "Производит {0} из {1} и {2}."

#. STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.BODY.CONTAINER1
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.BODY.CONTAINER1"
msgid "Fires <link=\"MISSILELAUNCHER\">Blastshot</link> shells at meteor showers to defend the colony from impact-related damage.\n\nRange: 16 tiles horizontally, 32 tiles vertically.\n\nMeteors that have been blown to smithereens leave behind no harvestable resources."
msgstr "Стреляет <link=\"MISSILELAUNCHER\">Гранатами</link> по метеоритным дождям, чтобы защитить колонию от повреждений от ударов.\n\nДальность: 16 блоков горизонтально, 32 блока вертикально.\n\nМетеориты, разорванные на куски, не оставляют за собой ресурсов для сбора."

#. STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.DESC"
msgid "Some meteors drop harvestable resources when they're blown to smithereens."
msgstr "Некоторые метеориты оставляют ресурсы, когда разлетаются на куски."

#. STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.EFFECT"
msgid "Fires <link=\"MISSILELAUNCHER\">Blastshot</link> shells at meteor showers to defend the colony from impact-related damage.\n\nRange: 16 tiles horizontally, 32 tiles vertically."
msgstr "Стреляет <link=\"MISSILELAUNCHER\">Гранатами</link> по метеоритным дождям, чтобы защитить колонию от повреждений от ударов.\n\nДальность: 16 блоков горизонтально, 32 блока вертикально."

#. STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.NAME"
msgid "<link=\"MISSILELAUNCHER\">Meteor Blaster</link>"
msgstr "<link=\"MISSILELAUNCHER\">Метеоритный бластер</link>"

#. STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.TARGET_SELECTION_HEADER
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSILELAUNCHER.TARGET_SELECTION_HEADER"
msgid "Target Selection"
msgstr "Выбор цели"

#. STRINGS.BUILDINGS.PREFABS.MISSIONCONTROL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSIONCONTROL.DESC"
msgid "Like a backseat driver who actually does know better."
msgstr "Как пассажир, который действительно знает, как лучше."

#. STRINGS.BUILDINGS.PREFABS.MISSIONCONTROL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSIONCONTROL.EFFECT"
msgid "Provides guidance data to rocket pilots, to improve rocket speed.\n\nMust be operated by a Duplicant with the <link=\"ASTRONOMY\">Astronomy</link> skill.\n\nRequires a clear line of sight to space in order to function."
msgstr "Предоставляет данные для навигации шаттлу, чтобы увеличить его скорость.\n\nДолжен управляться Дупликантом с навыком <link=\"ASTRONOMY\">Астрономия</link>.\n\nТребуется прямой вид на космос для функционирования."

#. STRINGS.BUILDINGS.PREFABS.MISSIONCONTROL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSIONCONTROL.NAME"
msgid "<link=\"MISSIONCONTROL\">Mission Control Station</link>"
msgstr "<link=\"MISSIONCONTROL\">Станции управления полетами</link>"

#. STRINGS.BUILDINGS.PREFABS.MISSIONCONTROLCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSIONCONTROLCLUSTER.DESC"
msgid "Like a backseat driver who actually does know better."
msgstr "Как пассажир, который действительно знает, как лучше."

#. STRINGS.BUILDINGS.PREFABS.MISSIONCONTROLCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSIONCONTROLCLUSTER.EFFECT"
msgid "Provides guidance data to rocket pilots within range, to improve rocket speed.\n\nMust be operated by a Duplicant with the <link=\"ASTRONOMY\">Astronomy</link> skill.\n\nRequires a clear line of sight to space in order to function."
msgstr "Предоставляет данные для навигации шаттла в радиусе действия, чтобы увеличить его скорость.\n\nДолжен управляться Дупликантом с навыком <link=\"ASTRONOMY\">Астрономия</link>.\n\nТребуется прямой вид на космос для функционирования."

#. STRINGS.BUILDINGS.PREFABS.MISSIONCONTROLCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MISSIONCONTROLCLUSTER.NAME"
msgid "<link=\"MISSIONCONTROLCLUSTER\">Mission Control Station</link>"
msgstr "<link=\"MISSIONCONTROLCLUSTER\">Кластер управления полетами</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARGASINPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARGASINPUT.DESC"
msgid "A hub from which to input <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "Центр для подачи <link=\"ELEMENTSGAS\">Газа</link>."

#. STRINGS.BUILDINGS.PREFABS.MODULARGASINPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARGASINPUT.NAME"
msgid "<link=\"MODULARGASINPUT\">Gas Input Hub</link>"
msgstr "<link=\"MODULARGASINPUT\">Центр подачи газа</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORT.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTSOLID\">Порт для шаттла</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORT.NAME_PLURAL
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORT.NAME_PLURAL"
msgid "<link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Ports</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTSOLID\">Порты для шаттлов</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTBRIDGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTBRIDGE.DESC"
msgid "Allows rocket platforms to be built farther apart."
msgstr "Позволяет строить платформы для шаттлов на большем расстоянии друг от друга."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTBRIDGE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTBRIDGE.EFFECT"
msgid "Automatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or any <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>."
msgstr "Автоматически связывается при постройке рядом с <link=\"LAUNCHPAD\">платформой для шаттлов</link> или любым <link=\"MODULARLAUNCHPADPORTSOLID\">портом для шаттлов</link>."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTBRIDGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTBRIDGE.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTBRIDGE\">Rocket Port Extension</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTBRIDGE\">Расширение порта для шаттлов</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.DESC"
msgid "Rockets must be landed to load or unload resources."
msgstr "Шаттл должен приземлиться, чтобы закачать или откачать газ."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.EFFECT"
msgid "Loads <link=\"ELEMENTSGAS\">Gases</link> to the storage of a linked rocket.\n\nAutomatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or another <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>.\n\nUses the gas filters set on the rocket's cargo bays."
msgstr "Закачивает <link=\"ELEMENTSGAS\">Газ</link> в хранилище шаттла.\n\nПостройте рядом с <link=\"LAUNCHPAD\">Платформой для шаттлов</link> или другим <link=\"MODULARLAUNCHPADPORTSOLID\">Портом для шаттлов</link>.\n\nИспользует фильтр газа, установленный на грузовых отсеках шаттла."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGAS.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTGAS\">Gas Rocket Port Loader</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTGAS\">Станция закачки газа</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.DESC"
msgid "Rockets must be landed to load or unload resources."
msgstr "Шаттл должен приземлиться, чтобы закачать или откачать газ."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.EFFECT"
msgid "Unloads <link=\"ELEMENTSGAS\">Gases</link> from the storage of a linked rocket.\n\nAutomatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or another <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>.\n\nUses the gas filters set on this unloader."
msgstr "Откачивает <link=\"ELEMENTSGAS\">Газ</link> из хранилища шаттла.\n\nПостройте рядом с <link=\"LAUNCHPAD\">Платформой для шаттлов</link> или другим <link=\"MODULARLAUNCHPADPORTSOLID\">Портом для шаттлов</link>.\n\nИспользует фильтр газов, установленный в этой станции."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTGASUNLOADER.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTGASUNLOADER\">Gas Rocket Port Unloader</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTGASUNLOADER\">Станция откачки газа</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUID.DESC"
msgid "Rockets must be landed to load or unload resources."
msgstr "Шаттл должен приземлиться, чтобы закачать или откачать жидкость."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUID.EFFECT"
msgid "Loads <link=\"ELEMENTSLIQUID\">Liquids</link> to the storage of a linked rocket.\n\nAutomatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or another <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>.\n\nUses the liquid filters set on the rocket's cargo bays."
msgstr "Закачивает <link=\"ELEMENTSLIQUID\">Жидкость</link> в хранилище шаттла.\n\nПостройте рядом с <link=\"LAUNCHPAD\">Платформой для шаттлов</link> или другим <link=\"MODULARLAUNCHPADPORTSOLID\">Портом для шаттлов</link>.\n\nИспользует фильтр жидкостей, установленный на грузовых баках шаттла."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUID.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTLIQUID\">Liquid Rocket Port Loader</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTLIQUID\">Станция закачки жидкости</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUIDUNLOADER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUIDUNLOADER.DESC"
msgid "Rockets must be landed to load or unload resources."
msgstr "Шаттл должен приземлиться, чтобы закачать или откачать жидкость."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUIDUNLOADER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUIDUNLOADER.EFFECT"
msgid "Unloads <link=\"ELEMENTSLIQUID\">Liquids</link> from the storage of a linked rocket.\n\nAutomatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or another <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>.\n\nUses the liquid filters set on this unloader."
msgstr "Откачивает <link=\"ELEMENTSLIQUID\">Жидкость</link> из хранилища шаттла.\n\nПостройте рядом с <link=\"LAUNCHPAD\">Платформой для шаттлов</link> или другим <link=\"MODULARLAUNCHPADPORTSOLID\">Портом для шаттлов</link>.\n\nИспользует фильтр жидкостей, установленный в этой станции."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUIDUNLOADER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTLIQUIDUNLOADER.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTLIQUIDUNLOADER\">Liquid Rocket Port Unloader</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTLIQUIDUNLOADER\">Станция откачки жидкости</link>" 

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLID.DESC"
msgid "Rockets must be landed to load or unload resources."
msgstr "Шаттл должен приземлиться, чтобы закачать или откачать жидкость."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLID.EFFECT"
msgid "Loads <link=\"ELEMENTSSOLID\">Solids</link> to the storage of a linked rocket.\n\nAutomatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or another <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>.\n\nUses the solid material filters set on the rocket's cargo bays."
msgstr "Загружает <link=\"ELEMENTSSOLID\">Твердые материалы</link> в хранилище шаттла.\n\nПостройте рядом с <link=\"LAUNCHPAD\">Платформой для шаттлов</link> или другим <link=\"MODULARLAUNCHPADPORTSOLID\">Портом для шаттлов</link>.\n\nИспользует фильтр твердых материалов, установленный на грузовых отсеках шаттла."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLID.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTSOLID\">Solid Rocket Port Loader</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTSOLID\">Станция для загрузки твердых материалов</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLIDUNLOADER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLIDUNLOADER.DESC"
msgid "Rockets must be landed to load or unload resources."
msgstr "Шаттл должен приземлиться, чтобы загрузить или разгрузить ресурсы."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLIDUNLOADER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLIDUNLOADER.EFFECT"
msgid "Unloads <link=\"ELEMENTSSOLID\">Solids</link> from the storage of a linked rocket.\n\nAutomatically links when built to the side of a <link=\"LAUNCHPAD\">Rocket Platform</link> or another <link=\"MODULARLAUNCHPADPORTSOLID\">Rocket Port</link>.\n\nUses the solid material filters set on this unloader."
msgstr "Разгружает <link=\"ELEMENTSSOLID\">Твердые материалы</link> из хранилища шаттла.\n\nПостройте рядом с <link=\"LAUNCHPAD\">Платформой для шаттлов</link> или другим <link=\"MODULARLAUNCHPADPORTSOLID\">Портом для шаттлов</link>.\n\nИспользует фильтр твердых материалов, установленный в этой станции."

#. STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLIDUNLOADER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLAUNCHPADPORTSOLIDUNLOADER.NAME"
msgid "<link=\"MODULARLAUNCHPADPORTSOLIDUNLOADER\">Solid Rocket Port Unloader</link>"
msgstr "<link=\"MODULARLAUNCHPADPORTSOLIDUNLOADER\">Станция для разгрузки твердотелых ресурсов</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARLIQUIDINPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLIQUIDINPUT.DESC"
msgid "A hub from which to input <link=\"ELEMENTSLIQUID\">Liquids</link>."
msgstr "Хаб для ввода <link=\"ELEMENTSLIQUID\">Жидкостей</link>."

#. STRINGS.BUILDINGS.PREFABS.MODULARLIQUIDINPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARLIQUIDINPUT.NAME"
msgid "<link=\"MODULARLIQUIDINPUT\">Liquid Input Hub</link>"
msgstr "<link=\"MODULARLIQUIDINPUT\">Хаб ввода жидкостей</link>"

#. STRINGS.BUILDINGS.PREFABS.MODULARSOLIDINPUT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARSOLIDINPUT.DESC"
msgid "A hub from which to input <link=\"ELEMENTSSOLID\">Solids</link>."
msgstr "Хаб для ввода <link=\"ELEMENTSSOLID\">твердотелых ресурсов</link>."

#. STRINGS.BUILDINGS.PREFABS.MODULARSOLIDINPUT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MODULARSOLIDINPUT.NAME"
msgid "<link=\"MODULARSOLIDINPUT\">Solid Input Hub</link>"
msgstr "<link=\"MODULARSOLIDINPUT\">Хаб ввода твердых ресурсов</link>"

#. STRINGS.BUILDINGS.PREFABS.MONUMENTBOTTOM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTBOTTOM.DESC"
msgid "The base of a monument must be constructed first."
msgstr "База монумента должна быть построена первой."

#. STRINGS.BUILDINGS.PREFABS.MONUMENTBOTTOM.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTBOTTOM.EFFECT"
msgid "Builds the bottom section of a Great Monument.\n\nCan be customized.\n\nA Great Monument must be built to achieve the Colonize Imperative."
msgstr "Постройка нижней части Великого монумента.\n\nМожет быть настроена.\n\nВеликий монумент необходим для достижения императива Колонизация."

#. STRINGS.BUILDINGS.PREFABS.MONUMENTBOTTOM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTBOTTOM.NAME"
msgid "<link=\"MONUMENTBOTTOM\">Monument Base</link>"
msgstr "<link=\"MONUMENTBOTTOM\">База монумента</link>"

#. STRINGS.BUILDINGS.PREFABS.MONUMENTMIDDLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTMIDDLE.DESC"
msgid "Customized sections of a Great Monument can be mixed and matched."
msgstr "Настраиваемые секции Великого монумента можно смешивать и подобрать наилучшее сочетание."

#. STRINGS.BUILDINGS.PREFABS.MONUMENTMIDDLE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTMIDDLE.EFFECT"
msgid "Builds the middle section of a Great Monument.\n\nCan be customized.\n\nA Great Monument must be built to achieve the Colonize Imperative."
msgstr "Постройка средней части Великого монумента.\n\nМожет быть настроена.\n\nВеликий монумент необходим для достижения императива Колонизация."

#. STRINGS.BUILDINGS.PREFABS.MONUMENTMIDDLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTMIDDLE.NAME"
msgid "<link=\"MONUMENTMIDDLE\">Monument Midsection</link>"
msgstr "<link=\"MONUMENTMIDDLE\">Средняя часть монумента</link>"

#. STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.DESC"
msgid "Building a Great Monument will declare to the universe that this hunk of rock is your own."
msgstr "Постройка Великого монумента позволит объявить на всю вселенную, что этот кусок камня - ваш собственный."

#. STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.EFFECT"
msgid "Builds the top section of a Great Monument.\n\nCan be customized.\n\nA Great Monument must be built to achieve the Colonize Imperative."
msgstr "Постройка верхней части Великого монумента.\n\nМожет быть настроена.\n\nВеликий монумент необходим для достижения императива Колонизация."

#. STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MONUMENTTOP.NAME"
msgid "<link=\"MONUMENTTOP\">Monument Top</link>"
msgstr "<link=\"MONUMENTTOP\">Верхняя часть монумента</link>"

#. STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.DESC"
msgid "Allows a skilled Duplicant to manufacture a steady supply of icky yet effective bots."
msgstr "Позволяет опытному Дупликанту производить стабильное количество противных, но эффективных роботов."

#. STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.EFFECT"
msgid "Uses <link=\"ZOMBIESPORES\">Zombie Spores</link> and <link=\"STEEL\">Steel</link> to craft biofueled machines that can be sent into hostile environments.\n\nDefunct <link=\"STORYTRAITMORBROVER\">Biobots</link> drop harvestable <link=\"STEEL\">Steel</link>."
msgstr "Использует <link=\"ZOMBIESPORES\">Зомбоспоры</link> и <link=\"STEEL\">Сталь</link> для создания биотопливных роботов, которые можно отправить в враждебные среды.\n\nНеактивные <link=\"STORYTRAITMORBROVER\">Биоботы</link> оставляют собираемую <link=\"STEEL\">Сталь</link>."

#. STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MORBROVERMAKER.NAME"
msgid "<link=\"STORYTRAITMORBROVER\">Biobot Builder</link>"
msgstr "<link=\"STORYTRAITMORBROVER\">Фабрика биороботов</link>"

#. STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.DESC"
msgid "Trimming is used as purely decorative lining for walls and structures."
msgstr "Отделка используется в качестве чисто декоративной облицовки для стен и конструкций."

#. STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.EFFECT"
msgid "Used to build the walls and floors of rooms.\n\nIncreases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>."
msgstr "Используется для строительства стен и полов в комнатах.\n\nУвеличивает показатель <link=\"DECOR\">Декора</link>, влияющий на <link=\"MORALE\">Мораль</link> Дупликантов."

#. STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.MOULDINGTILE.NAME"
msgid "<link=\"MOUDLINGTILE\">Trimming Tile</link>"
msgstr "<link=\"MOUDLINGTILE\">Отделочный блок</link>"

#. STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.DESC"
msgid "Every rocket requires a nosecone to fly."
msgstr "Каждому шаттлу для полета требуется носовой модуль."

#. STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.EFFECT"
msgid "Protects a rocket during takeoff and entry, enabling space travel.\n\nEngine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n\nMust be built at the top of a rocket."
msgstr "Защищает шаттл во время взлета и выхода в космос, позволяя совершать космические путешествия.\n\nДолжен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>. \n\nДолжен быть построен на вершине шаттла."

#. STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEBASIC.NAME"
msgid "<link=\"NOSECONEBASIC\">Basic Nosecone</link>"
msgstr "<link=\"NOSECONEBASIC\">Носовой модуль шаттла</link>"

#. STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.DESC"
msgid "Harvests resources from the universe."
msgstr "Добывает ресурсы из вселенной."

#. STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.EFFECT"
msgid "Enables a rocket to drill into interstellar debris and collect <link=\"ELEMENTSGAS\">gas</link>, <link=\"ELEMENTSLIQUID\">liquid</link> and <link=\"ELEMENTSSOLID\">solid</link> resources from space.\n\nEngine must be built via <link=\"LAUNCHPAD\">Rocket Platform</link>. \n\nMust be built at the top of a rocket with <link=\"ELEMENTSGAS\">gas</link>, <link=\"ELEMENTSLIQUID\">liquid</link> or <link=\"ELEMENTSSOLID\">solid</link> Cargo Module attached to store the appropriate resources."
msgstr "Позволяет шаттлу бурить межзвездные обломки и добывать <link=\"ELEMENTSGAS\">Газ</link>, <link=\"ELEMENTS LIQUID\">Жидкость</link> и <link=\"ELEMENTS SOLID\" >Твердотелые</link> ресурсы из космоса.\n\nДолжен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>. \n\nДолжен быть построен на вершине шаттла с грузовыми отсеками для сбора необходимых ресурсов."

#. STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.NOSECONEHARVEST.NAME"
msgid "<link=\"NOSECONEHARVEST\">Drillcone</link>"
msgstr "<link=\"NOSECONEHARVEST\">Носовой бур</link>"

#. STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.DESC"
msgid "Radbolt generators and reflectors make radiation useable by other buildings."
msgstr "Генераторы и отражатели радчастиц позволяют использовать радиацию другим постройкам."

#. STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.EFFECT"
msgid "Uses <link=\"ENRICHEDURANIUM\">Enriched Uranium</link> to produce <link=\"RADIATION\">Radiation</link> for Radbolt production.\n\nGenerates a massive amount of <link=\"HEAT\">Heat</link>. Overheating will result in an explosive meltdown."
msgstr "Использует <link=\"ENRICHEDURANIUM\">Обогащенный уран</link> для производства радиации.\n\nВыделяет обширное количество <link=\"HEAT\">Тепла</link>. Перегрев приведет к взрыву."

#. STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.INPUT_PORT_ACTIVE"
msgid "Fuel Delivery Enabled"
msgstr "Доставка топлива активна"

#. STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.INPUT_PORT_INACTIVE"
msgid "Fuel Delivery Disabled"
msgstr "Доставка топлива отключена"

#. STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.LOGIC_PORT"
msgid "Fuel Delivery Control"
msgstr "Управление доставкой топлива"

#. STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARREACTOR.NAME"
msgid "<link=\"NUCLEARREACTOR\">Research Reactor</link>"
msgstr "<link=\"NUCLEARREACTOR\">Научный реактор</link>"

#. STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.DESC"
msgid "Comes with a few ions thrown in, free of charge."
msgstr "Поставляется с несколькими дополнительными ионами, бесплатно."

#. STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.EFFECT"
msgid "Conducts <link=\"RESEARCHDLC1\">Materials Science Research</link> to unlock new technologies.\n\nConsumes Radbolts.\n\nAssigned Duplicants must possess the <link=\"ATOMICRESEARCH\">Applied Sciences Research</link> skill."
msgstr "Проводит <link=\"RESEARCHDLC1\">Исследования материй</link>, для открытия новых технологий.\n\Потребляет радчастицы.\n\nНазначенные Дупликаты должны обладать навыком <link=\"ATOMICRESEARCHER\">Атомная физика</link>.

#. STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.NUCLEARRESEARCHCENTER.NAME"
msgid "<link=\"NUCLEARRESEARCHCENTER\">Materials Study Terminal</link>"
msgstr "<link=\"NUCLEARRESEARCHCENTER\">Терминал материй</link>"

#. STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.DESC"
msgid "Automatic dispensers will store and drop resources in small quantities."
msgstr "Авто-дозаторы будут хранить и сбрасывать небольшие объемы ресурсов."

#. STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.EFFECT"
msgid "Stores any <link=\"ELEMENTSSOLID\">Solid Materials</link> delivered to it by Duplicants.\n\nDumps stored materials back into the world when it receives a <b><style=\"logic_on\">Green Signal</style></b>."
msgstr "Хранит любой <link=\"ELEMENTSSOLID\">Твердотелый материал</link>, доставленный в него Дупликантами.\n\nСбрасывает, хранимые материалы обратно в мир, если получает <b><style=\"logic_off\">Красный сигнал</style></b>."

#. STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT"
msgid "Dump Trigger"
msgstr "Триггер сброса"

#. STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Dump all stored materials"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Сбрасывает все хранимые материалы"

#. STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.LOGIC_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Store materials"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Хранит материалы"

#. STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OBJECTDISPENSER.NAME"
msgid "<link=\"OBJECTDISPENSER\">Automatic Dispenser</link>"
msgstr "<link=\"OBJECTDISPENSER\">Авто-дозатор</link>"

#. STRINGS.BUILDINGS.PREFABS.OILREFINERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OILREFINERY.DESC"
msgid "Petroleum can only be produced from the refinement of crude oil."
msgstr "Керосин может добываться только при переработке сырой нефти."

#. STRINGS.BUILDINGS.PREFABS.OILREFINERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OILREFINERY.EFFECT"
msgid "Converts <link=\"CRUDEOIL\">Crude Oil</link> into <link=\"PETROLEUM\">Petroleum</link> and <link=\"METHANE\">Natural Gas</link>."
msgstr "Перерабатывает <link=\"CRUDEOIL\">Сырую нефть</link> в <link=\"PETROLEUM\">Керосин</link> и <link=\"METHANE\">Природный газ</link>."

#. STRINGS.BUILDINGS.PREFABS.OILREFINERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OILREFINERY.NAME"
msgid "<link=\"OILREFINERY\">Oil Refinery</link>"
msgstr "<link=\"OILREFINERY\">Нефтеперегонная установка</link>"

#. STRINGS.BUILDINGS.PREFABS.OILWELLCAP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OILWELLCAP.DESC"
msgid "Water pumped into an oil reservoir cannot be recovered."
msgstr "Вода, закаченная в нефтяную скважину не может быть откачана обратно."

#. STRINGS.BUILDINGS.PREFABS.OILWELLCAP.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OILWELLCAP.EFFECT"
msgid "Extracts <link=\"CRUDEOIL\">Crude Oil</link> using clean <link=\"WATER\">Water</link>.\n\nMust be built atop an <link=\"OILWELL\">Oil Reservoir</link>."
msgstr "Добывает <link=\"CRUDEOIL\">Сырую нефть</link>, используя чистую <link=\"WATER\">Воду</link>.\n\nДолжна быть построена на <link=\"OILWELL\">нефтяной скважине</link>."

#. STRINGS.BUILDINGS.PREFABS.OILWELLCAP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OILWELLCAP.NAME"
msgid "<link=\"OILWELLCAP\">Oil Well</link>"
msgstr "<link=\"OILWELLCAP\">Нефтяная скважина</link>"

#. STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.DESC"
msgid "It's a generally good idea to pack some supplies when exploring unknown worlds."
msgstr "Упаковывать припасы перед отправкой для исследования неизвестных миров - хорошая идея."

#. STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.EFFECT"
msgid "Delivers cargo to the surface of Planetoids that do not yet have a <link=\"LAUNCHPAD\">Rocket Platform</link>. \n\nMust be built via Rocket Platform."
msgstr "Доставляет груз на поверхность планетоидов, у которых еще нет <link=\"LAUNCHPAD\">Платформы для шаттлов</link>. \n\nДолжен быть построен с помощью платформы для шаттлов."

#. STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALCARGOMODULE.NAME"
msgid "<link=\"ORBITALCARGOMODULE\">Orbital Cargo Module</link>"
msgstr "<link=\"ORBITALCARGOMODULE\">Орбитальный грузовой модуль</link>"

#. STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.DESC"
msgid "Orbital Data Collection Labs record data while orbiting a Planetoid and write it to a <link=\"ORBITALRESEARCHDATABANK\">Data Bank</link>. "
msgstr "Орбитальная лаборатория, расположенные на орбите, записывают информацию, пока оборачиваются вокруг планетоидов, и сохранают ее в <link=\"ORBITALRESEARCHDATABANK\">Банки данных</link>."

#. STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.EFFECT"
msgid "Creates <link=\"ORBITALRESEARCHDATABANK\">Data Banks</link> that can be consumed at a <link=\"DLC1COSMICRESEARCHCENTER\">Virtual Planetarium</link> to unlock new technologies.\n\nConsumes <link=\"POLYPROPYLENE\">Plastic</link> and <link=\"POWER\">Power</link>."
msgstr "Создает <link=\"ORBITALRESEARCHDATABANK\">Банки данных</link>, которые можно использовать в <link=\"DLC1COSMICRESEARCHCENTER\">Планетарии</link> для открытия новых технологий.\n\nПотребляет <link=\"POLYPROPYLENE\">Пластик</link> и <link=\"POWER\">Электричество</link>."

#. STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ORBITALRESEARCHCENTER.NAME"
msgid "<link=\"ORBITALRESEARCHCENTER\">Orbital Data Collection Lab</link>"
msgstr "<link=\"ORBITALRESEARCHCENTER\">Орбитальная лаборатория</link>"

#. STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.DESC"
msgid "Scrubbers sanitize freshly mined materials before they're brought into the colony."
msgstr "Очистители руды дезинфицируют свежесобранные ресурсы, прежде чем привезти их в колонию."

#. STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.EFFECT"
msgid "Kills a significant amount of <link=\"DISEASE\">Germs</link> present on <link=\"RAWMINERAL\">Raw Ore</link>."
msgstr "Убивает огромное количество <link=\"DISEASE\">Микробов</link>, находящихся на поверхности <link=\"RAWMINERAL\">Руды</link>."

#. STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.ORESCRUBBER.NAME"
msgid "<link=\"ORESCRUBBER\">Ore Scrubber</link>"
msgstr "<link=\"ORESCRUBBER\">Обеззараживатель руды</link>"

#. STRINGS.BUILDINGS.PREFABS.OUTHOUSE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OUTHOUSE.DESC"
msgid "The colony that eats together, excretes together."
msgstr "Дупликанты без доступа к туалету сделают \"беспорядок\", вызывая стресс и распространение микробов."

#. STRINGS.BUILDINGS.PREFABS.OUTHOUSE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OUTHOUSE.EFFECT"
msgid "Gives Duplicants a place to relieve themselves.\n\nRequires no <link=\"LIQUIDPIPING\">Piping</link>.\n\nMust be periodically emptied of <link=\"TOXICSAND\">Polluted Dirt</link>."
msgstr "Предоставляет Дупликантам место для справления их нужд.\n\nНе требует <link=\"LIQUIDPIPING\">Водопроводных труб</link>.\n\nДолжно быть периодически очищено от <link=\"TOXICSAND\">Загрязненной земли</link>."

#. STRINGS.BUILDINGS.PREFABS.OUTHOUSE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OUTHOUSE.NAME"
msgid "<link=\"OUTHOUSE\">Outhouse</link>"
msgstr "<link=\"OUTHOUSE\">Отхожее место</link>"

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.DESC"
msgid "Solid oxidizers allows rocket fuel to be efficiently burned in the vacuum of space."
msgstr "Кислородные резервуары позволяют шаттлу более эффективно сжигать топливо в вакууме космоса."

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.EFFECT"
msgid "Stores <link=\"OXYROCK\">Oxylite</link> and other oxidizers for burning rocket fuels."
msgstr "Хранит <link=\"OXYROCK\">Оксилит</link> и другие ресурсы, подходящие для использования в качестве топлива шаттла."

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.NAME"
msgid "<link=\"OXIDIZERTANK\">Solid Oxidizer Tank</link>"
msgstr "<link=\"OXIDIZERTANK\">Резервуар твердого кислорода</link>"

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.UI_FILTER_CATEGORY
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANK.UI_FILTER_CATEGORY"
msgid "Accepted Oxidizers"
msgstr "Допустимые окислители"

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.DESC"
msgid "Solid oxidizers allows rocket fuel to be efficiently burned in the vacuum of space."
msgstr "Кислородные резервуары позволяют шаттлу более эффективно сжигать топливо в вакууме космоса."

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.EFFECT"
msgid "Stores <link=\"OXYROCK\">Oxylite</link> and other oxidizers for burning rocket fuels.\n\nMust be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr "Хранит <link=\"OXYROCK\">Оксилит</link> и другие ресурсы, подходящие для использования в качестве топлива шаттла. \n\nДолжен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>"

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.NAME"
msgid "<link=\"OXIDIZERTANKCLUSTER\">Large Solid Oxidizer Tank</link>"
msgstr "<link=\"OXIDIZERTANKCLUSTER\">Большой резервуар твердого кислорода</link>"

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.UI_FILTER_CATEGORY
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKCLUSTER.UI_FILTER_CATEGORY"
msgid "Accepted Oxidizers"
msgstr "Допустимые окислители"

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.DESC"
msgid "Liquid oxygen improves the thrust-to-mass ratio of rocket fuels."
msgstr "Жидкий кислород улучшает соотношение тяги к массе ракетного топлива."

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.EFFECT"
msgid "Stores <link=\"LIQUIDOXYGEN\">Liquid Oxygen</link> for burning rocket fuels."
msgstr "Хранит <link=\"LIQUIDOXYGEN\">Жидкий кислород</link> для сжигания в качестве топлива в шаттле."

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUID.NAME"
msgid "<link=\"OXIDIZERTANKLIQUID\">Liquid Oxidizer Tank</link>"
msgstr "<link=\"OXIDIZERTANKLIQUID\">Резервуар жидкого кислорода</link>"

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.DESC"
msgid "Liquid oxygen improves the thrust-to-mass ratio of rocket fuels."
msgstr "Жидкий кислород улучшает соотношение тяги к массе ракетного топлива."

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.EFFECT"
msgid "Stores <link=\"LIQUIDOXYGEN\">Liquid Oxygen</link> for burning rocket fuels. \n\nMust be built via <link=\"LAUNCHPAD\">Rocket Platform</link>."
msgstr "Хранит <link=\"LIQUIDOXYGEN\">Жидкий кислород</link> для сжигания в качестве топлива в шаттле. \n\nДолжен быть построен с помощью <link=\"LAUNCHPAD\">Платформы для шаттлов</link>"

#. STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXIDIZERTANKLIQUIDCLUSTER.NAME"
msgid "<link=\"OXIDIZERTANKLIQUIDCLUSTER\">Liquid Oxidizer Tank</link>"
msgstr "<link=\"OXIDIZERTANKLIQUIDCLUSTER\">Резервуар для жидкого кислорода</link>"

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.DESC"
msgid "An oxygen mask dock will store and refill masks while they're not in use."
msgstr "Док кислородных масок будет хранить и заправлять маски, пока они не используются."

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.EFFECT"
msgid "Stores <link=\"OXYGENMASK\">Oxygen Masks</link> and refuels them with <link=\"OXYGEN\">Oxygen</link>.\n\nBuild next to an <link=\"OXYGENMASKMARKER\">Oxygen Mask Checkpoint</link> to make Duplicants put on masks when passing by."
msgstr "Хранит <link=\"JETSUIT\">Кислородные маски</link>, заправляет их <link=\"OXYGEN\">Кислородом</link>.\n\nПостройте рядом с <link=\"OXYGENMASKMARKER\">Контрольным пунктом кислородных масок</link>, чтобы Дупликанты брали маски, проходя мимо."

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKLOCKER.NAME"
msgid "<link=\"OXYGENMASKLOCKER\">Oxygen Mask Dock</link>"
msgstr "<link=\"OXYGENMASKLOCKER\">Док кислородных масок</link>"

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.DESC"
msgid "A checkpoint must have a correlating dock built on the opposite side its arrow faces."
msgstr "Контрольный пункт должен иметь док кислородных масок, построенный на противоположной стороне."

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.EFFECT"
msgid "Marks a threshold where Duplicants must put on or take off an <link=\"OXYGENMASK\">Oxygen Mask</link>.\n\nMust be built next to an <link=\"OXYGENMASKLOCKER\">Oxygen Mask Dock</link>.\n\nCan be rotated before construction."
msgstr "Отмечает порог, при котором Дупликанты должны надеть или снять свои <link=\"OXYGENMASK\">кислородные маски</link>.\n\nДолжен быть построен рядом с <link=\"OXYGENMASKLOCKER\">доком кислородных масок</link>.\n\nМожет быть повернута перед постройкой."

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKMARKER.NAME"
msgid "<link=\"OXYGENMASKMARKER\">Oxygen Mask Checkpoint</link>"
msgstr "<link=\"OXYGENMASKMARKER\">Контрольный пункт кислородных масок</link>"

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.DESC"
msgid "Duplicants can't pass by a station if it lacks enough oxygen to fill a mask."
msgstr "Дупликанты не смогут пройти мимо постройки, если в ней нет недостаточно кислорода для наполнения маски."

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.EFFECT"
msgid "Uses designated <link=\"METAL\">Metal Ores</link> from filter settings to create <link=\"OXYGENMASK\">Oxygen Masks</link>.\n\nAutomatically draws in ambient <link=\"OXYGEN\">Oxygen</link> to fill masks.\n\nMarks a threshold where Duplicants must put on or take off a mask.\n\nCan be rotated before construction."
msgstr "Использует выбранные  <link=\"METAL\">Металлические руды</link>, из выбранных в настройках фильтра, для создания <link=\"OXYGENMASK\">Кислородных масок</link>. Автоматически забирает кислород из окружающей среды для наполнения масок.\n\nОтмечает порог, при котором Дупликанты должны снять или одеть маску.\n\nПостройка может быть повернута перед строительством."

#. STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYGENMASKSTATION.NAME"
msgid "<link=\"OXYGENMASKSTATION\">Oxygen Mask Station</link>"
msgstr "<link=\"OXYGENMASKSTATION\">Станция кислородных масок</link>"

#. STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.DESC"
msgid "Oxylite is a solid and easily transportable source of consumable oxygen."
msgstr "Оксилит - это твердый и легко транспортируемый материал, выделяющий кислород."

#. STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.EFFECT"
msgid "Synthesizes <link=\"OXYROCK\">Oxylite</link> using <link=\"OXYGEN\">Oxygen</link> and a small amount of <link=\"GOLD\">Gold</link>."
msgstr "Синтезирует <link=\"OXYROCK\">Оксилит</link>, используя <link=\"OXYGEN\">Кислород</link> и небольшое количество <link=\"GOLD\">Золота</link>."

#. STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYLITEREFINERY.NAME"
msgid "<link=\"OXYLITEREFINERY\">Oxylite Refinery</link>"
msgstr "<link=\"OXYLITEREFINERY\">Синтезатор оксилита</link>"

#. STRINGS.BUILDINGS.PREFABS.OXYSCONCE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYSCONCE.DESC"
msgid "Sconces prevent diffused oxygen from being wasted inside storage bins."
msgstr "Светильники предотвращают потерю кислорода из оксилита, находясь в хранилищах."

#. STRINGS.BUILDINGS.PREFABS.OXYSCONCE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYSCONCE.EFFECT"
msgid "Stores a small chunk of <link=\"OXYROCK\">Oxylite</link> which gradually releases <link=\"OXYGEN\">Oxygen</link> into the environment."
msgstr "Содержит небольшую порцию <link=\"OXYROCK\">Оксилита</link>, который постепенно выделяет <link=\"OXYGEN\">Кислород</link> в окружающую среду."

#. STRINGS.BUILDINGS.PREFABS.OXYSCONCE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.OXYSCONCE.NAME"
msgid "<link=\"OXYSCONCE\">Oxylite Sconce</link>"
msgstr "<link=\"OXYSCONCE\">Светильник с оксилитом</link>"

#. STRINGS.BUILDINGS.PREFABS.PARKSIGN.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PARKSIGN.DESC"
msgid "Passing through parks will increase Duplicant Morale."
msgstr "Проходя мимо знака \"Парк\" Дупликант получит бонус к морали."

#. STRINGS.BUILDINGS.PREFABS.PARKSIGN.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PARKSIGN.EFFECT"
msgid "Classifies an area as a Park or Nature Reserve."
msgstr "Классифицирует зону в качестве парка или заповедника."

#. STRINGS.BUILDINGS.PREFABS.PARKSIGN.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PARKSIGN.NAME"
msgid "<link=\"PARKSIGN\">Park Sign</link>"
msgstr "<link=\"PARKSIGN\">Знак \"Парк\"</link>"

#. STRINGS.BUILDINGS.PREFABS.PARTYCAKE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PARTYCAKE.DESC"
msgid "Any way you slice it, that's a good looking cake."
msgstr "Как бы вы его ни нарезали, он будет хорошо выглядеть."

#. STRINGS.BUILDINGS.PREFABS.PARTYCAKE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PARTYCAKE.EFFECT"
msgid "Increases <link=\"DECOR\">Decor</link>, contributing to <link=\"MORALE\">Morale</link>.\n\nAdds a <link=\"MORALE\">Morale</link> bonus to Duplicants' parties."
msgstr "Увеличивает показатель <link=\"DECOR\">Декора</link>, влияющий на <link=\"MORALE\">Мораль</link> Дупликантов.\n\nДает бонус к <link=\"MORALE\">Морали</link> для вечеринки Дупликантов."

#. STRINGS.BUILDINGS.PREFABS.PARTYCAKE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PARTYCAKE.NAME"
msgid "<link=\"PARTYCAKE\">Triple Decker Cake</link>"
msgstr "Трехъярусный торт"

#. STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.DESC"
msgid "Petroleum generators have a high energy output but produce a great deal of waste."
msgstr "Генераторы на жидком топливе производят много электричества, но также и много отходов."

#. STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.EFFECT"
msgid "Converts either <link=\"PETROLEUM\">Petroleum</link> or <link=\"ETHANOL\">Ethanol</link> into electrical <link=\"POWER\">Power</link>.\n\nProduces <link=\"CARBONDIOXIDE\">Carbon Dioxide</link> and <link=\"DIRTYWATER\">Polluted Water</link>."
msgstr "Перерабатывает <link=\"PETROLEUM\">Керосин</link> или <link=\"ETHANOL\">Этанол</link> в <link=\"POWER\">Электричество</link>.\n\nПроизводит <link=\"CARBONDIOXIDE\">Углекислый газ</link> и <link=\"DIRTYWATER\">Загрязненную воду</link>."

#. STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PETROLEUMGENERATOR.NAME"
msgid "<link=\"PETROLEUMGENERATOR\">Petroleum Generator</link>"
msgstr "<link=\"PETROLEUMGENERATOR\">Генератор на жидком топливе</link>"

#. STRINGS.BUILDINGS.PREFABS.PHONOBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PHONOBOX.DESC"
msgid "Dancing helps Duplicants get their innermost feelings out."
msgstr "Танцы помогают Дупликантам выпустить свои чувства наружу."

#. STRINGS.BUILDINGS.PREFABS.PHONOBOX.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PHONOBOX.EFFECT"
msgid "Plays music for Duplicants to dance to on their breaks.\n\nIncreases Duplicant <link=\"MORALE\">Morale</link>."
msgstr "Играет музыку для Дупликантов, чтобы они могли танцевать на своих перерывах.\n\nУвеличивает <link=\"MORALE\">Мораль</link> Дупликанта."

#. STRINGS.BUILDINGS.PREFABS.PHONOBOX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PHONOBOX.NAME"
msgid "<link=\"PHONOBOX\">Jukebot</link>"
msgstr "<link=\"PHONOBOX\">Джукбот</link>"

#. STRINGS.BUILDINGS.PREFABS.PIONEERLANDER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERLANDER.DESC"
msgid "Lands a Duplicant on a Planetoid from an orbiting <link=\"PIONEERMODULE\">Trailblazer Module</link>."
msgstr "Приземлит Дупликанта на планетоид из орбитального <link=\"PIONEERMODULE\">Модуля Первопроходца</link>."

#. STRINGS.BUILDINGS.PREFABS.PIONEERLANDER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERLANDER.NAME"
msgid "<link=\"PIONEERLANDER\">Trailblazer Lander</link>"
msgstr "<link=\"PIONEERLANDER\">Капсула первопроходца</link>"

#. STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.DESC"
msgid "That's one small step for Dupekind."
msgstr "Один маленький шаг для всех Дупликантов."

#. STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.EFFECT"
msgid "Enables travel to Planetoids that do not yet have a <link=\"LAUNCHPAD\">Rocket Platform</link>.\n\nCan hold one Duplicant traveller.\n\nDeployment is available while in a Starmap hex adjacent to a Planetoid. \n\nMust be built via Rocket Platform."
msgstr "Позволяет путешествовать к планетоидам, у которых еще нет <link=\"LAUNCHPAD\">Платформы для шаттлов</link>.\n\nМожет содержать одного Дупликанта-путешественника.\n\nРазвертывание доступно только на орбите планетоида. \n\nДолжен быть построен с помощью платформы для шаттлов."

#. STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PIONEERMODULE.NAME"
msgid "<link=\"PIONEERMODULE\">Trailblazer Module</link>"
msgstr "<link=\"PIONEERMODULE\">Модуль Первопроходца</link>"

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.DESC"
msgid "Four pixels which can be individually designated different colors."
msgstr "4 пикселя, каждый из которых способен отображать индивидуально выбранные цвета."

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.EFFECT"
msgid "Pixels can be designated a color when it receives a <b><style=\"logic_on\">Green Signal</style></b> and a different color when it receives a <b><style=\"logic_off\">Red Signal</style></b>.\n\nInput from an <link=\"LOGICWIRE\">Automation Wire</link> controls the whole strip. Input from an <link=\"LOGICRIBBON\">Automation Ribbon</link> can control individual pixels on the strip."
msgstr "При получения пикселем <b><style=\"logic_on\">Зеленого сигнала</style></b> он может отобразить один цвет, а при получении <b><style=\"logic_off\">Красного сигнала</style></b> другой.\n\nВвод из <link=\"LOGICWIRE\">Провода автоматики</link> контролирует все 4 пикселя на полосе. Ввод из <link=\"LOGICRIBBON\">Ленты автоматики</link> может контролировать индивидуально каждый из 4-х пикселей на полосе."

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_NAME"
msgid "RIBBON INPUT"
msgstr "ЛЕНТОЧНЫЙ ВВОД"

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_PORT_ACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_PORT_ACTIVE"
msgid "<b><style=\"logic_on\">Green Signal</style></b>: Display the configured <b><style=\"logic_on\">Green Signal</style></b> pixels"
msgstr "<b><style=\"logic_on\">Зеленый сигнал</style></b>: Отображает выбранный <b><style=\"logic_on\">Зеленого сигнала</style></b> цвет пикселя"

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_PORT_INACTIVE
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.INPUT_PORT_INACTIVE"
msgid "<b><style=\"logic_off\">Red Signal</style></b>: Display the configured <b><style=\"logic_off\">Red Signal</style></b> pixels"
msgstr "<b><style=\"logic_off\">Красный сигнал</style></b>: Отображает выбранный <b><style=\"logic_off\">Красного сигнала</style></b> цвет пикселя"

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.LOGIC_PORT
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.LOGIC_PORT"
msgid "Color Selection"
msgstr "Выбор цвета"

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.NAME"
msgid "<link=\"PIXELPACK\">Pixel Pack</link>"
msgstr "<link=\"PIXELPACK\">Пиксельный экран</link>"

#. STRINGS.BUILDINGS.PREFABS.PIXELPACK.SIDESCREEN_TITLE
msgctxt "STRINGS.BUILDINGS.PREFABS.PIXELPACK.SIDESCREEN_TITLE"
msgid "Pixel Pack"
msgstr "Пиксельный экран"

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.DESC"
msgid "Domestically grown seeds mature more quickly than wild plants."
msgstr "Семена, которые выращиваются внутри, созревают быстрее, чем дикие растения."

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.EFFECT"
msgid "Grows one <link=\"PLANTS\">Plant</link> from a <link=\"PLANTS\">Seed</link>."
msgstr "Выращивает одно <link=\"PLANTS\">Растение</link> из <link=\"PLANTS\">Семени</link>."

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.BRISTLEBLOSSOM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.BRISTLEBLOSSOM.DESC"
msgid "The interior is lined with tiny barbs."
msgstr "Внутри находятся крошечные шипы."

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.BRISTLEBLOSSOM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.BRISTLEBLOSSOM.NAME"
msgid "<link=\"PLANTERBOX\">Bristly Green Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">Шершавый ящик для растений</link>"

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.DEFAULT_PLANTERBOX.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.DEFAULT_PLANTERBOX.DESC"
msgid "Domestically grown seeds mature more quickly than wild plants."
msgstr "Семена, выращенные в домашних условиях, созревают быстрее, чем дикорастущие растения."

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.DEFAULT_PLANTERBOX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.DEFAULT_PLANTERBOX.NAME"
msgid "<link=\"PLANTERBOX\">Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">Ящик для растений</link>"

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.MEALWOOD.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.MEALWOOD.DESC"
msgid "Inspired by genetically modified nature."
msgstr "Вдохновлено генетически модифицированной природой."

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.MEALWOOD.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.MEALWOOD.NAME"
msgid "<link=\"PLANTERBOX\">Mealy Teal Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">Меланжевый ящик для растений</link>"

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SALMON_PINK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SALMON_PINK.DESC"
msgid "It's not exactly a subtle color."
msgstr "Это не самый сдержанный цвет."

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SALMON_PINK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SALMON_PINK.NAME"
msgid "<link=\"PLANTERBOX\">Flashy Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">Яркий ящик для растений</link>"

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SLEETWHEAT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SLEETWHEAT.DESC"
msgid "The thick paint drips are invisible from a distance."
msgstr "Толстые капли краски невидимы издалека."

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SLEETWHEAT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.SLEETWHEAT.NAME"
msgid "<link=\"PLANTERBOX\">Sleet Blue Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">Синий ящик для растений</link>"

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.WHEEZEWORT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.WHEEZEWORT.DESC"
msgid "For the dreamy agriculturalist."
msgstr "Для мечтательного агронома."

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.WHEEZEWORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.FACADES.WHEEZEWORT.NAME"
msgid "<link=\"PLANTERBOX\">Wheezy Whorl Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">Ящик для растений с вихрем</link>"

#. STRINGS.BUILDINGS.PREFABS.PLANTERBOX.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLANTERBOX.NAME"
msgid "<link=\"PLANTERBOX\">Planter Box</link>"
msgstr "<link=\"PLANTERBOX\">Ящик для рассады</link>"

#. STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.DESCRIPTION
msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.DESCRIPTION"
msgid "Maintenance-free blooms that will outlive us all."
msgstr "Цветы, не требующие ухода, которые переживут всех нас."

#. STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.LORE_DLC2
msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.LORE_DLC2"
msgid "Manufactured by Home Staging Heroes Ltd. as commissioned by the Gravitas Facility, to <i>\"Make Space Feel More Like Home.\"</i>\n\nThis bouquet is designed to smell like freshly baked cookies."
msgstr "Произведено компанией \"Домашние Герои\". по заказу Центра Гравитас, чтобы <i>\"Сделать пространство более уютным.\"</i>\n\nЭтот букет предназначен для того, чтобы пахнуть свежеиспеченным печеньем."

#. STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICFLOWERS.NAME"
msgid "Plastic Flowers"
msgstr "Пластиковые цветы"

#. STRINGS.BUILDINGS.PREFABS.PLASTICTILE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICTILE.DESC"
msgid "Plastic tile is mildly antiseptic and can help limit the spread of germs in a colony."
msgstr "Пластиковый блок - антисептический, и позволяет уменьшить распространение микробов в колонии."

#. STRINGS.BUILDINGS.PREFABS.PLASTICTILE.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICTILE.EFFECT"
msgid "Used to build the walls and floors of rooms.\n\nSignificantly increases Duplicant runspeed."
msgstr "Используется как блок пола и стен при строительстве комнат.\n\nЗначительно увеличивает скорость бега Дупликанта."

#. STRINGS.BUILDINGS.PREFABS.PLASTICTILE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PLASTICTILE.NAME"
msgid "<link=\"PLASTICTILE\">Plastic Tile</link>"
msgstr "<link=\"PLASTICTILE\">Пластиковый блок</link>"

#. STRINGS.BUILDINGS.PREFABS.POIBUNKEREXTERIORDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POIBUNKEREXTERIORDOOR.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.POIBUNKEREXTERIORDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POIBUNKEREXTERIORDOOR.EFFECT"
msgid "A strong door with a sophisticated genetic lock."
msgstr "Прочная дверь со сложным генетическим замком."

#. STRINGS.BUILDINGS.PREFABS.POIBUNKEREXTERIORDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POIBUNKEREXTERIORDOOR.NAME"
msgid "Security Door"
msgstr "Дверь безопасности"

#. STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.EFFECT"
msgid "Large double doors identical to those you might find at the main entrance to a large facility."
msgstr "Большие двустворчатые двери, идентичные тем, что можно найти на главном входе в крупное сооружение."

#. STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDLC2SHOWROOMDOOR.NAME"
msgid "Showroom Doors"
msgstr "Двери шоурума"

#. STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.EFFECT"
msgid "A strong door with a sophisticated genetic lock."
msgstr "Прочная дверь со сложным генетическим замком."

#. STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POIDOORINTERNAL.NAME"
msgid "Security Door"
msgstr "Дверь безопасности"

#. STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.EFFECT"
msgid "Large double doors that were once the main entrance to a large facility."
msgstr "Массивные двойные двери, которые ранее служили главным входом в большое учреждение."

#. STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POIFACILITYDOOR.NAME"
msgid "Lobby Doors"
msgstr "Двери учреждения"

#. STRINGS.BUILDINGS.PREFABS.POLYMERIZER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.DESC"
msgid "Plastic can be used to craft unique buildings and goods."
msgstr "Пластик используется для производства уникальных построек и товаров."

#. STRINGS.BUILDINGS.PREFABS.POLYMERIZER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.EFFECT"
msgid "Converts <link=\"PETROLEUM\">Petroleum</link> or <link=\"SUGARWATER\">Nectar</link> into raw <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr "Перерабатывает <link=\"PETROLEUM\">Керосин</link> или <link=\"SUGARWATER\">Нектар</link> в <link=\"POLYPROPYLENE\">Пластик</link>."

#. STRINGS.BUILDINGS.PREFABS.POLYMERIZER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POLYMERIZER.NAME"
msgid "<link=\"POLYMERIZER\">Polymer Press</link>"
msgstr "<link=\"POLYMERIZER\">Полимерный пресс</link>"

#. STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.DESC"
msgid "Only one Duplicant may be assigned to a station at a time."
msgstr "Только один Дупликант может быть назначен для работы на станции."

#. STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.EFFECT"
msgid "Produces <link=\"POWERSTATIONTOOLS\">Microchip</link> to increase the <link=\"POWER\">Power</link> output of generators.\n\nAssigned Duplicants must possess the <link=\"TECHNICALS2\">Tune Up</link> trait.\n\nThis building is a necessary component of the Power Plant room."
msgstr "Производит <link=\"POWERSTATIONTOOLS\">микрочип</link> для увеличения производства <link=\"POWER\">Электричества</link> генераторами.\n\nНазначенные Дупликанты должны иметь навык <link=\"TECHNICALS2\">Подстройка</link>.\n\nЭта постройка необходима для комнаты \"Электростанция\"."

#. STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERCONTROLSTATION.NAME"
msgid "<link=\"POWERCONTROLSTATION\">Power Control Station</link>"
msgstr "<link=\"POWERCONTROLSTATION\">Станция управления мощностью</link>"

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.DESC"
msgid "It's a power transformer, but larger."
msgstr "Как трансформатор, только больше."

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.EFFECT"
msgid "Limits <link=\"POWER\">Power</link> flowing through the Transformer to 4 kW.\n\nConnect <link=\"BATTERY\">Batteries</link> on the large side to act as a valve and prevent <link=\"WIRE\">Wires</link> from drawing more than 4 kW.\n\nCan be rotated before construction."
msgstr "Ограничивает мощность <link=\"POWER\">Электричества</link>, передаваемого через трансформатор до 4 кВатт.\n\nСоединяет <link=\"BATTERY\">Батареи</link> с источниками потребления электричества, передавая не более 4 кВатт,тем самым сохраняя <link=\"WIRE\">провода</link> от перегрузки.\n\nМожет быть повернут перед постройкой."

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMER.NAME"
msgid "<link=\"POWERTRANSFORMER\">Large Power Transformer</link>"
msgstr "<link=\"POWERTRANSFORMER\">Трансформатор</link>"

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.DESC"
msgid "Limiting the power drawn by wires prevents them from incurring overload damage."
msgstr "Ограничивает мощность, потребляемого проводами электричества, предотвращая их повреждение от перегрузки."

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.EFFECT"
msgid "Limits <link=\"POWER\">Power</link> flowing through the Transformer to 1000 W.\n\nConnect <link=\"BATTERY\">Batteries</link> on the large side to act as a valve and prevent <link=\"WIRE\">Wires</link> from drawing more than 1000 W.\n\nCan be rotated before construction."
msgstr "Ограничивает мощность <link=\"POWER\">Электричества</link>, передаваемого через трансформатор до 1000 Ватт.\n\nСоединяет <link=\"BATTERY\">Батареи</link> с источниками потребления электричества, передавая не более 1000 Ватт, тем самым сохраняя <link=\"WIRE\">провода</link> от перегрузки.\n\nМожет быть повернут перед постройкой."

#. STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.POWERTRANSFORMERSMALL.NAME"
msgid "<link=\"POWERTRANSFORMERSMALL\">Power Transformer</link>"
msgstr "<link=\"POWERTRANSFORMERSMALL\">Маленький трансформатор</link>"

#. STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.DESC"
msgid "Mechanized airlocks open and close more quickly than other types of door."
msgstr "Механизированный шлюз, подключенный к электрической сети, открывается и закрывается гораздо быстрее, чем другие типы дверей."

#. STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.EFFECT"
msgid "Blocks <link=\"ELEMENTSLIQUID\">Liquid</link> and <link=\"ELEMENTSGAS\">Gas</link> flow, maintaining pressure between areas.\n\nFunctions as a <link=\"MANUALPRESSUREDOOR\">Manual Airlock</link> when no <link=\"POWER\">Power</link> is available.\n\nWild <link=\"CREATURES\">Critters</link> cannot pass through doors."
msgstr "Блокирует потоки <link=\"ELEMENTSLIQUID\">Жидкости</link> и <link=\"ELEMENTSGAS\">Газа</link>, поддерживая атмосферное давление между зонами.\n\nФункционирует как <link=\"MANUALPRESSUREDOOR\">ручной шлюз</link>, когда нет доступа к <link=\"POWER\">Электричеству</link>.\n\nДикие <link=\"CREATURES\">Существа</link> не могут проходить через двери."

#. STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSUREDOOR.NAME"
msgid "<link=\"PRESSUREDOOR\">Mechanized Airlock</link>"
msgstr "<link=\"PRESSUREDOOR\">Авто шлюз</link>"

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.DESC"
msgid "An atmo switch shuts off power when the air pressure surrounding it surpasses the set threshold."
msgstr "Атмосферный датчик, который отключает подачу электричества при установленном пороге атмосферного давления."

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.EFFECT"
msgid "Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"PRESSURE\">Gas Pressure</link> .\n\nDoes not affect circuitry preceding the switch."
msgstr "Автоматизирует переключение <link=\"POWER\">Электричества</link> в сети на включено или выключено, исходя из <link=\"PRESSURE\">Атмосферного давления</link> газа в окружающей среде.\n\nНе влияет на часть сети, расположенную до датчика."

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHGAS.NAME"
msgid "<link=\"PRESSURESWITCHGAS\">Atmo Switch</link>"
msgstr "<link=\"PRESSURESWITCHGAS\">Атмосферный датчик</link>"

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.DESC"
msgid "A hydro switch shuts off power when the liquid pressure surrounding it surpasses the set threshold."
msgstr "Датчик воды отключает подачу электричества при определенном, установленном пороге давления жидкости."

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.EFFECT"
msgid "Automatically turns <link=\"POWER\">Power</link> on or off using ambient <link=\"PRESSURE\">Liquid Pressure</link>.\n\nDoes not affect circuitry preceding the switch.\n\nMust be submerged in <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr "Автоматизирует переключение <link=\"POWER\">Электричества</link> в сети на включено или выключено, исходя из <link=\"PRESSURE\">Давления жидкости</link> в окружающей среде.\n\nНе влияет на часть сети, расположенную до датчика.\n\nДолжен быть погружен в <link=\"ELEMENTSLIQUID\">Жидкость</link>."

#. STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PRESSURESWITCHLIQUID.NAME"
msgid "<link=\"PRESSURESWITCHLIQUID\">Hydro Switch</link>"
msgstr "<link=\"PRESSURESWITCHLIQUID\">Датчик воды</link>"

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.DESC"
msgid "A poster promoting a local tourist attraction.\n\nActual scenery may vary."
msgstr "Плакат, рекламирующий местную туристическую достопримечательность.\n\nФактический вид может отличаться."

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERA.NAME"
msgid "Travel Poster"
msgstr "Туристический плакат"

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.DESC"
msgid "A poster promoting local wildlife.\n\nThe first in an unfinished series."
msgstr "Плакат, рекламирующий местную дикую природу.\n\nПервый в незавершенной серии."

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERB.NAME"
msgid "Travel Poster"
msgstr "Туристический плакат"

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.DESC"
msgid "A sound-absorbing panel that makes small-space living more bearable.\n\nThe artwork features a  power source."
msgstr "Панель, поглощающая звук, которая делает жизнь в небольших помещениях более терпимой.\n\nНа картине изображен источник питания."

#. STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCERESPOSTERLARGE.NAME"
msgid "Acoustic Art Panel"
msgstr "Акустическая художественная панель"

#. STRINGS.BUILDINGS.PREFABS.PROPCLOCK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOCK.DESC"
msgid "A simple wall clock.\n\nIt is no longer ticking."
msgstr "Простые настенные часы.\n\nУже давно не ходят."

#. STRINGS.BUILDINGS.PREFABS.PROPCLOCK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOCK.NAME"
msgid "Clock"
msgstr "Часы"

#. STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.DESC"
msgid "Holds one <link=\"WARMVEST\">Warm Coat</link>.\n\nIt'd be silly not to use it."
msgstr "Вмещает один <link=\"WARMVEST\">Теплый свитер</link>.\n\nБыло бы глупо не использовать его."

#. STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPCLOTHESHANGER.NAME"
msgid "Coat Rack"
msgstr "Вешалка для одежды"

#. STRINGS.BUILDINGS.PREFABS.PROPDESK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDESK.DESC"
msgid "An intact office desk, decorated with several personal belongings and a barely functioning computer."
msgstr "Нетронутый офисный стол, украшенный несколькими личными вещами и едва функционирующим компьютером."

#. STRINGS.BUILDINGS.PREFABS.PROPDESK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDESK.NAME"
msgid "Computer Desk"
msgstr "Компьютерный стол"

#. STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.DESC"
msgid "An electronic display projecting the blueprint of an engineering project.\n\nIt looks like a pump of some kind."
msgstr "Электронный дисплей, проецирующий чертеж инженерного проекта.\n\nПохоже на насос какого-то рода."

#. STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2DISPLAY1.NAME"
msgid "Electronic Display"
msgstr "Электронный дисплей"

#. STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.DESC"
msgid "Maintenance equipment that once flushed debris out of complex mechanisms.\n\nOne of the wheels is squeaky."
msgstr "Оборудование для технического обслуживания, которое когда-то смывало мусор из сложных механизмов.\n\nОдно из колес скрипит."

#. STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPDLC2GEOTHERMALCART.NAME"
msgid "Service Cart"
msgstr "Служебная тележка"

#. STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.DESC"
msgid "Out of service.\n\nThe buttons inside indicate it went down more than a dozen floors at one point in time."
msgstr "Не работает.\n\nКнопки внутри говорят о том, что когда-то давно он ушел вниз более чем на десяток этажей."

#. STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPELEVATOR.NAME"
msgid "Broken Elevator"
msgstr "Сломанный лифт"

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.DESC"
msgid "A locker made with ultra-lightweight textiles.\n\nIt contains an assortment of personal effects."
msgstr "Шкаф из ультралегких тканей.\n\nСодержит разнообразные личные вещи."

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSETLOCKER.NAME"
msgid "Off-site Locker"
msgstr "Личный шкаф"

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.DESC"
msgid "A shelf made out of flat-packed pieces that can be assembled in various ways.\n\nThis is the long way."
msgstr "Полка из плоских деталей, которые можно собрать по-разному.\n\nЭто длинный вариант."

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELFLONG.NAME"
msgid "Long Prefab Shelf"
msgstr "Длинная сборная полка"

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.DESC"
msgid "A shelf made out of flat-packed pieces that can be assembled in various ways.\n\nIt looks nice, actually."
msgstr "Полка из плоских деталей, которые можно собрать по-разному.\n\nНа самом деле выглядит неплохо."

#. STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPEXOSHELSHORT.NAME"
msgid "Prefab Shelf"
msgstr "Сборная полка"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.DESC"
msgid "A chair where visitors can comfortably wait before their appointments."
msgstr "Стул, где посетители могут с комфортом ожидать назначенной им встречи."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHAIR.NAME"
msgid "Lobby Chair"
msgstr "Стул для посетителей"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.DESC"
msgid "A large chandelier that hangs from the ceiling.\n\nIt does not appear to function."
msgstr "Большая люстра, свисающая с потолка.\n\nНе похоже, что она функционирует."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCHANDELIER.NAME"
msgid "Chandelier"
msgstr "Люстра"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.DESC"
msgid "A couch where visitors can comfortably wait before their appointments."
msgstr "Диван, где посетители могут с комфортом ожидать назначенной им встречи."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYCOUCH.NAME"
msgid "Lobby Couch"
msgstr "Диван для посетителей"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.DESC"
msgid "A spotless desk filled with impeccably organized office supplies.\n\nA photo peeks out from beneath the desk pad, depicting two beaming young women in caps and gowns.\n\nThe photo is quite old."
msgstr "Безупречный стол, наполненный безукоризненно организованными канцелярскими принадлежностями.\n\nИз-под стола выглядывает фотография, изображая двух сияющих молодых женщин в шляпах и платьях.\n\nНа вид фотографии довольно старая."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDESK.NAME"
msgid "Director's Desk"
msgstr "Стол директора"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY1.DESC"
msgid "An electronic display projecting the blueprint of a familiar device.\n\nIt looks like a Printing Pod."
msgstr "Электронный дисплей, проецирующий чертеж странного устройства.\n\nВыглядит как подставка для печати."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY1.NAME"
msgid "Electronic Display"
msgstr "Электронный дисплей"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY2.DESC"
msgid "An electronic display projecting the blueprint of a familiar device.\n\nIt looks like a Mining Gun."
msgstr "Электронный дисплей, проецирующий чертеж странного устройства.\n\nВыглядит как буровая пушка."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY2.NAME"
msgid "Electronic Display"
msgstr "Электронный дисплей"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.DESC"
msgid "An electronic display projecting the blueprint of a strange device.\n\nPerhaps these displays were used to entice visitors."
msgstr "Электронный дисплей, проецирующий чертеж странного устройства.\n\nВозможно эти дисплеи создавались для привлечения посетителей."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYDISPLAY3.NAME"
msgid "Electronic Display"
msgstr "Электронный дисплей"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.DESC"
msgid "A filing cabinet for storing hard copy employee records.\n\nThe contents have been shredded."
msgstr "Шкаф для хранения хранимых записей сотрудников.\n\nСодержимое было измельчено."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYGLOBEDROORS.NAME"
msgid "Filing Cabinet"
msgstr "Шкаф для хранения документов"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.DESC"
msgid "A long light fixture that hangs from the ceiling.\n\nIt does not appear to function."
msgstr "Длинный светильник, свисающий с потолка.\n\nНе похоже, что он функционирует."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYLAMP.NAME"
msgid "Light Fixture"
msgstr "Светильник"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.DESC"
msgid "A painting featuring a copse of fir trees and a magnificent mountain range on the horizon.\n\nThe air in the room prickles with the sensation that I'm not meant to be here."
msgstr "Картина с изображением елового леса и великолепного горного хребта на горизонте. \n\nВоздух в комнате создает ощущение, что я не должен здесь находиться."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYPAINTING.NAME"
msgid "Landscape Portrait"
msgstr "Картина с ландшафтом"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.DESC"
msgid "A large, modern sculpture that sits in the center of the lobby.\n\nIt's an artistic cross between an hourglass shape and a double helix."
msgstr "В центре лобби расположена большая современная скульптура.\n\nОна напоминает что-то среднее между формой песочных часов и двойной спиралью."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYSTATUE.NAME"
msgid "Gravitas Monument"
msgstr "Памятник Гравитас"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.DESC"
msgid "A low coffee table that may have once held old science magazines."
msgstr "Низкий кофейный столик, на котором, возможно, когда-то лежали научные журналы."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTABLE.NAME"
msgid "Coffee Table"
msgstr "Кофейный столик"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.DESC"
msgid "It's survived the vacuum of space by virtue of being plastic."
msgstr "Он пережил вакуум пространства, благодаря тому, что был сделан из пластика."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYTALLPLANT.NAME"
msgid "Office Plant"
msgstr "Офисное растение"

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.DESC"
msgid "Certification in Applied Physics, awarded in recognition of one \"Jacquelyn A. Stern\"."
msgstr "Награда в прикладной физике, присужденный в знак признания достижений \"Жаклин А. Стерн\"."

#. STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPFACILITYWALLDEGREE.NAME"
msgid "Doctorate Degree"
msgstr "Докторская степень"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.DESC"
msgid "Non-functioning robotic arms that once assisted lab technicians."
msgstr "Не функционирующие руки робота, которые когда-то помогали лаборантам."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCEILINGROBOT.NAME"
msgid "Ceiling Robot"
msgstr "Робот-манипулятор"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.DESC"
msgid "An anatomical illustration of the very first <link=\"HATCH\">Hatch</link> ever produced.\n\nWhile the ratio of egg sac to brain may appear outlandish, it is in fact to scale."
msgstr "Анатомическая иллюстрация первого <link=\"HATCH\">Норника</link>, когда-либо произведенного.\n\nХотя соотношение яйцевого мешка к мозгу может показаться странным, оно соответствует масштабу."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASCREATUREPOSTER.NAME"
msgid "Anatomy Poster"
msgstr "Постер с анатомией"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.DESC"
msgid "A tall, thin window which once pointed to a courtyard."
msgstr "Высокое узкое окно, которое выходило на внутренний двор."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDECORATIVEWINDOW.NAME"
msgid "Window"
msgstr "Окно"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.DESC"
msgid "A clutter-proof desk to minimize distractions.\n\nThere appears to be something stored in the computer."
msgstr "Безупречно организованный стол, минимизирующий отвлечения.\n\nПохоже, в компьютере что-то хранится."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDESKPODIUM.NAME"
msgid "Computer Podium"
msgstr "Компьютерный стол"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDISPLAY4.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDISPLAY4.DESC"
msgid "An electronic display projecting the blueprint of a robotic device.\n\nIt looks like a ceiling robot."
msgstr "Электронный дисплей, на котором изображена схема роботизированного устройства.\n\nПохожа на робот-манипулятор."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDISPLAY4.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASDISPLAY4.NAME"
msgid "Electronic Display"
msgstr "Электронный дисплей"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIREEXTINGUISHER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIREEXTINGUISHER.DESC"
msgid "Essential lab equipment.\n\nThe inspection tag indicates it has long expired."
msgstr "Необходимое лабораторное оборудование.\n\nМетка проверки указывает, что срок годности давно истек."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIREEXTINGUISHER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIREEXTINGUISHER.NAME"
msgid "Broken Fire Extinguisher"
msgstr "Сломанный огнетушитель"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIRSTAIDKIT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIRSTAIDKIT.DESC"
msgid "It looks like it's been used a lot."
msgstr "Выглядит так, будто ей пользовались часто."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIRSTAIDKIT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFIRSTAIDKIT.NAME"
msgid "First Aid Kit"
msgstr "Аптечка"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.DESC"
msgid "The grasping robotic claw designed to assist technicians in a lab."
msgstr "Хватательная клешня робота, предназначенная для помощи техникам в лаборатории."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASFLOORROBOT.NAME"
msgid "Robotic Arm"
msgstr "Рука робота"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.DESC"
msgid "A sophisticated security device.\n\nIt appears to use a method other than fingerprints to verify an individual's identity."
msgstr "Сложное устройство защиты.\n\nПохоже, вместо отпечатков пальцев, оно использует другой способ для проверки личности."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASHANDSCANNER.NAME"
msgid "Hand Scanner"
msgstr "Сканер руки"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.DESC"
msgid "An abnormally large brain floating in embalming liquid to prevent decomposition."
msgstr "Аномально большой мозг, плавающий в бальзамирующей жидкости, предотвращающей его разложение."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR1.NAME"
msgid "Big Brain Jar"
msgstr "Большая банка с мозгами"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.DESC"
msgid "The corpse of a proto-hatch creature meticulously preserved in a jar."
msgstr "Труп прото-норника, существа тщательно сохраненного в банке."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASJAR2.NAME"
msgid "Sample Jar"
msgstr "Банка с образцом"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.DESC"
msgid "The quaint research desk of a departed lab technician.\n\nPerhaps the computer stores something of interest."
msgstr "Причудливый исследовательский стол покойного техника лаборатории.\n\nВозможно, его компьютер  хранит что-нибудь интересное."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABTABLE.NAME"
msgid "Lab Desk"
msgstr "Лабораторный стол"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWALL.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWALL.EFFECT"
msgid "A regular wall that once existed in a working lab."
msgstr "Обычная стена, очертивающая пространство когда-то рабочей лаборатории."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWALL.NAME"
msgid "Lab Wall"
msgstr "Лабораторная стена"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOW.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOW.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOW.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOW.EFFECT"
msgid "A lab window. Formerly a portal to the outside world."
msgstr "Лабораторное окно. Раньше было порталом во внешний мир."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOW.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOW.NAME"
msgid "Lab Window"
msgstr "Лабораторное окно"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOWHORIZONTAL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOWHORIZONTAL.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOWHORIZONTAL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOWHORIZONTAL.EFFECT"
msgid "A lab window.\n\nSomeone once stared out of this, contemplating the results of an experiment."
msgstr "Лабораторное окно.\n\nКто-то однажды смотрел в него, размышляя о результатах эксперимента."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOWHORIZONTAL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASLABWINDOWHORIZONTAL.NAME"
msgid "Lab Window"
msgstr "Лабораторное окно"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASROBTICTABLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASROBTICTABLE.DESC"
msgid "The work space of an extinct robotics technician who left behind some unfinished prototypes."
msgstr "Рабочее место вымершего робототехника с неоконченными прототипами."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASROBTICTABLE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASROBTICTABLE.NAME"
msgid "Robotics Research Desk"
msgstr "Стол для исследований робототехники"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSHELF.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSHELF.DESC"
msgid "A shelf holding jars just out of reach for a short person."
msgstr "Полка с банками, вне досягаемости для невысокого человека."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSHELF.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSHELF.NAME"
msgid "Shelf"
msgstr "Полка"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSMALLSEEDLOCKER.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSMALLSEEDLOCKER.DESC"
msgid "A small glass cabinet.\n\nThere's a biohazard symbol on it."
msgstr "Небольшой стеклянный шкаф.\n\nНа нем есть символ биологической опасности."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSMALLSEEDLOCKER.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASSMALLSEEDLOCKER.NAME"
msgid "Wall Cabinet"
msgstr "Шкаф для био-образцов"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLCRATE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLCRATE.DESC"
msgid "A packing crate intended for safety equipment.\n\nIt has been repurposed for tool storage."
msgstr "Бывший ящик для защитной экипировки.\n\nТеперь используется для хранения инструментов."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLCRATE.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLCRATE.NAME"
msgid "Tool Crate"
msgstr "Ящик для инструментов"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLSHELF.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLSHELF.DESC"
msgid "A wall-mounted rack for storing and displaying useful tools at a not-so-useful height."
msgstr "Крепящийся к стене стеллаж для хранения и демонстрации полезных инструментов на не слишком удобной высоте."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLSHELF.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASTOOLSHELF.NAME"
msgid "Tool Rack"
msgstr "Стеллаж для инструментов"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALL.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALL.DESC"
msgid ""
msgstr ""

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALL.EFFECT
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALL.EFFECT"
msgid "The wall of a once-great scientific facility."
msgstr "Стена когда-то великого научного центра."

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALL.NAME
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALL.NAME"
msgid "Wall"
msgstr "Стена"

#. STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALLPURPLE.DESC
msgctxt "STRINGS.BUILDINGS.PREFABS.PROPGRAVITASWALLPURPLE.DESC"
msgid ""
msgstr ""

