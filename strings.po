msgid "<link=\"SQUIRREL\">Cuddle Pip</link>"
msgstr "<link=\"SQUIRREL\">Мягкопип</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.BABY.DESC"
msgid "A chubby little Plug Sluglet.\n\nIn time it will mature into a fully grown <link=\"STATERPILLAR\">Plug Slug</link>."
msgstr "Пухленький маленький Плюгленок.\n\nСо временем он вырастет во взрослого <link=\"STATERPILLAR\">Плюгла</link>."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.BABY.NAME"
msgid "<link=\"STATERPILLAR\">Plug Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">Плюгленок</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.DESC"
msgid "Plug Slugs are dynamic creatures that generate electrical <link=\"POWER\">Power</link> during the night.\n\nTheir power can be harnessed by leaving an exposed wire near areas where they like to sleep."
msgstr "Плюглы - энергичные существа, которые генерируют <link=\"POWER\">Электричество</link> ночью.\n\nИх энергию можно использовать, оставив открытый провод рядом с местом, где они любят спать."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">Яйцо Плюгла</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.NAME"
msgid "<link=\"STATERPILLAR\">Plug Slug</link>"
msgstr "<link=\"STATERPILLAR\">Плюгл</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.DESC"
msgid "A tubby little Smog Sluglet.\n\nIn time it will mature into a fully grown <link=\"STATERPILLAR\">Smog Slug</link>."
msgstr "Толстенький маленький Смогуленок.\n\nСо временем он вырастет во взрослого <link=\"STATERPILLAR\">Смогула</link>."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.BABY.NAME"
msgid "<link=\"STATERPILLAR\">Smog Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">Смогуленок</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.DESC"
msgid "Smog Slugs are porous creatures that draw in unbreathable <link=\"ELEMENTSGAS\">Gases</link> during the day.\n\nAt night, they sleep near exposed <link=\"GASCONDUIT\">Gas Pipes,</link> where they deposit their cache."
msgstr "Смогулы - пористые существа, которые поглощают непригодные для дыхания <link=\"ELEMENTSGAS\">Газы</link> в течение дня.\n\nНочью они спят рядом с открытыми <link=\"GASCONDUIT\">Вентиляционными</link> отверстиями газопроводов, где откладывают свой запас."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Smog Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">Яйцо Смогула</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_GAS.NAME"
msgid "<link=\"STATERPILLAR\">Smog Slug</link>"
msgstr "<link=\"STATERPILLAR\">Смогул</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.DESC"
msgid "A chonky little Sponge Sluglet.\n\nIn time it will mature into a fully grown <link=\"STATERPILLAR\">Sponge Slug</link>."
msgstr "Пухленький маленький Губуленок.\n\nСо временем он вырастет во взрослого <link=\"STATERPILLAR\">Губула</link>."

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.BABY.NAME"
msgid "<link=\"STATERPILLAR\">Sponge Sluglet</link>"
msgstr "<link=\"STATERPILLAR\">Губуленок</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.DESC"
msgid "Sponge Slugs are thirsty creatures that soak up <link=\"ELEMENTSLIQUID\">Liquids</link> during the day.\n\nThey deposit their stored <link=\"ELEMENTSLIQUID\">Liquids</link> into the exposed <link=\"LIQUIDCONDUIT\">Liquid Pipes</link> they sleep next to at night."
msgstr "Губулы - жаждущие существа, которые впитывают <link=\"ELEMENTSLIQUID\">Жидкости</link> в течение дня.\n\n

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.EGG_NAME"
msgid "<link=\"STATERPILLAR\">Sponge Slug Egg</link>"
msgstr "<link=\"STATERPILLAR\">Яйцо Губула</link>"

#. STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STATERPILLAR.VARIANT_LIQUID.NAME"
msgid "<link=\"STATERPILLAR\">Sponge Slug</link>"
msgstr "<link=\"STATERPILLAR\">Губул</link>"

#. STRINGS.CREATURES.SPECIES.STEAMSPOUT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.STEAMSPOUT.DESC"
msgid "A rocky vent that spouts <link=\"STEAM\">Steam</link>."
msgstr "Скважина, извергающая <link=\"STEAM\">Пар</link>."

#. STRINGS.CREATURES.SPECIES.STEAMSPOUT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.STEAMSPOUT.NAME"
msgid "<link=\"GEYSERS\">Steam Spout</link>"
msgstr "<link=\"GEYSERS\">Паровая скважина</link>"

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DESC"
msgid "A Grubfruit Plant that has flourished after being tended by a <link=\"DIVERGENTSPECIES\">Divergent</link> critter.\n\nIt will produce high quality <link=\"WORMSUPERFRUIT\">Grubfruits</link>."
msgstr "Растение корнефрута, которое зацвело после ухода за ним существа из семейства <link=\"DIVERGENTSPECIES\">Дивергентов</link>.\n\nОно будет производить высококачественные <link=\"WORMSUPERFRUIT\">Корнефруты</link>."

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"WORMSUPERFRUIT\">Grubfruit</link>."
msgstr "Это растение производит съедобные <link=\"WORMSUPERFRUIT\">Корнефруты</link>."

#. STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SUPERWORMPLANT.NAME"
msgid "<link=\"WORMPLANT\">Grubfruit Plant</link>"
msgstr "<link=\"WORMPLANT\">Растение корнефрут</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.DESC"
msgid "Swamp Chards are incapable of propagating but can be harvested for a single low quality and calorie dense <link=\"FOOD\">Food</link> serving."
msgstr "Трясинник не способен размножаться, но его можно собрать, чтобы получить одну порцию низкокачественной, но калорийной <link=\"FOOD\">Еды</link>."

#. STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPFORAGEPLANTPLANTED.NAME"
msgid "<link=\"SWAMPFORAGEPLANTPLANTED\">Swamp Chard</link>"
msgstr "<link=\"SWAMPFORAGEPLANTPLANTED\">Трясинник</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DESC"
msgid "Bog Buckets produce juicy, sweet <link=\"SWAMPFRUIT\">Bog Jellies</link> for <link=\"FOOD\">Food</link>."
msgstr "Багровник производят сочные, сладкое <link=\"SWAMPFRUIT\">Болотное желе</link> для <link=\"FOOD\">Еды</link>."

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"SWAMPFRUIT\">Bog Jellies</link>."
msgstr "Это растение производит съедобное <link=\"SWAMPFRUIT\">Болотное желе</link>."

#. STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPHARVESTPLANT.NAME"
msgid "<link=\"SWAMPHARVESTPLANT\">Bog Bucket</link>"
msgstr "<link=\"SWAMPHARVESTPLANT\">Багровник</link>"

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.DESC"
msgid "Balm Lilies produce <link=\"SWAMPLILYFLOWER\">Balm Lily Flower</link>, a lovely bloom with medicinal properties."
msgstr "При созревании Бальзамная лилия производит <link=\"SWAMPLILYFLOWER\">Цветок бальзамной лилии</link>, обладающий лечебными свойствами."

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.DOMESTICATEDDESC"
msgid "This plant produces medicinal <link=\"SWAMPLILYFLOWER\">Balm Lily Flower</link>."
msgstr "При созревании это растение производит <link=\"SWAMPLILYFLOWER\">Цветок бальзамной лилии</link>, используемый в медицине."

#. STRINGS.CREATURES.SPECIES.SWAMPLILY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.SWAMPLILY.NAME"
msgid "<link=\"SWAMPLILY\">Balm Lily</link>"
msgstr "<link=\"SWAMPLILY\">Бальзамная лилия</link>"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.DESC"
msgid "Tranquil Toes improve <link=\"DECOR\">Decor</link> by giving their surroundings the visual equivalent of a foot rub."
msgstr "Тихоцвет улучшает <link=\"DECOR\">Декор</link>, создавая визуальный эффект массажа стоп."

#. STRINGS.CREATURES.SPECIES.TOEPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Это растение улучшает окружающий <link=\"DECOR\">Декор</link>."

#. STRINGS.CREATURES.SPECIES.TOEPLANT.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Бонус к росту"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.NAME"
msgid "<link=\"TOEPLANT\">Tranquil Toes</link>"
msgstr "<link=\"TOEPLANT\">Тихоцвет</link>"

#. STRINGS.CREATURES.SPECIES.TOEPLANT.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.TOEPLANT.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Штраф за увядание"

#. STRINGS.CREATURES.SPECIES.WINECUPS.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.DESC"
msgid "Mellow Mallows heighten <link=\"DECOR\">Decor</link> and alleviate <link=\"STRESS\">Stress</link> with their calming color and cradle shape."
msgstr "Мальва повышает уровень  <link=\"DECOR\">Декора</link> и снижает <link=\"STRESS\">Стресс</link> своим успокаивающим цветом и формой."

#. STRINGS.CREATURES.SPECIES.WINECUPS.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.DOMESTICATEDDESC"
msgid "This plant improves ambient <link=\"DECOR\">Decor</link>."
msgstr "Это растение увеличивает уровень <link=\"DECOR\">Декора</link>."

#. STRINGS.CREATURES.SPECIES.WINECUPS.GROWTH_BONUS
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.GROWTH_BONUS"
msgid "Growth Bonus"
msgstr "Бонус роста"

#. STRINGS.CREATURES.SPECIES.WINECUPS.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.NAME"
msgid "<link=\"WINECUPS\">Mellow Mallow</link>"
msgstr "<link=\"WINECUPS\">Мальва</link>"

#. STRINGS.CREATURES.SPECIES.WINECUPS.WILT_PENALTY
msgctxt "STRINGS.CREATURES.SPECIES.WINECUPS.WILT_PENALTY"
msgid "Wilt Penalty"
msgstr "Штраф дикости"

#. STRINGS.CREATURES.SPECIES.WOOD_TREE.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.DESC"
msgid "Arbor Trees grow <link=\"FORESTTREE\">Arbor Tree Branches</link> and can be harvested for <link=\"WOOD\">Wood</link>."
msgstr "Деревья арбора производят <link=\"FORESTTREE\">Ветки дерева арбора</link>, которые могут быть срублены для получения link=\"WOOD\">Древесины</link>."

#. STRINGS.CREATURES.SPECIES.WOOD_TREE.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.DOMESTICATEDDESC"
msgid "This plant produces <link=\"FORESTTREE\">Arbor Tree Branches</link> that can be harvested for <link=\"WOOD\">Wood</link>."
msgstr "Это растение производит <link=\"FORESTTREE\">Ветки дерева арбора</link>, которые могут быть срублены для получения <link=\"WOOD\">Древесины</link>."

#. STRINGS.CREATURES.SPECIES.WOOD_TREE.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE.NAME"
msgid "<link=\"FORESTTREE\">Arbor Tree</link>"
msgstr "<link=\"FORESTTREE\">Дерево арбора</link>"

#. STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.DESC"
msgid "Arbor Trees Branches can be harvested for <link=\"WOOD\">Wood</link>."
msgstr "Ветки дерева арбора могут быть срублены для получения <link=\"WOOD\">Древесины</link>."

#. STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOOD_TREE_BRANCH.NAME"
msgid "<link=\"FORESTTREE\">Arbor Tree Branch</link>"
msgstr "<link=\"FORESTTREE\">Ветка дерева Арбора</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.BABY.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.BABY.DESC"
msgid "A little yipping Flox Fawn.\n\nIn time it will mature into a fully grown <link=\"WOODDEER\">Flox</link>."
msgstr "Маленький пищащий детеныш Флокса.\n\nС течением времени он вырастет во взрослого <link=\"WOODDEER\">Флокса</link>."

#. STRINGS.CREATURES.SPECIES.WOODDEER.BABY.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.BABY.NAME"
msgid "<link=\"WOODDEER\">Flox Fawn</link>"
msgstr "<link=\"WOODDEER\">Детеныш Флокса</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.DESC"
msgid "Floxes are nonhostile critters that graze on live and fallen <link=\"HARDSKINBERRY\">Pikeapples</link>.\n\nWhen Flox antlers are fully grown, they harden into shearable <link=\"WOOD\">Wood</link>."
msgstr "Флоксы - доброжелательные существа, которые питаются растушими и упавшими <link=\"HARDSKINBERRY\">Колючебусами</link>.\n\nКогда рога Флоксов полностью вырастут, они превратятся в срубаемую <link=\"WOOD\">Древесину</link>."

#. STRINGS.CREATURES.SPECIES.WOODDEER.EGG_NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.EGG_NAME"
msgid "<link=\"WOODDEER\">Flox Fawn Egg</link>"
msgstr "<link=\"WOODDEER\">Яйцо Флокса</link>"

#. STRINGS.CREATURES.SPECIES.WOODDEER.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WOODDEER.NAME"
msgid "<link=\"WOODDEER\">Flox</link>"
msgstr "<link=\"WOODDEER\">Флокс</link>"

#. STRINGS.CREATURES.SPECIES.WORMPLANT.DESC
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.DESC"
msgid "Spindly Grubfruit Plants produce <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link> for <link=\"FOOD\">Food</link>.\n\nIf it is tended by a <link=\"DIVERGENTSPECIES\">Divergent</link> critter, it will produce high quality fruits instead."
msgstr "Кусты корнефрутов производят <link=\"WORMBASICFRUIT\">Плоды</link>, пригодные для употребления в качестве <link=\"FOOD\">Еды</link>.\n\nЕсли о них заботится существо из семейства <link=\"DIVERGENTSPECIES\">Дивергентов</link>, то он будет производить плоды более высокого качества вместо этого."

#. STRINGS.CREATURES.SPECIES.WORMPLANT.DOMESTICATEDDESC
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.DOMESTICATEDDESC"
msgid "This plant produces edible <link=\"WORMBASICFRUIT\">Spindly Grubfruit</link>."
msgstr "Этот растение производит съедобные <link=\"WORMBASICFRUIT\">Корнефруты</link>."

#. STRINGS.CREATURES.SPECIES.WORMPLANT.NAME
msgctxt "STRINGS.CREATURES.SPECIES.WORMPLANT.NAME"
msgid "<link=\"WORMPLANT\">Spindly Grubfruit Plant</link>"
msgstr "<link=\"WORMPLANT\">Куст Корнефрута</link>"

#. STRINGS.CREATURES.STATS.AGE.NAME
msgctxt "STRINGS.CREATURES.STATS.AGE.NAME"
msgid "Age"
msgstr "Возраст"

#. STRINGS.CREATURES.STATS.AGE.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.AGE.TOOLTIP"
msgid "This critter will die when its <style=\"KKeyword\">Age</style> reaches its species' maximum lifespan"
msgstr "Существа умрут, когда их <style=\"KKeyword\">возраст</style> достигнет максимального возраста для данного вида"

#. STRINGS.CREATURES.STATS.AIRPRESSURE.NAME
msgctxt "STRINGS.CREATURES.STATS.AIRPRESSURE.NAME"
msgid "Air Pressure"
msgstr "Атмосферное давление"

#. STRINGS.CREATURES.STATS.AIRPRESSURE.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.AIRPRESSURE.TOOLTIP"
msgid "The average <style=\"KKeyword\">Gas</style> density of the air surrounding this plant"
msgstr "Средняя плотность <style=\"KKeyword\">газа</style>, окружающего это растение"

#. STRINGS.CREATURES.STATS.BECKONING.NAME
msgctxt "STRINGS.CREATURES.STATS.BECKONING.NAME"
msgid "Accu-moo-lation"
msgstr "Му-копление"

#. STRINGS.CREATURES.STATS.BECKONING.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.BECKONING.TOOLTIP"
msgid "At 100% <style=\"KKeyword\">Accu-moo-lation</style>, a Gassy Moo calls a friend to join them on this asteroid\n\nAfter the new Gassy Moo has landed, <style=\"KKeyword\">Accu-moo-lation</style> is rolled back to 0%"
msgstr "При 100% <style=\"KKeyword\">Му-копление</style> Газомус призывает друга присоединиться к нему на этом астероиде\n\nПосле того как новый Газомус приземлится, <style=\"KKeyword\">Му-копление</style> сбрасывается до 0%"

#. STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.NAME
msgctxt "STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.NAME"
msgid "Body Temperature"
msgstr "Температура тела"

#. STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.CRITTERTEMPERATURE.TOOLTIP"
msgid "This critter's comfortable <style=\"KKeyword\">Body Temperature</style> range is between <b>{0}</b> and <b>{1}</b>"
msgstr "Комфортный диапазон <style=\"KKeyword\">Температуры тела</style> этого существа составляет от <b>{0}</b> до <b>{1}</b>"

#. STRINGS.CREATURES.STATS.DOMESTICATION.NAME
msgctxt "STRINGS.CREATURES.STATS.DOMESTICATION.NAME"
msgid "Domestication"
msgstr "Приручение"

#. STRINGS.CREATURES.STATS.DOMESTICATION.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.DOMESTICATION.TOOLTIP"
msgid "Fully <style=\"KKeyword\">Tame</style> critters produce more materials than wild ones, and may even provide psychological benefits to my colony\n\nThis critter is <b>{0}</b> domesticated"
msgstr "Полностью <style=\"KKeyword\">прирученные</style> существа будут производить больше материалов, чем дикие и даже могут психологически помогать моей колонии\n\nЭто существо: <b>{0}</b>, приручено"

#. STRINGS.CREATURES.STATS.ELEMENTGROWTH.NAME
msgctxt "STRINGS.CREATURES.STATS.ELEMENTGROWTH.NAME"
msgid "Quill Growth"
msgstr "Рост игл"

#. STRINGS.CREATURES.STATS.ELEMENTGROWTH.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.ELEMENTGROWTH.TOOLTIP"
msgid "The amount of time required for this critter to regrow its <style=\"KKeyword\">Tonic Root</style>"
msgstr "Время, необходимое этому существу для отращивания его <style=\"KKeyword\">Тонизирующий корень</style>"

#. STRINGS.CREATURES.STATS.FERTILITY.NAME
msgctxt "STRINGS.CREATURES.STATS.FERTILITY.NAME"
msgid "Reproduction"
msgstr "Репродуктивность"

#. STRINGS.CREATURES.STATS.FERTILITY.TOOLTIP
msgctxt "STRINGS.CREATURES.STATS.FERTILITY.TOOLTIP"
msgid "At 100% <style=\"KKeyword\">Reproduction</style>, critters will reach the end of their reproduction cycle and lay a new <style=\"KKeyword\">Egg</style>\n\nAfter an <style=\"KKeyword\">Egg</style> is laid, <style=\"KKeyword\">Reproduction</style> is rolled back to 0%"
msgstr "При 100% <style=\"KKeyword\">репродуктивности</style>, существо достигнет пика репродуктивности и отложит <style=\"KKeyword\">яйцо</style>\n\nПосле кладки <style=\"KKeyword\">яйца</style>, <style=\"KKeyword\">репродуктивность</style> падает и становится 0%"

