#. STRINGS.ELEMENTS.HARDPOLYPROPYLENE.DESC
msgctxt "STRINGS.ELEMENTS.HARDPOLYPROPYLENE.DESC"
msgid "<link=\"HARDPOLYPROPYLENE\">Plastium</link> is an advanced thermoplastic polymer made from <link=\"TEMPCONDUCTORSOLID\">Thermium</link>, <link=\"POLYPROPYLENE\">Plastic</link> and <link=\"MILKFAT\">Brackwax</link>.\n\nIt is highly heat-resistant and suitable for use in space buildings."
msgstr "<link=\"HARDPOLYPROPYLENE\">Пластиум</link> - это усовершенствованный термопластичный полимер, изготовленный из <link=\"TEMPCONDUCTORSOLID\">Термия</link>, <link=\"POLYPROPYLENE\">Ппластика</link> и <link=\"MILKFAT\">Браковакса</link>.\n\nОн обладает высокой термостойкостью и подходит для использования в космических постройках."

#. STRINGS.ELEMENTS.HARDPOLYPROPYLENE.NAME
msgctxt "STRINGS.ELEMENTS.HARDPOLYPROPYLENE.NAME"
msgid "<link=\"HARDPOLYPROPYLENE\">Plastium</link>"
msgstr "<link=\"HARDPOLYPROPYLENE\">Пластиум</link>"

#. STRINGS.ELEMENTS.HELIUM.DESC
msgctxt "STRINGS.ELEMENTS.HELIUM.DESC"
msgid "(He) Helium is an atomically lightweight, chemical <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "Гелий (He) - атомарно легкий химический <link=\"ELEMENTSGAS\">Газ</link>."

#. STRINGS.ELEMENTS.HELIUM.NAME
msgctxt "STRINGS.ELEMENTS.HELIUM.NAME"
msgid "<link=\"HELIUM\">Helium</link>"
msgstr "<link=\"HELIUM\">Гелий</link>"

#. STRINGS.ELEMENTS.HYDROGEN.DESC
msgctxt "STRINGS.ELEMENTS.HYDROGEN.DESC"
msgid "(H) Hydrogen Gas is the universe's most common and atomically light element in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "Водород (H) - наиболее распространенный и атомарно легкий элемент во вселенной, находящийся в состоянии <link=\"ELEMENTSGAS\">Газа</link>."

#. STRINGS.ELEMENTS.HYDROGEN.NAME
msgctxt "STRINGS.ELEMENTS.HYDROGEN.NAME"
msgid "<link=\"HYDROGEN\">Hydrogen Gas</link>"
msgstr "<link=\"HYDROGEN\">Водород</link>"

#. STRINGS.ELEMENTS.ICE.DESC
msgctxt "STRINGS.ELEMENTS.ICE.DESC"
msgid "(H<sub>2</sub>O) Ice is clean water frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Лед (H<sub>2</sub>O) - это чистая вода, замороженная до <link=\"ELEMENTSSOLID\">Твердого</link> состояния."

#. STRINGS.ELEMENTS.ICE.NAME
msgctxt "STRINGS.ELEMENTS.ICE.NAME"
msgid "<link=\"ICE\">Ice</link>"
msgstr "<link=\"ICE\">Лед</link>"

#. STRINGS.ELEMENTS.IGNEOUSROCK.DESC
msgctxt "STRINGS.ELEMENTS.IGNEOUSROCK.DESC"
msgid "Igneous Rock is a composite of solidified volcanic rock.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "Вулканическая порода - смесь затвердевших вулканических пород.\n\nОна полезна в качестве <b>строительного материала</b>."

#. STRINGS.ELEMENTS.IGNEOUSROCK.NAME
msgctxt "STRINGS.ELEMENTS.IGNEOUSROCK.NAME"
msgid "<link=\"IGNEOUSROCK\">Igneous Rock</link>"
msgstr "<link=\"IGNEOUSROCK\">Вулканическая порода</link>"

#. STRINGS.ELEMENTS.IRON.DESC
msgctxt "STRINGS.ELEMENTS.IRON.DESC"
msgid "(Fe) Iron is a common industrial <link=\"RAWMETAL\">Metal</link>."
msgstr "Железо (Fe) - это распространенный промышленный <link=\"RAWMETAL\">Металл</link>."

#. STRINGS.ELEMENTS.IRON.NAME
msgctxt "STRINGS.ELEMENTS.IRON.NAME"
msgid "<link=\"IRON\">Iron</link>"
msgstr "<link=\"IRON\">Железо</link>"

#. STRINGS.ELEMENTS.IRONGAS.DESC
msgctxt "STRINGS.ELEMENTS.IRONGAS.DESC"
msgid "(Fe) Iron Gas is a common industrial <link=\"RAWMETAL\">Metal</link>, heated into a <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "Железо (Fe) - это распространенный промышленный <link=\"RAWMETAL\">Металл</link>, нагретый до <link=\"ELEMENTSGAS\">Газообразного</link> состояния."

#. STRINGS.ELEMENTS.IRONGAS.NAME
msgctxt "STRINGS.ELEMENTS.IRONGAS.NAME"
msgid "<link=\"IRONGAS\">Iron Gas</link>"
msgstr "<link=\"IRONGAS\">Железо</link>"

#. STRINGS.ELEMENTS.IRONORE.DESC
msgctxt "STRINGS.ELEMENTS.IRONORE.DESC"
msgid "(Fe) Iron Ore is a soft <link=\"RAWMETAL\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "Железная руда (Fe) - мягкий <link=\"RAWMETAL\">Металл</link>.\n\nОна отлично подходит для создания <link=\"POWER\">Электрических</link> сетей."

#. STRINGS.ELEMENTS.IRONORE.NAME
msgctxt "STRINGS.ELEMENTS.IRONORE.NAME"
msgid "<link=\"IRONORE\">Iron Ore</link>"
msgstr "<link=\"IRONORE\">Железная руда</link>"

#. STRINGS.ELEMENTS.ISORESIN.DESC
msgctxt "STRINGS.ELEMENTS.ISORESIN.DESC"
msgid "Isoresin is a crystallized sap composed of long-chain polymers.\n\nIt is used in the production of rare, high grade materials."
msgstr "Изо-смола - кристаллизованный сок, состоящий из длинноцепочечных полимеров.\n\nИспользуется для производства редких высококачественных материалов."

#. STRINGS.ELEMENTS.ISORESIN.NAME
msgctxt "STRINGS.ELEMENTS.ISORESIN.NAME"
msgid "<link=\"ISORESIN\">Isoresin</link>"
msgstr "<link=\"ISORESIN\">Изо-смола</link>"

#. STRINGS.ELEMENTS.KATAIRITE.DESC
msgctxt "STRINGS.ELEMENTS.KATAIRITE.DESC"
msgid "(Ab) Abyssalite is a resilient, crystalline element."
msgstr "Абиссалит (Ab) - это упругий, кристаллический элемент."

#. STRINGS.ELEMENTS.KATAIRITE.NAME
msgctxt "STRINGS.ELEMENTS.KATAIRITE.NAME"
msgid "<link=\"KATAIRITE\">Abyssalite</link>"
msgstr "<link=\"KATAIRITE\">Абиссалит</link>"

#. STRINGS.ELEMENTS.LEAD.DESC
msgctxt "STRINGS.ELEMENTS.LEAD.DESC"
msgid "(Pb) Lead is a soft yet extremely dense <link=\"REFINEDMETAL\">Refined Metal</link>.\n\nIt has a low Overheat Temperature and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(Pb) Свинец мягкий, но невероятно плотный <link=\"REFINEDMETAL\">Очищенный металл</link>.\n\nОн имеет низкую температуру перегрева и подходит для постройки <link=\"POWER\">Электрических систем</link>."

#. STRINGS.ELEMENTS.LEAD.NAME
msgctxt "STRINGS.ELEMENTS.LEAD.NAME"
msgid "<link=\"LEAD\">Lead</link>"
msgstr "<link=\"LEAD\">Свинец</link>"

#. STRINGS.ELEMENTS.LEADGAS.DESC
msgctxt "STRINGS.ELEMENTS.LEADGAS.DESC"
msgid "(Pb) Lead Gas is a soft yet extremely dense <link=\"REFINEDMETAL\">Refined Metal</link> heated into a <link=\"ELEMENTSGAS\">Gaseous</link>."
msgstr "(Pb) Свинцовый газ мягкий, но невероятно плотный <link=\"REFINEDMETAL\">Очищенный металл</link>, разогретый до <link=\"ELEMENTSGAS\">газообразного</link> состояния."

#. STRINGS.ELEMENTS.LEADGAS.NAME
msgctxt "STRINGS.ELEMENTS.LEADGAS.NAME"
msgid "<link=\"LEADGAS\">Lead Gas</link>"
msgstr "<link=\"LEADGAS\">Свинцовый газ</link>"

#. STRINGS.ELEMENTS.LIME.DESC
msgctxt "STRINGS.ELEMENTS.LIME.DESC"
msgid "(CaCO<sub>3</sub>) Lime is a mineral commonly found in <link=\"CREATURES\">Critter</link> egg shells.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "Известняк (CaCO<sub>3</sub>) - минерал, обычно встречающийся в скорлупе <link=\"CRITTERS\">существ</link>.\n\nОн используется в качестве <b>строительного материала</b>."

#. STRINGS.ELEMENTS.LIME.NAME
msgctxt "STRINGS.ELEMENTS.LIME.NAME"
msgid "<link=\"LIME\">Lime</link>"
msgstr "<link=\"LIME\">Известняк</link>"

#. STRINGS.ELEMENTS.LIQUIDCARBONDIOXIDE.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDCARBONDIOXIDE.DESC"
msgid "(CO<sub>2</sub>) Carbon Dioxide is an unbreathable chemical compound.\n\nThis selection is currently in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Углекислый газ (CO<sub>2</sub>) - это не подходящее для дыхания химическое соединение.\n\nЭтот находится в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии."

#. STRINGS.ELEMENTS.LIQUIDCARBONDIOXIDE.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDCARBONDIOXIDE.NAME"
msgid "<link=\"LIQUIDCARBONDIOXIDE\">Liquid Carbon Dioxide</link>"
msgstr "<link=\"LIQUIDCARBONDIOXIDE\">Углекислый газ</link>"

#. STRINGS.ELEMENTS.LIQUIDHELIUM.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDHELIUM.DESC"
msgid "(He) Helium is an atomically lightweight chemical element cooled into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Гелий (He) - это атомарно легкий химический элемент, охлажденный до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.LIQUIDHELIUM.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDHELIUM.NAME"
msgid "<link=\"LIQUIDHELIUM\">Helium</link>"
msgstr "<link=\"LIQUIDHELIUM\">Гелий</link>"

#. STRINGS.ELEMENTS.LIQUIDHYDROGEN.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDHYDROGEN.DESC"
msgid "(H) Hydrogen in its <link=\"ELEMENTSLIQUID\">Liquid</link> state.\n\nIt freezes most substances that come into contact with it."
msgstr "Водород (H) - это химический элемент в <link=\"ELEMENTSLIQUID\">Жидкой</link> форме.\n\nЗамораживает большую часть контактирующих с ним веществ."

#. STRINGS.ELEMENTS.LIQUIDHYDROGEN.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDHYDROGEN.NAME"
msgid "<link=\"LIQUIDHYDROGEN\">Liquid Hydrogen</link>"
msgstr "<link=\"LIQUIDHYDROGEN\">Водород</link>"

#. STRINGS.ELEMENTS.LIQUIDMETHANE.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDMETHANE.DESC"
msgid "(CH<sub>4</sub>) Methane is an alkane.\n\nThis selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Прородный газ (CH<sub>4</sub>) - это алкан.\n\nНаходится в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии."

#. STRINGS.ELEMENTS.LIQUIDMETHANE.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDMETHANE.NAME"
msgid "<link=\"LIQUIDMETHANE\">Liquid Methane</link>"
msgstr "<link=\"LIQUIDMETHANE\">Природный газ</link>"

#. STRINGS.ELEMENTS.LIQUIDOXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDOXYGEN.DESC"
msgid "(O<sub>2</sub>) Oxygen is a breathable chemical.\n\nThis selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Кислород (O<sub>2</sub>) - пригодный для дыхания химикат.\n\nНаходится в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии."

#. STRINGS.ELEMENTS.LIQUIDOXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDOXYGEN.NAME"
msgid "<link=\"LIQUIDOXYGEN\">Liquid Oxygen</link>"
msgstr "<link=\"LIQUIDOXYGEN\">Кислород</link>"

#. STRINGS.ELEMENTS.LIQUIDPHOSPHORUS.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDPHOSPHORUS.DESC"
msgid "(P) Phosphorus is a chemical element.\n\nThis selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Фосфор (P) - это химический элемент.\n\nНаходится в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии."

#. STRINGS.ELEMENTS.LIQUIDPHOSPHORUS.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDPHOSPHORUS.NAME"
msgid "<link=\"LIQUIDPHOSPHORUS\">Liquid Phosphorus</link>"
msgstr "<link=\"LIQUIDPHOSPHORUS\">Фосфор</link>"

#. STRINGS.ELEMENTS.LIQUIDPROPANE.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDPROPANE.DESC"
msgid "(C<sub>3</sub>H<sub>8</sub>) Propane is an alkane.\n\nThis selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state.\n\nIt is useful in <link=\"POWER\">Power</link> production."
msgstr "Пропан (C<sub>3</sub>H<sub>8</sub>) - это алкан в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии.\n\nПропан полезен в выработке <link=\"POWER\">Электричества</link>."

#. STRINGS.ELEMENTS.LIQUIDPROPANE.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDPROPANE.NAME"
msgid "<link=\"LIQUIDPROPANE\">Liquid Propane</link>"
msgstr "<link=\"LIQUIDPROPANE\">Пропан</link>"

#. STRINGS.ELEMENTS.LIQUIDSULFUR.DESC
msgctxt "STRINGS.ELEMENTS.LIQUIDSULFUR.DESC"
msgid "(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> production.\n\nThis selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(S) Сера - широко распространенный химический элемент, получающийся при производстве <link=\"METHANE\">Природного газа</link>.\n\nЭта часть в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии."

#. STRINGS.ELEMENTS.LIQUIDSULFUR.NAME
msgctxt "STRINGS.ELEMENTS.LIQUIDSULFUR.NAME"
msgid "<link=\"LIQUIDSULFUR\">Liquid Sulfur</link>"
msgstr "<link=\"LIQUIDSULFUR\">Сера</link>"

#. STRINGS.ELEMENTS.MAFICROCK.DESC
msgctxt "STRINGS.ELEMENTS.MAFICROCK.DESC"
msgid "Mafic Rock is a variation of <link=\"IGNEOUSROCK\">Igneous Rock</link> that is rich in <link=\"IRON\">Iron</link>.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "Мафический камень - богатая <link=\"IRON\">Железом</link> вариация <link=\"IGNEOUSROCK\">Вулканического камня</link>.\n\nПолезный <b>строительный материал</b>."

#. STRINGS.ELEMENTS.MAFICROCK.NAME
msgctxt "STRINGS.ELEMENTS.MAFICROCK.NAME"
msgid "<link=\"MAFICROCK\">Mafic Rock</link>"
msgstr "<link=\"MAFICROCK\">Мафический камень</link>"

#. STRINGS.ELEMENTS.MAGMA.DESC
msgctxt "STRINGS.ELEMENTS.MAGMA.DESC"
msgid "Magma is a composite of <link=\"IGNEOUSROCK\">Igneous Rock</link> heated into a molten, <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Магма - смесь расплавленных <link=\"IGNEOUSROCK\">Вулканических пород</link> в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии."

#. STRINGS.ELEMENTS.MAGMA.NAME
msgctxt "STRINGS.ELEMENTS.MAGMA.NAME"
msgid "<link=\"MAGMA\">Magma</link>"
msgstr "<link=\"MAGMA\">Магма</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.DECOR
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.DECOR"
msgid "<link=\"DECOR\">Decor</link>: {0}"
msgstr "<link=\"DECOR\">Декор</link>: {0}"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.EFFECTS_HEADER
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.EFFECTS_HEADER"
msgid "<b>Resource Effects:</b>"
msgstr "<b>Эффекты ресурса:</b>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.EXCELLENT_RADIATION_SHIELD
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.EXCELLENT_RADIATION_SHIELD"
msgid "<link=\"RADIATION\">Excellent Radiation Shield</link>"
msgstr "<link=\"RADIATION\">Идеальный радиационный щит</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.HIGH_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.HIGH_SPECIFIC_HEAT_CAPACITY"
msgid "<link=\"HEAT\">Slow Heating</link>"
msgstr "<link=\"HEAT\">Медленный нагрев</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.HIGH_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.HIGH_THERMAL_CONDUCTIVITY"
msgid "<link=\"HEAT\">High Thermal Conductivity</link>"
msgstr "<link=\"HEAT\">Высокая теплопроводность</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.LOW_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.LOW_SPECIFIC_HEAT_CAPACITY"
msgid "<link=\"HEAT\">Thermally Reactive</link>"
msgstr "<link=\"HEAT\">Термоактивный</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.LOW_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.LOW_THERMAL_CONDUCTIVITY"
msgid "<link=\"HEAT\">Insulator</link>"
msgstr "<link=\"HEAT\">Изолятор</link>"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.OVERHEATTEMPERATURE
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.OVERHEATTEMPERATURE"
msgid "<link=\"HEAT\">Overheat Temperature</link>: {0}"
msgstr "<link=\"HEAT\">Температура перегрева</link>: {0}"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.DECOR
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.DECOR"
msgid "This material will add <b>{0}</b> to the finished building's <style=\"KKeyword\">Decor</style>"
msgstr "Этот материал добавляет <b>{0}</b> к уровню <style=\"KKeyword\">декора</style> готовой постройки"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EFFECTS_HEADER
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EFFECTS_HEADER"
msgid "Buildings constructed from this material will have these properties"
msgstr "Постройки изготовленные из этого материала унаследуют перечисленные здесь свойства"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EXCELLENT_RADIATION_SHIELD
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.EXCELLENT_RADIATION_SHIELD"
msgid "<style=\"KKeyword\">Excellent Radiation Shield</style> radiation has a hard time passing through materials with a high <style=\"KKeyword\">Radiation Absorption Factor</style> value. \n\nRadiation Absorption Factor: {1}"
msgstr "<style=\"KKeyword\">Идеальный радиационный щит</style> - радиации трудно проходить через материалы с высоким значением <style=\"KKeyword\">коэффициента поглощения радиации</style>.\n\nУровень абсорбации радиации: {1} "

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_SPECIFIC_HEAT_CAPACITY"
msgid "<style=\"KKeyword\">Slow Heating</style> materials require a large amount of energy to raise in <style=\"KKeyword\">Temperature</style>, and therefore heat and cool slowly\n\nSpecific Heat Capacity: {1} DTU to raise 1g by 1K"
msgstr "<style=\"KKeyword\">Медленно нагревающиеся</style> материалы требуют большого количества энергии, чтобы изменить свою <style=\"KKeyword\">температуру</style> и поэтому медленно нагреваются и остужаются\n\nСпецифическая теплоемкость: {1} DTU для повышения 1 г на 1 К"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.HIGH_THERMAL_CONDUCTIVITY"
msgid "This material disperses <style=\"KKeyword\">Heat</style> because energy transfers quickly through materials with high <style=\"KKeyword\">Thermal Conductivity</style>\n\nBetween two objects, the rate of <style=\"KKeyword\">Heat</style> transfer will be determined by the object with the <i>lowest</i> <style=\"KKeyword\">Thermal Conductivity</style>\n\nThermal Conductivity: {1} W per degree K difference (Oxygen: 0.024 W)"
msgstr "Этот материал рассеивает <style=\"KKeyword\">тепло</style>, потому что энергия быстрее переносится через материалы с высокой <style=\"KKeyword\">теплопроводностью</style>\n\nМежду двумя объектами скорость <style=\"KKeyword\">теплопередачи</style> будет определяться объектом с <i>наименьшей</i> <style=\"KKeyword\">теплопроводностью</style>\n\nТеплопроводность: {1} Вт на градус К (кислород: 0,024 Вт)"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_SPECIFIC_HEAT_CAPACITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_SPECIFIC_HEAT_CAPACITY"
msgid "<style=\"KKeyword\">Thermally Reactive</style> materials require little energy to raise in <style=\"KKeyword\">Temperature</style>, and therefore heat and cool quickly\n\nSpecific Heat Capacity: {1} DTU to raise 1g by 1K"
msgstr "<style=\"KKeyword\">Термоактивные</style> материалы требуют мало энергии для изменения <style=\"KKeyword\">температуры</style>, поэтому быстро нагреваются и остужаются\n\nУдельная теплоемкость: {1} DTU для повышения 1 г на 1 К"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_THERMAL_CONDUCTIVITY
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.LOW_THERMAL_CONDUCTIVITY"
msgid "This material retains <style=\"KKeyword\">Heat</style> because energy transfers slowly through materials with low <style=\"KKeyword\">Thermal Conductivity</style>\n\nBetween two objects, the rate of <style=\"KKeyword\">Heat</style> transfer will be determined by the object with the <i>lowest</i> <style=\"KKeyword\">Thermal Conductivity</style>\n\nThermal Conductivity: {1} W per degree K difference (Oxygen: 0.024 W)"
msgstr "Этот материал сохраняет <style=\"KKeyword\">тепло</style>, потому что энергия медленно переносится через материалы с низкой <style=\"KKeyword\">теплопроводностью</style>\n\nМежду двумя объектами скорость <style=\"KKeyword\">теплопередачи</style> будет определяться объектом с <i>наименьшей</i> <style=\"KKeyword\">теплопроводностью</style>\n\nТеплопроводность: {1} Вт на градус К (кислород: 0,024 Вт)"

#. STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.OVERHEATTEMPERATURE
msgctxt "STRINGS.ELEMENTS.MATERIAL_MODIFIERS.TOOLTIP.OVERHEATTEMPERATURE"
msgid "This material will add <b>{0}</b> to the finished building's <style=\"KKeyword\">Overheat Temperature</style>"
msgstr "Этот материал добавит <b>{0}</b> к <style=\"KKeyword\">температуре перегрева</style> постройки"

#. STRINGS.ELEMENTS.MERCURY.DESC
msgctxt "STRINGS.ELEMENTS.MERCURY.DESC"
msgid "(Hg) Mercury is a metallic <link=\"ELEMENTSLIQUID\">Liquid</link>."
msgstr "Ртуть (Hg) - это металлическая <link=\"ELEMENTSLIQUID\">Жидкость</link>."

#. STRINGS.ELEMENTS.MERCURY.NAME
msgctxt "STRINGS.ELEMENTS.MERCURY.NAME"
msgid "<link=\"MERCURY\">Mercury</link>"
msgstr "<link=\"MERCURY\">Ртуть</link>"

#. STRINGS.ELEMENTS.MERCURYGAS.DESC
msgctxt "STRINGS.ELEMENTS.MERCURYGAS.DESC"
msgid "(Hg) Mercury Gas is a <link=\"RAWMETAL\">Metal</link> heated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "Ртуть (Hg) - это <link=\"RAWMETAL\">Металл</link>, нагретый до <link=\"ELEMENTSGAS\">Газообразного</link> состояния."

#. STRINGS.ELEMENTS.MERCURYGAS.NAME
msgctxt "STRINGS.ELEMENTS.MERCURYGAS.NAME"
msgid "<link=\"MERCURYGAS\">Mercury Gas</link>"
msgstr "<link=\"MERCURYGAS\">Ртуть</link>"

#. STRINGS.ELEMENTS.METHANE.DESC
msgctxt "STRINGS.ELEMENTS.METHANE.DESC"
msgid "Natural Gas is a mixture of various alkanes in a <link=\"ELEMENTSGAS\">Gaseous</link> state.\n\nIt is useful in <link=\"POWER\">Power</link> production."
msgstr "Природный газ - представляет собой смесь различных алканов в <link=\"ELEMENTSGAS\">Газообразном</link> состоянии.\n\nОн используется для производства <link=\"POWER\">Электричества</link>."

#. STRINGS.ELEMENTS.METHANE.NAME
msgctxt "STRINGS.ELEMENTS.METHANE.NAME"
msgid "<link=\"METHANE\">Natural Gas</link>"
msgstr "<link=\"METHANE\">Природный газ</link>"

#. STRINGS.ELEMENTS.MILK.DESC
msgctxt "STRINGS.ELEMENTS.MILK.DESC"
msgid "Brackene is a sodium-rich <link=\"ELEMENTSLIQUID\">Liquid</link>.\n\nIt is useful in <link=\"RANCHING\">Ranching</link>."
msgstr "Бракен — это <link=\"ELEMENTSLIQUID\">Жидкость</link>, богатая натрием.\n\nПолезен в <link=\"RANCHING\">Животноводстве</link>."

#. STRINGS.ELEMENTS.MILK.NAME
msgctxt "STRINGS.ELEMENTS.MILK.NAME"
msgid "<link=\"MILK\">Brackene</link>"
msgstr "<link=\"MILK\">Бракен</link>"

#. STRINGS.ELEMENTS.MILKFAT.DESC
msgctxt "STRINGS.ELEMENTS.MILKFAT.DESC"
msgid "Brackwax is a <link=\"ELEMENTSSOLID\">Solid</link> byproduct of <link=\"MILK\">Brackene</link>."
msgstr "Браковакс — это <link=\"ELEMENTSSOLID\">Твердотелый</link> побочный продукт <link=\"MILK\">Бракенa</link>."

#. STRINGS.ELEMENTS.MILKFAT.NAME
msgctxt "STRINGS.ELEMENTS.MILKFAT.NAME"
msgid "<link=\"MILKFAT\">Brackwax</link>"
msgstr "<link=\"MILKFAT\">Браковакс</link>"

#. STRINGS.ELEMENTS.MILKICE.DESC
msgctxt "STRINGS.ELEMENTS.MILKICE.DESC"
msgid "Frozen Brackene is <link=\"MILK\">Brackene</link> frozen into a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Бракен — это <link=\"MILK\">Бракен</link>, замороженный до <link=\"ELEMENTSSOLID\">Твердотелого</link> состояния."

#. STRINGS.ELEMENTS.MILKICE.NAME
msgctxt "STRINGS.ELEMENTS.MILKICE.NAME"
msgid "<link=\"MILKICE\">Frozen Brackene</link>"
msgstr "<link=\"MILKICE\">Бракен</link>"

#. STRINGS.ELEMENTS.MOLTENALUMINUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENALUMINUM.DESC"
msgid "(Al) Molten Aluminum is a low density <link=\"REFINEDMETAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Al) Алюминий - <link=\"REFINEDMETAL\">Металл</link> низкой плотности, расплавленный до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENALUMINUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENALUMINUM.NAME"
msgid "<link=\"MOLTENALUMINUM\">Molten Aluminum</link>"
msgstr "<link=\"MOLTENALUMINUM\">Алюминий</link>"

#. STRINGS.ELEMENTS.MOLTENCARBON.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCARBON.DESC"
msgid "(C) Liquid Carbon is an abundant, versatile element heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Углерод (C) - это распространенный универсальный элемент, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENCARBON.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCARBON.NAME"
msgid "<link=\"MOLTENCARBON\">Liquid Carbon</link>"
msgstr "<link=\"MOLTENCARBON\">Углерод</link>"

#. STRINGS.ELEMENTS.MOLTENCOBALT.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCOBALT.DESC"
msgid "(Co) Molten Cobalt is a <link=\"REFINEDMETAL\">Refined Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Co) Кобальт - <link=\"REFINEDMETAL\">Очищенный металл</link>, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENCOBALT.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCOBALT.NAME"
msgid "<link=\"MOLTENCOBALT\">Molten Cobalt</link>"
msgstr "<link=\"MOLTENCOBALT\">Кобальт</link>"

#. STRINGS.ELEMENTS.MOLTENCOPPER.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENCOPPER.DESC"
msgid "(Cu) Molten Copper is a conductive <link=\"RAWMETAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Медь (Cu) - это проводящий <link=\"RAWMETAL\">Металл</link>, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENCOPPER.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENCOPPER.NAME"
msgid "<link=\"MOLTENCOPPER\">Molten Copper</link>"
msgstr "<link=\"MOLTENCOPPER\">Медь</link>"

#. STRINGS.ELEMENTS.MOLTENGLASS.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENGLASS.DESC"
msgid "Molten Glass is a composite of granular rock, heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Стекло - композит гранулированной породы, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENGLASS.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENGLASS.NAME"
msgid "<link=\"MOLTENGLASS\">Molten Glass</link>"
msgstr "<link=\"MOLTENGLASS\">Стекло</link>"

#. STRINGS.ELEMENTS.MOLTENGOLD.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENGOLD.DESC"
msgid "(Au) Gold, a conductive precious <link=\"RAWMETAL\">Metal</link>, heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Золото (Au) - это отличный <link=\"RAWMETAL\">Металлический</link> проводник, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENGOLD.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENGOLD.NAME"
msgid "<link=\"MOLTENGOLD\">Molten Gold</link>"
msgstr "<link=\"MOLTENGOLD\">Золото</link>"

#. STRINGS.ELEMENTS.MOLTENIRON.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENIRON.DESC"
msgid "(Fe) Molten Iron is a common industrial <link=\"RAWMETAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Железо (Fe) - это распространенный промышленный <link=\"RAWMETAL\">Металл</link>, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENIRON.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENIRON.NAME"
msgid "<link=\"MOLTENIRON\">Molten Iron</link>"
msgstr "<link=\"MOLTENIRON\">Железо</link>"

#. STRINGS.ELEMENTS.MOLTENLEAD.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENLEAD.DESC"
msgid "(Pb) Lead is an extremely dense <link=\"REFINEDMETAL\">Refined Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Pb) Свинец - чрезвычайно плотный <link=\"REFINEDMETAL\">Очищенный металл</link>, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENLEAD.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENLEAD.NAME"
msgid "<link=\"MOLTENLEAD\">Molten Lead</link>"
msgstr "<link=\"MOLTENLEAD\">Свинец</link>"

#. STRINGS.ELEMENTS.MOLTENNIOBIUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENNIOBIUM.DESC"
msgid "(Nb) Molten Niobium is a rare metal heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(Nb) Ниобий - редкий металл, разогретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENNIOBIUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENNIOBIUM.NAME"
msgid "<link=\"MOLTENNIOBIUM\">Molten Niobium</link>"
msgstr "<link=\"MOLTENNIOBIUM\">Ниобий</link>"

#. STRINGS.ELEMENTS.MOLTENSALT.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSALT.DESC"
msgid "(NaCl) Molten Salt is an edible chemical compound that has been heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "(NaCl) Соль - это съедобное химическое соединение, разогретое до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENSALT.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSALT.NAME"
msgid "<link=\"MOLTENSALT\">Molten Salt</link>"
msgstr "<link=\"MOLTENSALT\">Соль</link>"

#. STRINGS.ELEMENTS.MOLTENSTEEL.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSTEEL.DESC"
msgid "Molten Steel is a <link=\"RAWMETAL\">Metal</link> alloy of iron and carbon, heated into a hazardous <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Сталь - это <link=\"RAWMETAL\">Металлический</link> сплав железа и углерода, нагретый до опасно горячего <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENSTEEL.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSTEEL.NAME"
msgid "<link=\"MOLTENSTEEL\">Molten Steel</link>"
msgstr "<link=\"MOLTENSTEEL\">Сталь</link>"

#. STRINGS.ELEMENTS.MOLTENSUCROSE.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSUCROSE.DESC"
msgid "(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) Liquid Sucrose is the raw form of sugar, heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Сахароза (C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) — это необработанная форма сахара, нагретая до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENSUCROSE.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSUCROSE.NAME"
msgid "<link=\"MOLTENSUCROSE\">Liquid Sucrose</link>"
msgstr "<link=\"MOLTENSUCROSE\">Сахароза</link>"

#. STRINGS.ELEMENTS.MOLTENSYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENSYNGAS.DESC"
msgid "Molten Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSLIQUID\">Liquid</link>.\n\nIt can be converted into an efficient fuel."
msgstr "Синтетический газ — это искусственная, несъедобная <link=\"ELEMENTSLIQUID\">Жидкость</link>.\n\nЕго можно преобразовать в эффективное топливо."

#. STRINGS.ELEMENTS.MOLTENSYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENSYNGAS.NAME"
msgid "<link=\"SYNGAS\">Molten Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">Синтетический газ</link>"

#. STRINGS.ELEMENTS.MOLTENTUNGSTEN.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTEN.DESC"
msgid "(W) Molten Tungsten is a crystalline <link=\"RAWMETAL\">Metal</link> heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Вольфрам (W) - это кристаллический <link=\"RAWMETAL\">Металл</link>, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENTUNGSTEN.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTEN.NAME"
msgid "<link=\"MOLTENTUNGSTEN\">Molten Tungsten</link>"
msgstr "<link=\"MOLTENTUNGSTEN\">Вольфрам</link>"

#. STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.DESC"
msgid "(WSe<sub>2</sub>) Tungsten Diselenide is an inorganic <link=\"RAWMETAL\">Metal</link> compound heated into a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Диселенид вольфрама (WSe<sub>2</sub>) - это неорганический сплав <link=\"RAWMETAL\">Металла</link>, нагретый до <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния."

#. STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENTUNGSTENDISELENIDE.NAME"
msgid "<link=\"MOLTENTUNGSTENDISELENIDE\">Tungsten Diselenide</link>"
msgstr "<link=\"MOLTENTUNGSTENDISELENIDE\">Диселенид вольфрама</link>"

#. STRINGS.ELEMENTS.MOLTENURANIUM.DESC
msgctxt "STRINGS.ELEMENTS.MOLTENURANIUM.DESC"
msgid "(U) Liquid Uranium is a highly <link=\"RADIATION\">Radioactive</link> substance, heated into a hazardous <link=\"ELEMENTSLIQUID\">Liquid</link> state.\n\nIt is a byproduct of <link=\"ENRICHEDURANIUM\">Enriched Uranium</link>."
msgstr "(U) Уран - высоко<link=\"RADIATION\">радиоактивный</link> элемент, разогретый для смертоносного <link=\"ELEMENTSLIQUID\">Жидкого</link> состояния.\n\nЯвляется побочным продуктом процесса <link=\"ENRICHEDURANIUM\">Обогащения урана</link>."

#. STRINGS.ELEMENTS.MOLTENURANIUM.NAME
msgctxt "STRINGS.ELEMENTS.MOLTENURANIUM.NAME"
msgid "<link=\"MOLTENURANIUM\">Liquid Uranium</link>"
msgstr "<link=\"MOLTENURANIUM\">Уран</link>"

#. STRINGS.ELEMENTS.MUD.DESC
msgctxt "STRINGS.ELEMENTS.MUD.DESC"
msgid "A mixture of <link=\"DIRT\">Dirt</link> and <link=\"WATER\">Water</link>.\n\nCan be separated into its base elements using a <link=\"SLUDGEPRESS\">Sludge Press</link>."
msgstr "Смесь <link=\"DIRT\">Земли</link> и <link=\"WATER\">Воды</link>.\n\nМожно разделить на составляющие ее базовые элементы с помощью <link=\"SLUDGEPRESS">Грязевого пресса</link>."

#. STRINGS.ELEMENTS.MUD.NAME
msgctxt "STRINGS.ELEMENTS.MUD.NAME"
msgid "<link=\"MUD\">Mud</link>"
msgstr "<link=\"MUD\">Тина</link>"

#. STRINGS.ELEMENTS.NAPHTHA.DESC
msgctxt "STRINGS.ELEMENTS.NAPHTHA.DESC"
msgid "Naphtha a distilled hydrocarbon mixture produced from the burning of <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr "Нафта - дистиллированная углеводородная смесь, полученная при сжигании <link=\"POLYPROPYLENE\">Пластика</link>."

#. STRINGS.ELEMENTS.NAPHTHA.NAME
msgctxt "STRINGS.ELEMENTS.NAPHTHA.NAME"
msgid "<link=\"NAPHTHA\">Liquid Naphtha</link>"
msgstr "<link=\"NAPHTHA\">Нафта</link>"

#. STRINGS.ELEMENTS.NIOBIUM.DESC
msgctxt "STRINGS.ELEMENTS.NIOBIUM.DESC"
msgid "(Nb) Niobium is a rare metal with many practical applications in metallurgy and superconductor <link=\"RESEARCH\">Research</link>."
msgstr "(Nb) Ниобий - <link=\"RAREMATERIALS\">Редкий металл</link> с множеством практических применений в металлургии и в качестве сверхпроводника <link=\"RESEARCH\">Исследований</link>."

#. STRINGS.ELEMENTS.NIOBIUM.NAME
msgctxt "STRINGS.ELEMENTS.NIOBIUM.NAME"
msgid "<link=\"NIOBIUM\">Niobium</link>"
msgstr "<link=\"NIOBIUMGAS\">Ниобий</link>"

#. STRINGS.ELEMENTS.NIOBIUMGAS.DESC
msgctxt "STRINGS.ELEMENTS.NIOBIUMGAS.DESC"
msgid "(Nb) Niobium Gas is a rare metal.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(Nb) Ниобий - редкий металл.\n\nЭта часть в <link=\"ELEMENTSGAS\">Газообразном</link> состоянии."

#. STRINGS.ELEMENTS.NIOBIUMGAS.NAME
msgctxt "STRINGS.ELEMENTS.NIOBIUMGAS.NAME"
msgid "<link=\"NIOBIUMGAS\">Niobium Gas</link>"
msgstr "<link=\"NIOBIUMGAS\">Ниобий</link>"

#. STRINGS.ELEMENTS.NUCLEARWASTE.DESC
msgctxt "STRINGS.ELEMENTS.NUCLEARWASTE.DESC"
msgid "Highly toxic liquid full of <link=\"RADIATION\">Radioactive Contaminants</link> which emit <link=\"RADIATION\">Radiation</link> that can be absorbed by <link=\"HIGHENERGYPARTICLESPAWNER\">Radbolt Generators</link>."
msgstr "Очень токсичная жидкость, полная <link=\"RADIATION\">Радиоактивных загрязнителей</link>, испускающих <link=\"RADIATION\">Радиацию</link>, которую может поглотить <link=\"HIGHENERGYPARTICLESPAWNER\">Генератор радчастиц</link>."

#. STRINGS.ELEMENTS.NUCLEARWASTE.NAME
msgctxt "STRINGS.ELEMENTS.NUCLEARWASTE.NAME"
msgid "<link=\"NUCLEARWASTE\">Liquid Nuclear Waste</link>"
msgstr "<link=\"NUCLEARWASTE\">Ядерные отходы</link>"

#. STRINGS.ELEMENTS.OBSIDIAN.DESC
msgctxt "STRINGS.ELEMENTS.OBSIDIAN.DESC"
msgid "Obsidian is a brittle composite of volcanic <link=\"GLASS\">Glass</link>."
msgstr "Обсидиан - это хрупкий композит вулканического <link=\"GLASS\">Стекла</link>."

#. STRINGS.ELEMENTS.OBSIDIAN.NAME
msgctxt "STRINGS.ELEMENTS.OBSIDIAN.NAME"
msgid "<link=\"OBSIDIAN\">Obsidian</link>"
msgstr "<link=\"OBSIDIAN\">Обсидиан</link>"

#. STRINGS.ELEMENTS.OXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.OXYGEN.DESC"
msgid "(O<sub>2</sub>) Oxygen is an atomically lightweight and breathable <link=\"ELEMENTSGAS\">Gas</link>, necessary for sustaining life.\n\nIt tends to rise above other gases."
msgstr "Кислород (O<sub>2</sub>) - это атомарно легкий, пригодный для дыхания <link=\"ELEMENTSGAS\">Газ</link>, необходимый для поддержания жизни.\n\nЕму свойственно подниматься выше других газов."

#. STRINGS.ELEMENTS.OXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.OXYGEN.NAME"
msgid "<link=\"OXYGEN\">Oxygen</link>"
msgstr "<link=\"OXYGEN\">Кислород</link>"

#. STRINGS.ELEMENTS.OXYROCK.DESC
msgctxt "STRINGS.ELEMENTS.OXYROCK.DESC"
msgid "(Ir<sub>3</sub>O<sub>2</sub>) Oxylite is a chemical compound that slowly emits breathable <link=\"OXYGEN\">Oxygen</link>.\n\nExcavating <link=\"OXYROCK\">Oxylite</link> increases its emission rate, but depletes the ore more rapidly."
msgstr "Оксилит (Ir<sub>3</sub>O<sub>2</sub>) - это химическое соединение, которое медленно выделяет пригодный для дыхания <link=\"OXYGEN\">Кислород</link>.\n\nВыкаппнный <link=\"OXYROCK\">Оксилит</link> быстрее выделяет кислород и расходуется."

#. STRINGS.ELEMENTS.OXYROCK.NAME
msgctxt "STRINGS.ELEMENTS.OXYROCK.NAME"
msgid "<link=\"OXYROCK\">Oxylite</link>"
msgstr "<link=\"OXYROCK\">Оксилит</link>"

#. STRINGS.ELEMENTS.PETROLEUM.DESC
msgctxt "STRINGS.ELEMENTS.PETROLEUM.DESC"
msgid "Petroleum is a <link=\"POWER\">Power</link> source refined from <link=\"CRUDEOIL\">Crude Oil</link>.\n\nIt is also an essential ingredient in the production of <link=\"POLYPROPYLENE\">Plastic</link>."
msgstr "Керосин - источник <link=\"POWER\">Электричества</link>, полученный из <link=\"CRUDEOIL\">Нефти</link>.\n\n.Он также является важным компонентом для производства <link=\"POLYPROPYLENE\">Пластика</link>."

#. STRINGS.ELEMENTS.PETROLEUM.NAME
msgctxt "STRINGS.ELEMENTS.PETROLEUM.NAME"
msgid "<link=\"PETROLEUM\">Petroleum</link>"
msgstr "<link=\"PETROLEUM\">Керосин</link>"

#. STRINGS.ELEMENTS.PETROLEUM.NAME_TWO
msgctxt "STRINGS.ELEMENTS.PETROLEUM.NAME_TWO"
msgid "<link=\"PETROLEUM\">Petroleum</link>"
msgstr "<link=\"PETROLEUM\">Керосин</link>"

#. STRINGS.ELEMENTS.PHOSPHATENODULES.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHATENODULES.DESC"
msgid "(PO<sup>3-</sup><sub>4</sub>) Nodules of sedimentary rock containing high concentrations of phosphate."
msgstr "Фосфатный гравий (PO<sup>3-</sup><sub>4</sub>) - осадочная порода, содержащая большое число фосфатов."

#. STRINGS.ELEMENTS.PHOSPHATENODULES.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHATENODULES.NAME"
msgid "<link=\"PHOSPHATENODULES\">Phosphate Nodules</link>"
msgstr "<link=\"PHOSPHATENODULES\">Фосфатный гравий</link>"

#. STRINGS.ELEMENTS.PHOSPHORITE.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORITE.DESC"
msgid "Phosphorite is a composite of sedimentary rock, saturated with phosphate."
msgstr "Фосфорит - это смесь осадочных пород, обогащенных фосфатами."

#. STRINGS.ELEMENTS.PHOSPHORITE.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORITE.NAME"
msgid "<link=\"PHOSPHORITE\">Phosphorite</link>"
msgstr "<link=\"PHOSPHORITE\">Фосфорит</link>"

#. STRINGS.ELEMENTS.PHOSPHORUS.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORUS.DESC"
msgid "(P) Refined Phosphorus is a chemical element in its <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Очищенный фосфор (P) - это химический элемент в его <link=\"ELEMENTSSOLID\">Твердом</link> состоянии."

#. STRINGS.ELEMENTS.PHOSPHORUS.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORUS.NAME"
msgid "<link=\"PHOSPHORUS\">Refined Phosphorus</link>"
msgstr "<link=\"PHOSPHORUS\">Очищенный фосфор</link>"

#. STRINGS.ELEMENTS.PHOSPHORUSGAS.DESC
msgctxt "STRINGS.ELEMENTS.PHOSPHORUSGAS.DESC"
msgid "(P) Phosphorus Gas is the <link=\"ELEMENTSGAS\">Gaseous</link> state of <link=\"PHOSPHORUS\">Refined Phosphorus</link>."
msgstr "Фосфор (P) - это химический элемент в состоянии <link=\"ELEMENTSGAS\">Газа</link>."

#. STRINGS.ELEMENTS.PHOSPHORUSGAS.NAME
msgctxt "STRINGS.ELEMENTS.PHOSPHORUSGAS.NAME"
msgid "<link=\"PHOSPHORUSGAS\">Phosphorus Gas</link>"
msgstr "<link=\"PHOSPHORUSGAS\">Фосфор</link>"

#. STRINGS.ELEMENTS.POLYPROPYLENE.BUILD_DESC
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.BUILD_DESC"
msgid "Buildings made of this <link=\"POLYPROPYLENE\">Plastic</link> have antiseptic properties"
msgstr "Постройки из <link=\"POLYPROPYLENE\">Пластика</link> обладают антисептическими свойствами"

#. STRINGS.ELEMENTS.POLYPROPYLENE.DESC
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.DESC"
msgid "(C<sub>3</sub>H<sub>6</sub>)<sub>n</sub> <link=\"POLYPROPYLENE\">Plastic</link> is a thermoplastic polymer.\n\nIt is useful for constructing a variety of advanced buildings and equipment."
msgstr "Пластик (C<sub>3</sub>H<sub>6</sub>)<sub>n</sub> - <link=\"POLYPROPYLENE\">Пластик</link> - это термопластичный полимер.\n\nОн используется для строительства продвинутых построек и оборудования."

#. STRINGS.ELEMENTS.POLYPROPYLENE.NAME
msgctxt "STRINGS.ELEMENTS.POLYPROPYLENE.NAME"
msgid "<link=\"POLYPROPYLENE\">Plastic</link>"
msgstr "<link=\"POLYPROPYLENE\">Пластик</link>"

#. STRINGS.ELEMENTS.PONDSCUM.DESC
msgctxt "STRINGS.ELEMENTS.PONDSCUM.DESC"
msgid "Pondscum is a soft, naturally occurring composite of biological nutrients.\n\nIt may be processed into <link=\"FERTILIZER\">Fertilizer</link> and aids in the growth of certain <link=\"PLANTS\">Plants</link>."
msgstr "Тина - это мягкая, естественно образующаяся смесь биологических питательных веществ.\n\nОна может быть переработана в <link=\"FERTILIZER\">Удобрение</link> и помочь росту некоторых <link=\"PLANTS\">Растений</link>."

#. STRINGS.ELEMENTS.PONDSCUM.NAME
msgctxt "STRINGS.ELEMENTS.PONDSCUM.NAME"
msgid "<link=\"PONDSCUM\">Pondscum</link>"
msgstr "<link=\"PONDSCUM\">Тина</link>"

#. STRINGS.ELEMENTS.PROPANE.DESC
msgctxt "STRINGS.ELEMENTS.PROPANE.DESC"
msgid "(C<sub>3</sub>H<sub>8</sub>) Propane Gas is a natural alkane.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state.\n\nIt is useful in <link=\"POWER\">Power</link> production."
msgstr "Пропан (C<sub>3</sub>H<sub>8</sub>) - это природный алкан в состоянии <link=\"ELEMENTSGAS\">Газа</link>.\n\nОн используется в производстве <link=\"POWER\">Электричества</link>."

#. STRINGS.ELEMENTS.PROPANE.NAME
msgctxt "STRINGS.ELEMENTS.PROPANE.NAME"
msgid "<link=\"PROPANE\">Propane Gas</link>"
msgstr "<link=\"PROPANE\">Пропан</link>"

#. STRINGS.ELEMENTS.RADIATIONPROPERTIES
msgctxt "STRINGS.ELEMENTS.RADIATIONPROPERTIES"
msgid "Radiation Absorption Factor: {0}\nRadiation Emission/1000kg: {1}"
msgstr "Уровень поглощения радиации: {0}\nРадиационное излучение/1000кг: {1}"

#. STRINGS.ELEMENTS.RADIUM.DESC
msgctxt "STRINGS.ELEMENTS.RADIUM.DESC"
msgid "(Ra) Radium is a <link=\"LIGHT\">Light</link> emitting radioactive substance.\n\nIt is useful as a <link=\"POWER\">Power</link> source."
msgstr "Радий (Ra) - это <link=\"LIGHT\">Светящееся</link>, выделяющее радиацию вещество.\n\nОн используется в качестве источника <link=\"POWER\">Электричества</link>."

#. STRINGS.ELEMENTS.RADIUM.NAME
msgctxt "STRINGS.ELEMENTS.RADIUM.NAME"
msgid "<link=\"RADIUM\">Radium</link>"
msgstr "<link=\"RADIUM\">Радий</link>"

#. STRINGS.ELEMENTS.REFINEDCARBON.DESC
msgctxt "STRINGS.ELEMENTS.REFINEDCARBON.DESC"
msgid "(C) Refined carbon is solid element purified from raw <link=\"CARBON\">Coal</link>."
msgstr "Очищенный углерод (C) - твердый элемент, получаемый из <link=\"CARBON\">Угля</link>."

#. STRINGS.ELEMENTS.REFINEDCARBON.NAME
msgctxt "STRINGS.ELEMENTS.REFINEDCARBON.NAME"
msgid "<link=\"REFINEDCARBON\">Refined Carbon</link>"
msgstr "<link=\"REFINEDCARBON\">Очищенный углерод</link>"

#. STRINGS.ELEMENTS.REGOLITH.DESC
msgctxt "STRINGS.ELEMENTS.REGOLITH.DESC"
msgid "Regolith is a sandy substance composed of the various particles that collect atop terrestrial objects.\n\nIt is useful as a <link=\"REGOLITH\">Filtration Medium</link>."
msgstr "Реголит - песчаный материал, состоящий из различных частиц, собирающихся на поверхности наземных объектов.\n\nПолезный <link=\"REGOLITH\">фильтрационный материал</link>."

#. STRINGS.ELEMENTS.REGOLITH.NAME
msgctxt "STRINGS.ELEMENTS.REGOLITH.NAME"
msgid "<link=\"REGOLITH\">Regolith</link>"
msgstr "<link=\"REGOLITH\">Реголит</link>"

#. STRINGS.ELEMENTS.RESIN.DESC
msgctxt "STRINGS.ELEMENTS.RESIN.DESC"
msgid "Sticky goo harvested from a grumpy tree.\n\nIt can be polymerized into <link=\"ISORESIN\">Isoresin</link> by boiling away its excess moisture."
msgstr "Липкая слизь, собранная со Сваридрева.\n\nЕго можно полимеризовать в <link=\"ISORESIN\">Изо-смолу</link>, выпарив лишнюю влагу."

#. STRINGS.ELEMENTS.RESIN.NAME
msgctxt "STRINGS.ELEMENTS.RESIN.NAME"
msgid "<link=\"RESIN\">Liquid Resin</link>"
msgstr "<link=\"RESIN\">Смола</link>"

#. STRINGS.ELEMENTS.ROCKGAS.DESC
msgctxt "STRINGS.ELEMENTS.ROCKGAS.DESC"
msgid "Rock Gas is rock that has been superheated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "Каменный газ - это камень, который был нагрет до состояния <link=\"ELEMENTSGAS\">Газа</link>."

#. STRINGS.ELEMENTS.ROCKGAS.NAME
msgctxt "STRINGS.ELEMENTS.ROCKGAS.NAME"
msgid "<link=\"ROCKGAS\">Rock Gas</link>"
msgstr "<link=\"ROCKGAS\">Каменный газ</link>"

#. STRINGS.ELEMENTS.RUST.DESC
msgctxt "STRINGS.ELEMENTS.RUST.DESC"
msgid "Rust is an iron oxide that forms from the breakdown of <link=\"IRON\">Iron</link>.\n\nIt is useful in some <link=\"OXYGEN\">Oxygen</link> production processes."
msgstr "Ржавчина - это оксид железа, который образуется в результате разрушения <link=\"IRON\">Железа</link>.\n\nОна используется для производства <link=\"OXYGEN\">Кислорода</link>."

#. STRINGS.ELEMENTS.RUST.NAME
msgctxt "STRINGS.ELEMENTS.RUST.NAME"
msgid "<link=\"RUST\">Rust</link>"
msgstr "<link=\"RUST\">Ржавчина</link>"

#. STRINGS.ELEMENTS.SALT.DESC
msgctxt "STRINGS.ELEMENTS.SALT.DESC"
msgid "(NaCl) Salt, also known as sodium chloride, is an edible chemical compound.\n\nWhen refined, it can be eaten with meals to increase Duplicant <link=\"MORALE\">Morale</link>."
msgstr "(NaCl) Соль, также известная как хлорид натрия, является съедобным химическим соединением.\n\nПосле рафинации ее можно употреблять во время еды, чтобы увеличить <link=\"MORALE\">Мораль</link> Дупликантов."

#. STRINGS.ELEMENTS.SALT.NAME
msgctxt "STRINGS.ELEMENTS.SALT.NAME"
msgid "<link=\"SALT\">Salt</link>"
msgstr "<link=\"SALT\">Соль</link>"

#. STRINGS.ELEMENTS.SALTGAS.DESC
msgctxt "STRINGS.ELEMENTS.SALTGAS.DESC"
msgid "(NaCl) Salt Gas is an edible chemical compound that has been superheated into a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(NaCl) Соленый газ - это съедобное химическое соединение, перегретое до <link=\"ELEMENTSGAS\">Газообразного</link> состояния."

#. STRINGS.ELEMENTS.SALTGAS.NAME
msgctxt "STRINGS.ELEMENTS.SALTGAS.NAME"
msgid "<link=\"SALTGAS\">Salt Gas</link>"
msgstr "<link=\"SALTGAS\">Соленый газ</link>"

#. STRINGS.ELEMENTS.SALTWATER.DESC
msgctxt "STRINGS.ELEMENTS.SALTWATER.DESC"
msgid "Salt Water is a natural, lightly concentrated solution of <link=\"SALT\">Salt</link> dissolved in <link=\"WATER\">Water</link>.\n\nIt can be used in desalination processes, separating out usable salt."
msgstr "Соленая вода представляет собой природный, низкоконцентрированный раствор<link=\"SALT\">Соли</link>, растворенной в <link=\"WATER\">Воде</link>.\n\nОн может использовать в процессах опреснения воды, отделяя полезную соль."

#. STRINGS.ELEMENTS.SALTWATER.NAME
msgctxt "STRINGS.ELEMENTS.SALTWATER.NAME"
msgid "<link=\"SALTWATER\">Salt Water</link>"
msgstr "<link=\"SALTWATER\">Соленая вода</link>"

#. STRINGS.ELEMENTS.SAND.DESC
msgctxt "STRINGS.ELEMENTS.SAND.DESC"
msgid "Sand is a composite of granular rock.\n\nIt is useful as a <link=\"FILTER\">Filtration Medium</link>."
msgstr "Песок - это соединение мелкого камня.\n\nОн используется в качестве <link=\"FILTER\">Фильтрующей среды</link>."

#. STRINGS.ELEMENTS.SAND.NAME
msgctxt "STRINGS.ELEMENTS.SAND.NAME"
msgid "<link=\"SAND\">Sand</link>"
msgstr "<link=\"SAND\">Песок</link>"

#. STRINGS.ELEMENTS.SANDCEMENT.DESC
msgctxt "STRINGS.ELEMENTS.SANDCEMENT.DESC"
msgid ""
msgstr ""

#. STRINGS.ELEMENTS.SANDCEMENT.NAME
msgctxt "STRINGS.ELEMENTS.SANDCEMENT.NAME"
msgid "<link=\"SANDCEMENT\">Sand Cement</link>"
msgstr "<link=\"SANDCEMENT\">Цемент</link>"

#. STRINGS.ELEMENTS.SANDSTONE.DESC
msgctxt "STRINGS.ELEMENTS.SANDSTONE.DESC"
msgid "Sandstone is a composite of relatively soft sedimentary rock.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "Песчаник - это соединение достаточно мягких осадочных пород.\n\nОн используется в качестве <b>строительного материала</b>."

#. STRINGS.ELEMENTS.SANDSTONE.NAME
msgctxt "STRINGS.ELEMENTS.SANDSTONE.NAME"
msgid "<link=\"SANDSTONE\">Sandstone</link>"
msgstr "<link=\"SANDSTONE\">Песчаник</link>"

#. STRINGS.ELEMENTS.SEDIMENTARYROCK.DESC
msgctxt "STRINGS.ELEMENTS.SEDIMENTARYROCK.DESC"
msgid "Sedimentary Rock is a hardened composite of sediment layers.\n\nIt is useful as a <b>Construction Material</b>."
msgstr "Осадочная порода - это укрепленное соединение осадочных слоев.\n\nОна используется в качестве <b>строительного материала</b>."

#. STRINGS.ELEMENTS.SEDIMENTARYROCK.NAME
msgctxt "STRINGS.ELEMENTS.SEDIMENTARYROCK.NAME"
msgid "<link=\"SEDIMENTARYROCK\">Sedimentary Rock</link>"
msgstr "<link=\"SEDIMENTARYROCK\">Осадочная порода</link>"

#. STRINGS.ELEMENTS.SLABS.DESC
msgctxt "STRINGS.ELEMENTS.SLABS.DESC"
msgid "Slabs are a refined mineral building block used for assembling advanced buildings."
msgstr "Строительные плиты - улучшенные минеральные строительные блоки, необходимые для сборки сложных построек."

#. STRINGS.ELEMENTS.SLABS.NAME
msgctxt "STRINGS.ELEMENTS.SLABS.NAME"
msgid "<link=\"SLABS\">Building Slab</link>"
msgstr "<link=\"SLABS\">Строительная плита</link>"

#. STRINGS.ELEMENTS.SLIMEMOLD.DESC
msgctxt "STRINGS.ELEMENTS.SLIMEMOLD.DESC"
msgid "Slime is a thick biomixture of algae, fungi, and mucopolysaccharides.\n\nIt can be distilled into <link=\"ALGAE\">Algae</link> and emits <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link> once dug up."
msgstr "Слизь - это густая смесь водорослей, грибов и мукополисахаридов.\n\nОна выделяет <link=\"CONTAMINATEDOXYGEN\">Загрязненный кислород</link> после выкапывания, из нее можно получить <link=\"ALGAE\">Водоросли</link> путем дистиляции."

#. STRINGS.ELEMENTS.SLIMEMOLD.NAME
msgctxt "STRINGS.ELEMENTS.SLIMEMOLD.NAME"
msgid "<link=\"SLIMEMOLD\">Slime</link>"
msgstr "<link=\"SLIMEMOLD\">Слизь</link>"

#. STRINGS.ELEMENTS.SNOW.DESC
msgctxt "STRINGS.ELEMENTS.SNOW.DESC"
msgid "(H<sub>2</sub>O) Snow is a mass of loose, crystalline ice particles.\n\nIt becomes <link=\"WATER\">Water</link> when melted."
msgstr "Снег (H<sub>2</sub>O) - это сыпучие, кристаллические частицы льда.\n\nОн становится <link=\"WATER\">Водой</link> при плавлении."

#. STRINGS.ELEMENTS.SNOW.NAME
msgctxt "STRINGS.ELEMENTS.SNOW.NAME"
msgid "<link=\"SNOW\">Snow</link>"
msgstr "<link=\"SNOW\">Снег</link>"

#. STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.DESC"
msgid "(CO<sub>2</sub>) Carbon Dioxide is an unbreathable compound in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Углекислый газ (CO<sub>2</sub>) - это не пригодное для дыхания соединение в <link=\"ELEMENTSSOLID\">Твердом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDCARBONDIOXIDE.NAME"
msgid "<link=\"SOLIDCARBONDIOXIDE\">Solid Carbon Dioxide</link>"
msgstr "<link=\"SOLIDCARBONDIOXIDE\">Углекислый газ</link>"

#. STRINGS.ELEMENTS.SOLIDCHLORINE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDCHLORINE.DESC"
msgid "(Cl) Chlorine is a natural <link=\"DISEASE\">Germ</link>-killing element in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Хлор (Cl) - это химический элемент в <link=\"ELEMENTSSOLID\">Твердом</link> состоянии, естественный убийца <link=\"DISEASE\">Микробов</link>."

#. STRINGS.ELEMENTS.SOLIDCHLORINE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDCHLORINE.NAME"
msgid "<link=\"SOLIDCHLORINE\">Solid Chlorine</link>"
msgstr "<link=\"SOLIDCHLORINE\">Хлор</link>"

#. STRINGS.ELEMENTS.SOLIDCRUDEOIL.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDCRUDEOIL.DESC"
msgid ""
msgstr ""

#. STRINGS.ELEMENTS.SOLIDCRUDEOIL.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDCRUDEOIL.NAME"
msgid "<link=\"SOLIDCRUDEOIL\">Solid Crude Oil</link>"
msgstr "<link=\"SOLIDCRUDEOIL\">Нефть</link>"

#. STRINGS.ELEMENTS.SOLIDETHANOL.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDETHANOL.DESC"
msgid "(C<sub>2</sub>H<sub>6</sub>O) Solid Ethanol is an advanced chemical compound.\n\nIt can be used as a highly effective fuel source when burned."
msgstr "(C<sub>2</sub>H<sub>6</sub>O) Этанол - усовершенствованное химическое соединение.\n\nОн применяется в качестве высокоэффективного источника сжигаемого топлива."

#. STRINGS.ELEMENTS.SOLIDETHANOL.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDETHANOL.NAME"
msgid "<link=\"SOLIDETHANOL\">Solid Ethanol</link>"
msgstr "<link=\"SOLIDETHANOL\">Этанол</link>"

#. STRINGS.ELEMENTS.SOLIDHYDROGEN.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDHYDROGEN.DESC"
msgid "(H) Solid Hydrogen is the universe's most common element in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Водород (H) - это самый распространенный во вселенной элемент в <link=\"ELEMENTSSOLID\">Твердом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDHYDROGEN.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDHYDROGEN.NAME"
msgid "<link=\"SOLIDHYDROGEN\">Solid Hydrogen</link>"
msgstr "<link=\"SOLIDHYDROGEN\">Водород</link>"

#. STRINGS.ELEMENTS.SOLIDMERCURY.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDMERCURY.DESC"
msgid "(Hg) Mercury is a rare <link=\"RAWMETAL\">Metal</link> in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(Hg) Ртуть — редкий <link=\"RAWMETAL\">Металл</link> в <link=\"ELEMENTSSOLID\">Твердотелом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDMERCURY.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDMERCURY.NAME"
msgid "<link=\"SOLIDMERCURY\">Mercury</link>"
msgstr "<link=\"SOLIDMERCURY\">Ртуть</link>"

#. STRINGS.ELEMENTS.SOLIDMETHANE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDMETHANE.DESC"
msgid "(CH<sub>4</sub>) Methane is an alkane in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(CH<sub>4</sub>) Метан является алканом в <link=\"ELEMENTSSOLID\">Твердотелом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDMETHANE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDMETHANE.NAME"
msgid "<link=\"SOLIDMETHANE\">Solid Methane</link>"
msgstr "<link=\"SOLIDMETHANE\">Твердый метан</link>"

#. STRINGS.ELEMENTS.SOLIDNAPHTHA.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDNAPHTHA.DESC"
msgid "Naphtha is a distilled hydrocarbon mixture in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Нафта — это дистиллированная углеводородная смесь в <link=\"ELEMENTSSOLID\">твердом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDNAPHTHA.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDNAPHTHA.NAME"
msgid "<link=\"SOLIDNAPHTHA\">Solid Naphtha</link>"
msgstr "<link=\"SOLIDNAPHTHA\">Твкрдая нафта</link>"

#. STRINGS.ELEMENTS.SOLIDNUCLEARWASTE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDNUCLEARWASTE.DESC"
msgid "Highly toxic solid full of <link=\"RADIATION\">Radioactive Contaminants</link>."
msgstr "Высокотоксичный твердый материал, полный <link=\"RADIATION\">Радиации</link>."

#. STRINGS.ELEMENTS.SOLIDNUCLEARWASTE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDNUCLEARWASTE.NAME"
msgid "<link=\"SOLIDNUCLEARWASTE\">Solid Nuclear Waste</link>"
msgstr "<link=\"SOLIDNUCLEARWASTE\">Твердые ядерные отходы</link>"

#. STRINGS.ELEMENTS.SOLIDOXYGEN.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDOXYGEN.DESC"
msgid "(O<sub>2</sub>) Solid Oxygen is a breathable element in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(O<sub>2</sub>) Твердый кислород — элемент, пригодный для дыхания, в <link=\"ELEMENTSSOLID\">Твердотелом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDOXYGEN.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDOXYGEN.NAME"
msgid "<link=\"SOLIDOXYGEN\">Solid Oxygen</link>"
msgstr "<link=\"SOLIDOXYGEN\">Твердый кислород</link>"

#. STRINGS.ELEMENTS.SOLIDPETROLEUM.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDPETROLEUM.DESC"
msgid "Petroleum is a <link=\"POWER\">Power</link> source.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Керосин — это источник <link=\"POWER\">Электричества</link>.\n\nВ данном случае — в <link=\"ELEMENTSSOLID\">Твердотелом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDPETROLEUM.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDPETROLEUM.NAME"
msgid "<link=\"SOLIDPETROLEUM\">Solid Petroleum</link>"
msgstr "<link=\"SOLIDPETROLEUM\">Твердый керосин</link>"

#. STRINGS.ELEMENTS.SOLIDPROPANE.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDPROPANE.DESC"
msgid "(C<sub>3</sub>H<sub>8</sub>) Solid Propane is a natural gas in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(C<sub>3</sub>H<sub>8</sub>) Твердый пропан — это природный газ в <link=\"ELEMENTSSOLID\">Твердотелом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDPROPANE.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDPROPANE.NAME"
msgid "<link=\"SOLIDPROPANE\">Solid Propane</link>"
msgstr "<link=\"SOLIDPROPANE\">Твердый пропан</link>"

#. STRINGS.ELEMENTS.SOLIDRESIN.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDRESIN.DESC"
msgid "Solidified goo harvested from a grumpy tree.\n\nIt is used in the production of <link=\"ISORESIN\">Isoresin</link>."
msgstr "Затвердевшая смола, собранная с сердитого дерева.\n\nИспользуется в производстве <link=\"ISORESIN\">Изо-смолы</link>."

#. STRINGS.ELEMENTS.SOLIDRESIN.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDRESIN.NAME"
msgid "<link=\"SOLIDRESIN\">Solid Resin</link>"
msgstr "<link=\"SOLIDRESIN\">Твердая смола</link>"

#. STRINGS.ELEMENTS.SOLIDSUPERCOOLANT.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDSUPERCOOLANT.DESC"
msgid "Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> coolant.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Супер-хладагент — это промышленный хладагент из <link=\"FULLERENE\">Фуллерена</link>.\n\nВ данном случае — в <link=\"ELEMENTSSOLID\">Твердотелом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDSUPERCOOLANT.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDSUPERCOOLANT.NAME"
msgid "<link=\"SOLIDSUPERCOOLANT\">Solid Super Coolant</link>"
msgstr "<link=\"SOLIDSUPERCOOLANT\">Твердый Супер-хладагент</link>"

#. STRINGS.ELEMENTS.SOLIDSYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDSYNGAS.DESC"
msgid "Solid Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSSOLID\">Solid</link>.\n\nIt can be converted into an efficient fuel."
msgstr "Твердый синтез-газ — это искусственное, непригодное для дыхания <link=\"ELEMENTSSOLID\">Твердотелое вещество</link>.\n\nМожет быть преобразован в эффективное топливо."

#. STRINGS.ELEMENTS.SOLIDSYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDSYNGAS.NAME"
msgid "<link=\"SYNGAS\">Solid Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">Твердый синтез-газ</link>"

#. STRINGS.ELEMENTS.SOLIDVISCOGEL.DESC
msgctxt "STRINGS.ELEMENTS.SOLIDVISCOGEL.DESC"
msgid "Visco-Gel is a polymer that has high surface tension when in <link=\"ELEMENTSLIQUID\">Liquid</link> form.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "Вискогель — это полимер с высокой поверхностным натяжением в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии.\n\nВ данном случае — в <link=\"ELEMENTSSOLID\">Твердом</link> состоянии."

#. STRINGS.ELEMENTS.SOLIDVISCOGEL.NAME
msgctxt "STRINGS.ELEMENTS.SOLIDVISCOGEL.NAME"
msgid "<link=\"SOLIDVISCOGEL\">Solid Visco-Gel</link>"
msgstr "<link=\"SOLIDVISCOGEL\">Твердый Вискогель</link>"

#. STRINGS.ELEMENTS.SOURGAS.DESC
msgctxt "STRINGS.ELEMENTS.SOURGAS.DESC"
msgid "Sour Gas is a hydrocarbon <link=\"ELEMENTSGAS\">Gas</link> containing high concentrations of hydrogen sulfide.\n\nIt is a byproduct of highly heated <link=\"PETROLEUM\">Petroleum</link>."
msgstr "Кислый газ — это углеводородный <link=\"ELEMENTSGAS\">Газ</link>, содержащий высокие концентрации сероводорода.\n\nОн является побочным продуктом сильно нагретого <link=\"PETROLEUM\">Керосина</link>."

#. STRINGS.ELEMENTS.SOURGAS.NAME
msgctxt "STRINGS.ELEMENTS.SOURGAS.NAME"
msgid "<link=\"SOURGAS\">Sour Gas</link>"
msgstr "<link=\"SOURGAS\">Кислый Газ</link>"

#. STRINGS.ELEMENTS.SOURGAS.NAME_TWO
msgctxt "STRINGS.ELEMENTS.SOURGAS.NAME_TWO"
msgid "<link=\"SOURGAS\">Sour Gas</link>"
msgstr "<link=\"SOURGAS\">Кислый Газ</link>"

#. STRINGS.ELEMENTS.STABLESNOW.DESC
msgctxt "STRINGS.ELEMENTS.STABLESNOW.DESC"
msgid "(H<sub>2</sub>O) Snow is a mass of loose, crystalline ice particles.\n\nIt becomes <link=\"WATER\">Water</link> when melted."
msgstr "(H<sub>2</sub>O) Снег — это масса рыхлых кристаллических частиц льда.\n\nПри таянии превращается в <link=\"WATER\">Воду</link>."

#. STRINGS.ELEMENTS.STABLESNOW.NAME
msgctxt "STRINGS.ELEMENTS.STABLESNOW.NAME"
msgid "Packed <link=\"SNOW\">Snow</link>"
msgstr "Слежавшийся <link=\"SNOW\">Снег</link>"

#. STRINGS.ELEMENTS.STATE.GAS
msgctxt "STRINGS.ELEMENTS.STATE.GAS"
msgid "Gas"
msgstr "Газ"

#. STRINGS.ELEMENTS.STATE.LIQUID
msgctxt "STRINGS.ELEMENTS.STATE.LIQUID"
msgid "Liquid"
msgstr "Жидкость"

#. STRINGS.ELEMENTS.STATE.SOLID
msgctxt "STRINGS.ELEMENTS.STATE.SOLID"
msgid "Solid"
msgstr "Твердотелый"

#. STRINGS.ELEMENTS.STATE.VACUUM
msgctxt "STRINGS.ELEMENTS.STATE.VACUUM"
msgid "None"
msgstr "Отсутствует"

#. STRINGS.ELEMENTS.STEAM.DESC
msgctxt "STRINGS.ELEMENTS.STEAM.DESC"
msgid "(H<sub>2</sub>O) Steam is <link=\"WATER\">Water</link> that has been heated into a scalding <link=\"ELEMENTSGAS\">Gas</link>."
msgstr "(H<sub>2</sub>O) Пар — это <link=\"WATER\">Вода</link>, нагретая до состояния обжигающего <link=\"ELEMENTSGAS\">Газа</link>."

#. STRINGS.ELEMENTS.STEAM.NAME
msgctxt "STRINGS.ELEMENTS.STEAM.NAME"
msgid "<link=\"STEAM\">Steam</link>"
msgstr "<link=\"STEAM\">Пар</link>"

#. STRINGS.ELEMENTS.STEEL.DESC
msgctxt "STRINGS.ELEMENTS.STEEL.DESC"
msgid "Steel is a <link=\"REFINEDMETAL\">Metal Alloy</link> composed of iron and carbon."
msgstr "Сталь — это <link=\"REFINEDMETAL\">Металлический сплав</link>, состоящий из железа и углерода."

#. STRINGS.ELEMENTS.STEEL.NAME
msgctxt "STRINGS.ELEMENTS.STEEL.NAME"
msgid "<link=\"STEEL\">Steel</link>"
msgstr "<link=\"STEEL\">Сталь</link>"

#. STRINGS.ELEMENTS.STEELGAS.DESC
msgctxt "STRINGS.ELEMENTS.STEELGAS.DESC"
msgid "Steel Gas is a superheated <link=\"RAWMETAL\">Metal</link> <link=\"ELEMENTSGAS\">Gas</link> composed of iron and carbon."
msgstr "Газообразная сталь — это перегретый <link=\"RAWMETAL\">Металлический</link> <link=\"ELEMENTSGAS\">Газ</link>, состоящий из железа и углерода."

#. STRINGS.ELEMENTS.STEELGAS.NAME
msgctxt "STRINGS.ELEMENTS.STEELGAS.NAME"
msgid "<link=\"STEELGAS\">Steel Gas</link>"
msgstr "<link=\"STEELGAS\">Газообразная Сталь</link>"

#. STRINGS.ELEMENTS.SUCROSE.DESC
msgctxt "STRINGS.ELEMENTS.SUCROSE.DESC"
msgid "(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) Sucrose is the raw form of sugar.\n\nIt can be used for cooking higher-quality <link=\"FOOD\">Food</link>."
msgstr "(C<sub>12</sub>H<sub>22</sub>O<sub>11</sub>) Сахароза — это сахар натурального происхождения.\n\nМожет использоваться для приготовления более качественной <link=\"FOOD\">Еды</link>."

#. STRINGS.ELEMENTS.SUCROSE.NAME
msgctxt "STRINGS.ELEMENTS.SUCROSE.NAME"
msgid "<link=\"SUCROSE\">Sucrose</link>"
msgstr "<link=\"SUCROSE\">Сахароза</link>"

#. STRINGS.ELEMENTS.SUGARWATER.DESC
msgctxt "STRINGS.ELEMENTS.SUGARWATER.DESC"
msgid "Nectar is a natural, lightly concentrated solution of <link=\"SUCROSE\">Sucrose</link> dissolved in <link=\"WATER\">Water</link>."
msgstr "Нектар — это натуральный, слегка концентрированный раствор <link=\"SUCROSE\">Сахарозы</link>, растворенной в <link=\"WATER\">Воде</link>."

#. STRINGS.ELEMENTS.SUGARWATER.NAME
msgctxt "STRINGS.ELEMENTS.SUGARWATER.NAME"
msgid "<link=\"SUGARWATER\">Nectar</link>"
msgstr "<link=\"SUGARWATER\">Нектар</link>"

#. STRINGS.ELEMENTS.SULFUR.DESC
msgctxt "STRINGS.ELEMENTS.SULFUR.DESC"
msgid "(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> production.\n\nThis selection is in a <link=\"ELEMENTSSOLID\">Solid</link> state."
msgstr "(S) Сера — распространенный химический элемент и побочный продукт производства <link=\"METHANE\">Природного газа</link>.\n\nВ данном случае — в <link=\"ELEMENTSSOLID\">Твердом</link> состоянии."

#. STRINGS.ELEMENTS.SULFUR.NAME
msgctxt "STRINGS.ELEMENTS.SULFUR.NAME"
msgid "<link=\"SULFUR\">Sulfur</link>"
msgstr "<link=\"SULFUR\">Сера</link>"

#. STRINGS.ELEMENTS.SULFURGAS.DESC
msgctxt "STRINGS.ELEMENTS.SULFURGAS.DESC"
msgid "(S) Sulfur is a common chemical element and byproduct of <link=\"METHANE\">Natural Gas</link> production.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(S) Сера — распространённый химический элемент и побочный продукт производства <link=\"METHANE\"Природного газа</link>.\n\nВ данном случае — в <link=\"ELEMENTSGAS\">Газообразном</link> состоянии."

#. STRINGS.ELEMENTS.SULFURGAS.NAME
msgctxt "STRINGS.ELEMENTS.SULFURGAS.NAME"
msgid "<link=\"SULFURGAS\">Sulfur Gas</link>"
msgstr "<link=\"SULFURGAS\">Газообразная сера</link>"

#. STRINGS.ELEMENTS.SUPERCOOLANT.DESC
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANT.DESC"
msgid "Super Coolant is an industrial-grade coolant that utilizes the unusual energy states of <link=\"FULLERENE\">Fullerene</link>.\n\nThis selection is in a <link=\"ELEMENTSLIQUID\">Liquid</link> state."
msgstr "Супер-хладагент — это промышленный хладагент, использующий необычные энергетические состояния <link=\"FULLERENE\">Фуллерена</link>.\n\nВ данном случае — в <link=\"ELEMENTSLIQUID\">Жидком</link> состоянии."

#. STRINGS.ELEMENTS.SUPERCOOLANT.NAME
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANT.NAME"
msgid "<link=\"SUPERCOOLANT\">Super Coolant</link>"
msgstr "<link=\"SUPERCOOLANT\">Супер-хладагент</link>"

#. STRINGS.ELEMENTS.SUPERCOOLANTGAS.DESC
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANTGAS.DESC"
msgid "Super Coolant is an industrial-grade <link=\"FULLERENE\">Fullerene</link> coolant.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "Супер-хладагент — это промышленный хладагент из <link=\"FULLERENE\">Фуллерена</link>.\n\nВ данном случае — в <link=\"ELEMENTSGAS\">Газообразном</link> состоянии."

#. STRINGS.ELEMENTS.SUPERCOOLANTGAS.NAME
msgctxt "STRINGS.ELEMENTS.SUPERCOOLANTGAS.NAME"
msgid "<link=\"SUPERCOOLANTGAS\">Super Coolant Gas</link>"
msgstr "<link=\"SUPERCOOLANTGAS\">Газообразный супер-хладагент</link>"

#. STRINGS.ELEMENTS.SUPERINSULATOR.DESC
msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.DESC"
msgid "Insulite reduces <link=\"HEAT\">Heat Transfer</link> and is composed of recrystallized <link=\"KATAIRITE\">Abyssalite</link>."
msgstr "Инсулит снижает <link=\"HEAT\">Теплопередачу</link> и состоит из рекристаллизованного <link=\"KATAIRITE\">Абиссалита</link>."

#. STRINGS.ELEMENTS.SUPERINSULATOR.NAME
msgctxt "STRINGS.ELEMENTS.SUPERINSULATOR.NAME"
msgid "<link=\"SUPERINSULATOR\">Insulite</link>"
msgstr "<link=\"SUPERINSULATOR\">Инсулит</link>"

#. STRINGS.ELEMENTS.SYNGAS.DESC
msgctxt "STRINGS.ELEMENTS.SYNGAS.DESC"
msgid "Synthesis Gas is an artificial, unbreathable <link=\"ELEMENTSGAS\">Gas</link>.\n\nIt can be converted into an efficient fuel."
msgstr "Синтез-газ — это искусственный, непригодный для дыхания <link=\"ELEMENTSGAS\">Газ</link>.\n\nМожет быть преобразован в эффективное топливо."

#. STRINGS.ELEMENTS.SYNGAS.NAME
msgctxt "STRINGS.ELEMENTS.SYNGAS.NAME"
msgid "<link=\"SYNGAS\">Synthesis Gas</link>"
msgstr "<link=\"SYNGAS\">Синтез-газ</link>"

#. STRINGS.ELEMENTS.TALLOW.DESC
msgctxt "STRINGS.ELEMENTS.TALLOW.DESC"
msgid "A chunk of uncooked grease from a deceased <link=\"SEAL\">Spigot Seal</link>."
msgstr "Кусок сырого жира с покойного <link=\"SEAL\">Сифонника</link>."

#. STRINGS.ELEMENTS.TALLOW.NAME
msgctxt "STRINGS.ELEMENTS.TALLOW.NAME"
msgid "<link=\"TALLOW\">Tallow</link>"
msgstr "<link=\"TALLOW\">Жир</link>"

#. STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.DESC
msgctxt "STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.DESC"
msgid "Thermium is an industrial metal alloy formulated to maximize <link=\"HEAT\">Heat Transfer</link> and thermal dispersion."
msgstr "Термий — это промышленный металлический сплав, разработанный для максимальной <link=\"HEAT\">Теплопередачи</link> и тепловой дисперсии."

#. STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.NAME
msgctxt "STRINGS.ELEMENTS.TEMPCONDUCTORSOLID.NAME"
msgid "<link=\"TEMPCONDUCTORSOLID\">Thermium</link>"
msgstr "<link=\"TEMPCONDUCTORSOLID\">Термий</link>"

#. STRINGS.ELEMENTS.TESTELEMENT.DESC
msgctxt "STRINGS.ELEMENTS.TESTELEMENT.DESC"
msgid "((Fe,Mn)WO<sub>4</sub>) Wolframite is a dense Metallic element in a <link=\"ELEMENTSSOLID\">Solid</link> state.\n\nIt is a source of <link=\"TUNGSTEN\">Tungsten</link> and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "((Fe,Mn)WO<sub>4</sub>) Вольфрамит — плотный металлический элемент в <link=\"ELEMENTSSOLID\">Твердотелом</link> состоянии.\n\nЯвляется источником <link=\"TUNGSTEN\">Вольфрама</link> и подходит для создания систем <link=\"POWER\">Электроснабжения</link>."

#. STRINGS.ELEMENTS.TESTELEMENT.NAME
msgctxt "STRINGS.ELEMENTS.TESTELEMENT.NAME"
msgid "<link=\"TESTELEMENT\">Test Element</link>"
msgstr "<link=\"TESTELEMENT\">Тестовый Элемент</link>"

#. STRINGS.ELEMENTS.THERMALPROPERTIES
msgctxt "STRINGS.ELEMENTS.THERMALPROPERTIES"
msgid "\nSpecific Heat Capacity: {SPECIFIC_HEAT_CAPACITY}\nThermal Conductivity: {THERMAL_CONDUCTIVITY}"
msgstr "\nУдельная теплоемкость: {SPECIFIC_HEAT_CAPACITY}\nТеплопроводность: {THERMAL_CONDUCTIVITY}"

#. STRINGS.ELEMENTS.TOXICMUD.DESC
msgctxt "STRINGS.ELEMENTS.TOXICMUD.DESC"
msgid "A mixture of <link=\"TOXICSAND\">Polluted Dirt</link> and <link=\"DIRTYWATER\">Polluted Water</link>.\n\nCan be separated into its base elements using a <link=\"SLUDGEPRESS\">Sludge Press</link>."
msgstr "Смесь <link=\"TOXICSAND\">Загрязненной земли</link> и <link=\"DIRTYWATER\">Загрязненной воды</link>.\n\nМожет быть разделена на исходные элементы с помощью <link=\"SLUDGEPRESS\">Грязевого пресса</link>."

#. STRINGS.ELEMENTS.TOXICMUD.NAME
msgctxt "STRINGS.ELEMENTS.TOXICMUD.NAME"
msgid "<link=\"TOXICMUD\">Polluted Mud</link>"
msgstr "<link=\"TOXICMUD\">Загрязненная Грязь</link>"

#. STRINGS.ELEMENTS.TOXICSAND.DESC
msgctxt "STRINGS.ELEMENTS.TOXICSAND.DESC"
msgid "Polluted Dirt is unprocessed biological waste.\n\nIt emits <link=\"CONTAMINATEDOXYGEN\">Polluted Oxygen</link> over time."
msgstr "Загрязненная земля — необработанные биологические отходы.\n\nСо временем выделяет <link=\"CONTAMINATEDOXYGEN\">Загрязненный кислород</link>."

#. STRINGS.ELEMENTS.TOXICSAND.NAME
msgctxt "STRINGS.ELEMENTS.TOXICSAND.NAME"
msgid "<link=\"TOXICSAND\">Polluted Dirt</link>"
msgstr "<link=\"TOXICSAND\">Загрязненная Земля</link>"

#. STRINGS.ELEMENTS.TUNGSTEN.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTEN.DESC"
msgid "(W) Tungsten is an extremely tough crystalline <link=\"RAWMETAL\">Metal</link>.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(W) Вольфрам — крайне прочный кристаллический <link=\"RAWMETAL\">Металл</link>.\n\nПодходит для создания систем <link=\"POWER\">электроснабжения</link>."

#. STRINGS.ELEMENTS.TUNGSTEN.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTEN.NAME"
msgid "<link=\"TUNGSTEN\">Tungsten</link>"
msgstr "<link=\"TUNGSTEN\">Вольфрам</link>"

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDE.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDE.DESC"
msgid "(WSe<sub>2</sub>) Tungsten Diselenide is an inorganic <link=\"RAWMETAL\">Metal</link> compound with a crystalline structure.\n\nIt is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "(WSe<sub>2</sub>) Диселенид вольфрама — неорганическое <link=\"RAWMETAL\">Металлическое</link> соединение с кристаллической структурой.\n\nПодходит для создания систем <link=\"POWER\">Электроснабжения</link>."

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDE.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDE.NAME"
msgid "<link=\"TUNGSTENDISELENIDE\">Tungsten Diselenide</link>"
msgstr "<link=\"TUNGSTENDISELENIDE\">Диселенид Вольфрама</link>"

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.DESC"
msgid "(WSe<sub>2</sub>) Tungsten Diselenide Gasis a superheated <link=\"RAWMETAL\">Metal</link> compound in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(WSe<sub>2</sub>) Диселенид вольфрама — перегретое <link=\"RAWMETAL\">Металлическое</link> соединение в <link=\"ELEMENTSGAS\">Газообразном</link> состоянии."

#. STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENDISELENIDEGAS.NAME"
msgid "<link=\"TUNGSTENDISELENIDEGAS\">Tungsten Diselenide Gas</link>"
msgstr "<link=\"TUNGSTENDISELENIDEGAS\">Газообразный Диселенид Вольфрама</link>"

#. STRINGS.ELEMENTS.TUNGSTENGAS.DESC
msgctxt "STRINGS.ELEMENTS.TUNGSTENGAS.DESC"
msgid "(W) Tungsten is a superheated crystalline <link=\"RAWMETAL\">Metal</link>.\n\nThis selection is in a <link=\"ELEMENTSGAS\">Gaseous</link> state."
msgstr "(W) Вольфрам — перегретый кристаллический <link=\"RAWMETAL\">Металл</link>.\n\nВ этом состоянии он находится в <link=\"ELEMENTSGAS\">Газообразной</link> форме."

#. STRINGS.ELEMENTS.TUNGSTENGAS.NAME
msgctxt "STRINGS.ELEMENTS.TUNGSTENGAS.NAME"
msgid "<link=\"TUNGSTENGAS\">Tungsten Gas</link>"
msgstr "<link=\"TUNGSTENGAS\">Газообразный Вольфрам</link>"

#. STRINGS.ELEMENTS.UNOBTANIUM.DESC
msgctxt "STRINGS.ELEMENTS.UNOBTANIUM.DESC"
msgid "(Nt) Neutronium is a mysterious and extremely resilient element.\n\nIt cannot be excavated by any Duplicant mining tool."
msgstr "(Nt) Нейтрониум — загадочный и чрезвычайно прочный элемент.\n\nНе поддается добыче никаким инструментом Дупликанта."

#. STRINGS.ELEMENTS.UNOBTANIUM.NAME
msgctxt "STRINGS.ELEMENTS.UNOBTANIUM.NAME"
msgid "<link=\"UNOBTANIUM\">Neutronium</link>"
msgstr "<link=\"UNOBTANIUM\">Нейтрониум</link>"

#. STRINGS.ELEMENTS.URANIUMORE.DESC
msgctxt "STRINGS.ELEMENTS.URANIUMORE.DESC"
msgid "(U) Uranium Ore is a highly <link=\"RADIATION\">Radioactive</link> substance.\n\nIt can be refined into fuel for research reactors."
msgstr "(U) Урановая руда — это высоко <link=\"RADIATION\">Радиоактивное</link> вещество.\n\nЕе можно переработать в топливо для научныз реакторов."

#. STRINGS.ELEMENTS.URANIUMORE.NAME
msgctxt "STRINGS.ELEMENTS.URANIUMORE.NAME"
msgid "<link=\"URANIUMORE\">Uranium Ore</link>"
msgstr "<link=\"URANIUMORE\">Урановая руда</link>"

#. STRINGS.ELEMENTS.VACUUM.DESC
msgctxt "STRINGS.ELEMENTS.VACUUM.DESC"
msgid "A vacuum is a space devoid of all matter."
msgstr "Вакуум — это пространство, лишенное материи."

#. STRINGS.ELEMENTS.VACUUM.NAME
msgctxt "STRINGS.ELEMENTS.VACUUM.NAME"
msgid "<link=\"VACUUM\">Vacuum</link>"
msgstr "<link=\"VACUUM\">Вакуум</link>"

#. STRINGS.ELEMENTS.VISCOGEL.DESC
msgctxt "STRINGS.ELEMENTS.VISCOGEL.DESC"
msgid "Visco-Gel Fluid is a <link=\"ELEMENTSLIQUID\">Liquid</link> polymer with high surface tension, preventing typical liquid flow and allowing for unusual configurations."
msgstr "Вискогель — это <link=\"ELEMENTSLIQUID\">Жидкий</link> полимер с высоким поверхностным натяжением, что препятствует обычному течению жидкости и позволяет создавать необычные формы."

#. STRINGS.ELEMENTS.VISCOGEL.NAME
msgctxt "STRINGS.ELEMENTS.VISCOGEL.NAME"
msgid "<link=\"VISCOGEL\">Visco-Gel Fluid</link>"
msgstr "<link=\"VISCOGEL\">Вискогель</link>"

#. STRINGS.ELEMENTS.VOID.DESC
msgctxt "STRINGS.ELEMENTS.VOID.DESC"
msgid "Cold, infinite nothingness."
msgstr "Холодная, бесконечная пустота."

#. STRINGS.ELEMENTS.VOID.NAME
msgctxt "STRINGS.ELEMENTS.VOID.NAME"
msgid "<link=\"VOID\">Void</link>"
msgstr "<link=\"VOID\">Пустота</link>"

#. STRINGS.ELEMENTS.WATER.DESC
msgctxt "STRINGS.ELEMENTS.WATER.DESC"
msgid "(H<sub>2</sub>O) Clean <link=\"WATER\">Water</link>, suitable for consumption."
msgstr "(H<sub>2</sub>O) Чистая <link=\"WATER\">Вода</link>, пригодная для потребления."

#. STRINGS.ELEMENTS.WATER.NAME
msgctxt "STRINGS.ELEMENTS.WATER.NAME"
msgid "<link=\"WATER\">Water</link>"
msgstr "<link=\"WATER\">Вода</link>"

#. STRINGS.ELEMENTS.WOLFRAMITE.DESC
msgctxt "STRINGS.ELEMENTS.WOLFRAMITE.DESC"
msgid "((Fe,Mn)WO<sub>4</sub>) Wolframite is a dense Metallic element in a <link=\"ELEMENTSSOLID\">Solid</link> state.\n\nIt is a source of <link=\"TUNGSTEN\">Tungsten</link> and is suitable for building <link=\"POWER\">Power</link> systems."
msgstr "((Fe,Mn)WO<sub>4</sub>) Вольфрамит — плотный металлический элемент в <link=\"ELEMENTSSOLID\">Твердотелом</link> состоянии.\n\nЯвляется источником <link=\"TUNGSTEN\">Вольфрама</link> и подходит для создания <link=\"POWER\">Электрических</link> систем."

#. STRINGS.ELEMENTS.WOLFRAMITE.NAME
msgctxt "STRINGS.ELEMENTS.WOLFRAMITE.NAME"
msgid "<link=\"WOLFRAMITE\">Wolframite</link>"
msgstr "<link=\"WOLFRAMITE\">Вольфрамит</link>"

#. STRINGS.ELEMENTS.WOODLOG.DESC
msgctxt "STRINGS.ELEMENTS.WOODLOG.DESC"
msgid "Wood is a good source of <link=\"HEAT\">Heat</link> and <link=\"POWER\">Power</link>.\n\nIts insulation properties and positive <link=\"DECOR\">Decor</link> also make it a useful <b>Construction Material</b>."
msgstr "Древесина — хороший источник <link=\"HEAT\">Тепла</link> и <link=\"POWER\">Электричества</link>.\n\nЕк теплоизоляционные свойства и положительное влияние на <link=\"DECOR\">Декор</link> также делают ее полезным <b>строительным материалом</b>."

#. STRINGS.ELEMENTS.WOODLOG.NAME
msgctxt "STRINGS.ELEMENTS.WOODLOG.NAME"
msgid "<link=\"WOOD\">Wood</link>"
msgstr "<link=\"WOOD\">Древесина</link>"

#. STRINGS.ELEMENTS.YELLOWCAKE.DESC
msgctxt "STRINGS.ELEMENTS.YELLOWCAKE.DESC"
msgid "(U<sub>3</sub>O<sub>8</sub>) Yellowcake is a byproduct of <link=\"URANIUM\">Uranium</link> mining.\n\nIt is useful in preparing fuel for <link=\"NUCLEARREACTOR\">Research Reactors</link>.\n\nNote: Do not eat."
msgstr "(U<sub>3</sub>O<sub>8</sub>) Желтый кек — побочный продукт добычи <link=\"URANIUM\">Урана</link>.\n\nИспользуется при подготовке топлива для <link=\"NUCLEARREACTOR\">Научных реакторов</link>.\n\nПримечание: не ешьте."

#. STRINGS.ELEMENTS.YELLOWCAKE.NAME
msgctxt "STRINGS.ELEMENTS.YELLOWCAKE.NAME"
msgid "<link=\"YELLOWCAKE\">Yellowcake</link>"
msgstr "<link=\"YELLOWCAKE\">Желтый кек</link>"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.DESC"
msgid "Because breathing underwater is better than... not."
msgstr "Потому что дышать под водой лучше, чем... не дышать."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.EFFECT"
msgid "Supplies Duplicants with <style=\"oxygen\">Oxygen</style> in underwater environments.\n\nMust be refilled with <link=\"OXYGEN\">Oxygen</link> at an <link=\"SUITLOCKER\">Atmo Suit Dock</link> when depleted."
msgstr "Обеспечивает Дупликантов <style=\"oxygen\">Кислородом</style> под водой.\n\nНеобходимо пополнять <link=\"OXYGEN\">Кислородом</link> в <link=\"SUITLOCKER\">доке экзокостюмов</link>."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.NAME"
msgid "<link=\"AQUASUIT\">Aqua Suit</link>"
msgstr "<link=\"AQUASUIT\">Аквакостюм</link>"

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.RECIPE_DESC"
msgid "Supplies Duplicants with <style=\"oxygen\">Oxygen</style> in underwater environments."
msgstr "Обеспечивает Дупликантов <style=\"oxygen\">Кислородом</style> в подводной среде."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_DESC"
msgid "A worn out <link=\"AQUASUIT\">Aqua Suit</link>.\n\nSuits can be repaired at a <link=\"CRAFTINGTABLE\">Crafting Station</link>."
msgstr "Изношенный <link=\"AQUASUIT\">Аквакостюм</link>.\n\nКостюмы можно отремонтировать на <link=\"CRAFTINGTABLE\">Ремесленном верстаке</link>."

#. STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.AQUA_SUIT.WORN_NAME"
msgid "<link=\"AQUASUIT\">Worn Lead Suit</link>"
msgstr "<link=\"AQUASUIT\">Изношенный антирадкостюм</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.DESC"
msgid "Ensures my Duplicants can breathe easy, anytime, anywhere."
msgstr "Гарантирует, что мои Дупликанты могут легко дышать в любое время и в любом месте."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.EFFECT
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.EFFECT"
msgid "Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link> in toxic and low breathability environments, and protects against extreme temperatures.\n\nMust be refilled with oxygen at an <link=\"SUITLOCKER\">Atmo Suit Dock</link> when depleted."
msgstr "Обеспечивает Дупликантов <link=\"OXYGEN\">Кислородом</link> в токсичных средах и средах с низкой воздухопроницаемостью, а также защищает от экстремальных температур.\n\nДолжен быть пополнен кислородом в <link=\"SUITLOCKER\">Доке экзокостюмов</link>."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.GENERICNAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.GENERICNAME"
msgid "Suit"
msgstr "Костюм"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.NAME"
msgid "<link=\"ATMOSUIT\">Atmo Suit</link>"
msgstr "<link=\"ATMOSUIT\">Экзокостюм</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.RECIPE_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.RECIPE_DESC"
msgid "Supplies Duplicants with <link=\"OXYGEN\">Oxygen</link>  in toxic and low breathability environments."
msgstr "Обеспечивает Дупликантов <link=\"OXYGEN\">Кислородом</link> в токсичных и с низкой воздухопроницаемостью средах."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_DESC"
msgid "Restore a <link=\"ATMOSUIT\">Worn Atmo Suit</link> to working order."
msgstr "Восстановите <link=\"ATMOSUIT\">Изношенный экзокостюм</link> в рабочее состояние."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_RECIPE_NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.REPAIR_WORN_RECIPE_NAME"
msgid "Repair <link=\"ATMOSUIT\">Atmo Suit</link>"
msgstr "Ремонт <link=\"ATMOSUIT\">Экзокостюма</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.WORN_DESC"
msgid "A worn out <link=\"ATMOSUIT\">Atmo Suit</link>.\n\nSuits can be repaired at an <link=\"SUITFABRICATOR\">Exosuit Forge</link>."
msgstr "Изношенный <link=\"ATMOSUIT\">Экзокостюм</link>.\n\nКостюмы можно отремонтировать в <link=\"SUITFABRICATOR\">Цехе экзокостюмов</link>."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.WORN_NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT.WORN_NAME"
msgid "<link=\"ATMOSUIT\">Worn Atmo Suit</link>"
msgstr "<link=\"ATMOSUIT\">Изношенный экзокостюм</link>"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.DESC"
msgid "Default belt for atmo suits."
msgstr "Стандартный экзоремень."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GOLD.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GOLD.DESC"
msgid "Better to be overdressed than underdressed."
msgstr "Лучше быть слишком нарядным, чем недостаточно."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GOLD.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GOLD.NAME"
msgid "Gold Atmo Belt"
msgstr "Золотой экзоремень"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GREY.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GREY.DESC"
msgid "Slick and understated space style."
msgstr "Стильный и сдержанный космический стиль."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GREY.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_GREY.NAME"
msgid "Slate Atmo Belt"
msgstr "Сланцевый экзоремень"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_NEON_PINK.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_NEON_PINK.DESC"
msgid "Visible from several planetoids away."
msgstr "Видим с нескольких планетоидов."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_NEON_PINK.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.BASIC_NEON_PINK.NAME"
msgid "Neon Pink Atmo Belt"
msgstr "Неоновый розовый экзоремень"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.CANTALOUPE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.CANTALOUPE.DESC"
msgid "A tribute to the <i>cucumis melo cantalupensis</i>."
msgstr "Данина <i>cucumis melo cantalupensis</i>."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.CANTALOUPE.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.CANTALOUPE.NAME"
msgid "Rocketmelon Atmo Belt"
msgstr "Дыневый экзоремень"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.LIMONE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.LIMONE.DESC"
msgid "This lime-hued belt really pulls an atmo suit together."
msgstr "Этот ремень цвета лайма действительно делает экзокостюм цельным."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.LIMONE.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.LIMONE.NAME"
msgid "Citrus Atmo Belt"
msgstr "Цитрусовый экзоремень"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.PUFT.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.PUFT.DESC"
msgid "If critters wore belts...\nReleased for Klei Fest 2023."
msgstr "Если бы существа носили ремни...\nВыпущено для Klei Fest 2023."

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.PUFT.NAME
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.PUFT.NAME"
msgid "Puft Atmo Belt"
msgstr "Экзоремень Пуфа"

#. STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_BLUE.DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.ATMO_SUIT_BELT.FACADES.SPARKLE_BLUE.DESC"
msgid "It's blue! It's shiny! It keeps atmo suit pants on!"
