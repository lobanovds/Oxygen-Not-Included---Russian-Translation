msgstr "Нет построенных <link=\"DOCTORSTATION\">Лазаретов</link>"

#. STRINGS.MISC.NOTIFICATIONS.NO_MEDICAL_COTS.TOOLTIP
msgctxt "STRINGS.MISC.NOTIFICATIONS.NO_MEDICAL_COTS.TOOLTIP"
msgid "There is nowhere for sick Duplicants receive medical care\n\n<link=\"DOCTORSTATION\">Sick Bays</link> can be built from the <b>Medicine Tab</b> {Hotkey/Plan8}"
msgstr "Вашим больным Дупликантам негде отдохнуть и получить медицинскую помощь\n\n<link=\"DOCTORSTATION\">Лазарет</link> можно построить из меню <b>Лечение</b> {Hotkey/Plan8}"

