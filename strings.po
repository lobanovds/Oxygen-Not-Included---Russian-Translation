msgstr "Высушеный {0}"

#. STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.DESC
msgctxt "STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.DESC"
msgid "A package of non-perishable dehydrated food.\n\nIt requires no refrigeration, but must be rehydrated before consumption."
msgstr "Упаковка нескоропортящейся высушенной еды.\n\nНе требует охлаждения, но должна быть регидратирована перед употреблением."

#. STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.NAME
msgctxt "STRINGS.ITEMS.DEHYDRATEDFOODPACKAGE.NAME"
msgid "Dry Ration"
msgstr "Сухой паек"

#. STRINGS.ITEMS.DREAMJOURNAL.DESC
msgctxt "STRINGS.ITEMS.DREAMJOURNAL.DESC"
msgid "A hand-scrawled account of <link=\"SLEEPCLINICPAJAMAS\">Pajama</link>-induced dreams.\n\nCan be analyzed using a <link=\"MEGABRAINTANK\">Somnium Synthesizer</link>."
msgstr "Рукописный отчет о снах, вызванных <link=\"SLEEPCLINICPAJAMAS\">Пижамой</link>.\n\nМожет быть проанализирован с помощью <link=\"MEGABRAINTANK\">Синтезатора Сомний</link>."

#. STRINGS.ITEMS.DREAMJOURNAL.NAME
msgctxt "STRINGS.ITEMS.DREAMJOURNAL.NAME"
msgid "Dream Journal"
msgstr "Журнал сновидений"

#. STRINGS.ITEMS.FOOD.BASICFORAGEPLANT.DESC
msgctxt "STRINGS.ITEMS.FOOD.BASICFORAGEPLANT.DESC"
msgid "A seedless fruit with an upsettingly bland aftertaste.\n\nIt cannot be replanted.\n\nDigging up Buried Objects may uncover a <link=\"BASICFORAGEPLANT\">Muckroot</link>."
msgstr "Фрукт без семечек с мягким послевкусием разочарования.\n\nНе может быть пересажен.\n\nПри выкапывании заваленных объектов может обнаружиться семя <link=\"BASICFORAGEPLANT\">гнилькорня</link>."

#. STRINGS.ITEMS.FOOD.BASICFORAGEPLANT.NAME
msgctxt "STRINGS.ITEMS.FOOD.BASICFORAGEPLANT.NAME"
msgid "<link=\"BASICFORAGEPLANT\">Muckroot</link>"
msgstr "<link=\"BASICFORAGEPLANT\">Гнилькорень</link>"

#. STRINGS.ITEMS.FOOD.BASICPLANTBAR.DESC
msgctxt "STRINGS.ITEMS.FOOD.BASICPLANTBAR.DESC"
