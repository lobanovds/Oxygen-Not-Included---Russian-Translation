msgstr "<smallcaps>Кому: <b>Доктор Склодовская</b><size=10><alpha=#AA> <msklodowska@gravitas.nova></size></color>\nОт: <b>Мистер Краус</b><alpha=#AA><size=10> <okraus@gravitas.nova></size></color></smallcaps>\n------------------\n"

