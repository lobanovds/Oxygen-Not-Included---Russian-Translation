#. STRINGS.MISC.NOTIFICATIONS.NEEDENERGYSOURCE.NAME
msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDENERGYSOURCE.NAME"
msgid "Colony requires a <link=\"POWER\">Power</link> source"
msgstr "Колонии требуется источник <link=\"POWER\">Электричества</link>"

#. STRINGS.MISC.NOTIFICATIONS.NEEDENERGYSOURCE.TOOLTIP
msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDENERGYSOURCE.TOOLTIP"
msgid "<link=\"POWER\">Power</link> is required to operate electrical buildings\n\n<link=\"MANUALGENERATOR\">Manual Generators</link> and <link=\"WIRE\">Wire</link> can be built from the <link=\"[3]\">Power Tab</link>"
msgstr "Для работы электрических построек требуется <link=\"POWER\">Электричество</link>\n\n<link=\"MANUALGENERATOR\">Ручной генератор</link> и <link=\"WIRE\">Провода</link> могут быть построены через меню <link=\"[3]\">Энергия</link>"

#. STRINGS.MISC.NOTIFICATIONS.NEEDFOOD.NAME
msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDFOOD.NAME"
msgid "Colony requires a food source"
msgstr "Колонии требуется источник еды"

#. STRINGS.MISC.NOTIFICATIONS.NEEDFOOD.TOOLTIP
msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDFOOD.TOOLTIP"
msgid "The colony will exhaust their supplies without a new <link=\"FOOD\">Food</link> source\n\n<link=\"MICROBEMUSHER\">Microbe Mushers</link> can be built from the <b>Food Tab</b> {Hotkey/Plan4}"
msgstr "Запасы <link=\"FOOD\">Еды</link> в колонии иссякнут, если Вы не найдете постоянный источник их производства\n\n<link=\"MICROBEMUSHER\">Миксер микробов</link> может быть построен из меню <b>Еда</b> {Hotkey/Plan4}"

#. STRINGS.MISC.NOTIFICATIONS.NEEDSLEEP.NAME
msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDSLEEP.NAME"
msgid "No <link=\"BED\">Cots</link> built"
msgstr "Колонии требуются <link=\"BED\">кровати</link>"

#. STRINGS.MISC.NOTIFICATIONS.NEEDSLEEP.TOOLTIP
msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDSLEEP.TOOLTIP"
msgid "My Duplicants would appreciate a place to sleep\n\n<link=\"BED\">Cots</link> can be built from the <b>Furniture Tab</b> {Hotkey/Plan9}"
msgstr "Вашим Дупликантам нужны спальные места\n\n<link=\"BED\">Койки</link> могут быть построены из меню <b>Мебель</b> {Hotkey/Plan9}"

#. STRINGS.MISC.NOTIFICATIONS.NEEDTOILET.NAME
msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDTOILET.NAME"
msgid "No <link=\"OUTHOUSE\">Outhouse</link> built"
msgstr "Колонии требуются <link=\"OUTHOUSE\">туалеты</link>"

#. STRINGS.MISC.NOTIFICATIONS.NEEDTOILET.TOOLTIP
msgctxt "STRINGS.MISC.NOTIFICATIONS.NEEDTOILET.TOOLTIP"
msgid "My Duplicants have nowhere to relieve themselves\n\n<link=\"OUTHOUSE\">Outhouses</link> can be built from the <b>Plumbing Tab</b> {Hotkey/Plan5}"
msgstr "Вашим Дупликантам негде справить нужду\n\n<link=\"OUTHOUSE\">Отхожие места</link> могут быть построены через меню  <b>Службы</b> {Hotkey/Plan5}"

#. STRINGS.MISC.NOTIFICATIONS.NEW_AUTOMATION_WARNING.NAME
