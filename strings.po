msgctxt "STRINGS.MISC.NOTIFICATIONS.NEWMUTANTSEED.TOOLTIP"
msgid "A new mutant variety of the {Plant} has been found. Analyze it at the <link=\"GENETICANALYSISSTATION\">Botanical Analyzer</link> to learn more!"
