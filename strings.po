msgctxt "STRINGS.UI.BUILDINGEFFECTS.TOOLTIPS.OVERHEAT_TEMP"
msgid "Begins overheating at <b>{0}</b>"
msgstr "Начинает перегреваться при <b>{0}</b>"

#. STRINGS.UI.BUILDINGEFFECTS.TOOLTIPS.PARTICLE_PORT_INPUT
msgctxt "STRINGS.UI.BUILDINGEFFECTS.TOOLTIPS.PARTICLE_PORT_INPUT"
msgid "A Radbolt Port on this building allows it to receive <style=\"KKeyword\">Radbolts</style>"
msgstr "Порт Радчастиц этой постройки позволяет получать <style=\"KKeyword\">Радчастицы</style>"

