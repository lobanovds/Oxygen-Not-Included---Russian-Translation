msgctxt "STRINGS.UI.USERMENUACTIONS.PICKUPABLEMOVE.NAME"
msgid "Relocate To"
msgstr "Переместить в"

#. STRINGS.UI.USERMENUACTIONS.PICKUPABLEMOVE.NAME_OFF
msgctxt "STRINGS.UI.USERMENUACTIONS.PICKUPABLEMOVE.NAME_OFF"
