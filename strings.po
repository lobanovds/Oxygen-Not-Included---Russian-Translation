#. STRINGS.LORE.BUILDINGS.SET_OBJECT.BODY.CONTAINER1
msgctxt "STRINGS.LORE.BUILDINGS.SET_OBJECT.BODY.CONTAINER1"
msgid "<smallcaps><b>Reminder to All Personnel!</b>\nFrom: <b>Admin</b><alpha=#AA><admin@gravitas.nova></color>\nTO: <b>All</b></smallcaps>\n------------------\n<indent=5%>\nTo all employees;\n\nThe Gravitas Facility does not officially host a \"Bring Your Child To Work Day\" office event. We ask that personnel please do not bring children into top secret research departments, and especially that they do not let said children play with the high velocity particle accelerators.\n\nWe thank you for your understanding.</indent>"
msgstr "<smallcaps><b>Напоминание всему персоналу!</b>\nОт: <b>Админ</b><alpha=#AA><admin@gravitas.nova></color>\nКому: <b>Всем</b></smallcaps>\n------------------\n<indent=5%>\nВсем сотрудникам;\n\nВ Центре Гравитас официально не проводится офисное мероприятие \"Приведи ребенка на работу\". Просим сотрудников не приводить детей в отделы секретных исследований, и особенно чтобы они не позволяли детям играть с высокоскоростными ускорителями частиц.\n\nМы благодарим вас за понимание.</indent>"

#. STRINGS.LORE.BUILDINGS.SET_OBJECT.BODY.SIGNATURE1
msgctxt "STRINGS.LORE.BUILDINGS.SET_OBJECT.BODY.SIGNATURE1"
msgid "\n-Admin\n<size=11>The Gravitas Facility</size>\n------------------\n"
msgstr "\n-Админ\n<size=11>Центр Гравитас</size>\n------------------\n"

#. STRINGS.LORE.BUILDINGS.SET_OBJECT.SUBTITLE
msgctxt "STRINGS.LORE.BUILDINGS.SET_OBJECT.SUBTITLE"
msgid "SUBJECT: IMPORTANT"
msgstr "ТЕМА: ВАЖНО"

