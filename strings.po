msgstr "Снабжает Дупликантов <link=\"OXYGEN\">Кислородом</link> в областях с токсичной или безкислородной средой.\n\nЗащищает Дупликантов от <link=\"RADIATION\">Радиации</link>."

#. STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.SUIT_OUT_OF_BATTERIES
msgctxt "STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.SUIT_OUT_OF_BATTERIES"
msgid "Suit Batteries Empty"
msgstr "Батарея костюма разряжена"

#. STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.WORN_DESC
msgctxt "STRINGS.EQUIPMENT.PREFABS.LEAD_SUIT.WORN_DESC"
msgid "A worn out <link=\"LEADSUIT\">Lead Suit</link>.\n\nSuits can be repaired at an <link=\"SUITFABRICATOR\">Exosuit Forge</link>."
msgstr "Изношенный <link=\"JETSUIT\">антирадиационный костюм</link>.\n\nКостюмы можно починить в любом <link=\"SUITFABRICATOR\">Цехе экзокостюмов</link>."

