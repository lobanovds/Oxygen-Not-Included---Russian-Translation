msgctxt "STRINGS.UI.BUILDINGEFFECTS.TOOLTIPS.REFILLOXYGENTANK"
msgid "Refills <style=\"KKeyword\">Exosuit</style> Oxygen tanks with <style=\"KKeyword\">Oxygen</style> for reuse"
